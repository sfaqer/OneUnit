// Параметр пересозданного звена цепочки причин. Причину готовой ошибки не заменить,
// а повторный выброс обернет ее лишним звеном, поэтому ошибка с другой причиной
// пересоздается. Пересозданное звено прозрачно: описание, модуль, строку, стек
// и параметры показывает исходная ошибка, а причину - само звено,
// см. ТестированиеСлужебный.ОшибкаСПричиной

Перем _Исходная; // ИнформацияОбОшибке - Исходная ошибка

// Исходная ошибка пересозданного звена
//
//  Возвращаемое значение:
//   ИнформацияОбОшибке - Исходная ошибка
//
Функция Исходная() Экспорт
	Возврат _Исходная;
КонецФункции

Процедура ОбработкаПолученияПредставления(Представление, СтандартнаяОбработка) // BSLLS:UnusedLocalMethod-off
	СтандартнаяОбработка = Ложь;
	Представление = Строка(_Исходная.Параметры);
КонецПроцедуры

Процедура ПриСозданииОбъекта(Исходная)
	_Исходная = Исходная;
КонецПроцедуры
