// Общая логика запуска прогонов дочерним процессом oscript через точку входа
// ядра: тестирование и обнаружение тестов, сбор покрытия кода. Используется
// командами консольного приложения (execute, discover), MCP-инструментами
// и процессным исполнителем тестов ядра (изоляция уровня "Процесс").

#Использовать 1commands
#Использовать tempfiles
#Использовать coverage
#Использовать fs

Перем _ПостроительТочкиВхода; // ПостроительТочкиВхода - Сборщик точки входа дочернего прогона

// Возвращает параметры запуска прогона со значениями по умолчанию
//
//  Возвращаемое значение:
//   Структура - Параметры запуска:
//    * РабочийКаталог - Строка - Каталог проекта, пустое значение - текущий каталог
//    * ЛогВывода - Лог, Произвольный - Лог трансляции вывода прогона или объект с методами
//                Информация(Текст) и Ошибка(Текст), которому 1commands отдает вывод процесса
//                порциями по мере чтения, Неопределено - не транслировать
//    * ПортОтладки - Число - Порт сервера отладки прогона, 0 - без отладки
//    * ПутьКОтчетуGenericCoverage - Строка - Путь к формируемому отчету покрытия GenericCoverage
//    * ПутьКОтчетуCobertura - Строка - Путь к формируемому отчету покрытия Cobertura
//    * ПутьКСтатистикеПокрытия - Строка - Путь к формируемому файлу статистики покрытия
//                (для изолированных прогонов: файл пишется в каталог статистики
//                родительского прогона и мержится им в общие отчеты покрытия)
//    * Импорты - Массив из Строка - Имена библиотек или полные пути, подключаемые
//                в прогоне после старта его поделки (для изолированных прогонов)
//    * ЛямбдаСовета - Строка - Лямбда-выражение совета создания поделки прогона,
//                исполняется в прогоне с захватом экземпляра набора, поднятого
//                напрямую через Новый, пустая строка - совет по умолчанию. Вывод
//                лямбды прогон передает сообщением канала событий изоляции
//                (см. КаналСобытийИзоляции.ПередатьВыводСовета)
//    * РаскладкаЛога - Строка - Раскладка лога прогона, по умолчанию JSONРаскладкаСообщения
//    * ТрансляцияСобытий - Булево - Транслировать события исполнения в stdout прогона
//                строками канала событий изоляции (для изолированных прогонов:
//                родитель ретранслирует их по ходу исполнения)
//    * КаталогЯдра - Строка - Каталог ядра (core чужой поставки, рядом обязан лежать
//                shared), которым выполняется прогон. Пустое значение - ядро, поставляемое
//                с текущим экземпляром OneUnit. Нужен приложениям, которые поставляют
//                OneUnit внутри себя, но прогоняют чужие тесты: тесты проекта тогда
//                выполняются тем ядром, на которое проект рассчитан.
//                Развязка при этом частичная. Точку входа строит по-прежнему построитель
//                вызывающего приложения, а он завязан на состав ядра: имена желудей,
//                имена деталек, настройки лога. Лишнюю детальку старое ядро пропустит,
//                а вот ядру новее построителя нужной детальки никто не запишет.
//                Дерево зависимостей прогона тоже остаётся прежним: lib.system
//                и lib.additional собираются из окружения вызывающего процесса
//                и oscript.cfg каталогов тестов
//
Функция ПараметрыЗапуска() Экспорт

	Параметры = Новый Структура();

	Параметры.Вставить("РабочийКаталог", "");
	Параметры.Вставить("ЛогВывода", Неопределено);
	Параметры.Вставить("ПортОтладки", 0);
	Параметры.Вставить("ПутьКОтчетуGenericCoverage", "");
	Параметры.Вставить("ПутьКОтчетуCobertura", "");
	Параметры.Вставить("ПутьКСтатистикеПокрытия", "");
	Параметры.Вставить("Импорты", Новый Массив);
	Параметры.Вставить("ЛямбдаСовета", "");
	Параметры.Вставить("РаскладкаЛога", "JSONРаскладкаСообщения");
	Параметры.Вставить("ТрансляцияСобытий", Ложь);
	Параметры.Вставить("КаталогЯдра", "");
	Параметры.Вставить("ИдентификаторПрогона", "");

	Возврат Параметры;

КонецФункции

// Запускает дочерний прогон без ожидания завершения. Вывод по мере поступления
// отдаётся в ЛогВывода параметров (как при синхронном Исполнить).
//
// Параметры:
//   Детальки  - см. ВыполнитьТестирование
//   Лог       - Лог - Лог вызывающего компонента
//   Параметры - см. ПараметрыЗапуска
//
//  Возвращаемое значение:
//   Структура - Контекст асинхронного прогона для ОпроситьПрогон / ЗавершитьПрогон:
//    * Процесс                 - Процесс - Запущенный процесс oscript
//    * Команда                 - Команда - Команда 1commands
//    * МенеджерВременныхФайлов - МенеджерВременныхФайлов - Временные файлы прогона
//    * ЛогВывода               - Произвольный - Приёмник вывода
//    * ФормироватьПокрытие     - Булево - Нужно ли мержить покрытие после завершения
//    * КаталогСтатистики       - Строка - Каталог stat_*.json при покрытии
//    * Параметры               - Структура - Копия параметров запуска
//    * ВремяНачала             - Число - Метка времени старта в мс
//
Функция НачатьПрогон(Детальки, Знач ВыполняемаяКоманда, Лог, Знач Параметры = Неопределено) Экспорт

	Контекст = ПодготовитьПрогон(Детальки, ВыполняемаяКоманда, Лог, Параметры);

	Контекст.Команда.УстановитьПериодОпросаЗавершения(50);
	Контекст.Процесс = Контекст.Команда.ЗапуститьПроцесс();
	Контекст.ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Возврат Контекст;

КонецФункции

// Сливает новый вывод запущенного прогона в его лог и возвращает признак завершения
//
// Параметры:
//  Контекст - см. НачатьПрогон
//
//  Возвращаемое значение:
//   Булево - Истина - процесс завершился (нужен ЗавершитьПрогон)
//
Функция ОпроситьПрогон(Контекст) Экспорт

	СлитьВыводПроцесса(Контекст.Процесс, Контекст.ЛогВывода);

	Возврат Контекст.Процесс.Завершен;

КонецФункции

// Прерывает зависший дочерний прогон. После вызова нужен ЗавершитьПрогон
//
// Параметры:
//  Контекст - см. НачатьПрогон
//
Процедура ПрерватьПрогон(Контекст) Экспорт

	Если Не Контекст.Процесс.Завершен Тогда
		Контекст.Процесс.Завершить();
	КонецЕсли;

КонецПроцедуры

// Дожидается завершения прогона, сливает остаток вывода и освобождает ресурсы
//
// Параметры:
//  Контекст - см. НачатьПрогон
//
//  Возвращаемое значение:
//   Структура - см. ВыполнитьТестирование
//
Функция ЗавершитьПрогон(Контекст) Экспорт

	Пока Не ОпроситьПрогон(Контекст) Цикл
		Приостановить(50);
	КонецЦикла;

	КодВозврата = Контекст.Процесс.КодВозврата;
	Вывод       = Контекст.Команда.ПолучитьВывод();

	Если Контекст.ФормироватьПокрытие Тогда
		СформироватьОтчетыПокрытия(Контекст.КаталогСтатистики, Контекст.Параметры);
	КонецЕсли;

	Контекст.МенеджерВременныхФайлов.Удалить();

	Возврат Новый Структура("КодВозврата, Вывод", КодВозврата, Вывод);

КонецФункции

// Выполняет тестирование дочерним прогоном
//
// Параметры:
//   Детальки  - Соответствие из КлючИЗначение - Детальки поделки прогона (фильтры тестов, отчеты, таймаут):
//    * Ключ     - Строка - Имя детальки поделки, например "КаталогиТестов"
//    * Значение - Строка, Число, Булево, Массив из Строка - Значение детальки
//   Лог       - Лог - Лог вызывающего компонента
//   Параметры - см. ПараметрыЗапуска, Неопределено - значения по умолчанию
//
//  Возвращаемое значение:
//   Структура - Результат прогона:
//    * КодВозврата - Число - Код возврата дочернего процесса
//    * Вывод       - Строка - Захваченный вывод прогона
//
Функция ВыполнитьТестирование(Детальки, Лог, Знач Параметры = Неопределено) Экспорт

	Возврат ВыполнитьПрогон(Детальки, ТелоКомандыТестирования(Параметры), Лог, Параметры);

КонецФункции

Функция ТелоКомандыТестирования(Знач Параметры)

	Если Параметры = Неопределено Тогда
		Параметры = ПараметрыЗапуска();
	КонецЕсли;

	Если Параметры.Свойство("ТрансляцияСобытий")
		И Параметры.ТрансляцияСобытий Тогда

		Трансляция =
			"	Поделка.НайтиЖелудь(
			|		""ТрансляторСобытийИзоляции"",
			|		Массивы.ИзЭлементов(Поделка.НайтиЖелудь(""КаналСобытийИзоляции""))
			|	);
			|";

	Иначе
		Трансляция = "";
	КонецЕсли;

	Возврат Трансляция +
		"	ТестПлан = МенеджерТестирования.Тестировать();
		|	Статистика = Поделка.НайтиЖелудь(""РепортерСтатистика"")
		|		.СтатистикаТестПлана();
		|
		|	Если Статистика.ПолучитьИлиУмолчание(""НаборовОшибка"", 0) > 0
		|		Или Статистика.ПолучитьИлиУмолчание(""НаборовСломано"", 0) > 0
		|		Или Статистика.ПолучитьИлиУмолчание(""ТестовОшибка"", 0) > 0
		|		Или Статистика.ПолучитьИлиУмолчание(""ТестовСломано"", 0) > 0 Тогда
		|		ЗавершитьРаботу(1);
		|	КонецЕсли;
		|";

КонецФункции

// Запускает тестирование дочерним процессом без ожидания завершения
//
// Параметры:
//   Детальки, Лог, Параметры - см. ВыполнитьТестирование
//
//  Возвращаемое значение:
//   см. НачатьПрогон
//
Функция НачатьТестирование(Детальки, Лог, Знач Параметры = Неопределено) Экспорт

	Возврат НачатьПрогон(Детальки, ТелоКомандыТестирования(Параметры), Лог, Параметры);

КонецФункции

// Выполняет обнаружение тестов дочерним прогоном. Узлы, которые не удалось
// обнаружить, выводятся в плане сломанными с причинами, а прогон завершается
// с ненулевым кодом возврата
//
// Параметры:
//   Детальки    - Соответствие из КлючИЗначение - Детальки поделки прогона (фильтры тестов):
//    * Ключ     - Строка - Имя детальки поделки, например "КаталогиТестов"
//    * Значение - Строка, Булево, Массив из Строка - Значение детальки
//   РежимВывода - Строка - Режим вывода обнаруженных тестов, см. РежимыВыводаЛога.
//                 Поддерживаются Дерево и ПлоскийСписок, прочие режимы план не выводят:
//                 подробные причины узлов, которые не удалось обнаружить, выводятся в любом
//                 режиме
//   Лог         - Лог - Лог вызывающего компонента
//   Параметры   - см. ПараметрыЗапуска, Неопределено - значения по умолчанию
//
//  Возвращаемое значение:
//   Структура - Результат прогона:
//    * КодВозврата - Число - Код возврата дочернего процесса
//    * Вывод       - Строка - Захваченный вывод прогона
//
Функция ВыполнитьОбнаружение(Детальки, Знач РежимВывода, Лог, Знач Параметры = Неопределено) Экспорт

	Если РежимВывода = РежимыВыводаЛога.Дерево Тогда
		Репортер = "Поделка.НайтиЖелудь(""РепортерЛогДерево"").ВывестиТестПлан(ТестПлан);";
	ИначеЕсли РежимВывода = РежимыВыводаЛога.ПлоскийСписок Тогда
		Репортер = "Поделка.НайтиЖелудь(""РепортерЛогПлоскийСписок"").ВывестиТестПлан(ТестПлан);";
	Иначе
		Репортер = "";
	КонецЕсли;

	// Подробные причины - после плана, как упавшие узлы после исполнения, и в любом
	// режиме вывода: ошибки выводятся даже без плана
	Репортер = Репортер + "
		|Поделка.НайтиЖелудь(""РепортерСтатистика"").ВывестиОшибкиОбнаружения(ТестПлан);";

	// Узлы, которые не удалось обнаружить, выведены в плане сломанными, но план
	// неполон - обнаружение завершается неудачей
	ВыполняемаяКоманда = СтрШаблон(
		"ТестПлан = МенеджерТестирования.Обнаружить();
		|%1
		|Если ТестПлан.ЕстьОшибкиОбнаружения() Тогда
		|	ЗавершитьРаботу(1);
		|КонецЕсли;
		|",
		Репортер
	);

	Возврат ВыполнитьПрогон(Детальки, ВыполняемаяКоманда, Лог, Параметры);

КонецФункции

// Выполняет обнаружение тестов дочерним прогоном с записью состава плана
// в JSON-файл (РепортерПланJSON) - без вывода в консоль и без исполнения тестов
//
// Параметры:
//   Детальки   - Соответствие из КлючИЗначение - Детальки поделки прогона (фильтры тестов):
//    * Ключ     - Строка - Имя детальки поделки, например "ФайлыТестов"
//    * Значение - Строка, Булево, Массив из Строка - Значение детальки
//   ПутьКПлану - Строка - Путь к формируемому файлу состава плана
//   Лог        - Лог - Лог вызывающего компонента
//   Параметры  - см. ПараметрыЗапуска, Неопределено - значения по умолчанию
//
//  Возвращаемое значение:
//   Структура - Результат прогона:
//    * КодВозврата - Число - Код возврата дочернего процесса
//    * Вывод       - Строка - Захваченный вывод прогона
//
Функция ВыполнитьОбнаружениеПлана(Детальки, Знач ПутьКПлану, Лог, Знач Параметры = Неопределено) Экспорт

	ВыполняемаяКоманда = СтрШаблон(
		"	ТестПлан = МенеджерТестирования.Обнаружить();
		|	Поделка.НайтиЖелудь(""РепортерПланJSON"").ЗаписатьПлан(ТестПлан, ""%1"");
		|",
		СтрЗаменить(ПутьКПлану, "\", "/")
	);

	Возврат ВыполнитьПрогон(Детальки, ВыполняемаяКоманда, Лог, Параметры);

КонецФункции

// Читает JSON-отчет прогона (РепортерJSON)
//
// Параметры:
//   ПутьКОтчету - Строка - Путь к файлу отчета
//
//  Возвращаемое значение:
//   Структура - Содержимое отчета:
//    * statistics - Структура - Статистика прогона:
//       ** total       - Число - Тестов обнаружено
//       ** passed      - Число - Тестов успешно
//       ** failed      - Число - Тестов с ошибками утверждений
//       ** broken      - Число - Тестов сломано
//       ** skipped     - Число - Тестов пропущено
//       ** aborted     - Число - Тестов прервано
//       ** duration_ms - Число - Длительность прогона в миллисекундах
//    * problems - Массив из Структура - Упавшие и сломанные тесты и наборы:
//       ** status  - Строка - Статус: "failed" или "broken"
//       ** suite   - Строка - Имя тестового набора
//       ** test    - Строка - Имя теста, отсутствует для проблемы всего набора
//       ** message - Строка - Краткие причины
//       ** details - Строка - Подробные причины со стеками
//       ** output  - Строка - Захваченный вывод, отсутствует при пустом выводе
//    * skipped_tests - Массив из Структура - Пропущенные тесты и наборы:
//       ** status - Строка - Статус: "skipped" или "aborted"
//       ** suite  - Строка - Имя тестового набора
//       ** test   - Строка - Имя теста, отсутствует для пропуска всего набора
//       ** reason - Строка - Причины пропуска
//       ** output - Строка - Захваченный вывод, отсутствует при пустом выводе
//    * tests - Массив из Структура - Все выполненные тесты в порядке плана:
//       ** status      - Строка - Статус: "passed", "failed", "broken", "skipped" или "aborted"
//       ** suite       - Строка - Имя тестового набора
//       ** test        - Строка - Имя теста
//       ** duration_ms - Число - Длительность теста в миллисекундах
//       ** message     - Строка - Краткие причины, отсутствует у успешных
//       ** details     - Строка - Подробные причины со стеками, отсутствует у успешных
//       ** output      - Строка - Захваченный вывод теста, отсутствует при пустом выводе
//   Неопределено - Файл отчета не существует или не разобран (прогон не состоялся
//                  или завершился аварийно, не дописав отчет)
//
Функция ПрочитатьОтчет(Знач ПутьКОтчету) Экспорт

	Если НЕ (Новый Файл(ПутьКОтчету)).Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.ОткрытьФайл(ПутьКОтчету);

	Попытка
		Отчет = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		Отчет = Неопределено;
	КонецПопытки;

	ЧтениеJSON.Закрыть();

	Возврат Отчет;

КонецФункции

// Возвращает существующий путь в каноническом регистре файловой системы.
// Также разворачивает короткие имена формата 8.3 в полные
//
// Параметры:
//   Путь - Строка - Путь к существующему файлу или каталогу
//
//  Возвращаемое значение:
//   Строка - Путь в регистре, в котором он хранится в файловой системе,
//            или исходный путь, если он не существует
//
Функция КаноническийРегистрПути(Знач Путь) Экспорт

	Файл = Новый Файл(Путь);

	Если НЕ Файл.Существует() Тогда
		Возврат Путь;
	КонецЕсли;

	ПолныйПуть   = Файл.ПолноеИмя;
	ПутьРодителя = (Новый Файл(Файл.Путь)).ПолноеИмя;

	Если ПутьРодителя = ПолныйПуть Тогда
		// Корень диска
		Возврат ВРег(ПолныйПуть);
	КонецЕсли;

	ИмяВФайловойСистеме = Файл.Имя;

	НайденныеФайлы = НайтиФайлы(ПутьРодителя, Файл.Имя);
	Если НайденныеФайлы.Количество() > 0 Тогда
		ИмяВФайловойСистеме = НайденныеФайлы[0].Имя;
	КонецЕсли;

	Возврат ОбъединитьПути(КаноническийРегистрПути(ПутьРодителя), ИмяВФайловойСистеме);

КонецФункции

Функция ВыполнитьПрогон(Детальки, Знач ВыполняемаяКоманда, Лог, Знач Параметры)

	Контекст = ПодготовитьПрогон(Детальки, ВыполняемаяКоманда, Лог, Параметры);

	Попытка
		КодВозврата = Контекст.Команда.Исполнить();
		Вывод       = Контекст.Команда.ПолучитьВывод();
	Исключение
		Контекст.МенеджерВременныхФайлов.Удалить();
		ВызватьИсключение;
	КонецПопытки;

	Если Контекст.ФормироватьПокрытие Тогда
		СформироватьОтчетыПокрытия(Контекст.КаталогСтатистики, Контекст.Параметры);
	КонецЕсли;

	Контекст.МенеджерВременныхФайлов.Удалить();

	Возврат Новый Структура("КодВозврата, Вывод", КодВозврата, Вывод);

КонецФункции

Функция ПодготовитьПрогон(Детальки, Знач ВыполняемаяКоманда, Лог, Знач Параметры)

	Если Параметры = Неопределено Тогда
		Параметры = ПараметрыЗапуска();
	КонецЕсли;

	БазовыйКаталог = ТекущийКаталог();

	ФормироватьПокрытие = ЗначениеЗаполнено(Параметры.ПутьКОтчетуGenericCoverage)
		ИЛИ ЗначениеЗаполнено(Параметры.ПутьКОтчетуCobertura);

	Если Параметры.Свойство("КаталогЯдра") И ЗначениеЗаполнено(Параметры.КаталогЯдра) Тогда
		Параметры.КаталогЯдра = АбсолютныйПуть(Параметры.КаталогЯдра, БазовыйКаталог);
	КонецЕсли;

	РабочийКаталог = КаноническийРегистрПути(АбсолютныйПуть(
		?(ЗначениеЗаполнено(Параметры.РабочийКаталог), Параметры.РабочийКаталог, БазовыйКаталог),
		БазовыйКаталог
	));

	НормализоватьПутиДеталек(Детальки, БазовыйКаталог);

	МенеджерВременныхФайлов = Новый МенеджерВременныхФайлов();
	МенеджерВременныхФайлов.БазовыйКаталог = МенеджерВременныхФайлов.СоздатьКаталог();

	КаталогСтатистики = "";

	Если ФормироватьПокрытие Тогда
		КаталогСтатистики = МенеджерВременныхФайлов.НовоеИмяФайла();
		ФС.ОбеспечитьПустойКаталог(КаталогСтатистики);
		Детальки.Вставить("КаталогСтатистикиПокрытия", КаталогСтатистики);
	КонецЕсли;

	Если ЗначениеЗаполнено(Параметры.ИдентификаторПрогона) Тогда
		Детальки.Вставить("ИдентификаторПрогона", Параметры.ИдентификаторПрогона);
	КонецЕсли;

	ИмяТочкиВхода = _ПостроительТочкиВхода.СоздатьТочкуВхода(
		Детальки,
		МенеджерВременныхФайлов,
		Лог,
		ВыполняемаяКоманда,
		Параметры,
		РабочийКаталог
	);

	Команда = Новый Команда();

	Команда.УстановитьКоманду("oscript");
	Команда.УстановитьРабочийКаталог(РабочийКаталог);
	Команда.ПоказыватьВыводНемедленно(Ложь);
	Команда.ПерехватыватьПотоки(Истина);

	Если ФормироватьПокрытие Тогда
		ПутьКСтатистике = ОбъединитьПути(КаталогСтатистики, "main.json");
	Иначе
		ПутьКСтатистике = Параметры.ПутьКСтатистикеПокрытия;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПутьКСтатистике) Тогда
		Команда.ДобавитьПараметр("-codestat=" + Команда.ОбернутьВКавычки(ПутьКСтатистике));
	КонецЕсли;

	Если Параметры.ПортОтладки > 0 Тогда
		Команда.ДобавитьПараметр("-debug=" + Параметры.ПортОтладки);
	КонецЕсли;

	Команда.ДобавитьПараметр(Команда.ОбернутьВКавычки(ИмяТочкиВхода));

	ЛогВывода = Параметры.ЛогВывода;

	Если ЛогВывода <> Неопределено Тогда
		Команда.ДобавитьЛогВыводаКоманды(ЛогВывода);
	КонецЕсли;

	Контекст = Новый Структура;
	Контекст.Вставить("Команда", Команда);
	Контекст.Вставить("Процесс", Неопределено);
	Контекст.Вставить("МенеджерВременныхФайлов", МенеджерВременныхФайлов);
	Контекст.Вставить("ЛогВывода", ЛогВывода);
	Контекст.Вставить("ФормироватьПокрытие", ФормироватьПокрытие);
	Контекст.Вставить("КаталогСтатистики", КаталогСтатистики);
	Контекст.Вставить("Параметры", Параметры);
	Контекст.Вставить("ВремяНачала", 0);

	Возврат Контекст;

КонецФункции

Процедура СлитьВыводПроцесса(Процесс, ЛогВывода)

	Если ЛогВывода = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Пока Процесс.ПотокВывода.ЕстьДанные Цикл
		ЛогВывода.Информация(Процесс.ПотокВывода.Прочитать());
	КонецЦикла;

	Пока Процесс.ПотокОшибок.ЕстьДанные Цикл
		ЛогВывода.Ошибка(Процесс.ПотокОшибок.Прочитать());
	КонецЦикла;

КонецПроцедуры

Функция АбсолютныйПуть(Знач Путь, Знач БазовыйКаталог)

	Если ПустаяСтрока(Путь) Тогда
		Возврат БазовыйКаталог;
	КонецЕсли;

	Если СтрДлина(Путь) > 1 И Сред(Путь, 2, 1) = ":" Тогда
		Возврат ФС.НормализоватьПуть(Путь);
	КонецЕсли;

	Если Лев(Путь, 2) = "\\" Или Лев(Путь, 2) = "//" Тогда
		Возврат ФС.НормализоватьПуть(Путь);
	КонецЕсли;

	Возврат ФС.НормализоватьПуть(ОбъединитьПути(БазовыйКаталог, Путь));

КонецФункции

Процедура НормализоватьПутиДеталек(Детальки, БазовыйКаталог)

	Для каждого ИмяСписка Из Массивы.ИзЭлементов("КаталогиТестов", "ФайлыТестов") Цикл

		Список = Детальки.Получить(ИмяСписка);
		Нормализованный = Новый Массив;

		Для каждого Путь Из Список Цикл
			Нормализованный.Добавить(АбсолютныйПуть(Путь, БазовыйКаталог));
		КонецЦикла;

		Детальки.Вставить(ИмяСписка, Нормализованный);

	КонецЦикла;

КонецПроцедуры

Процедура СформироватьОтчетыПокрытия(Знач КаталогСтатистики, Знач Параметры)

	ГлавныйФайлСтатистики = ОбъединитьПути(КаталогСтатистики, "main.json");

	Если НЕ (Новый Файл(ГлавныйФайлСтатистики)).Существует() Тогда
		Возврат;
	КонецЕсли;

	ПроцессорГенерации = Новый ГенераторОтчетаПокрытия();

	// Шаблон stat_*.json собирает статистику изолированных дочерних процессов
	ПроцессорГенерации.ФайлСтатистики(ГлавныйФайлСтатистики)
		.РабочийКаталог(КаталогСтатистики)
		.ИмяФайлаСтатистики("stat_*.json")
		.GenericCoverage("genericCoverage.xml")
		.Cobertura("cobertura.xml")
		.Сформировать();

	СкопироватьОтчет(ОбъединитьПути(КаталогСтатистики, "genericCoverage.xml"), Параметры.ПутьКОтчетуGenericCoverage);
	СкопироватьОтчет(ОбъединитьПути(КаталогСтатистики, "cobertura.xml"), Параметры.ПутьКОтчетуCobertura);

КонецПроцедуры

Процедура СкопироватьОтчет(Знач Источник, Знач Приемник)

	Если НЕ ЗначениеЗаполнено(Приемник) Тогда
		Возврат;
	КонецЕсли;

	ФС.ОбеспечитьКаталог(Новый Файл(Приемник).Путь);
	КопироватьФайл(Источник, Приемник);

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин ПостроительТочкиВхода)
	_ПостроительТочкиВхода = ПостроительТочкиВхода;
КонецПроцедуры
