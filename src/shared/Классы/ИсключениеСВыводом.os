// Параметр исключения, несущий перехваченный вывод упавшего кода: вывод - контекст
// отказа, а не мусор. Исключение с таким параметром - прозрачная обертка исходной
// ошибки: ее описание - описание исходной ошибки, причина - сама исходная ошибка,
// см. ТестированиеСлужебный.ВызватьСВыводом

Перем _Вывод; // Строка - Перехваченный вывод

// Перехваченный вывод упавшего кода
//
//  Возвращаемое значение:
//   Строка - Вывод
//
Функция Вывод() Экспорт
	Возврат _Вывод;
КонецФункции

Процедура ОбработкаПолученияПредставления(Представление, СтандартнаяОбработка) // BSLLS:UnusedLocalMethod-off
	СтандартнаяОбработка = Ложь;
	Представление = _Вывод;
КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач Вывод)
	_Вывод = Вывод;
КонецПроцедуры
