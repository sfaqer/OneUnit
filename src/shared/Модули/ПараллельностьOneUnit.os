// Разбор значения OneUnit.Параллельность для CLI и MCP

// Возвращает целое число потоков пула (не меньше 1)
//
// Параметры:
//  Значение - Строка, Число - Число потоков, "auto" или "0" — число CPU минус 1
//
//  Возвращаемое значение:
//   Число - Размер пула
//
Функция РазрешитьПараллельность(Знач Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Число = Значение;
	Иначе
		СтрокаЗначения = НРег(СокрЛП(Строка(Значение)));

		Если СтрокаЗначения = "auto" Или СтрокаЗначения = "0" Тогда
			Число = Новый СистемнаяИнформация().КоличествоПроцессоров - 1;
		Иначе
			Число = Число(СтрокаЗначения);
		КонецЕсли;

	КонецЕсли;

	Возврат Макс(1, Число);

КонецФункции

// Проверяет сочетание параллельности и отладки
//
// Параметры:
//  Параллельность - Число - Размер пула
//  ПортОтладки    - Число - Порт отладки, 0 — без отладки
//
Процедура ПроверитьОтладкуИПараллельность(Знач Параллельность, Знач ПортОтладки) Экспорт

	Если Параллельность > 1 И ПортОтладки > 0 Тогда
		ВызватьИсключение "Отладка (--debug) недоступна при параллельном прогоне (--parallel > 1)";
	КонецЕсли;

КонецПроцедуры
