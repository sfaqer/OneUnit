// Сведения о параметризованном вызове из текущего узла исполнения.

#Использовать collectionos

Перем ИнформацияВызовов; // Табакерка - Сведения о вызовах

// Параметры:
//  КонтекстЭлемента - КонтекстПараметра, КонтекстПоля - Параметр или поле, которому нужно значение
//  Контекст - КонтекстИсполнения - Контекст текущего узла
//
// Возвращаемое значение:
//  ИнформацияОПараметризованномВызове - Номер вызова и аргументы источника
//
Функция Значение(КонтекстЭлемента, Контекст) Экспорт // BSLLS:UnusedParameters-off

	Узел = Контекст.Узел();

	Если ТипЗнч(Узел) = Тип("ОпределениеТеста") Тогда

		Номер = Узел.НомерПараметризованногоВызова();

		Если Номер.СодержитЗначение() Тогда

			Возврат ИнформацияВызовов.Достать(Массивы.ИзЭлементов(
				Номер.Получить(),
				Узел.Параметры()
			));

		КонецЕсли;

	КонецЕсли;

	ВызватьИсключение "Информация о параметризованном вызове доступна только при выполнении параметризованного теста";

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин("ИнформацияОПараметризованномВызове") СведенияОВызовах)
	ИнформацияВызовов = СведенияОВызовах;
КонецПроцедуры
