#Использовать collectionos
#Использовать "../../../shared"

Перем _Лог;
Перем _РепортерСтатистика;

Перем _ВыводитсяПлан; // Булево - Выводится план без исполнения (discover): у узлов нет времени выполнения

// Выводит тест-план без исполнения (discover): тесты - строками списка. Наборы
// и контейнеры, которые не удалось обнаружить, тоже выводятся строкой - сломанными
// с причинами
//
// Параметры:
//  ТестПлан - ТестПлан - Составленный тест-план
//
Процедура ВывестиТестПлан(ТестПлан) Экспорт

	_ВыводитсяПлан = Истина;

	ТестПлан.Дети()
		.ПроцессорКоллекции()
		.ДляКаждого("Набор -> ВывестиУзел(Набор)", ЭтотОбъект);

	_ВыводитсяПлан = Ложь;

КонецПроцедуры

// Выводит узел плана после его потомков. Экспортная, потому что ее вызывает
// лямбда обхода, а лямбде доступны только экспортные методы
//
// Параметры:
//  Узел - ОпределениеТестНабора, ОпределениеТеста - Узел плана
//
Процедура ВывестиУзел(Узел) Экспорт

	Узел.Дети()
		.ДляКаждого("Дитя -> ВывестиУзел(Дитя)", ЭтотОбъект);

	Результат = _РепортерСтатистика.РезультатОбнаружения(Узел);

	Если Результат.СодержитЗначение() Или ЭтоТест(Узел) Тогда
		ВывестиВЛог(Узел, Результат);
	КонецЕсли;

КонецПроцедуры

&ПодпискаНаСобытие("ИсполнениеТестКонец")
Процедура ИсполнениеТестКонец(Тест, Результат) Экспорт

	Если ЭтоТест(Тест) Тогда
		ВывестиВЛог(Тест, Новый Опциональный(Результат));
	КонецЕсли;

КонецПроцедуры

// Выводит строку узла
//
// Параметры:
//  Определение - ОпределениеТестНабора, ОпределениеТеста - Узел плана
//  РезультатВыполнения - Опциональный - Результат узла (РезультатВыполненияТеста),
//                        пустой - у узла нет результата (план без исполнения)
//
Процедура ВывестиВЛог(Определение, РезультатВыполнения)

	Поля = Новый КартаСоответствие;
	Поля.Вставить("ИмяТеста",  Определение.ПолноеИмя());

	Если РезультатВыполнения.СодержитЗначение() Тогда

		Результат = РезультатВыполнения.Получить();

		Уровень = СостоянияВыполненияТестов.УровеньЛогаСостояния(Результат.Состояние());

		Причины = Результат.ОписанияПричин();
		Если Не Причины.Пусто() Тогда
			Поля.Вставить("Причина", Причины);
		КонецЕсли;

		Поля.Вставить("Результат", СостоянияВыполненияТестов.СимволСостояния(Результат.Состояние()));

		Если _ВыводитсяПлан Тогда
			// Цепочки причин: текстовая раскладка их не выводит - подробности идут
			// блоками после плана, а JSON-раскладка отдает их инструментам (MCP)
			Поля.Вставить("Подробности", Результат.Причины()
				.ПроцессорКоллекции()
				.Обработать("Причина -> ТестированиеСлужебный.ПодробноеОписаниеОшибки(""Причина"", Причина)")
				.ВСтроку(""));
		Иначе
			Поля.Вставить(
				"ВремяВыполнения",
				_РепортерСтатистика.СтатистикаТеста(Определение).ПолучитьИлиУмолчание("ВремяВыполнения", 0)
			);
		КонецЕсли;

	Иначе
		Уровень = УровниЛога.Информация;
	КонецЕсли;

	_Лог.ПоляИз(Поля.КлючиИЗначения())
		.Вывести("", Уровень);

КонецПроцедуры

Функция ЭтоТест(Узел)
	Возврат ТипЗнч(Узел) = Тип("ОпределениеТеста") И Узел.ТипОпределения() = ТипыОпределенийТестов.Тест;
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Лог("oscript.lib.oneunit.core") Лог,
	&Пластилин РепортерСтатистика)

	_Лог = Лог;

	_РепортерСтатистика = РепортерСтатистика;

	_ВыводитсяПлан = Ложь;

КонецПроцедуры
