// Канал трансляции событий из дочернего процесса изолированного прогона: каждое
// сообщение - отдельная строка stdout, маркер и JSON в одну строку. Сообщения
// идут вперемешку с прочим выводом процесса, который остается его выводом.
// Канал переводит сообщения трансляции в записи формата обмена и обратно.
//
// Строка канала - чистый ASCII: символы вне ASCII экранируются, и кодовая страница
// консоли не искажает имена наборов и тестов. Консоль в UTF-8 начинает порции
// вывода процесса с BOM - при разборе он отбрасывается.

#Использовать collectionos

Перем _Маркер;             // Строка - Префикс строки-сообщения
Перем _ИменаСобытий;       // ФиксированнаяКарта из КлючИЗначение - Имена событий в записях:
                           //  * Ключ     - Строка - Событие, см. СобытияИзоляции
                           //  * Значение - Строка - Имя события в записи
Перем _СобытияПоИменам;    // ФиксированнаяКарта из КлючИЗначение - События по именам в записях:
                           //  * Ключ     - Строка - Имя события в записи
                           //  * Значение - Строка - Событие, см. СобытияИзоляции
Перем _ПереносРезультатов; // ПереносРезультатов - Перевод результатов в записи и обратно
Перем _РепортерПланJSON;   // РепортерПланJSON - Перевод состава плана в записи и обратно

// Выводит сообщение строкой в stdout дочернего процесса - приемник транслятора
// событий изолированного прогона на уровне "Процесс"
//
// Параметры:
//  Сообщение - см. СообщениеЗаписи
//
Процедура Принять(Сообщение) Экспорт

	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(
		ПереносСтрокJSON.Нет,
		,
		,
		ЭкранированиеСимволовJSON.СимволыВнеASCII
	));
	ЗаписатьJSON(ЗаписьJSON, ЗаписьСообщения(Сообщение));

	Консоль.ВывестиСтроку(_Маркер + ЗаписьJSON.Закрыть());

КонецПроцедуры

// Разбирает строку вывода дочернего процесса
//
// Параметры:
//  СтрокаВывода - Строка - Строка вывода без перевода строки
//
//  Возвращаемое значение:
//   Опциональный - Сообщение трансляции, см. СообщениеЗаписи; пустой - строка
//    не сообщение, а обычный вывод
//
Функция Разобрать(Знач СтрокаВывода) Экспорт

	СтрокаВывода = СтрЗаменить(СтрЗаменить(СтрокаВывода, Символ(65279), ""), Символы.ВК, "");

	Если Не СтрНачинаетсяС(СтрокаВывода, _Маркер) Тогда
		Возврат Опциональные.Пустой();
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(Сред(СтрокаВывода, СтрДлина(_Маркер) + 1));
	Запись = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();

	Возврат Новый Опциональный(СообщениеЗаписи(Запись));

КонецФункции

// Переводит сообщение трансляции в запись формата обмена
//
// Параметры:
//  Сообщение - см. СообщениеЗаписи
//
//  Возвращаемое значение:
//   Структура - Запись сообщения:
//    * seq    - Число - Номер сообщения
//    * event  - Строка - Имя события: "plan", "testStart", "testEnd" или "suiteEnd"
//    * path   - Массив из Число - Путь узла, у событий теста и набора
//    * result - см. ПереносРезультатов.ЗаписьРезультата
//    * suites - см. РепортерПланJSON.ЗаписиСостава
//
Функция ЗаписьСообщения(Сообщение)

	Запись = Новый Структура(
		"seq, event",
		Сообщение.Номер,
		_ИменаСобытий.Получить(Сообщение.Событие).Получить()
	);

	Если Сообщение.Свойство("Путь") Тогда
		Запись.Вставить("path", Сообщение.Путь.ВМассив());
	КонецЕсли;

	Если Сообщение.Свойство("Результат") Тогда
		Запись.Вставить("result", _ПереносРезультатов.ЗаписьРезультата(Сообщение.Результат));
	КонецЕсли;

	Если Сообщение.Свойство("Состав") Тогда
		Запись.Вставить("suites", _РепортерПланJSON.ЗаписиСостава(Сообщение.Состав));
	КонецЕсли;

	Возврат Запись;

КонецФункции

// Переводит запись формата обмена в сообщение трансляции. Описание сообщения
// здесь общее для всех, кто его передает, - поэтому функция экспортная:
// ссылки «см.» из других модулей видят только экспортные методы
//
// Параметры:
//  Запись - см. ЗаписьСообщения
//
//  Возвращаемое значение:
//   Структура - Сообщение трансляции:
//    * Номер     - Число - Номер сообщения, сквозной с 1: по разрыву нумерации родитель
//                  узнает о потерянном сообщении, а не принимает набор без него за целый
//    * Событие   - Строка - Вид сообщения, см. СобытияИзоляции:
//                  Состав - состав плана на старте исполнения, поле Состав;
//                  НачалоТеста - начало теста или контейнера, поле Путь;
//                  КонецТеста - конец теста или контейнера, поля Путь и Результат;
//                  КонецНабора - конец набора, поля Путь и Результат
//    * Путь      - СписокМассив из Число - Путь узла индексами от плана: набор, тест, итерация
//    * Результат - РезультатВыполненияТеста - Копия результата со временем, измеренным в среде
//    * Состав    - см. РепортерПланJSON.СоставПлана
//
Функция СообщениеЗаписи(Запись) Экспорт

	// Неизвестное событие - не сообщение: выброшенное исключение оставит строку
	// выводом, а потерю сообщения покажет разрыв нумерации
	Сообщение = Новый Структура(
		"Номер, Событие",
		Запись.seq,
		_СобытияПоИменам.Получить(Запись.event).Получить()
	);

	Если Запись.Свойство("path") Тогда
		Сообщение.Вставить("Путь", Массивы.КакСписок(Запись.path));
	КонецЕсли;

	Если Запись.Свойство("result") Тогда
		Сообщение.Вставить("Результат", _ПереносРезультатов.РезультатЗаписи(Запись.result));
	КонецЕсли;

	Если Запись.Свойство("suites") Тогда
		Сообщение.Вставить("Состав", _РепортерПланJSON.СоставЗаписей(Запись.suites));
	КонецЕсли;

	Возврат Сообщение;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин ПереносРезультатов,
	&Пластилин РепортерПланJSON)

	_ПереносРезультатов = ПереносРезультатов;
	_РепортерПланJSON   = РепортерПланJSON;

	_Маркер = "##oneunit:";

	ИменаСобытий = Новый КартаСоответствие();
	ИменаСобытий.Вставить(СобытияИзоляции.Состав, "plan");
	ИменаСобытий.Вставить(СобытияИзоляции.НачалоТеста, "testStart");
	ИменаСобытий.Вставить(СобытияИзоляции.КонецТеста, "testEnd");
	ИменаСобытий.Вставить(СобытияИзоляции.КонецНабора, "suiteEnd");

	СобытияПоИменам = Новый КартаСоответствие();

	ИменаСобытий.ДляКаждого(
		"Событие, Имя -> СобытияПоИменам.Вставить(Имя, Событие)",
		Новый Структура("СобытияПоИменам", СобытияПоИменам)
	);

	_ИменаСобытий    = Новый ФиксированнаяКарта(ИменаСобытий);
	_СобытияПоИменам = Новый ФиксированнаяКарта(СобытияПоИменам);

КонецПроцедуры
