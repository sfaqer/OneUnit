// Описание конструктора и этапов исполнения тестового набора.

#Использовать collectionos
#Использовать fluent

Перем Конструктор;   // Опциональный - СигнатураМетода конструктора, пустой - сигнатуры конструктора нет
Перем ИмяКонструктора; // Строка - Имя явного конструктора, пустая строка - набор создается завязью
Перем ПередВсеми;    // ЭтапЖизненногоЦикла - Подготовка набора
Перем ПередКаждым;   // ЭтапЖизненногоЦикла - Подготовка экземпляра и методы перед тестом
Перем ПослеКаждого;  // ЭтапЖизненногоЦикла - Методы после теста
Перем ПослеВсех;     // ЭтапЖизненногоЦикла - Завершение набора
Перем ФабрикаЭтапов; // Табакерка - Этапы жизненного цикла

Функция Конструктор() Экспорт
	Возврат Конструктор;
КонецФункции

Функция ПередВсеми() Экспорт
	Возврат ПередВсеми;
КонецФункции

Функция ПередКаждым() Экспорт
	Возврат ПередКаждым;
КонецФункции

Функция ПослеКаждого() Экспорт
	Возврат ПослеКаждого;
КонецФункции

Функция ПослеВсех() Экспорт
	Возврат ПослеВсех;
КонецФункции

// Описывает вызов тестового метода на подготовленном экземпляре.
//
// Параметры:
//  ИмяМетода - Строка - Имя тестового метода
//
// Возвращаемое значение:
//  ЭтапЖизненногоЦикла - Вызов метода между ПередКаждым и ПослеКаждого
//
Функция Тест(Знач ИмяМетода) Экспорт
	Возврат ФабрикаЭтапов.Достать(Массивы.ИзЭлементов(Списки.ИзЭлементов(ИмяМетода), Ложь));
КонецФункции

// Признак подготовки экземпляра для методов уровня набора.
//
// Возвращаемое значение:
//  Булево - ПередВсеми или ПослеВсех требует подготовки экземпляра
//
Функция ТребуетПодготовкиНабора() Экспорт
	Возврат ПередВсеми.ТребуетПодготовки() Или ПослеВсех.ТребуетПодготовки();
КонецФункции

// Возвращает имена конструктора и всех методов жизненного цикла без повторений.
//
// Возвращаемое значение:
//  СписокМассив из Строка - Имена методов в порядке этапов
//
Функция Методы() Экспорт

	Возврат ИменаМетодов(Массивы.ИзЭлементов(
		МетодыКонструктора(),
		ПередВсеми.Методы(),
		ПередКаждым.Методы(),
		ПослеКаждого.Методы(),
		ПослеВсех.Методы()
	));

КонецФункции

// Возвращает методы, значения параметров которых получает узел набора.
//
// Возвращаемое значение:
//  СписокМассив из Строка - Конструктор, ПередВсеми и ПослеВсех без повторений
//
Функция МетодыНабора() Экспорт

	Возврат ИменаМетодов(Массивы.ИзЭлементов(
		МетодыКонструктора(),
		ПередВсеми.Методы(),
		ПослеВсех.Методы()
	));

КонецФункции

// Возвращает методы, значения параметров которых получает узел теста.
//
// Параметры:
//  ИмяМетода - Строка - Имя тестового метода
//
// Возвращаемое значение:
//  СписокМассив из Строка - Метод теста, ПередКаждым и ПослеКаждого без повторений
//
Функция МетодыТеста(Знач ИмяМетода) Экспорт

	Возврат ИменаМетодов(Массивы.ИзЭлементов(
		Тест(ИмяМетода).Методы(),
		ПередКаждым.Методы(),
		ПослеКаждого.Методы()
	));

КонецФункции

Функция МетодыКонструктора()

	Если Не ПустаяСтрока(ИмяКонструктора) Тогда
		Возврат Списки.ИзЭлементов(ИмяКонструктора);
	КонецЕсли;

	Возврат Списки.ИзЭлементов();

КонецФункции

Функция ИменаМетодов(Коллекции)

	Возврат ПроцессорыКоллекций.ИзКоллекции(Коллекции)
		.Развернуть("Методы -> Методы.ПроцессорКоллекции()")
		.Различные()
		.Получить("СписокМассив");

КонецФункции

Функция ЭтапНабора(ИменаМетодов)
	Возврат ФабрикаЭтапов.Достать(Массивы.ИзЭлементов(ИменаМетодов, Не ИменаМетодов.Пусто()));
КонецФункции

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин("ЭтапЖизненногоЦикла") ТабакеркаЭтапов,
	&Блестяшка МетодыЭтапов,
	&Блестяшка ИмяКонструктораНабора,
	&Блестяшка ОписаниеКонструктора)

	ФабрикаЭтапов = ТабакеркаЭтапов;
	Конструктор = ОписаниеКонструктора;
	ИмяКонструктора = ИмяКонструктораНабора;
	ПередВсеми = ЭтапНабора(МетодыЭтапов.Получить("ПередВсеми").Получить());
	ПослеВсех = ЭтапНабора(МетодыЭтапов.Получить("ПослеВсех").Получить());
	ПередКаждым = ФабрикаЭтапов.Достать(Массивы.ИзЭлементов(
		МетодыЭтапов.Получить("ПередКаждым").Получить(),
		Истина
	));
	ПослеКаждого = ФабрикаЭтапов.Достать(Массивы.ИзЭлементов(
		МетодыЭтапов.Получить("ПослеКаждого").Получить(),
		Ложь
	));

КонецПроцедуры
