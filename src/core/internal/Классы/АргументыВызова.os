// Аргументы вызова метода или конструктора тестового набора.
// При создании задаются метаданные метода, позиционные значения и индексы
// заполняемых параметров. Их значения задаются методом Установить.
// Чтение заполняемого параметра до установки значения вызывает исключение.

#Использовать collectionos

Перем Метод;       // СтрокаТаблицыЗначений - Метаданные вызываемого метода
Перем Позиционные; // ФиксированныйСписок из Произвольный - Позиционные значения вызова
Перем Заполняемые; // ФиксированныйСписок из Число - Индексы заполняемых параметров

// КартаСоответствие из КлючИЗначение - Позиции параметров с позиционными значениями:
//  * Ключ     - Число - Индекс параметра в сигнатуре
//  * Значение - Число - Индекс в позиционных значениях
Перем Позиции;

// КартаСоответствие из КлючИЗначение - Значения, заданные методом Установить:
//  * Ключ     - Число - Индекс параметра
//  * Значение - Произвольный - Значение параметра или приватный маркер Неопределено
Перем Значения;

Перем МаркерНеопределено; // Структура - Пустой объект, обозначающий Неопределено в карте значений

// Метаданные вызываемого метода
//
//  Возвращаемое значение:
//   СтрокаТаблицыЗначений - Метаданные метода
//
Функция Метод() Экспорт
	Возврат Метод;
КонецФункции

// Индексы параметров, значения которых задаются методом Установить
//
//  Возвращаемое значение:
//   ФиксированныйСписок из Число - Индексы параметров, начиная с нуля
//
Функция ИндексыЗаполняемыхПараметров() Экспорт
	Возврат Заполняемые;
КонецФункции

// Признак наличия заполняемых параметров
//
//  Возвращаемое значение:
//   Булево - Истина - есть параметры, доступные для заполнения
//
Функция ТребуютЗаполнения() Экспорт
	Возврат Не Заполняемые.Пусто();
КонецФункции

// Устанавливает значение заполняемого параметра.
// Вызывает исключение, если параметр недоступен для заполнения или значение уже установлено.
//
// Параметры:
//  Индекс   - Число - Индекс параметра в сигнатуре, начиная с нуля
//  Значение - Произвольный - Значение параметра
//
Процедура Установить(Знач Индекс, Значение) Экспорт

	Описание = ОписаниеПараметра(Индекс);

	Если Не Заполняемые.Содержит(Индекс) Тогда
		ВызватьИсключение СтрШаблон("Параметр %1 недоступен для заполнения", Описание);
	КонецЕсли;

	Хранимое = ?(Значение = Неопределено, МаркерНеопределено, Значение);

	Если Значения.ВставитьЕслиОтсутствует(Индекс, Хранимое).СодержитЗначение() Тогда
		ВызватьИсключение СтрШаблон("Значение параметра %1 уже получено", Описание);
	КонецЕсли;

КонецПроцедуры

// Возвращает значение параметра по индексу в сигнатуре.
// Для заполняемого параметра возвращает значение, заданное методом Установить;
// если оно не задано, вызывает исключение. Для остальных параметров использует
// позиционное значение, а при его отсутствии - значение по умолчанию или Неопределено.
//
// Параметры:
//  Индекс - Число - Индекс параметра в сигнатуре, начиная с нуля
//
//  Возвращаемое значение:
//   Произвольный - Значение параметра
//
Функция Значение(Знач Индекс) Экспорт

	Параметр = Метод.Параметры.Получить(Индекс);

	Если Не Заполняемые.Содержит(Индекс) Тогда

		Позиция = Позиции.Получить(Индекс).Получить();

		Если Позиция < Позиционные.Количество() Тогда
			Возврат Позиционные.Получить(Позиция);
		КонецЕсли;

		Возврат ?(Параметр.ЕстьЗначениеПоУмолчанию, Параметр.ЗначениеПоУмолчанию, Неопределено);

	КонецЕсли;

	Полученное = Значения.Получить(Индекс);

	Если Не Полученное.СодержитЗначение() Тогда
		ВызватьИсключение СтрШаблон("Значение параметра %1 не установлено", ОписаниеПараметра(Индекс));
	КонецЕсли;

	Хранимое = Полученное.Получить();
	Возврат ?(Хранимое = МаркерНеопределено, Неопределено, Хранимое);

КонецФункции

// Возвращает список аргументов для вызова метода.
// При наличии заполняемых параметров собирает значения в порядке параметров метода
// с помощью метода Значение и добавляет лишние позиционные аргументы в конец списка.
// Если заполняемых параметров нет, возвращает исходный список позиционных значений.
//
//  Возвращаемое значение:
//   ФиксированныйСписок из Произвольный - Значения параметров метода
//
Функция Значения() Экспорт

	Если Не ТребуютЗаполнения() Тогда
		Возврат Позиционные;
	КонецЕсли;

	Результат = Новый СписокМассив;

	Для Индекс = 0 По Метод.Параметры.Количество() - 1 Цикл
		Результат.Добавить(Значение(Индекс));
	КонецЦикла;

	// Сохраняем лишние аргументы для проверки их количества при вызове метода
	Позиционные.ПроцессорКоллекции()
		.Пропустить(Позиции.Количество())
		.ДляКаждого(Новый Действие(Результат, "Добавить"));

	Возврат Новый ФиксированныйСписок(Результат);

КонецФункции

Функция ОписаниеПараметра(Знач Индекс)

	Возврат СтрШаблон(
		"%1 метода %2",
		Метод.Параметры.Получить(Индекс).Имя,
		Метод.Имя
	);

КонецФункции

// Создает аргументы вызова с указанными позиционными значениями
//
// Параметры:
//  ОписаниеМетода       - СтрокаТаблицыЗначений - Метаданные вызываемого метода
//  ПозиционныеПараметры - ФиксированныйСписок из Произвольный - Позиционные значения
//  ЗаполняемыеПараметры - ФиксированныйСписок из Число - Индексы параметров, доступных для заполнения
//
Процедура ПриСозданииОбъекта(ОписаниеМетода, ПозиционныеПараметры, ЗаполняемыеПараметры)

	Метод       = ОписаниеМетода;
	Позиционные = ПозиционныеПараметры;
	Заполняемые = ЗаполняемыеПараметры;
	Позиции     = Новый КартаСоответствие;
	Значения    = Новый КартаСоответствие;

	МаркерНеопределено = Новый Структура;

	Для Индекс = 0 По Метод.Параметры.Количество() - 1 Цикл
		Если Не Заполняемые.Содержит(Индекс) Тогда
			Позиции.Вставить(Индекс, Позиции.Количество());
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
