// Транслирует события исполнения изолированного прогона родителю по ходу
// исполнения, а не после него. Сообщения описаны в КаналСобытийИзоляции.СообщениеЗаписи:
// канал переводит их в строки вывода процесса и обратно, поэтому общее описание - там.
//
// Родитель строит зеркала по составу до первого теста и находит их по тем же путям.
// Желудь создается родителем с приемником, как рогатка создает репортеры: без него
// транслятора в поделке нет. Приемник изолированной поделки - сам ретранслятор
// родителя, дочернего процесса - канал, который переводит сообщения в строки вывода.

#Использовать collectionos

Перем _Приемник;           // Произвольный - Приемник сообщений, реализует Принять(Сообщение)
Перем _ПереносРезультатов; // ПереносРезультатов - Перенос результатов из изолированной среды
Перем _РепортерПланJSON;   // РепортерПланJSON - Состав плана
Перем _ВремяНачала;        // КартаСоответствие из КлючИЗначение - Время начала узлов:
                           //  * Ключ     - ОпределениеТестНабора, ОпределениеТеста - Узел плана
                           //  * Значение - Число - Время начала в миллисекундах
Перем _НомерСообщения;     // Число - Номер последнего отправленного сообщения

&ПодпискаНаСобытие("ИсполнениеТестПланНачало")
Процедура ИсполнениеТестПланНачало(ТестПлан) Экспорт

	Отправить(Новый Структура(
		"Событие, Состав",
		СобытияИзоляции.Состав,
		_РепортерПланJSON.СоставПлана(ТестПлан)
	));

КонецПроцедуры

&ПодпискаНаСобытие("ИсполнениеТестНаборНачало")
Процедура ИсполнениеТестНаборНачало(ТестНабор) Экспорт
	_ВремяНачала.Вставить(ТестНабор, ТекущаяУниверсальнаяДатаВМиллисекундах());
КонецПроцедуры

&ПодпискаНаСобытие("ИсполнениеТестНаборКонец")
Процедура ИсполнениеТестНаборКонец(ТестНабор, Результат) Экспорт

	Отправить(Новый Структура(
		"Событие, Путь, Результат",
		СобытияИзоляции.КонецНабора,
		Путь(ТестНабор),
		ПереносимыйРезультат(ТестНабор, Результат)
	));

КонецПроцедуры

&ПодпискаНаСобытие("ИсполнениеТестНачало")
Процедура ИсполнениеТестНачало(Тест) Экспорт

	_ВремяНачала.Вставить(Тест, ТекущаяУниверсальнаяДатаВМиллисекундах());

	Отправить(Новый Структура(
		"Событие, Путь",
		СобытияИзоляции.НачалоТеста,
		Путь(Тест)
	));

КонецПроцедуры

&ПодпискаНаСобытие("ИсполнениеТестКонец")
Процедура ИсполнениеТестКонец(Тест, Результат) Экспорт

	Отправить(Новый Структура(
		"Событие, Путь, Результат",
		СобытияИзоляции.КонецТеста,
		Путь(Тест),
		ПереносимыйРезультат(Тест, Результат)
	));

КонецПроцедуры

Процедура Отправить(Сообщение)

	_НомерСообщения = _НомерСообщения + 1;
	Сообщение.Вставить("Номер", _НомерСообщения);

	_Приемник.Принять(Сообщение);

КонецПроцедуры

Функция ПереносимыйРезультат(Узел, Результат)

	// Замер свой, а не статистики: порядок подписчиков одного события не задан,
	// и статистика могла еще не обработать конец узла
	Длительность = _ВремяНачала.Удалить(Узел)
		.Обработать("ВремяНачала -> ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала");

	Возврат _ПереносРезультатов.ПереносимыйРезультат(Результат, Длительность);

КонецФункции

Функция Путь(Знач Узел)

	Путь = Новый СписокМассив;

	Пока ТипЗнч(Узел) <> Тип("ТестПлан") Цикл
		Путь.Вставить(0, Узел.Родитель().Дети().Индекс(Узел));
		Узел = Узел.Родитель();
	КонецЦикла;

	Возврат Путь;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Блестяшка Приемник,
	&Пластилин ПереносРезультатов,
	&Пластилин РепортерПланJSON)

	_Приемник           = Приемник;
	_ПереносРезультатов = ПереносРезультатов;
	_РепортерПланJSON   = РепортерПланJSON;
	_ВремяНачала        = Новый КартаСоответствие();
	_НомерСообщения     = 0;

КонецПроцедуры
