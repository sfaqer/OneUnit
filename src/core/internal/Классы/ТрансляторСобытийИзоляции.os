// Транслирует события исполнения изолированного прогона родителю по ходу
// исполнения, а не после него. Сообщения - структуры:
//  * event - Строка - Вид сообщения:
//     "plan"      - состав плана на старте исполнения, поле suites - записи наборов,
//                   см. РепортерПланJSON.ЗаписиНаборов;
//     "testStart" - начало теста или контейнера, поле path;
//     "testEnd"   - конец теста или контейнера, поля path и result;
//     "suiteEnd"  - конец набора, поля path и result.
//  * seq    - Число - Номер сообщения, сквозной с 1: по разрыву нумерации родитель
//             узнает о потерянном сообщении, а не принимает набор без него за целый
//  * path   - Массив из Число - Путь узла индексами от плана: набор, тест, итерация
//  * result - Структура - Запись результата с полем duration_ms, см. ПереносРезультатов
//
// Родитель строит зеркала по составу до первого теста и находит их по тем же путям.
// Желудь создается родителем с приемником, как рогатка создает репортеры: без него
// транслятора в поделке нет.

Перем _Приемник;           // Произвольный - Приемник сообщений, реализует Принять(Сообщение)
Перем _ПереносРезультатов; // ПереносРезультатов - Перевод результатов в записи
Перем _РепортерПланJSON;   // РепортерПланJSON - Записи состава плана
Перем _ВремяНачала;        // Соответствие из КлючИЗначение - Время начала узлов:
                           //  * Ключ     - ОпределениеТестНабора, ОпределениеТеста - Узел плана
                           //  * Значение - Число - Время начала в миллисекундах
Перем _НомерСообщения;     // Число - Номер последнего отправленного сообщения

&ПодпискаНаСобытие("ИсполнениеТестПланНачало")
Процедура ИсполнениеТестПланНачало(ТестПлан) Экспорт

	Отправить(Новый Структура(
		"event, suites",
		"plan",
		_РепортерПланJSON.ЗаписиНаборов(ТестПлан)
	));

КонецПроцедуры

&ПодпискаНаСобытие("ИсполнениеТестНаборНачало")
Процедура ИсполнениеТестНаборНачало(ТестНабор) Экспорт
	_ВремяНачала.Вставить(ТестНабор, ТекущаяУниверсальнаяДатаВМиллисекундах());
КонецПроцедуры

&ПодпискаНаСобытие("ИсполнениеТестНаборКонец")
Процедура ИсполнениеТестНаборКонец(ТестНабор, Результат) Экспорт

	Отправить(Новый Структура(
		"event, path, result",
		"suiteEnd",
		Путь(ТестНабор),
		ЗаписьРезультата(ТестНабор, Результат)
	));

КонецПроцедуры

&ПодпискаНаСобытие("ИсполнениеТестНачало")
Процедура ИсполнениеТестНачало(Тест) Экспорт

	_ВремяНачала.Вставить(Тест, ТекущаяУниверсальнаяДатаВМиллисекундах());

	Отправить(Новый Структура(
		"event, path",
		"testStart",
		Путь(Тест)
	));

КонецПроцедуры

&ПодпискаНаСобытие("ИсполнениеТестКонец")
Процедура ИсполнениеТестКонец(Тест, Результат) Экспорт

	Отправить(Новый Структура(
		"event, path, result",
		"testEnd",
		Путь(Тест),
		ЗаписьРезультата(Тест, Результат)
	));

КонецПроцедуры

Процедура Отправить(Сообщение)

	_НомерСообщения = _НомерСообщения + 1;
	Сообщение.Вставить("seq", _НомерСообщения);

	_Приемник.Принять(Сообщение);

КонецПроцедуры

Функция ЗаписьРезультата(Узел, Результат)

	Запись = _ПереносРезультатов.ЗаписьРезультата(Результат);

	// Замер свой, а не статистики: порядок подписчиков одного события не задан,
	// и статистика могла еще не обработать конец узла
	ВремяНачала = _ВремяНачала.Получить(Узел);

	Если ВремяНачала <> Неопределено Тогда
		Запись.Вставить("duration_ms", ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала);
		_ВремяНачала.Удалить(Узел);
	КонецЕсли;

	Возврат Запись;

КонецФункции

Функция Путь(Знач Узел)

	Путь = Новый Массив;

	Пока ТипЗнч(Узел) <> Тип("ТестПлан") Цикл
		Путь.Вставить(0, Узел.Родитель().Дети().Индекс(Узел));
		Узел = Узел.Родитель();
	КонецЦикла;

	Возврат Путь;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Блестяшка Приемник,
	&Пластилин ПереносРезультатов,
	&Пластилин РепортерПланJSON)

	_Приемник           = Приемник;
	_ПереносРезультатов = ПереносРезультатов;
	_РепортерПланJSON   = РепортерПланJSON;
	_ВремяНачала        = Новый Соответствие;
	_НомерСообщения     = 0;

КонецПроцедуры
