#Использовать collectionos
#Использовать "../../../shared"

Перем _ПутьКОтчету;

Перем _РепортерСтатистика;

// КартаСоответствие из КлючИЗначение - Счётчики записей JUnit:
//  * Ключ - ТестПлан, ОпределениеТестНабора, ОпределениеТеста - Узел плана
//  * Значение - см. ПодсчитатьСлучаи - Счётчики поддерева
Перем СчетчикиУзлов;

&ПодпискаНаСобытие("ИсполнениеТестПланКонец")
Процедура ИсполнениеТестПланКонец(ТестПлан) Экспорт

	Если Не ЗначениеЗаполнено(_ПутьКОтчету) Тогда
		Возврат;
	КонецЕсли;

	ВывестиТестПлан(ТестПлан);

КонецПроцедуры

Процедура ВывестиТестПлан(ТестПлан)

	СтатистикаТестПлана =  _РепортерСтатистика.СтатистикаТестПлана();
	СчетчикиУзлов = Новый КартаСоответствие;
	Счетчики = ПодсчитатьСлучаи(ТестПлан);

	ЗаписьXML = Новый ЗаписьXML();
	ЗаписьXML.ОткрытьФайл(_ПутьКОтчету, "UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();

	ЗаписьXML.ЗаписатьНачалоЭлемента("testsuites");

	ЗаписьXML.ЗаписатьАтрибут("name",       "Test run");

	ВывестиСчетчики(ЗаписьXML, Счетчики);
	ЗаписьXML.ЗаписатьАтрибут("assertions", 0);
	ЗаписьXML.ЗаписатьАтрибут("time", СтатистикаТестПлана.ПолучитьИлиУмолчание("ВремяВыполнения", 0) / 1000);

	ЗаписьXML.ЗаписатьАтрибут(
		"timestamp",
		XMLСтрока(СтатистикаТестПлана.ПолучитьИлиУмолчание("ДатаЗавершения", '00010101'))
	);

	ЗаписьXML.ЗаписатьНачалоЭлемента("properties");

	СистемнаяИнформация = Новый СистемнаяИнформация();

	Рефлектор = Новый Рефлектор();
	Свойства = Рефлектор.ПолучитьТаблицуСвойств(СистемнаяИнформация);

	Для каждого Свойство Из Свойства Цикл

		Значение = СистемнаяИнформация[Свойство.Имя];

		Если ТипЗнч(Значение) = Тип("ФиксированныйМассив") Тогда
			Значение = СтрСоединить(Новый Массив(Значение), ",");
		КонецЕсли;

		ЗаписьXML.ЗаписатьНачалоЭлемента("property");
		ЗаписьXML.ЗаписатьАтрибут("name",  Свойство.Имя);
		ЗаписьXML.ЗаписатьАтрибут("value", Значение);

		ЗаписьXML.ЗаписатьКонецЭлемента();

	КонецЦикла;

	ЗаписьXML.ЗаписатьКонецЭлемента();

	Для каждого Набор Из ТестПлан.Дети() Цикл
		ВывестиТестНабор(ЗаписьXML, Набор);
	КонецЦикла;

	ЗаписьXML.ЗаписатьКонецЭлемента();

	ЗаписьXML.Закрыть();

КонецПроцедуры

Процедура ВывестиТестНабор(ЗаписьXML, ТестНабор) Экспорт

	Если ТипЗнч(ТестНабор) = Тип("ОпределениеТестНабора") Тогда
		Статистика = _РепортерСтатистика.СтатистикаНабора(ТестНабор);
	Иначе
		Статистика = _РепортерСтатистика.СтатистикаТеста(ТестНабор);
	КонецЕсли;

	ЗаписьXML.ЗаписатьНачалоЭлемента("testsuite");

	ЗаписьXML.ЗаписатьАтрибут("name", ТестНабор.Имя());
	ВывестиСчетчики(ЗаписьXML, СчетчикиУзлов.Получить(ТестНабор).Получить());
	ЗаписьXML.ЗаписатьАтрибут("assertions", 0);
	ЗаписьXML.ЗаписатьАтрибут("time", Статистика.ПолучитьИлиУмолчание("ВремяВыполнения", 0) / 1000);

	ЗаписьXML.ЗаписатьАтрибут(
		"timestamp",
		XMLСтрока(Статистика.ПолучитьИлиУмолчание("ДатаЗавершения", '00010101'))
	);

	ЗаписьXML.ЗаписатьАтрибут("file", ТестНабор.Путь().Иначе_(""));

	Результат = _РепортерСтатистика.Результат(ТестНабор);

	Вывод = Результат.Вывод();
	Причины = "";
	ПричинаПропуска = "";

	Если ЭтоОшибка(Результат) Тогда

		Причины = Результат.Причины()
			.ПроцессорКоллекции()
			.Обработать("Причина -> ТестированиеСлужебный.ПодробноеОписаниеОшибки(""Причина"", Причина)")
			.ВСтроку(Символы.ПС);

	КонецЕсли;

	Если ЭтоПропуск(Результат) Тогда
		ПричинаПропуска = СтрСоединить(Результат.Причины().ВМассив(), Символы.ПС);
	КонецЕсли;

	ЗаписьXML.ЗаписатьНачалоЭлемента("properties");

	ЗаписьXML.ЗаписатьНачалоЭлемента("property");
	ЗаписьXML.ЗаписатьАтрибут("name", "tags");
	ЗаписьXML.ЗаписатьАтрибут("value", СтрСоединить(ТестНабор.Теги().ВМассив(), ","));
	ЗаписьXML.ЗаписатьКонецЭлемента();

	Если Не ПустаяСтрока(ПричинаПропуска) Тогда

		ЗаписьXML.ЗаписатьНачалоЭлемента("property");
		ЗаписьXML.ЗаписатьАтрибут("name", "skippedReason");
		ЗаписьXML.ЗаписатьАтрибут("value", ПричинаПропуска);
		ЗаписьXML.ЗаписатьКонецЭлемента();

	КонецЕсли;

	ЗаписьXML.ЗаписатьКонецЭлемента();

	ЗаписьXML.ЗаписатьНачалоЭлемента("system-out");

	Если Не ПустаяСтрока(Вывод) Тогда

		ЗаписьXML.ЗаписатьТекст(Символы.ПС);
		ЗаписьXML.ЗаписатьСекциюCDATA(Вывод);
		ЗаписьXML.ЗаписатьТекст(Символы.ПС);

	КонецЕсли;

	ЗаписьXML.ЗаписатьКонецЭлемента();

	ЗаписьXML.ЗаписатьНачалоЭлемента("system-err");

	Если Не ПустаяСтрока(Причины) Тогда

		ЗаписьXML.ЗаписатьТекст(Символы.ПС);
		ЗаписьXML.ЗаписатьСекциюCDATA(Причины);
		ЗаписьXML.ЗаписатьТекст(Символы.ПС);

	КонецЕсли;

	ЗаписьXML.ЗаписатьКонецЭлемента();

	Если ЭтоОшибка(Результат) Тогда
		ВывестиОшибкуУзла(ЗаписьXML, ТестНабор, Результат);
	КонецЕсли;

	ВывестиДетейНабора(ЗаписьXML, ТестНабор);

	ЗаписьXML.ЗаписатьКонецЭлемента();

КонецПроцедуры

// Выводит результаты дочерних тестов и контейнеров.
//
// Параметры:
//  ЗаписьXML - ЗаписьXML - Запись JUnit-отчёта
//  ТестНабор - ОпределениеТестНабора, ОпределениеТеста - Набор или контейнер с дочерними узлами
//
Процедура ВывестиДетейНабора(ЗаписьXML, ТестНабор)

	Для Каждого Тест Из ТестНабор.Дети() Цикл

		Если _РепортерСтатистика.НайтиРезультат(Тест).Пустой() Тогда
			Продолжить;
		КонецЕсли;

		Если Тест.ТипОпределения() = ТипыОпределенийТестов.Контейнер Тогда
			ВывестиТестНабор(ЗаписьXML, Тест);
		Иначе
			ВывестиТест(ЗаписьXML, Тест);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ВывестиТест(ЗаписьXML, Тест) Экспорт

	СтатистикаТеста  = _РепортерСтатистика.СтатистикаТеста(Тест);

	ЗаписьXML.ЗаписатьНачалоЭлемента("testcase");
	ЗаписьXML.ЗаписатьАтрибут("name", Тест.Имя());

	Родитель = Тест.Родитель();

	Пока ТипЗнч(Родитель) <> Тип("ОпределениеТестНабора") Цикл
		Родитель = Родитель.Родитель();
	КонецЦикла;

	ЗаписьXML.ЗаписатьАтрибут("classname", Родитель.Имя());
	ЗаписьXML.ЗаписатьАтрибут("assertions", 0);
	ЗаписьXML.ЗаписатьАтрибут("time", СтатистикаТеста.ПолучитьИлиУмолчание("ВремяВыполнения", 0) / 1000);

	ЗаписьXML.ЗаписатьАтрибут("file", Тест.Путь().Иначе_(""));
	ЗаписьXML.ЗаписатьАтрибут("line", 0);

	Результат = _РепортерСтатистика.Результат(Тест);

	Вывод = Результат.Вывод();

	ВывестиСостояние(ЗаписьXML, Результат);
	ВывестиСвойстваТеста(ЗаписьXML, Тест);
	ВывестиВыводТеста(ЗаписьXML, Вывод);
	ЗаписьXML.ЗаписатьКонецЭлемента();

КонецПроцедуры

Процедура ВывестиОшибкуУзла(ЗаписьXML, Узел, Результат)

	ЗаписьXML.ЗаписатьНачалоЭлемента("testcase");

	ЗаписьXML.ЗаписатьАтрибут("name", Узел.Имя() + ".containerError");
	ЗаписьXML.ЗаписатьАтрибут("classname", Узел.Набор().Имя());

	ЗаписьXML.ЗаписатьАтрибут("assertions", 0);
	ЗаписьXML.ЗаписатьАтрибут("time", 0);
	ЗаписьXML.ЗаписатьАтрибут("file", Узел.Путь().Иначе_(""));
	ЗаписьXML.ЗаписатьАтрибут("line", 0);

	ВывестиСостояние(ЗаписьXML, Результат);
	ВывестиСвойстваТеста(ЗаписьXML, Узел);
	ВывестиВыводТеста(ЗаписьXML, Результат.Вывод());

	ЗаписьXML.ЗаписатьКонецЭлемента();

КонецПроцедуры

Процедура ВывестиСостояние(ЗаписьXML, Результат)

	Если ЭтоОшибка(Результат) Тогда

		Если Результат.Состояние() = СостоянияВыполненияТестов.Ошибка Тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента("failure");
		Иначе
			ЗаписьXML.ЗаписатьНачалоЭлемента("error");
		КонецЕсли;

		ЗаписьXML.ЗаписатьАтрибут("message", Результат.ОписанияПричин().ПроцессорКоллекции().ВСтроку(Символы.ПС));
		ЗаписьXML.ЗаписатьАтрибут("type", "");

		ЗаписьXML.ЗаписатьТекст(Символы.ПС);

		Причины = Результат.Причины()
			.ПроцессорКоллекции()
			.Обработать("Причина -> ТестированиеСлужебный.ПодробноеОписаниеОшибки(""Причина"", Причина)")
			.ВСтроку(Символы.ПС);

		ЗаписьXML.ЗаписатьСекциюCDATA(Причины);
		ЗаписьXML.ЗаписатьТекст(Символы.ПС);

		ЗаписьXML.ЗаписатьКонецЭлемента();

	КонецЕсли;

	Если ЭтоПропуск(Результат) Тогда

		ЗаписьXML.ЗаписатьНачалоЭлемента("skipped");
		ЗаписьXML.ЗаписатьАтрибут("message", СтрСоединить(Результат.Причины().ВМассив(), Символы.ПС));
		ЗаписьXML.ЗаписатьКонецЭлемента();

	КонецЕсли;

КонецПроцедуры

Процедура ВывестиСвойстваТеста(ЗаписьXML, Тест)

	ЗаписьXML.ЗаписатьНачалоЭлемента("properties");

	ЗаписьXML.ЗаписатьНачалоЭлемента("property");
	ЗаписьXML.ЗаписатьАтрибут("name", "tags");
	ЗаписьXML.ЗаписатьАтрибут("value", СтрСоединить(Тест.Теги().ВМассив(), ","));
	ЗаписьXML.ЗаписатьКонецЭлемента();

	ЗаписьXML.ЗаписатьКонецЭлемента();

КонецПроцедуры

Процедура ВывестиВыводТеста(ЗаписьXML, Вывод)

	ЗаписьXML.ЗаписатьНачалоЭлемента("system-out");

	Если Не ПустаяСтрока(Вывод) Тогда

		ЗаписьXML.ЗаписатьТекст(Символы.ПС);
		ЗаписьXML.ЗаписатьСекциюCDATA(Вывод);
		ЗаписьXML.ЗаписатьТекст(Символы.ПС);

	КонецЕсли;

	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.ЗаписатьНачалоЭлемента("system-err");
	ЗаписьXML.ЗаписатьКонецЭлемента();

КонецПроцедуры

Функция ЭтоОшибка(Результат)

	Возврат Результат.Состояние() = СостоянияВыполненияТестов.Ошибка
		Или Результат.Состояние() = СостоянияВыполненияТестов.Сломан;

КонецФункции

Функция ЭтоПропуск(Результат)

	Возврат Результат.Состояние() = СостоянияВыполненияТестов.Пропущен
		Или Результат.Состояние() = СостоянияВыполненияТестов.Прерван;

КонецФункции

// Считает именно записи testcase, включая собственные ошибки нелистовых узлов.
//
// Параметры:
//  Узел - ТестПлан, ОпределениеТестНабора, ОпределениеТеста - Корень обрабатываемого поддерева
//
// Возвращаемое значение:
//  Структура - Счётчики поддерева:
//   * Тесты - Число - Количество записей testcase
//   * Пропуски - Число - Количество записей skipped
//   * Падения - Число - Количество записей failure
//   * Ошибки - Число - Количество записей error
//
Функция ПодсчитатьСлучаи(Узел)

	Счетчики = Новый Структура;
	Счетчики.Вставить("Тесты", 0);
	Счетчики.Вставить("Пропуски", 0);
	Счетчики.Вставить("Падения", 0);
	Счетчики.Вставить("Ошибки", 0);

	Для Каждого Дитя Из Узел.Дети() Цикл

		Дочерние = ПодсчитатьСлучаи(Дитя);
		Счетчики.Тесты = Счетчики.Тесты + Дочерние.Тесты;
		Счетчики.Пропуски = Счетчики.Пропуски + Дочерние.Пропуски;
		Счетчики.Падения = Счетчики.Падения + Дочерние.Падения;
		Счетчики.Ошибки = Счетчики.Ошибки + Дочерние.Ошибки;

	КонецЦикла;

	РезультатУзла = _РепортерСтатистика.НайтиРезультат(Узел);

	Если РезультатУзла.СодержитЗначение() Тогда

		Результат = РезультатУзла.Получить();
		ЭтоТест = ТипЗнч(Узел) = Тип("ОпределениеТеста")
			И Узел.ТипОпределения() = ТипыОпределенийТестов.Тест;

		Если ЭтоТест Или ЭтоОшибка(Результат) Тогда
			УчестьРезультат(Счетчики, Результат);
		КонецЕсли;

	КонецЕсли;

	СчетчикиУзлов.Вставить(Узел, Счетчики);
	Возврат Счетчики;

КонецФункции

Процедура УчестьРезультат(Счетчики, Результат)

	Счетчики.Тесты = Счетчики.Тесты + 1;

	Если Результат.Состояние() = СостоянияВыполненияТестов.Ошибка Тогда
		Счетчики.Падения = Счетчики.Падения + 1;
	КонецЕсли;

	Если Результат.Состояние() = СостоянияВыполненияТестов.Сломан Тогда
		Счетчики.Ошибки = Счетчики.Ошибки + 1;
	КонецЕсли;

	Если ЭтоПропуск(Результат) Тогда
		Счетчики.Пропуски = Счетчики.Пропуски + 1;
	КонецЕсли;

КонецПроцедуры

Процедура ВывестиСчетчики(ЗаписьXML, Счетчики)

	ЗаписьXML.ЗаписатьАтрибут("tests", Счетчики.Тесты);
	ЗаписьXML.ЗаписатьАтрибут("skipped", Счетчики.Пропуски);
	ЗаписьXML.ЗаписатьАтрибут("failures", Счетчики.Падения);
	ЗаписьXML.ЗаписатьАтрибут("errors", Счетчики.Ошибки);

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(&Блестяшка ПутьКОтчетуJUnit, &Пластилин РепортерСтатистика)
	_ПутьКОтчету        = ПутьКОтчетуJUnit;
	_РепортерСтатистика = РепортерСтатистика;
КонецПроцедуры
