// Описание поля тестового набора.
// Передается поставщику значения первым аргументом функции Значение.

#Использовать annotations

Перем Данные;    // СтрокаТаблицыЗначений - Данные поля с развернутыми аннотациями
Перем Поставщик; // Строка - Имя желудя-поставщика

// Имя поля
//
//  Возвращаемое значение:
//   Строка - Имя поля
//
Функция Имя() Экспорт
	Возврат Данные.Имя;
КонецФункции

// Метаданные поля с развернутыми аннотациями
//
//  Возвращаемое значение:
//   СтрокаТаблицыЗначений - Данные поля: Имя, Аннотации (развернутые)
//
Функция Данные() Экспорт
	Возврат Данные;
КонецФункции

// Первая аннотация поля с указанным именем
//
// Параметры:
//  ИмяАннотации - Строка - Имя аннотации
//
//  Возвращаемое значение:
//   Опциональный - Аннотация (СтрокаТаблицыЗначений), пустой - аннотации нет
//
Функция Аннотация(Знач ИмяАннотации) Экспорт
	Возврат Новый Опциональный(РаботаСАннотациями.ПолучитьАннотацию(Данные, ИмяАннотации), Истина);
КонецФункции

// Имя желудя-поставщика значения поля
//
//  Возвращаемое значение:
//   Строка - Имя поставщика
//
Функция Поставщик() Экспорт
	Возврат Поставщик;
КонецФункции

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Блестяшка ОписаниеПоля, &Блестяшка ИмяПоставщика)
	Данные    = ОписаниеПоля;
	Поставщик = ИмяПоставщика;
КонецПроцедуры
