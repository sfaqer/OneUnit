// Переводит результаты выполнения тестов в записи и обратно. Записями результаты
// уходят в JSON-отчет прогона и переезжают из изолированной среды в родительский
// прогон, поэтому формат у отчета и у трансляции событий один. Имена полей
// записей - формат обмена, прикладной код работает с результатами.

#Использовать collectionos
#Использовать "../../../shared"

Перем _ТабакеркаРезультатов; // Табакерка - Результаты выполнения тестов

// Возвращает запись результата выполнения
//
// Параметры:
//  Результат - РезультатВыполненияТеста - Результат теста или набора
//
//  Возвращаемое значение:
//   Структура - Запись результата:
//    * status      - Строка - Статус: "passed", "failed", "broken", "skipped" или "aborted"
//    * message     - Строка - Краткие причины, отсутствует у успешных
//    * details     - Строка - Подробные причины со стеками, только у упавших и сломанных
//    * output      - Строка - Захваченный вывод, отсутствует при пустом выводе
//    * duration_ms - Число - Перенесенное время выполнения в миллисекундах,
//                    только у результата, время которого перенесено
//
Функция ЗаписьРезультата(Результат) Экспорт

	Запись = Новый Структура();

	Запись.Вставить("status", СтатусСостояния(Результат.Состояние()));

	Если Результат.Состояние() = СостоянияВыполненияТестов.Ошибка
		Или Результат.Состояние() = СостоянияВыполненияТестов.Сломан Тогда

		// Подробности со стеками есть только у проблем -
		// причины пропусков и прерываний описываются строками
		Запись.Вставить("message", ОписанияПричин(Результат));
		Запись.Вставить("details", ПодробныеПричины(Результат));

	ИначеЕсли Результат.Состояние() <> СостоянияВыполненияТестов.Успех Тогда
		Запись.Вставить("message", ОписанияПричин(Результат));
	КонецЕсли; // BSLLS:IfElseIfEndsWithElse-off

	Если Не ПустаяСтрока(Результат.Вывод()) Тогда
		Запись.Вставить("output", Результат.Вывод());
	КонецЕсли;

	Перенесенное = Результат.ПеренесенноеВремяВыполнения();

	Если Перенесенное.СодержитЗначение() Тогда
		Запись.Вставить("duration_ms", Перенесенное.Получить());
	КонецЕсли;

	Возврат Запись;

КонецФункции

// Восстанавливает результат выполнения по записи. Время выполнения из записи
// переносится в результат: запись приходит из среды, где тест выполнялся
//
// Параметры:
//  Запись - см. ЗаписьРезультата
//         - Структура - Запись пропуска JSON-отчета:
//            * status - Строка - Статус: "skipped" или "aborted"
//            * reason - Строка - Причины пропуска
//
//  Возвращаемое значение:
//   РезультатВыполненияТеста - Восстановленный результат
//
Функция РезультатЗаписи(Запись) Экспорт

	Состояние = СостояниеПоСтатусу(Запись.status);

	Причины = Новый СписокМассив;

	Если Состояние = СостоянияВыполненияТестов.Ошибка
		Или Состояние = СостоянияВыполненияТестов.Сломан Тогда

		Причины.Добавить(ПричинаЗаписи(Запись));

	ИначеЕсли Состояние = СостоянияВыполненияТестов.Пропущен
		Или Состояние = СостоянияВыполненияТестов.Прерван Тогда

		// Причина пропуска у записи результата - в поле message, у записи
		// пропуска JSON-отчета - в поле reason
		Причина = ЗначениеСвойства(Запись, "reason", "");
		Причины.Добавить(ЗначениеСвойства(Запись, "message", Причина));

	КонецЕсли; // BSLLS:IfElseIfEndsWithElse-off

	Результат = НовыйРезультат(Состояние, Причины, ЗначениеСвойства(Запись, "output", ""));

	Если Запись.Свойство("duration_ms") Тогда
		Результат.ПеренестиВремяВыполнения(Запись.duration_ms);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает копию результата, которая уходит из изолированной среды вместе
// со временем выполнения, измеренным там. Сам результат не меняется: его еще
// обрабатывают подписчики изолированной среды
//
// Параметры:
//  Результат - РезультатВыполненияТеста - Результат теста или набора
//  Миллисекунды - Опциональный - Время выполнения в миллисекундах, пустой - время не измерено
//
//  Возвращаемое значение:
//   РезультатВыполненияТеста - Копия результата с перенесенным временем
//
Функция ПереносимыйРезультат(Результат, Миллисекунды) Экспорт

	Копия = НовыйРезультат(Результат.Состояние(), Результат.Причины(), Результат.Вывод());

	Миллисекунды.ЕслиСодержитЗначение(Новый Действие(Копия, "ПеренестиВремяВыполнения"));

	Возврат Копия;

КонецФункции

// Восстанавливает результаты прогона по его JSON-отчету
//
// Параметры:
//  Отчет - см. ЗапускательТестирования.ПрочитатьОтчет
//
//  Возвращаемое значение:
//   Структура - Результаты прогона:
//    * Наборы - КартаСоответствие из КлючИЗначение - Результаты наборов, не дошедших
//               до своих тестов: сломанных, упавших в ПередВсеми, пропущенных целиком:
//       ** Ключ     - Строка - Имя набора
//       ** Значение - РезультатВыполненияТеста - Результат набора
//    * Тесты - СписокМассив из Структура - Результаты тестов в порядке плана:
//       ** Набор     - Строка - Имя набора
//       ** Тест      - Строка - Имя теста
//       ** Результат - РезультатВыполненияТеста - Результат со временем, измеренным в прогоне
//
Функция РезультатыОтчета(Отчет) Экспорт

	Наборы = Новый КартаСоответствие();

	// Проблема или пропуск уровня набора - запись без имени теста
	ПроцессорыКоллекций.ИзНабора(Отчет.problems, Отчет.skipped_tests)
		.Развернуть("Записи -> ПроцессорыКоллекций.ИзКоллекции(Записи)")
		.Фильтровать("Запись -> Не Запись.Свойство(""test"")")
		.ДляКаждого(
			"Запись -> Наборы.ВставитьЕслиОтсутствует(Запись.suite, Перенос.РезультатЗаписи(Запись))",
			Новый Структура("Наборы, Перенос", Наборы, ЭтотОбъект)
		);

	Тесты = ПроцессорыКоллекций.ИзКоллекции(Отчет.tests)
		.Обработать(
			"Запись -> Новый Структура(""Набор, Тест, Результат"", Запись.suite, Запись.test, РезультатЗаписи(Запись))",
			ЭтотОбъект
		)
		.Получить("СписокМассив");

	Возврат Новый Структура("Наборы, Тесты", Наборы, Тесты);

КонецФункции

// Возвращает запись причины для передачи из изолированной среды, обратное
// преобразование - ПричинаЗаписи
//
// Параметры:
//  Причина - ИнформацияОбОшибке - Причина
//
//  Возвращаемое значение:
//   Структура - Запись причины:
//    * message - Строка - Краткое описание
//    * details - Строка - Подробное описание со стеком
//
Функция ЗаписьПричины(Причина) Экспорт

	Возврат Новый Структура(
		"message, details",
		ТестированиеСлужебный.КраткоеОписаниеОшибки(Причина),
		ТестированиеСлужебный.ПодробноеОписаниеОшибки("Причина", Причина)
	);

КонецФункции

// Заворачивает сообщение и подробности записи в ИнформациюОбОшибке:
// репортеры ожидают у причин проблем интерфейс информации об ошибке
//
// Параметры:
//  Запись - Структура - Запись с полями message и details
//
//  Возвращаемое значение:
//   ИнформацияОбОшибке - Причина с сообщением и подробностями записи
//
Функция ПричинаЗаписи(Запись) Экспорт

	Сообщение = ЗначениеСвойства(Запись, "message", "Дочерний прогон завершился с ошибкой");
	Описание  = ЗначениеСвойства(Запись, "details", "");

	Если Не ЗначениеЗаполнено(Описание) Тогда
		Описание = СтрШаблон(
			"
			|Причина:
			|%1
			|",
			Сообщение
		);
	КонецЕсли;

	Возврат ПричинаСГотовымОписанием(Сообщение, Описание);

КонецФункции

// Создает причину, подробное описание которой уже сформировано другой средой:
// ТестированиеСлужебный.ПодробноеОписаниеОшибки вернет его как есть, не подмешивая
// модуль, строку и стек этой обертки
//
// Параметры:
//  Сообщение - Строка - Краткое описание причины
//  ГотовоеОписание - Строка - Подробное описание, сформированное другой средой
//
//  Возвращаемое значение:
//   ИнформацияОбОшибке - Причина с готовым подробным описанием
//
Функция ПричинаСГотовымОписанием(Знач Сообщение, Знач ГотовоеОписание) Экспорт

	Попытка
		ВызватьИсключение Новый ИнформацияОбОшибке(
			Сообщение,
			Новый Структура("ПеренесенноеОписание", ГотовоеОписание)
		);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

КонецФункции

// Создает причину, подробное описание которой дополнено захваченным выводом
// изолированной среды - единственным свидетельством того, что там происходило
//
// Параметры:
//  Сообщение - Строка - Краткое описание причины
//  Вывод - Строка - Захваченный вывод изолированной среды
//
//  Возвращаемое значение:
//   ИнформацияОбОшибке - Причина с готовым подробным описанием
//
Функция ПричинаСВыводом(Знач Сообщение, Знач Вывод) Экспорт
	Возврат ПричинаСГотовымОписанием(Сообщение, ОписаниеСВыводом(Сообщение, Вывод));
КонецФункции

// Вызывает исключение - причину с выводом изолированной среды, см. ПричинаСВыводом.
// Для отказов, которые принимает обработчик исключения: готовую причину повторно
// не выбросить - она обернется еще одним звеном
//
// Параметры:
//  Сообщение - Строка - Краткое описание причины
//  Вывод - Строка - Захваченный вывод изолированной среды
//
Процедура ВызватьПричинуСВыводом(Знач Сообщение, Знач Вывод) Экспорт

	ВызватьИсключение Новый ИнформацияОбОшибке(
		Сообщение,
		Новый Структура("ПеренесенноеОписание", ОписаниеСВыводом(Сообщение, Вывод))
	);

КонецПроцедуры

Функция ОписаниеСВыводом(Знач Сообщение, Знач Вывод)

	Вывод = РазвернутьЗаписиЛога(Вывод);

	Если Не ЗначениеЗаполнено(СокрЛП(Вывод)) Тогда
		Вывод = "<дочерний прогон ничего не вывел>";
	КонецЕсли;

	Возврат СтрШаблон(
		"
		|Причина:
		|%1
		|
		|Вывод дочернего прогона:
		|%2
		|",
		Сообщение,
		Вывод
	);

КонецФункции

// Создает причину для теста, результата которого нет в изолированной среде:
// пояснение и вывод среды показывают, что там происходило
//
// Параметры:
//  Тест - ОпределениеТеста - Определение теста или итерации контейнера
//  Пояснение - Строка - Чего именно не хватает в результатах изолированной среды
//  Вывод - Строка - Захваченный вывод изолированной среды
//
//  Возвращаемое значение:
//   ИнформацияОбОшибке - Причина с готовым подробным описанием
//
Функция ПричинаТестНеВыполнен(Тест, Знач Пояснение, Знач Вывод) Экспорт

	Возврат ПричинаСВыводом(
		СтрШаблон("Тест %1 не был выполнен в изолированной среде: %2", Тест.Имя(), Пояснение),
		Вывод
	);

КонецФункции

// Разворачивает записи JSON-раскладки лога в захваченном выводе изолированной
// среды в их сообщения: лог изолированной среды мог быть настроен не так,
// как у родителя, а сырые JSON-записи в описании причины нечитаемы
//
// Параметры:
//  Вывод - Строка - Захваченный вывод изолированной среды
//
//  Возвращаемое значение:
//   Строка - Вывод с сообщениями вместо JSON-записей лога
//
Функция РазвернутьЗаписиЛога(Знач Вывод) Экспорт

	Строки = Новый Массив;

	Для Каждого СтрокаВывода Из СтрРазделить(Вывод, Символы.ПС) Цикл
		Строки.Добавить(СообщениеЗаписиЛога(СтрокаВывода));
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Возвращает краткие описания причин результата одной строкой
//
// Параметры:
//  Результат - РезультатВыполненияТеста - Результат теста или набора
//
//  Возвращаемое значение:
//   Строка - Краткие описания причин через перенос строки
//
Функция ОписанияПричин(Результат) Экспорт
	Возврат СтрСоединить(Результат.ОписанияПричин().ВМассив(), Символы.ПС);
КонецФункции

// Возвращает подробные описания причин результата со стеками одной строкой
//
// Параметры:
//  Результат - РезультатВыполненияТеста - Результат теста или набора
//
//  Возвращаемое значение:
//   Строка - Подробные описания причин через перенос строки
//
Функция ПодробныеПричины(Результат) Экспорт

	Возврат Результат.Причины()
		.ПроцессорКоллекции()
		.Обработать("Причина -> ТестированиеСлужебный.ПодробноеОписаниеОшибки(""Причина"", Причина)")
		.ВСтроку(Символы.ПС);

КонецФункции

// Возвращает статус записи по состоянию выполнения
//
// Параметры:
//  Состояние - Строка - Состояние выполнения, см. СостоянияВыполненияТестов
//
//  Возвращаемое значение:
//   Строка - Статус: "passed", "failed", "broken", "skipped" или "aborted"
//
Функция СтатусСостояния(Знач Состояние) Экспорт

	Если Состояние = СостоянияВыполненияТестов.Ошибка Тогда
		Возврат "failed";
	ИначеЕсли Состояние = СостоянияВыполненияТестов.Сломан Тогда
		Возврат "broken";
	ИначеЕсли Состояние = СостоянияВыполненияТестов.Пропущен Тогда
		Возврат "skipped";
	ИначеЕсли Состояние = СостоянияВыполненияТестов.Прерван Тогда
		Возврат "aborted";
	Иначе
		Возврат "passed";
	КонецЕсли;

КонецФункции

// Возвращает состояние выполнения по статусу записи
//
// Параметры:
//  Статус - Строка - Статус записи, см. СтатусСостояния
//
//  Возвращаемое значение:
//   Строка - Состояние выполнения, см. СостоянияВыполненияТестов
//
Функция СостояниеПоСтатусу(Знач Статус) Экспорт

	Если Статус = "failed" Тогда
		Возврат СостоянияВыполненияТестов.Ошибка;
	ИначеЕсли Статус = "broken" Тогда
		Возврат СостоянияВыполненияТестов.Сломан;
	ИначеЕсли Статус = "skipped" Тогда
		Возврат СостоянияВыполненияТестов.Пропущен;
	ИначеЕсли Статус = "aborted" Тогда
		Возврат СостоянияВыполненияТестов.Прерван;
	Иначе
		Возврат СостоянияВыполненияТестов.Успех;
	КонецЕсли;

КонецФункции

Функция СообщениеЗаписиЛога(Знач СтрокаВывода)

	Если Не СтрНачинаетсяС(СокрЛП(СтрокаВывода), "{") Тогда
		Возврат СтрокаВывода;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(СтрокаВывода);
		Запись = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		// Не запись лога, а просто строка с фигурной скобкой - оставляем как есть
		Возврат СтрокаВывода;
	КонецПопытки;

	Если ТипЗнч(Запись) <> Тип("Соответствие") Тогда
		Возврат СтрокаВывода;
	КонецЕсли;

	Сообщение = Запись.Получить("msg");

	Возврат ?(ТипЗнч(Сообщение) = Тип("Строка"), Сообщение, СтрокаВывода);

КонецФункции

Функция НовыйРезультат(Знач Состояние, Причины, Знач Вывод)
	Возврат _ТабакеркаРезультатов.Достать(Массивы.ИзЭлементов(Состояние, Причины, Вывод));
КонецФункции

Функция ЗначениеСвойства(Запись, Знач ИмяСвойства, Знач Умолчание)

	// Свойство() без найденного ключа обнуляет переменную до Неопределено,
	// поэтому умолчание нельзя положить в нее заранее
	Значение = Неопределено;

	Если Запись.Свойство(ИмяСвойства, Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат Умолчание;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Табакерка &Пластилин("РезультатВыполненияТеста") ТабакеркаРезультатов)
	_ТабакеркаРезультатов = ТабакеркаРезультатов;
КонецПроцедуры
