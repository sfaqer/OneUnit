// Один временный файл или каталог, освобождаемый контекстом владельца.

#Использовать collectionos
#Использовать fs
#Использовать tempfiles
#Использовать atomic
#Использовать logos

Перем ЭтоКаталог; // Булево - Истина для каталога, Ложь для файла
Перем Расширение; // Строка - Расширение временного файла без начальной точки
Перем Очистка; // Строка - Режим удаления: Всегда, ПриУспехе или Никогда
Перем Менеджер; // МенеджерВременныхФайлов - Создание и очистка пути этого объекта
Перем Лог; // Лог - Сообщения о сохранённых файлах и каталогах
Перем СозданныйПуть; // Опциональный - Путь ресурса (Строка), пустой до открытия
Перем УдалятьПовторно; // АтомарноеБулево - Путь должен быть удалён

// Создает пустой ресурс и регистрирует его освобождение у владельца.
//
// Параметры:
//  Контекст - КонтекстИсполнения - Владелец ресурса
//
// Возвращаемое значение:
//  Строка - Полный путь файла или каталога
//
Функция Открыть(Контекст) Экспорт

	СозданныйПуть.ЕслиСодержитЗначение(
		"Путь -> {
		|	ВызватьИсключение СтрШаблон(
		|		""Нельзя повторно создать временный файл или каталог: уже создан путь %1"",
		|		Путь
		|	);
		|}"
	);

	ФС.ОбеспечитьКаталог(Менеджер.БазовыйКаталог);

	Путь = Менеджер.НовоеИмяФайла(Расширение);

	СозданныйПуть = Новый Опциональный(Путь);

	Попытка

		Если ЭтоКаталог Тогда
			ФС.ОбеспечитьПустойКаталог(Путь);
		Иначе

			Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8NoBOM);
			Запись.Закрыть();

		КонецЕсли;

		Контекст.ПриЗакрытии(Новый Действие(ЭтотОбъект, "Закрыть"));

		Если ТипЗнч(Контекст.Узел()) = Тип("ОпределениеТеста") Тогда
			Контекст.Узел().Набор().Контекст().ПриЗакрытии(Новый Действие(ЭтотОбъект, "ПовторитьУдаление"));
		КонецЕсли;

	Исключение

		Менеджер.Удалить();
		ВызватьИсключение;

	КонецПопытки;

	Возврат Путь;

КонецФункции

// Освобождает ресурс при закрытии контекста, сообщает путь сохранённого ресурса.
//
// Параметры:
//  Контекст - КонтекстИсполнения - Закрываемый владелец
//
Процедура Закрыть(Контекст) Экспорт

	Путь = СозданныйПуть.Получить();

	Если Не ФС.Существует(Путь) Тогда

		УдалятьПовторно.Установить(Истина);
		Возврат;

	КонецЕсли;

	Сохранять = Очистка = РежимыОчисткиВременныхФайлов.Никогда
		Или Очистка = РежимыОчисткиВременныхФайлов.ПриУспехе И Контекст.ЕстьПадения();

	Если Сохранять И Не Пустой(Путь) Тогда

		Лог.Информация(СтрШаблон("Сохранён временный %1: %2", ?(ЭтоКаталог, "каталог", "файл"), Путь));
		Возврат;

	КонецЕсли;

	УдалятьПовторно.Установить(Истина);
	УдалитьРесурс();

КонецПроцедуры

// Повторяет очистку пути теста в конце набора, если удаление откладывалось
// или фоновый метод после таймаута создал путь заново.
//
// Параметры:
//  Контекст - КонтекстИсполнения - Контекст набора
//
Процедура ПовторитьУдаление(Контекст) Экспорт // BSLLS:UnusedParameters-off

	Если УдалятьПовторно.Получить() Тогда
		УдалитьРесурс();
	КонецЕсли;

КонецПроцедуры

Процедура УдалитьРесурс()
	Менеджер.УдалитьФайлСИсключением(СозданныйПуть.Получить());
КонецПроцедуры

Функция Пустой(Знач Путь)

	Попытка

		Если ФС.КаталогСуществует(Путь) Тогда
			Возврат ФС.КаталогПустой(Путь);
		КонецЕсли;

		Возврат Новый Файл(Путь).Размер() = 0;

	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(
	&Блестяшка Каталог,
	&Блестяшка Суффикс,
	&Блестяшка РежимОчистки,
	&Лог("oscript.lib.oneunit.core") ЛогированиеПутей
)

	ЭтоКаталог = Каталог;
	Расширение = Суффикс;
	Очистка = РежимОчистки;
	Лог = ЛогированиеПутей;

	Менеджер = Новый МенеджерВременныхФайлов;
	Менеджер.БазовыйКаталог = ФС.НормализоватьПуть(ОбъединитьПути(КаталогВременныхФайлов(), "oneunit"));

	СозданныйПуть = Опциональные.Пустой();
	УдалятьПовторно = Новый АтомарноеБулево;

КонецПроцедуры
