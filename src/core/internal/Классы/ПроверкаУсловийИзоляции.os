// Проверяет условия изолированного узла в текущей поделке, до подъема его среды:
// выключенный узел пропускается, не создавая ни поделки, ни дочернего процесса.
// Условия изолированного теста проверяются на экземпляре его набора - набор
// не изолирован, и его экземпляры и так создаются здесь. Условия изолированного
// набора - без экземпляра: конструктор изолированного набора вне его среды
// не выполняется. Условие, упавшее здесь (обращается к набору, которого нет,
// или к типу из импортов среды), ничего не решает. Узел, которого условия здесь
// не выключили, среда проверяет заново: условие может зависеть от ее деталек

#Использовать collectionos

Перем _ТабакеркаРезультатов; // Табакерка - Результаты выполнения тестов
Перем _ВызовМетода;          // ВызовМетода - Вызов условий с перехватом вывода
Перем _ФабрикаЭкземпляров;   // ФабрикаЭкземпляров - Экземпляр набора для условий изолированного теста

// Проверяет условия изолированного узла до подъема его среды
//
// Параметры:
//  Узел - ОпределениеТестНабора, ОпределениеТеста - Изолированный узел
//
//  Возвращаемое значение:
//   Структура - Итог проверки:
//    * Пропуск - Опциональный - Результат (РезультатВыполненияТеста) пропуска, пустой - узел
//                исполняется в своей среде
//    * Вывод   - Строка - Вывод создания экземпляра и условий: у пропуска он в результате,
//                а узлу, который исполняется в среде, предваряет вывод результата
//
Функция Проверить(Узел) Экспорт

	Проверка = Новый Структура("Пропуск, Вывод", Опциональные.Пустой(), "");

	Если Узел.Условия().Пусто() Тогда
		Возврат Проверка;
	КонецЕсли;

	Если ТипЗнч(Узел) = Тип("ОпределениеТестНабора") Тогда
		Создание = Новый Структура("Экземпляр, Вывод", Опциональные.Пустой(), "");
	Иначе
		Создание = _ФабрикаЭкземпляров.Создать(Узел.Набор());
	КонецЕсли;

	Вызов = _ВызовМетода.Вызвать(
		ЭтотОбъект,
		"ПричинаПропуска",
		Списки.ИзЭлементов(Узел.Условия(), Создание.Экземпляр),
		0
	);

	// Отказ создания здесь не причина: без экземпляра условия, которым он нужен,
	// проверит среда, а вывод создания остается выводом проверки
	Проверка.Вывод = Создание.Вывод + Вызов.Вывод;

	Если Вызов.Состояние = СостоянияВыполненияТестов.Успех
		И ЗначениеЗаполнено(Вызов.Значение.Получить()) Тогда

		Проверка.Пропуск = Новый Опциональный(_ТабакеркаРезультатов.Достать(Массивы.ИзЭлементов(
			СостоянияВыполненияТестов.Пропущен,
			Списки.ИзЭлементов(Вызов.Значение.Получить()),
			Проверка.Вывод
		)));

	КонецЕсли;

	Возврат Проверка;

КонецФункции

// Возвращает причину пропуска по первому условию, которое выключает узел вне его
// среды. Упавшее условие ничего не решает. Экспортная, потому что вызывается
// через ВызовМетода
//
// Параметры:
//  Условия   - ФиксированныйСписок, СписокМассив из Произвольный - Объекты аннотаций условий
//  Экземпляр - Опциональный - Объект сценария набора, пустой - условия проверяются без захвата
//
//  Возвращаемое значение:
//   Строка - Причина пропуска, пустая строка - условия узел не выключили
//
Функция ПричинаПропуска(Условия, Экземпляр) Экспорт

	Для Каждого Условие Из Условия Цикл

		Попытка
			Итог = Условие.Выполнять(Экземпляр);
		Исключение
			// Условию нужно то, чего вне среды узла нет, - его проверит среда
			Продолжить;
		КонецПопытки;

		Если Не Итог.Результат Тогда
			Возврат Итог.Причина;
		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин("РезультатВыполненияТеста") ТабакеркаРезультатов,
	&Пластилин ВызовМетода,
	&Пластилин ФабрикаЭкземпляров)

	_ТабакеркаРезультатов = ТабакеркаРезультатов;
	_ВызовМетода          = ВызовМетода;
	_ФабрикаЭкземпляров   = ФабрикаЭкземпляров;

КонецПроцедуры
