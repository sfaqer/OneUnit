#Использовать "../../../shared"

Перем _Состояние;
Перем _Причины;
Перем _Вывод;
Перем _ОписанияПричин;
Перем _ПеренесенноеВремяВыполнения; // Число - Время, измеренное изолированной средой, Неопределено - не переносилось

Функция Состояние() Экспорт
	Возврат _Состояние;
КонецФункции

Функция Причины() Экспорт
	Возврат _Причины;
КонецФункции

Функция ОписанияПричин() Экспорт
	Возврат _ОписанияПричин;
КонецФункции

Функция Вывод() Экспорт
	Возврат _Вывод;
КонецФункции

// Время выполнения, измеренное средой, где тест выполнялся на самом деле.
// Результат изолированного теста публикуется родителю, когда тест уже
// отработал, и замер родителя показал бы время доставки, а не выполнения
//
//  Возвращаемое значение:
//   Число - Время выполнения в миллисекундах
//   Неопределено - время измеряет статистика текущего прогона
//
Функция ПеренесенноеВремяВыполнения() Экспорт
	Возврат _ПеренесенноеВремяВыполнения;
КонецФункции

// Переносит в результат время выполнения, измеренное изолированной средой.
// Вызывается до публикации результата
//
// Параметры:
//  Миллисекунды - Число - Время выполнения в миллисекундах
//
//  Возвращаемое значение:
//   РезультатВыполненияТеста - Этот результат
//
Функция ПеренестиВремяВыполнения(Знач Миллисекунды) Экспорт
	_ПеренесенноеВремяВыполнения = Миллисекунды;
	Возврат ЭтотОбъект;
КонецФункции

Процедура ОбработкаПолученияПредставления(Представление, СтандартнаяОбработка) // BSLLS:UnusedLocalMethod-off
	СтандартнаяОбработка = Ложь;
	Представление = СтрШаблон("%1 %2", Состояние(), ОписанияПричин());
КонецПроцедуры

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Блестяшка Состояние, &Блестяшка Причины, &Блестяшка Вывод)

	_Состояние = Состояние;
	_Причины   = Причины;
	_Вывод     = Вывод;

	_ОписанияПричин  = Новый СписокМассив(_Причины);
	_ОписанияПричин.ЗаменитьВсе("Причина -> {
	|	Если ТипЗнч(Причина) = Тип(""Строка"") Тогда
	|		Возврат Причина;
	|	Иначе
	|		Возврат ТестированиеСлужебный.КраткоеОписаниеОшибки(Причина);
	|	КонецЕсли;
	|}");

КонецПроцедуры
