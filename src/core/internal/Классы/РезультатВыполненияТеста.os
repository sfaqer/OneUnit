#Использовать fluent
#Использовать "../../../shared"

Перем _Состояние;
Перем _Причины;
Перем _Вывод;
Перем ОписанияПричин;

// Опциональный - Время в миллисекундах, измеренное изолированной средой,
//  пустой - не переносилось
Перем ПеренесенноеВремяВыполнения;

Функция Состояние() Экспорт
	Возврат _Состояние;
КонецФункции

Функция Причины() Экспорт
	Возврат _Причины;
КонецФункции

Функция ОписанияПричин() Экспорт
	Возврат ОписанияПричин;
КонецФункции

Функция Вывод() Экспорт
	Возврат _Вывод;
КонецФункции

// Время выполнения, измеренное в изолированной среде
//
//  Возвращаемое значение:
//   Опциональный - Время выполнения в миллисекундах, пустой - время измеряет
//    статистика текущего прогона
//
Функция ПеренесенноеВремяВыполнения() Экспорт
	Возврат ПеренесенноеВремяВыполнения;
КонецФункции

// Переносит в результат время выполнения, измеренное изолированной средой.
// Вызывается до публикации результата
//
// Параметры:
//  Миллисекунды - Число - Время выполнения в миллисекундах
//
//  Возвращаемое значение:
//   РезультатВыполненияТеста - Этот результат
//
Функция ПеренестиВремяВыполнения(Знач Миллисекунды) Экспорт
	ПеренесенноеВремяВыполнения = Новый Опциональный(Миллисекунды);
	Возврат ЭтотОбъект;
КонецФункции

// Добавляет указанный текст перед текущим выводом результата.
// Изменение выполняется до публикации результата.
//
// Параметры:
//  Вывод - Строка - Предшествующий вывод
//
//  Возвращаемое значение:
//   РезультатВыполненияТеста - Этот результат
//
Функция ДобавитьПредшествующийВывод(Знач Вывод) Экспорт
	_Вывод = Вывод + _Вывод;
	Возврат ЭтотОбъект;
КонецФункции

// Добавляет вывод и исключения действий закрытия к результату узла.
// При наличии исключений учитывает состояние Сломан при выборе итогового состояния.
// Изменение выполняется до публикации результата.
//
// Параметры:
//  Закрытие - см. КонтекстИсполнения.Закрыть
//
//  Возвращаемое значение:
//   РезультатВыполненияТеста - Этот результат
//
Функция ДобавитьЗакрытие(Закрытие) Экспорт

	_Вывод = _Вывод + Закрытие.Вывод;

	Если Закрытие.Причины.Пусто() Тогда
		Возврат ЭтотОбъект;
	КонецЕсли;

	_Состояние = СостоянияВыполненияТестов.НаихудшееСостояние(_Состояние, СостоянияВыполненияТестов.Сломан);

	_Причины = ПроцессорыКоллекций.ИзНабора(_Причины, Закрытие.Причины)
		.Развернуть("Причины -> ПроцессорыКоллекций.ИзКоллекции(Причины)")
		.Получить("СписокМассив");

	ОписанияПричин = ОписанияПричинИз(_Причины);

	Возврат ЭтотОбъект;

КонецФункции

Функция ОписанияПричинИз(Причины)

	Возврат ПроцессорыКоллекций.ИзКоллекции(Причины)
		.Обработать("Причина -> {
		|
		|	Если ТипЗнч(Причина) = Тип(""Строка"") Тогда
		|		Возврат Причина;
		|	КонецЕсли;
		|
		|	Возврат ТестированиеСлужебный.КраткоеОписаниеОшибки(Причина);
		|
		|}")
		.Получить("СписокМассив");

КонецФункции

Процедура ОбработкаПолученияПредставления(Представление, СтандартнаяОбработка) // BSLLS:UnusedLocalMethod-off
	СтандартнаяОбработка = Ложь;
	Представление = СтрШаблон("%1 %2", Состояние(), ОписанияПричин());
КонецПроцедуры

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Блестяшка Состояние, &Блестяшка Причины, &Блестяшка Вывод)

	_Состояние = Состояние;
	_Причины   = Причины;
	_Вывод     = Вывод;

	ПеренесенноеВремяВыполнения = Опциональные.Пустой();

	ОписанияПричин = ОписанияПричинИз(_Причины);

КонецПроцедуры
