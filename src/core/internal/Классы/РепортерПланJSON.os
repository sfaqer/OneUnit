// Чтение и запись состава тест-плана в формате JSON.
// Используется для передачи обнаруженных наборов и тестов между изолированной средой
// и родительским прогоном. Результаты исполнения в состав плана не входят.

#Использовать collectionos
#Использовать fs

Перем _ПереносРезультатов; // ПереносРезультатов - Записи причин ошибок обнаружения

// Записывает состав тест-плана в файл
//
// Параметры:
//  ТестПлан - ТестПлан - Составленный тест-план
//  Путь - Строка - Путь к формируемому файлу
//
Процедура ЗаписатьПлан(ТестПлан, Знач Путь) Экспорт

	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.ОткрытьФайл(Путь);
	ЗаписатьJSON(ЗаписьJSON, Новый Структура("suites", ЗаписиСостава(СоставПлана(ТестПлан))));
	ЗаписьJSON.Закрыть();

КонецПроцедуры

// Читает состав плана из файла, записанного ЗаписатьПлан
//
// Параметры:
//  Путь - Строка - Путь к файлу
//
//  Возвращаемое значение:
//   Опциональный - Состав плана, см. СоставПлана; пустой - файла нет или он не разобран:
//    прогон не состоялся или завершился аварийно, не дописав файл
//
Функция ПрочитатьСостав(Знач Путь) Экспорт

	Если Не ФС.ФайлСуществует(Путь) Тогда
		Возврат Опциональные.Пустой();
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.ОткрытьФайл(Путь);

	Попытка
		Записи = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		ЧтениеJSON.Закрыть();
		Возврат Опциональные.Пустой();
	КонецПопытки;

	ЧтениеJSON.Закрыть();

	Если ТипЗнч(Записи) <> Тип("Структура") Или Не Записи.Свойство("suites") Тогда
		Возврат Опциональные.Пустой();
	КонецЕсли;

	Возврат Новый Опциональный(СоставЗаписей(Записи.suites));

КонецФункции

// Возвращает состав тест-плана для записи в файл и передачи событий изоляции
//
// Параметры:
//  ТестПлан - ТестПлан - Составленный тест-план
//
//  Возвращаемое значение:
//   СписокМассив из Структура - Наборы плана:
//    * Имя    - Строка - Имя набора
//    * Тесты  - см. УзлыСостава
//    * Вывод  - Строка - Вывод обнаружения набора
//    * Ошибки - ФиксированныйСписок из ИнформацияОбОшибке - Ошибки обнаружения набора;
//               пустой список - ошибок нет
//
Функция СоставПлана(ТестПлан) Экспорт

	Возврат ТестПлан.Дети().ПроцессорКоллекции()
		.Обработать(
			"Набор -> {
			|	Возврат Новый Структура(
			|		""Имя, Тесты, Ошибки, Вывод"",
			|		Набор.Имя(),
			|		УзлыСостава(Набор),
			|		Набор.ОшибкиОбнаружения(),
			|		Набор.ВыводОбнаружения()
			|	);
			|}",
			ЭтотОбъект
		)
		.Получить("СписокМассив");

КонецФункции

// Переводит состав плана в записи формата обмена
//
// Параметры:
//  Состав - см. СоставПлана
//
//  Возвращаемое значение:
//   Массив из Структура - Записи наборов:
//    * suite  - Строка - Имя набора
//    * tests  - см. ЗаписиУзлов
//    * output - Строка - Вывод обнаружения набора, пустая строка - вывода нет
//    * errors - см. ЗаписиОшибок
//
Функция ЗаписиСостава(Состав) Экспорт

	Возврат Состав.ПроцессорКоллекции()
		.Обработать(
			"Набор -> {
			|	Запись = Новый Структура(""suite, tests, output"", Набор.Имя, ЗаписиУзлов(Набор.Тесты), Набор.Вывод);
			|
			|	Запись.Вставить(""errors"", ЗаписиОшибок(Набор.Ошибки));
			|
			|	Возврат Запись;
			|}",
			ЭтотОбъект
		)
		.ВМассив();

КонецФункции

// Восстанавливает состав плана по записям формата обмена
//
// Параметры:
//  Записи - см. ЗаписиСостава
//
//  Возвращаемое значение:
//   см. СоставПлана
//
Функция СоставЗаписей(Записи) Экспорт

	Возврат ПроцессорыКоллекций.ИзКоллекции(Записи)
		.Обработать(
			"Запись -> {
			|	Возврат Новый Структура(
			|		""Имя, Тесты, Ошибки, Вывод"",
			|		Запись.suite,
			|		УзлыЗаписей(Запись.tests),
			|		ОшибкиЗаписей(Запись.errors),
			|		Запись.output
			|	);
			|}",
			ЭтотОбъект
		)
		.Получить("СписокМассив");

КонецФункции

// Возвращает состав дочерних узлов набора или контейнера.
// Для теста возвращает пустой список.
//
// Параметры:
//  Родитель - ОпределениеТестНабора, ОпределениеТеста - Набор, контейнер или тест
//
//  Возвращаемое значение:
//   СписокМассив из Структура - Узлы состава:
//    * Имя       - Строка - Имя теста
//    * ИмяМетода - Строка - Имя тестового метода
//    * Вывод     - Строка - Вывод обнаружения узла
//    * Тип       - Строка - Тест или контейнер, см. ТипыОпределенийТестов
//    * Дети      - см. УзлыСостава
//    * Ошибки    - ФиксированныйСписок из ИнформацияОбОшибке - Ошибки обнаружения узла,
//                  пустой - узел обнаружен
//
Функция УзлыСостава(Родитель) Экспорт

	Возврат Родитель.Дети().ПроцессорКоллекции()
		.Обработать(
			"Дитя -> {
			|	Возврат Новый Структура(
			|		""Имя, ИмяМетода, Тип, Дети, Ошибки, Вывод"",
			|		Дитя.Имя(),
			|		Дитя.ИмяМетода(),
			|		Дитя.ТипОпределения(),
			|		УзлыСостава(Дитя),
			|		Дитя.ОшибкиОбнаружения(),
			|		Дитя.ВыводОбнаружения()
			|	);
			|}",
			ЭтотОбъект
		)
		.Получить("СписокМассив");

КонецФункции

// Преобразует узлы состава в записи формата обмена
//
// Параметры:
//  Узлы - см. УзлыСостава
//
//  Возвращаемое значение:
//   Массив из Структура - Записи узлов, поле children есть только у контейнера:
//    * test     - Строка - Имя теста
//    * method   - Строка - Имя тестового метода
//    * output   - Строка - Вывод обнаружения узла, пустая строка - вывода нет
//    * children - см. ЗаписиУзлов
//    * errors   - Массив из Структура - Записи ошибок обнаружения, пустой массив - ошибок нет:
//       ** message - Строка - Краткое описание
//       ** details - Строка - Подробное описание со стеком
//
Функция ЗаписиУзлов(Узлы) Экспорт

	Возврат Узлы.ПроцессорКоллекции()
		.Обработать(
			"Узел -> {
			|	Запись = Новый Структура(""test, method, output"", Узел.Имя, Узел.ИмяМетода, Узел.Вывод);
			|
			|	Если Узел.Тип = ТипыОпределенийТестов.Контейнер Тогда
			|		Запись.Вставить(""children"", ЗаписиУзлов(Узел.Дети));
			|	КонецЕсли;
			|
			|	Запись.Вставить(""errors"", ЗаписиОшибок(Узел.Ошибки));
			|
			|	Возврат Запись;
			|}",
			ЭтотОбъект
		)
		.ВМассив();

КонецФункции

// Преобразует ошибки обнаружения в записи формата обмена
//
// Параметры:
//  Ошибки - ФиксированныйСписок из ИнформацияОбОшибке - Ошибки обнаружения узла
//
//  Возвращаемое значение:
//   Массив из см. ПереносРезультатов.ЗаписьПричины - Записи ошибок
//
Функция ЗаписиОшибок(Ошибки) Экспорт

	Возврат Ошибки.ПроцессорКоллекции()
		.Обработать(Новый Действие(_ПереносРезультатов, "ЗаписьПричины"))
		.ВМассив();

КонецФункции

// Восстанавливает ошибки обнаружения из записей формата обмена
//
// Параметры:
//  Записи - см. ЗаписиОшибок
//
//  Возвращаемое значение:
//   ФиксированныйСписок из ИнформацияОбОшибке - Ошибки обнаружения узла
//
Функция ОшибкиЗаписей(Записи) Экспорт

	Возврат Новый ФиксированныйСписок(
		ПроцессорыКоллекций.ИзКоллекции(Записи)
			.Обработать(Новый Действие(_ПереносРезультатов, "ПричинаЗаписи"))
			.Получить("СписокМассив")
	);

КонецФункции

// Восстанавливает узлы состава из записей формата обмена
//
// Параметры:
//  Записи - см. ЗаписиУзлов
//
//  Возвращаемое значение:
//   см. УзлыСостава
//
Функция УзлыЗаписей(Записи) Экспорт

	Возврат ПроцессорыКоллекций.ИзКоллекции(Записи)
		.Обработать(
			"Запись -> {
			|	ЭтоКонтейнер = Запись.Свойство(""children"");
			|
			|	Возврат Новый Структура(
			|		""Имя, ИмяМетода, Тип, Дети, Ошибки, Вывод"",
			|		Запись.test,
			|		Запись.method,
			|		?(ЭтоКонтейнер, ТипыОпределенийТестов.Контейнер, ТипыОпределенийТестов.Тест),
			|		?(ЭтоКонтейнер, УзлыЗаписей(Запись.children), Новый СписокМассив),
			|		ОшибкиЗаписей(Запись.errors),
			|		Запись.output
			|	);
			|}",
			ЭтотОбъект
		)
		.Получить("СписокМассив");

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин ПереносРезультатов)
	_ПереносРезультатов = ПереносРезультатов;
КонецПроцедуры
