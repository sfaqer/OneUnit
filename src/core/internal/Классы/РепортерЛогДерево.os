#Использовать collectionos

Перем _Лог;
Перем _РепортерСтатистика;

Перем Префикс;
Перем ТекущийКонтейнер;

Перем ЗапаркованныйКонтейнер;

Перем _ВыводитсяПлан; // Булево - Выводится план без исполнения (discover): у узлов нет времени выполнения

// Выводит тест-план без исполнения (discover). Узлы, которые не удалось
// обнаружить, выводятся на своем месте сломанными с причинами
//
// Параметры:
//  ТестПлан - ТестПлан - Составленный тест-план
//
Процедура ВывестиТестПлан(ТестПлан) Экспорт

	_ВыводитсяПлан = Истина;

	ИсполнениеТестПланНачало(ТестПлан);

	Для каждого Набор Из ТестПлан.Дети() Цикл

		ИсполнениеТестНаборНачало(Набор);

		Для каждого Тест Из Набор.Дети() Цикл
			ВывестиТест(Тест);
		КонецЦикла;

		ЗавершитьНабор(Набор, _РепортерСтатистика.РезультатОбнаружения(Набор));

	КонецЦикла;

	_ВыводитсяПлан = Ложь;

КонецПроцедуры

Процедура ВывестиТест(Тест)

	ИсполнениеТестНачало(Тест);

	Для каждого ВложенныйТест Из Тест.Дети() Цикл
		ВывестиТест(ВложенныйТест);
	КонецЦикла;

	ЗавершитьТест(Тест, _РепортерСтатистика.РезультатОбнаружения(Тест));

КонецПроцедуры

&ПодпискаНаСобытие("ИсполнениеТестПланНачало")
Процедура ИсполнениеТестПланНачало(ТестПлан) Экспорт

	Префикс          = Новый СписокМассив;
	ТекущийКонтейнер = ТестПлан;

КонецПроцедуры

&ПодпискаНаСобытие("ИсполнениеТестПланКонец")
Процедура ИсполнениеТестПланКонец(ТестПлан) Экспорт

	Префикс          = Неопределено;
	ТекущийКонтейнер = Неопределено;

КонецПроцедуры

&ПодпискаНаСобытие("ИсполнениеТестНаборНачало")
Процедура ИсполнениеТестНаборНачало(ТестНабор) Экспорт
	ЗапаркованныйКонтейнер = ТестНабор;
КонецПроцедуры

&ПодпискаНаСобытие("ИсполнениеТестНаборКонец")
Процедура ИсполнениеТестНаборКонец(ТестНабор, Результат) Экспорт
	ЗавершитьНабор(ТестНабор, Новый Опциональный(Результат));
КонецПроцедуры

&ПодпискаНаСобытие("ИсполнениеТестНачало")
Процедура ИсполнениеТестНачало(Тест) Экспорт
	РаспарковатьКонтейнер(Опциональные.Пустой());
	Если Тест.ТипОпределения() = ТипыОпределенийТестов.Контейнер Тогда
		// Заголовок контейнера паркуется, как заголовок набора: о состоянии
		// контейнера говорят его дети, а если детей не было - его собственный
		// результат, и тогда заголовок без символа и причины ничего не значил бы
		ЗапаркованныйКонтейнер = Тест;
	КонецЕсли;
КонецПроцедуры

&ПодпискаНаСобытие("ИсполнениеТестКонец")
Процедура ИсполнениеТестКонец(Тест, Результат) Экспорт
	ЗавершитьТест(Тест, Новый Опциональный(Результат));
КонецПроцедуры

// Завершает вывод набора
//
// Параметры:
//  ТестНабор - ОпределениеТестНабора - Набор
//  Результат - Опциональный - Результат набора (РезультатВыполненияТеста),
//              пустой - у набора нет результата (план без исполнения)
//
Процедура ЗавершитьНабор(ТестНабор, Результат)

	РаспарковатьКонтейнер(Результат);
	Префикс.Удалить(Префикс.Получить(Префикс.ВГраница()));
	ТекущийКонтейнер = ТестНабор.Родитель();

КонецПроцедуры

// Завершает вывод теста или контейнера
//
// Параметры:
//  Тест - ОпределениеТеста - Тест или контейнер
//  Результат - Опциональный - Результат теста (РезультатВыполненияТеста),
//              пустой - у теста нет результата (план без исполнения)
//
Процедура ЗавершитьТест(Тест, Результат)

	Если Тест.ТипОпределения() = ТипыОпределенийТестов.Контейнер Тогда

		// Контейнер всё ещё запаркован - значит, ни один его случай не выполнялся
		РаспарковатьКонтейнер(Результат);

		Префикс.Удалить(Префикс.Получить(Префикс.ВГраница()));
		ТекущийКонтейнер = Тест.Родитель();

	Иначе

		ЭтоПоследний = ТекущийКонтейнер.Дети().Индекс(Тест) = ТекущийКонтейнер.Дети().ВГраница();

		Если ЭтоПоследний Тогда
			Префикс.Добавить("└─");
		Иначе
			Префикс.Добавить("├─");
		КонецЕсли;

		ТекущийКонтейнер = Тест;

		ВывестиВЛог(Результат);

		Префикс.Удалить(Префикс.Получить(Префикс.ВГраница()));

		ТекущийКонтейнер = Тест.Родитель();

	КонецЕсли;

КонецПроцедуры

Процедура ВыводКонтейнера(Контейнер, РезультатВыполнения)

	ЭтоПоследний = ТекущийКонтейнер.Дети().Индекс(Контейнер) = ТекущийКонтейнер.Дети().ВГраница();

	Если ЭтоПоследний Тогда
		Префикс.Добавить("└─");
	Иначе
		Префикс.Добавить("├─");
	КонецЕсли;

	ТекущийКонтейнер = Контейнер;

	ВывестиВЛог(РезультатВыполнения);

	Если ЭтоПоследний Тогда
		Префикс.Установить(Префикс.ВГраница(), "    ");
	Иначе
		Префикс.Установить(Префикс.ВГраница(), "│   ");
	КонецЕсли;

КонецПроцедуры

Процедура ВывестиВЛог(РезультатВыполнения)

	Поля = Новый КартаСоответствие();
	Поля.Вставить("УровеньДерева", СтрСоединить(Префикс.ВМассив(), ""));
	Поля.Вставить("ИмяТеста",      ТекущийКонтейнер);

	Если РезультатВыполнения.СодержитЗначение() Тогда

		Результат = РезультатВыполнения.Получить();

		Уровень = СостоянияВыполненияТестов.УровеньЛогаСостояния(Результат.Состояние());

		Причины = Результат.ОписанияПричин();
		Если Не Причины.Пусто() Тогда
			Поля.Вставить("Причина", Причины);
		КонецЕсли;

		Поля.Вставить("Результат", СостоянияВыполненияТестов.СимволСостояния(Результат.Состояние()));

		Если Не _ВыводитсяПлан Тогда
			Поля.Вставить(
				"ВремяВыполнения",
				 _РепортерСтатистика.СтатистикаТеста(ТекущийКонтейнер).ПолучитьИлиУмолчание("ВремяВыполнения", 0)
			);
		КонецЕсли;

	Иначе
		Уровень = УровниЛога.Информация;
	КонецЕсли;

	_Лог.ПоляИз(Поля.КлючиИЗначения())
		.Вывести("", Уровень);

КонецПроцедуры

Процедура РаспарковатьКонтейнер(РезультатВыполнения)
	Если ЗначениеЗаполнено(ЗапаркованныйКонтейнер) Тогда
		ВыводКонтейнера(ЗапаркованныйКонтейнер, РезультатВыполнения);
		ЗапаркованныйКонтейнер = Неопределено;
	КонецЕсли;
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Лог("oscript.lib.oneunit.core") Лог,
	&Пластилин РепортерСтатистика)
	_Лог = Лог;
	_РепортерСтатистика = РепортерСтатистика;
	_ВыводитсяПлан = Ложь;
КонецПроцедуры
