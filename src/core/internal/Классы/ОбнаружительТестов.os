#Использовать annotations
#Использовать collectionos
#Использовать "../../../shared"

Перем _Поделка;                  // Поделка - Поделка текущего прогона
Перем _Фильтры;                  // Массив из Фильтр - Фильтры тестов и наборов
Перем _КорневыеАннотацииУсловий; // СписокМассив из Строка - Имена корневых аннотаций условий
Перем _ВыполняетсяВИзоляции;     // Булево - Признак прогона внутри изолированной среды
Перем _ПутиКТестовымНаборам;     // КартаСоответствие - Пути к файлам наборов по именам классов

// Составляет тест-план по окружению поделки. Состав изолированных наборов
// обнаруживается только в их средах: при исполнении его вклеивают их исполнители,
// при чистом обнаружении - отдельный шаг разворачивания (см. ДиспетчерТестов.Развернуть)
//
//  Возвращаемое значение:
//   ТестПлан - Составленный тест-план
//
Функция Обнаружить() Экспорт

	ТестПлан = _Поделка.НайтиЖелудь("ТестПлан");

	ОпределенияТестовыхНаборов = Новый Массив(Новый Рефлектор().ПолучитьСвойство(_Поделка, "ФабрикаЖелудей")
		.ПолучитьСписокОпределенийЖелудей("ТестовыйНабор"));
	Массивы.Сортировать(
		ОпределенияТестовыхНаборов,
		"(Первый, Второй) -> {
		|	Если Первый.Порядок() > Второй.Порядок() Тогда
		|		Возврат 1;
		|	ИначеЕсли Первый.Порядок() < Второй.Порядок() Тогда
		|		Возврат -1;
		|	Иначе
		|		Возврат СтрСравнить(Первый.Имя(), Второй.Имя());
		|	КонецЕсли;
		|}"
	);

	Для Каждого ОпределениеТестовогоНабора Из ОпределенияТестовыхНаборов Цикл

		Если Не _ПутиКТестовымНаборам.СодержитКлюч(ОпределениеТестовогоНабора.Имя()) Тогда
			// Аннотированные типы видны всем поделкам процесса: набор, файл которого
			// не подключала заготовка этой поделки, принадлежит чужому прогону
			Продолжить;
		КонецЕсли;

		ТестНабор = ЗарегистрироватьТестовыйНабор(ОпределениеТестовогоНабора, ТестПлан);

		Если Пропустить(ТестНабор) Тогда
			Продолжить;
		КонецЕсли;

		ТестПлан.ДобавитьТестовыйНабор(ТестНабор);

		Если ТестНабор.Изоляция().СодержитЗначение() Или Не ТестНабор.ОшибкиОбнаружения().Пусто() Тогда
			// Состав изолированного набора обнаруживается в его среде, а набор
			// с неверным объявлением сломан целиком
			Продолжить;
		КонецЕсли;

		Тесты = РаботаСАннотациями.НайтиМетодыСАннотацией(
			ОпределениеТестовогоНабора.Методы(),
			"Тестируемый"
		);

		Для каждого ТестМетод Из Тесты Цикл

			ОтображаемоеИмя = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
				РаботаСАннотациями.ПолучитьАннотацию(ТестМетод, "ОтображаемоеИмя"),
				"Значение",
				ТестМетод.Имя
			);

			Таймаут = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
				РаботаСАннотациями.ПолучитьАннотацию(ТестМетод, "Таймаут"),
				"Значение",
				0
			);

			Порядок = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
				РаботаСАннотациями.ПолучитьАннотацию(ТестМетод, "Порядок"),
				"Значение",
				0
			);

			Теги = Массивы.КакСписок(РаботаСАннотациями.ПолучитьАннотации(ТестМетод, "Тег"))
				.ПроцессорКоллекции()
				.Обработать("Аннотация -> РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация)")
				.Получить("СписокМассив");

			Теги.ДобавитьВсе(ТестНабор.Теги());

			Объявление = РазборИзоляции(ТестМетод);

			Свойства = Новый Структура(
				"ОтображаемоеИмя, Таймаут, Теги, Условия, Порядок, Изоляция",
				ОтображаемоеИмя,
				Таймаут,
				Теги,
				УсловияМетода(ТестМетод),
				Порядок,
				Объявление.Изоляция
			);

			// Ошибка обнаружения ломает свой узел, а не обнаружение всего плана:
			// неверное объявление изоляции или отказ поставщика контекста шаблона
			ОшибкаОбнаружения = Объявление.Ошибка;

			Если РаботаСАннотациями.ПолучитьАннотацию(ТестМетод, "Тест") <> Неопределено Тогда

				Определение = ОпределениеМетода(ТипыОпределенийТестов.Тест, Новый СписокМассив, ТестМетод, ТестНабор, Свойства);

				Если Пропустить(Определение) Тогда
					Продолжить;
				КонецЕсли;

			ИначеЕсли РаботаСАннотациями.ПолучитьАннотацию(ТестМетод, "ТестШаблон") <> Неопределено Тогда

				Дети = Новый СписокМассив;

				Определение = ОпределениеМетода(ТипыОпределенийТестов.Контейнер, Дети, ТестМетод, ТестНабор, Свойства);

				Если Пропустить(Определение) Тогда
					Продолжить;
				КонецЕсли;

				Описания = Новый СписокМассив;

				Если Не ОшибкаОбнаружения.СодержитЗначение() Тогда
					Итерации = ИтерацииШаблона(ТестМетод, ОтображаемоеИмя, ТестНабор);
					ОшибкаОбнаружения = Итерации.Ошибка;
					Описания = Итерации.Описания;
				КонецЕсли;

				Если ОшибкаОбнаружения.СодержитЗначение() Тогда
					// Шаблон без итераций становится тестом со своей ошибкой обнаружения:
					// так его видят статистика и все отчеты
					Определение = ОпределениеМетода(ТипыОпределенийТестов.Тест, Новый СписокМассив, ТестМетод, ТестНабор, Свойства);
				Иначе
					Определение.ДобавитьВыводОбнаружения(Итерации.Вывод);
				КонецЕсли;

				Для каждого Описание Из Описания Цикл

					Дети.Добавить(
						_Поделка.НайтиЖелудь(
							"ОпределениеТеста",
							Массивы.ИзЭлементов(
								ТипыОпределенийТестов.Тест,
								Описание.Имя(),
								Новый СписокМассив,
								Определение,
								ТестМетод.Имя,
								Описание.Параметры(),
								Таймаут,
								Теги,
								Свойства.Условия,
								Порядок,
								Опциональные.Пустой(),
								ИсполнителиТестов.Асинхронный
							)
						)
					);

				КонецЦикла;

			Иначе
				Продолжить;
			КонецЕсли;

			ОшибкаОбнаружения.ЕслиСодержитЗначение(Новый Действие(Определение, "ДобавитьОшибкуОбнаружения"));

			ТестНабор.ДобавитьТест(Определение);

		КонецЦикла;

	КонецЦикла;

	Возврат ТестПлан;

КонецФункции

// Создает определение тестового метода: теста или шаблона
//
// Параметры:
//  Тип - Строка - Тест или контейнер, см. ТипыОпределенийТестов
//  Дети - СписокМассив из ОпределениеТеста - Итерации шаблона, у теста пустой
//  ТестМетод - ДанныеМетода - Тестовый метод
//  ТестНабор - ОпределениеТестНабора - Набор метода
//  Свойства - Структура - Свойства метода из его аннотаций:
//   * ОтображаемоеИмя - Строка - Отображаемое имя
//   * Таймаут         - Число - Таймаут в миллисекундах, 0 - таймаут набора
//   * Теги            - СписокМассив из Строка - Теги метода и набора
//   * Условия         - СписокМассив из Произвольный - Объекты аннотаций условий
//   * Порядок         - Число - Порядок среди тестов набора
//   * Изоляция        - см. ОписаниеИзоляции
//
//  Возвращаемое значение:
//   ОпределениеТеста - Определение метода
//
Функция ОпределениеМетода(Знач Тип, Дети, ТестМетод, ТестНабор, Свойства)

	Возврат _Поделка.НайтиЖелудь(
		"ОпределениеТеста",
		Массивы.ИзЭлементов(
			Тип,
			Свойства.ОтображаемоеИмя,
			Дети,
			ТестНабор,
			ТестМетод.Имя,
			Новый СписокМассив,
			Свойства.Таймаут,
			Свойства.Теги,
			Свойства.Условия,
			Свойства.Порядок,
			Свойства.Изоляция,
			ИмяИсполнителя(Свойства.Изоляция)
		)
	);

КонецФункции

// Получает описания итераций тестового шаблона, перехватывая вывод поставщика
// контекста (например, вывод выражения источника аргументов): вывод удачного
// обнаружения предваряет вывод контейнера при исполнении, неудачного - несет
// ошибка обнаружения
//
// Параметры:
//  ТестМетод - ДанныеМетода - Метод тестового шаблона
//  ОтображаемоеИмя - Строка - Отображаемое имя шаблона
//  ТестНабор - ОпределениеТестНабора - Набор шаблона
//
//  Возвращаемое значение:
//   Структура - Итерации шаблона:
//    * Описания - СписокМассив из ОписаниеТеста - Описания итераций, при ошибке пустой
//    * Вывод    - Строка - Вывод удачного обнаружения
//    * Ошибка   - Опциональный - Ошибка обнаружения (ИнформацияОбОшибке) с выводом,
//                 пустой - итерации получены
//
Функция ИтерацииШаблона(ТестМетод, Знач ОтображаемоеИмя, ТестНабор)

	Итерации = Новый Структура("Описания, Вывод, Ошибка", Новый СписокМассив, "", Опциональные.Пустой());

	ПотокВывода = Новый ПотокВПамяти();
	ТестированиеСлужебный.НачатьПерехватВывода(ПотокВывода);

	Попытка
		Итерации.Описания = КонтекстыВызова(ТестМетод, ОтображаемоеИмя, ТестНабор);
	Исключение
		Итерации.Ошибка = Новый Опциональный(ИнформацияОбОшибке());
	КонецПопытки;

	ТестированиеСлужебный.ЗавершитьПерехватВывода();

	Вывод = ТестированиеСлужебный.ПрочитатьПоток(ПотокВывода);
	ПотокВывода.Закрыть();

	Если Итерации.Ошибка.СодержитЗначение() Тогда
		Итерации.Ошибка = Новый Опциональный(ТестированиеСлужебный.ОшибкаСВыводом(Итерации.Ошибка.Получить(), Вывод));
	Иначе
		Итерации.Вывод = Вывод;
	КонецЕсли;

	Возврат Итерации;

КонецФункции

// Получает у поставщика контекста, указанного в &ТестШаблон, описания итераций
// тестового шаблона
//
// Параметры:
//  ТестМетод - ДанныеМетода - Метод тестового шаблона
//  ОтображаемоеИмя - Строка - Отображаемое имя шаблона
//  ТестНабор - ОпределениеТестНабора - Набор шаблона
//
//  Возвращаемое значение:
//   СписокМассив из ОписаниеТеста - Описания итераций
//
Функция КонтекстыВызова(ТестМетод, Знач ОтображаемоеИмя, ТестНабор)

	ПоставщикКонтекста = _Поделка.НайтиЖелудь(
		РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
			РаботаСАннотациями.ПолучитьАннотацию(ТестМетод, "ТестШаблон")
		)
	);

	Возврат ПоставщикКонтекста.ПредоставитьКонтекстыВызова(
		_Поделка.НайтиЖелудь(
			"КонтекстРасширения",
			Массивы.ИзЭлементов(
				ТестМетод,
				ОтображаемоеИмя,
				ТестНабор
			)
		)
	).Получить("СписокМассив");

КонецФункции

Функция ЗарегистрироватьТестовыйНабор(ОпределениеТестовогоНабора, ТестПлан) Экспорт

	Конструктор = ОпределениеТестовогоНабора.Завязь().ДанныеМетода();

	Таймаут = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
		РаботаСАннотациями.ПолучитьАннотацию(Конструктор, "Таймаут"),
		"Значение",
		0
	);

	Теги = Массивы.КакСписок(РаботаСАннотациями.ПолучитьАннотации(Конструктор, "Тег"))
		.ПроцессорКоллекции()
		.Обработать("Аннотация -> РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация)")
		.Получить("СписокМассив");

	Методы = ОпределениеТестовогоНабора.Методы();

	ЖизненныйЦикл = Новый КартаСоответствие();
	ЖизненныйЦикл.Вставить("ПередВсеми", ИменаМетодовСАннотацией(Методы, "ПередВсеми"));
	ЖизненныйЦикл.Вставить("ПередКаждым", ИменаМетодовСАннотацией(Методы, "ПередКаждым"));
	ЖизненныйЦикл.Вставить("ПослеКаждого", ИменаМетодовСАннотацией(Методы, "ПослеКаждого"));
	ЖизненныйЦикл.Вставить("ПослеВсех", ИменаМетодовСАннотацией(Методы, "ПослеВсех"));

	Объявление = РазборИзоляции(Конструктор);

	ТестНабор = _Поделка.НайтиЖелудь(
		"ОпределениеТестНабора",
		Массивы.ИзЭлементов(
			ОпределениеТестовогоНабора,
			ТестПлан,
			Таймаут,
			Теги,
			УсловияМетода(Конструктор),
			ЖизненныйЦикл,
			Объявление.Изоляция,
			ИмяИсполнителя(Объявление.Изоляция)
		)
	);

	Объявление.Ошибка.ЕслиСодержитЗначение(Новый Действие(ТестНабор, "ДобавитьОшибкуОбнаружения"));

	Возврат ТестНабор;

КонецФункции

// Разбирает объявление изоляции метода. Неверное объявление не прерывает
// обнаружение: оно становится ошибкой обнаружения узла, а узел остается
// неизолированным
//
// Параметры:
//  Метод - ДанныеМетода - Метод теста или конструктор набора
//
//  Возвращаемое значение:
//   Структура - Итог разбора:
//    * Изоляция - см. ОписаниеИзоляции
//    * Ошибка   - Опциональный - Ошибка объявления (ИнформацияОбОшибке), пустой - объявление верное
//
Функция РазборИзоляции(Метод)

	Попытка
		Возврат Новый Структура("Изоляция, Ошибка", ОписаниеИзоляции(Метод), Опциональные.Пустой());
	Исключение
		Возврат Новый Структура("Изоляция, Ошибка", Опциональные.Пустой(), Новый Опциональный(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

// Строит описание изоляции по аннотации &Изолированный на методе
//
// Параметры:
//  Метод - ДанныеМетода - Метод теста или конструктор набора
//
//  Возвращаемое значение:
//   Опциональный - Описание изоляции (см. ИзоляцияАннотации), пустой - метод не изолирован
//                  или прогон уже идет в изолированной среде
//
Функция ОписаниеИзоляции(Метод)

	Если _ВыполняетсяВИзоляции Тогда
		// Внутри изолированной среды аннотация игнорируется, иначе изоляция
		// заворачивалась бы в изоляцию бесконечно
		Возврат Опциональные.Пустой();
	КонецЕсли;

	Возврат Новый Опциональный(РаботаСАннотациями.ПолучитьАннотацию(Метод, "Изолированный"), Истина)
		.Обработать(Новый Действие(ЭтотОбъект, "ИзоляцияАннотации"));

КонецФункции

// Строит описание изоляции по аннотации &Изолированный. Экспортная, потому что
// вызывается через Действие, а Действие работает только с экспортными методами
//
// Параметры:
//  Аннотация - СтрокаТабличнойЧасти - Аннотация &Изолированный
//
//  Возвращаемое значение:
//   Структура - Описание изоляции:
//    * Уровень      - Строка - Уровень изоляции, см. УровниИзоляции
//    * Импорты      - Массив из Строка - Пути импортов для уровня Процесс
//    * ЛямбдаСовета - Строка - Лямбда-выражение совета создания поделки, пустая строка - без совета
//
Функция ИзоляцияАннотации(Аннотация) Экспорт

	Уровень =РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Уровень", УровниИзоляции.Поделка);
	Импорты = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Импорты", "");
	ЛямбдаСовета = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Совет", "");

	Если Уровень <> УровниИзоляции.Поделка И Уровень <> УровниИзоляции.Процесс Тогда
		ВызватьИсключение СтрШаблон(
			"В аннотации Изолированный неизвестный уровень изоляции: %1", Уровень
		);
	КонецЕсли;

	СписокИмпортов = Новый Массив;
	Для каждого Импорт Из СтрРазделить(Импорты, ",", Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Импорт)) Тогда
			СписокИмпортов.Добавить(СокрЛП(Импорт));
		КонецЕсли;
	КонецЦикла;

	Если СписокИмпортов.Количество() > 0 И Уровень <> УровниИзоляции.Процесс Тогда
		ВызватьИсключение
			"Параметр Импорты аннотации Изолированный доступен только для уровня Процесс";
	КонецЕсли;

	Возврат Новый Структура(
		"Уровень, Импорты, ЛямбдаСовета",
		Уровень,
		СписокИмпортов,
		ЛямбдаСовета
	);

КонецФункции

// Возвращает имя исполнителя узла по описанию его изоляции
//
// Параметры:
//  Изоляция - см. ОписаниеИзоляции
//
//  Возвращаемое значение:
//   Строка - Имя исполнителя, см. ИсполнителиТестов
//
Функция ИмяИсполнителя(Изоляция)

	Возврат Изоляция
		.Обработать("Изоляция -> Изоляция.Уровень = УровниИзоляции.Процесс")
		.Обработать("ЭтоПроцесс -> ?(ЭтоПроцесс, ИсполнителиТестов.Процессный, ИсполнителиТестов.Поделочный)")
		.Иначе_(ИсполнителиТестов.Асинхронный);

КонецФункции

Функция УсловияМетода(Метод)

	Условия = Новый СписокМассив;

	Для каждого ИмяАннотации Из _КорневыеАннотацииУсловий Цикл
		Для каждого Аннотация Из РаботаСАннотациями.ПолучитьАннотации(Метод, ИмяАннотации) Цикл
			Условия.Добавить(_Поделка.ПолучитьОпределениеАннотации(Аннотация.Имя).СоздатьОбъектАннотации(Аннотация));
		КонецЦикла;
	КонецЦикла;

	Возврат Условия;

КонецФункции

Функция ИменаМетодовСАннотацией(Методы, ИмяАннотации)

	Возврат Новый ФиксированныйСписок(
		ПроцессорыКоллекций.ИзКоллекции(РаботаСАннотациями.НайтиМетодыСАннотацией(Методы, ИмяАннотации))
			.Обработать("Метод -> Метод.Имя")
			.Получить("СписокМассив")
	);

КонецФункции

Функция Пропустить(Определение)

	Для каждого Фильтр Из _Фильтры Цикл
		Если Фильтр.Пропустить(Определение) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин Поделка,
	&Пластилин ПутиКТестовымНаборам,
	&Пластилин("Фильтр", Тип = "Список") Фильтры,
	&Деталька("OneUnit.ВыполняетсяВИзоляции", ЗначениеПоУмолчанию = Ложь) ВыполняетсяВИзоляции)

	_Поделка = Поделка;
	_Фильтры = Фильтры;
	_ВыполняетсяВИзоляции = ВыполняетсяВИзоляции;
	_ПутиКТестовымНаборам = ПутиКТестовымНаборам;

	_КорневыеАннотацииУсловий = Новый СписокМассив;
	_КорневыеАннотацииУсловий.Добавить("ВыключенЕсли");
	_КорневыеАннотацииУсловий.Добавить("ВключенЕсли");

КонецПроцедуры
