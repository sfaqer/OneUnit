#Использовать asserts
#Использовать collectionos

Перем _Имя;
Перем _Параметры;
Перем СведенияОПовторении; // Опциональный - ИнформацияОПовторении; пустой для других видов вызовов

Функция Имя() Экспорт
	Возврат _Имя;
КонецФункции

Функция Параметры() Экспорт
	Возврат _Параметры;
КонецФункции

// Возвращает сведения о повторении, если описание относится к повторяемому тесту.
//
// Возвращаемое значение:
//  Опциональный - ИнформацияОПовторении; пустой - это другой вид вызова
//
Функция Повторение() Экспорт
	Возврат СведенияОПовторении;
КонецФункции

// Создает неизменяемое описание вызова теста.
//
// Параметры:
//  Имя        - Строка - Отображаемое имя вызова
//  Параметры  - Список из Произвольный - Позиционные значения параметров
//  Повторение - Опциональный - ИнформацияОПовторении; пустой для других видов вызовов
//
&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(
	&Блестяшка Знач Имя,
	&Блестяшка Знач Параметры,
	&Блестяшка Повторение) Экспорт

	Ожидаем.Что(Имя).ИмеетТип("Строка").Заполнено();
	Параметры = Списки.Скопировать(Параметры);

	_Имя = Имя;
	_Параметры = Параметры;
	СведенияОПовторении = Повторение;

КонецПроцедуры
