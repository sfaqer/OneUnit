// Ретранслирует в текущий прогон события изолированного набора по мере того, как
// их присылает изолированная среда (см. ТрансляторСобытийИзоляции): строит зеркала
// по составу набора до первого теста и публикует для них события исполнения.
// Когда среда завершилась, закрывает то, что она не успела завершить, и отдает
// результат набора.
//
// На уровне "Процесс" принимает вывод дочернего процесса как лог вывода команды
// 1commands (методы Информация и Ошибка): строки-сообщения канала ретранслируются,
// остальное копится как вывод прогона для причин отказов.

#Использовать collectionos
#Использовать "../../../shared"

Перем _ОпределениеНабора;    // ОпределениеТестНабора - Плейсхолдер изолированного набора
Перем _ТабакеркаОпределений; // Табакерка - Определения тестов для зеркал
Перем _ТабакеркаРезультатов; // Табакерка - Результаты выполнения тестов
Перем _ПубликаторСобытий;    // ПубликаторСобытий - Публикатор событий текущего прогона
Перем _ПереносРезультатов;   // ПереносРезультатов - Причины отказов изолированной среды
Перем _Канал;                // КаналСобытийИзоляции - Разбор строк-сообщений вывода процесса

Перем _СоставПолучен;        // Булево - Изолированная среда прислала состав плана
Перем _ИндексНабора;         // Опциональный - Индекс набора в плане среды, пустой - набор не обнаружен
Перем _Зеркала;              // КартаСоответствие из КлючИЗначение - Зеркала по путям:
                             //  * Ключ     - Строка - Путь узла от набора, индексы через точку
                             //  * Значение - ОпределениеТеста - Зеркало
Перем _ПорядокЗеркал;        // СписокМассив из ОпределениеТеста - Зеркала в порядке обхода состава
Перем _Начатые;              // МножествоСоответствие из ОпределениеТеста - Зеркала, начало которых опубликовано
Перем _Завершенные;          // МножествоСоответствие из ОпределениеТеста - Зеркала, конец которых опубликован
Перем _РезультатНабора;      // Опциональный - Результат набора в среде, пустой - не пришел
Перем _ОжидаемыйНомер;       // Число - Номер следующего сообщения трансляции
Перем _СообщенияПотеряны;    // Булево - Нумерация сообщений прерывалась: часть событий не дошла
Перем _Вывод;                // Массив из Строка - Вывод дочернего процесса помимо сообщений
Перем _Хвост;                // Строка - Недочитанная строка вывода дочернего процесса
Перем _ПотокПерехвата;       // Опциональный - Поток перехвата вывода изолированной поделки, пустой - без перехвата

// Принимает сообщение трансляции изолированной среды
//
// Параметры:
//  Сообщение - см. КаналСобытийИзоляции.СообщениеЗаписи
//
Процедура Принять(Сообщение) Экспорт

	// Разрыв нумерации - потерянное сообщение, например строка канала, склеенная
	// с посторонним выводом: без него набор нельзя считать целым
	Если Сообщение.Номер <> _ОжидаемыйНомер Тогда
		_СообщенияПотеряны = Истина;
	КонецЕсли;

	_ОжидаемыйНомер = Сообщение.Номер + 1;

	Если Сообщение.Событие = СобытияИзоляции.Состав Тогда
		ВклеитьСостав(Сообщение.Состав);
		Возврат;
	КонецЕсли;

	Если Не _ИндексНабора.СодержитЗначение() Или Сообщение.Путь.Получить(0) <> _ИндексНабора.Получить() Тогда
		Возврат;
	КонецЕсли;

	Если Сообщение.Событие = СобытияИзоляции.КонецНабора Тогда
		_РезультатНабора = Новый Опциональный(Сообщение.Результат);
		Возврат;
	КонецЕсли;

	НайденноеЗеркало = _Зеркала.Получить(КлючПути(Сообщение.Путь));

	Если Не НайденноеЗеркало.СодержитЗначение() Тогда
		Возврат;
	КонецЕсли;

	Зеркало = НайденноеЗеркало.Получить();

	Если Сообщение.Событие = СобытияИзоляции.НачалоТеста Тогда

		Начать(Зеркало);

	ИначеЕсли Сообщение.Событие = СобытияИзоляции.КонецТеста Тогда

		// Начало могло потеряться: репортерам нужна пара событий
		Начать(Зеркало);

		_Завершенные.Добавить(Зеркало);
		Опубликовать(
			Зеркало,
			"ИсполнениеТестКонец",
			Массивы.ИзЭлементов(Сообщение.Результат)
		);

	КонецЕсли; // BSLLS:IfElseIfEndsWithElse-off

КонецПроцедуры

// Строит зеркала изолированного набора по составу плана его среды. Зеркала
// строятся все сразу, до событий их исполнения: репортеры определяют положение
// узла среди соседей по составу родителя
//
// Параметры:
//  Состав - см. РепортерПланJSON.СоставПлана
//
Процедура ВклеитьСостав(Состав) Экспорт

	_СоставПолучен = Истина;

	Для ИндексНабора = 0 По Состав.ВГраница() Цикл

		Если Состав.Получить(ИндексНабора).Имя <> _ОпределениеНабора.Имя() Тогда
			Продолжить;
		КонецЕсли;

		_ИндексНабора = Новый Опциональный(ИндексНабора);

		Узлы = Состав.Получить(ИндексНабора).Тесты;

		Для Индекс = 0 По Узлы.ВГраница() Цикл
			_ОпределениеНабора.ДобавитьТест(
				ПостроитьЗеркало(Узлы.Получить(Индекс), _ОпределениеНабора, XMLСтрока(Индекс), Индекс)
			);
		КонецЦикла;

		Прервать;

	КонецЦикла;

КонецПроцедуры

// Принимает очередную порцию стандартного вывода дочернего процесса -
// интерфейс лога вывода команды 1commands
//
// Параметры:
//  Текст - Строка - Порция вывода, строки в ней могут быть оборваны
//
Процедура Информация(Знач Текст) Экспорт

	Строки = СтрРазделить(_Хвост + Текст, Символы.ПС);

	_Хвост = Строки[Строки.ВГраница()];
	Строки.Удалить(Строки.ВГраница());

	Для каждого СтрокаВывода Из Строки Цикл
		ПринятьСтроку(СтрокаВывода);
	КонецЦикла;

КонецПроцедуры

// Принимает очередную порцию вывода ошибок дочернего процесса -
// интерфейс лога вывода команды 1commands
//
// Параметры:
//  Текст - Строка - Порция вывода ошибок
//
Процедура Ошибка(Знач Текст) Экспорт
	_Вывод.Добавить(Текст);
КонецПроцедуры

// Включает публикацию событий мимо перехвата вывода изолированной поделки:
// события приходят изнутри ее исполнения, а вывод текущего прогона (дерево тестов)
// не должен попасть в перехват
//
// Параметры:
//  Поток - ПотокВПамяти - Поток перехвата вывода изолированной поделки
//
Процедура ПубликоватьМимоПерехвата(Поток) Экспорт
	_ПотокПерехвата = Новый Опциональный(Поток);
КонецПроцедуры

// Возвращает публикацию событий в обычный режим: перехват вывода изолированной
// поделки завершен
//
Процедура ЗавершитьПубликациюМимоПерехвата() Экспорт
	_ПотокПерехвата = Опциональные.Пустой();
КонецПроцедуры

// Закрывает то, что изолированная среда не успела завершить, и возвращает
// результат набора
//
// Параметры:
//  ВыводСреды - Строка - Захваченный вывод изолированной поделки,
//               вывод дочернего процесса ретранслятор накопил сам
//  ОшибкаСреды - Опциональный - Отказ (ИнформацияОбОшибке), не давший среде отработать,
//                пустой - среда отработала
//
//  Возвращаемое значение:
//   РезультатВыполненияТеста - Результат изолированного набора
//
Функция Завершить(Знач ВыводСреды, ОшибкаСреды) Экспорт

	Если _Хвост <> "" Тогда
		ПринятьСтроку(_Хвост);
		_Хвост = "";
	КонецЕсли;

	Вывод = СтрСоединить(_Вывод, Символы.ПС) + ВыводСреды;

	ЗакрытьНезавершенные(Вывод);

	Если ОшибкаСреды.СодержитЗначение() Тогда
		// Сдерживание отказов: среда не поднялась или упало ее обнаружение -
		// набор сломан, но общий прогон продолжается. Вывод среды - вывод набора
		Возврат _ТабакеркаРезультатов.Достать(Массивы.ИзЭлементов(
			СостоянияВыполненияТестов.Сломан,
			Списки.ИзЭлементов(ОшибкаСреды.Получить()),
			Вывод
		));
	КонецЕсли;

	Если _СообщенияПотеряны Тогда
		Возврат РезультатСломан(_ПереносРезультатов.ПричинаСВыводом(
			"Трансляция событий изолированного набора потеряла сообщения: результаты части тестов не дошли",
			Вывод
		));
	КонецЕсли;

	Если Не _СоставПолучен Тогда
		Возврат РезультатСломан(_ПереносРезультатов.ПричинаСВыводом(
			"Дочерний прогон изолированного набора завершился аварийно, не начав исполнение",
			Вывод
		));
	КонецЕсли;

	Если Не _ИндексНабора.СодержитЗначение() Тогда
		// Родитель набор обнаружил, а изолированная среда - нет: она собралась
		// не так, как ожидалось (например, совет подменил детальки прогона)
		Возврат РезультатСломан(_ПереносРезультатов.ПричинаСВыводом(
			СтрШаблон("Изолированный набор %1 не был обнаружен в дочернем прогоне", _ОпределениеНабора.Имя()),
			Вывод
		));
	КонецЕсли;

	Если Не _РезультатНабора.СодержитЗначение() Тогда
		Возврат РезультатСломан(_ПереносРезультатов.ПричинаСВыводом(
			"Дочерний прогон изолированного набора завершился аварийно, не завершив набор",
			Вывод
		));
	КонецЕсли;

	Возврат _РезультатНабора.Получить();

КонецФункции

Процедура ПринятьСтроку(Знач СтрокаВывода)

	Попытка
		Сообщение = _Канал.Разобрать(СтрокаВывода);
	Исключение
		// Строка с маркером, но не сообщение: остается выводом, а потерю
		// сообщения покажет разрыв нумерации
		Сообщение = Опциональные.Пустой();
	КонецПопытки;

	Если Сообщение.СодержитЗначение() Тогда
		Принять(Сообщение.Получить());
	Иначе
		_Вывод.Добавить(СтрЗаменить(СтрЗаменить(СтрокаВывода, Символ(65279), ""), Символы.ВК, ""));
	КонецЕсли;

КонецПроцедуры

// Закрывает начатые, но не завершенные зеркала: среда завершилась посреди
// исполнения. Итерации закрываются раньше своих контейнеров. Зеркала, до которых
// среда не дошла, остаются без результата, как тесты набора, упавшего до них
//
// Параметры:
//  Вывод - Строка - Вывод изолированной среды для причин
//
Процедура ЗакрытьНезавершенные(Знач Вывод)

	Для каждого Зеркало Из _ПорядокЗеркал Цикл

		Если Зеркало.ТипОпределения() = ТипыОпределенийТестов.Контейнер
			Или Не НачатоНоНеЗавершено(Зеркало) Тогда
			Продолжить;
		КонецЕсли;

		Причина = _ПереносРезультатов.ПричинаТестНеВыполнен(Зеркало, "среда завершилась посреди теста", Вывод);

		_Завершенные.Добавить(Зеркало);

		Опубликовать(
			Зеркало,
			"ИсполнениеТестКонец",
			Массивы.ИзЭлементов(РезультатСломан(Причина))
		);

	КонецЦикла;

	// Контейнеры - в обратном порядке обхода, после всех своих итераций
	Для Индекс = 0 По _ПорядокЗеркал.ВГраница() Цикл

		Зеркало = _ПорядокЗеркал.Получить(_ПорядокЗеркал.ВГраница() - Индекс);

		Если Зеркало.ТипОпределения() <> ТипыОпределенийТестов.Контейнер
			Или Не НачатоНоНеЗавершено(Зеркало) Тогда
			Продолжить;
		КонецЕсли;

		_Завершенные.Добавить(Зеркало);

		Опубликовать(
			Зеркало,
			"ИсполнениеТестКонец",
			Массивы.ИзЭлементов(Результат(СостоянияВыполненияТестов.Успех, Списки.ИзЭлементов()))
		);

	КонецЦикла;

КонецПроцедуры

// Публикует начало зеркала, если оно еще не опубликовано, - вместе с началом
// его контейнера: события по зеркалу приходят парой и вложенными, даже если
// сообщение о начале потерялось по дороге
//
// Параметры:
//  Зеркало - ОпределениеТеста - Зеркало теста, итерации или контейнера
//
Процедура Начать(Зеркало)

	Если _Начатые.Содержит(Зеркало) Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Зеркало.Родитель()) = Тип("ОпределениеТеста") Тогда
		Начать(Зеркало.Родитель());
	КонецЕсли;

	_Начатые.Добавить(Зеркало);
	Опубликовать(Зеркало, "ИсполнениеТестНачало", Новый Массив);

КонецПроцедуры

Функция НачатоНоНеЗавершено(Зеркало)
	Возврат _Начатые.Содержит(Зеркало) И Не _Завершенные.Содержит(Зеркало);
КонецФункции

// Строит зеркало узла состава и регистрирует его по пути
//
// Параметры:
//  Узел - Структура - Узел состава:
//   * Имя       - Строка - Имя теста
//   * ИмяМетода - Строка - Имя тестового метода
//   * Тип       - Строка - Тест или контейнер, см. ТипыОпределенийТестов
//   * Дети      - см. РепортерПланJSON.УзлыСостава
//   * Ошибки    - ФиксированныйСписок из ИнформацияОбОшибке - Ошибки обнаружения узла
//  Родитель - ОпределениеТестНабора, ОпределениеТеста - Родитель зеркала
//  Ключ - Строка - Путь узла от набора, индексы через точку
//  Порядок - Число - Порядок узла среди соседей: равен его индексу, чтобы
//            сортировка набора сохранила порядок изолированной среды
//
//  Возвращаемое значение:
//   ОпределениеТеста - Зеркало
//
Функция ПостроитьЗеркало(Узел, Родитель, Знач Ключ, Знач Порядок)

	Дети = Новый СписокМассив;

	Зеркало = _ТабакеркаОпределений.Достать(Массивы.ИзЭлементов(
		Узел.Тип,
		Узел.Имя,
		Дети,
		Родитель,
		Узел.ИмяМетода,
		Новый СписокМассив,
		0,
		Новый СписокМассив,
		Новый СписокМассив,
		Порядок,
		Опциональные.Пустой(),
		ИсполнителиТестов.Асинхронный
	));

	// Ошибки обнаружения среды видны на зеркале, как на узле плана родителя
	Узел.Ошибки.ПроцессорКоллекции()
		.ДляКаждого(Новый Действие(Зеркало, "ДобавитьОшибкуОбнаружения"));

	_Зеркала.Вставить(Ключ, Зеркало);
	_ПорядокЗеркал.Добавить(Зеркало);

	Для Индекс = 0 По Узел.Дети.ВГраница() Цикл
		Дети.Добавить(ПостроитьЗеркало(
			Узел.Дети.Получить(Индекс),
			Зеркало,
			Ключ + "." + XMLСтрока(Индекс),
			Индекс
		));
	КонецЦикла;

	Возврат Зеркало;

КонецФункции

Функция КлючПути(Путь)

	Индексы = Новый Массив;

	// Первый индекс - набор в плане среды, ключи зеркал отсчитываются от набора
	Для Позиция = 1 По Путь.ВГраница() Цикл
		Индексы.Добавить(XMLСтрока(Путь.Получить(Позиция)));
	КонецЦикла;

	Возврат СтрСоединить(Индексы, ".");

КонецФункции

Процедура Опубликовать(Источник, Знач ИмяСобытия, ПараметрыСобытия)

	Если Не _ПотокПерехвата.СодержитЗначение() Тогда
		_ПубликаторСобытий.ОпубликоватьСобытие(Источник, ИмяСобытия, ПараметрыСобытия);
		Возврат;
	КонецЕсли;

	// Перехваты вывода ведутся стеком: событие приходит между тестами изолированной
	// поделки, когда на вершине стека ее перехват, и снимается ровно он
	ТестированиеСлужебный.ЗавершитьПерехватВывода();

	Попытка
		_ПубликаторСобытий.ОпубликоватьСобытие(Источник, ИмяСобытия, ПараметрыСобытия);
	Исключение
		ТестированиеСлужебный.НачатьПерехватВывода(_ПотокПерехвата.Получить());
		ВызватьИсключение;
	КонецПопытки;

	ТестированиеСлужебный.НачатьПерехватВывода(_ПотокПерехвата.Получить());

КонецПроцедуры

Функция РезультатСломан(Причина)
	Возврат Результат(СостоянияВыполненияТестов.Сломан, Списки.ИзЭлементов(Причина));
КонецФункции

Функция Результат(Знач Состояние, Причины)
	Возврат _ТабакеркаРезультатов.Достать(Массивы.ИзЭлементов(Состояние, Причины, ""));
КонецФункции

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(
	&Блестяшка ОпределениеНабора,
	&Табакерка &Пластилин("ОпределениеТеста") ТабакеркаОпределений,
	&Табакерка &Пластилин("РезультатВыполненияТеста") ТабакеркаРезультатов,
	&Пластилин ПубликаторСобытий,
	&Пластилин ПереносРезультатов,
	&Пластилин КаналСобытийИзоляции)

	_ОпределениеНабора    = ОпределениеНабора;
	_ТабакеркаОпределений = ТабакеркаОпределений;
	_ТабакеркаРезультатов = ТабакеркаРезультатов;
	_ПубликаторСобытий    = ПубликаторСобытий;
	_ПереносРезультатов   = ПереносРезультатов;
	_Канал                = КаналСобытийИзоляции;

	_СоставПолучен = Ложь;
	_Зеркала       = Новый КартаСоответствие();
	_ПорядокЗеркал = Новый СписокМассив;
	_Начатые       = Новый МножествоСоответствие();
	_Завершенные   = Новый МножествоСоответствие();
	_Вывод         = Новый Массив;
	_Хвост         = "";

	_ИндексНабора    = Опциональные.Пустой();
	_РезультатНабора = Опциональные.Пустой();
	_ПотокПерехвата  = Опциональные.Пустой();

	_ОжидаемыйНомер    = 1;
	_СообщенияПотеряны = Ложь;

КонецПроцедуры
