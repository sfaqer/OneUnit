// Значения аннотаций ВременныйКаталог и ВременныйФайл в контексте владельца.

#Использовать annotations
#Использовать collectionos
#Использовать fluent

Перем Пути; // Табакерка - Ресурсы ВременныйПуть
Перем ДопустимыеОбласти; // СписокМассив из Строка - Области временного пути
Перем ДопустимыеРежимыОчистки; // СписокМассив из Строка - Режимы очистки
Перем НедопустимыеСимволы; // СписокМассив из Строка - Запрещённые символы в расширении файла

// Параметры:
//  Элемент - КонтекстПараметра, КонтекстПоля - Параметр или поле с аннотацией
//  Контекст - КонтекстИсполнения - Контекст текущего узла
//
// Возвращаемое значение:
//  Строка - Путь временного файла или каталога
//
Функция Значение(Элемент, Контекст) Экспорт

	Каталог = Элемент.Аннотация("ВременныйКаталог");
	Файл = Элемент.Аннотация("ВременныйФайл");

	Если Каталог.СодержитЗначение() И Файл.СодержитЗначение() Тогда

		ВызватьИсключение СтрШаблон(
			"Для %1 нельзя одновременно указывать &ВременныйКаталог и &ВременныйФайл. Оставьте одну аннотацию.",
			ОписаниеЭлемента(Элемент)
		);

	КонецЕсли;

	Аннотация = ?(Каталог.СодержитЗначение(), Каталог, Файл).ИначеВызватьИсключение(
		Новый ИнформацияОбОшибке("Не указана аннотация временного пути", Неопределено)
	);

	Область = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
		Аннотация,
		"Область",
		ОбластиВременныхФайлов.Тест
	);
	Очистка = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
		Аннотация,
		"Очистка",
		РежимыОчисткиВременныхФайлов.Всегда
	);
	Расширение = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация, "Расширение", "tmp");
	Проверить(Область, Очистка, Расширение, ОписаниеЭлемента(Элемент));

	Владелец = КонтекстВладельца(Контекст, Область);
	Описание = Новый Структура("Каталог, Расширение, Очистка", Каталог.СодержитЗначение(), Расширение, Очистка);

	Если Область = ОбластиВременныхФайлов.Набор Тогда

		Возврат Владелец.Хранилище().ВычислитьЕслиОтсутствует(
			КлючОбъявления(Элемент),
			"Ключ -> Поставщик.Создать(Описание, Владелец)",
			Новый Структура("Поставщик, Описание, Владелец", ЭтотОбъект, Описание, Владелец)
		).Получить();

	КонецЕсли;

	Возврат Создать(Описание, Владелец);

КонецФункции

// Создаёт ресурс и связывает его освобождение с контекстом владельца.
//
// Параметры:
//  Описание - Структура - Настройки ресурса:
//   * Каталог - Булево - Создаётся каталог
//   * Расширение - Строка - Расширение файла
//   * Очистка - Строка - Режим очистки
//  Владелец - КонтекстИсполнения - Владелец ресурса
//
// Возвращаемое значение:
//  Строка - Полный путь ресурса
//
Функция Создать(Описание, Владелец) Экспорт

	Ресурс = Пути.Достать(
		Массивы.ИзЭлементов(Описание.Каталог, Описание.Расширение, Описание.Очистка)
	);

	Если Ресурс = Неопределено Тогда
		ВызватьИсключение "Не удалось создать временный ресурс";
	КонецЕсли;

	Возврат Ресурс.Открыть(Владелец);

КонецФункции

Функция КонтекстВладельца(Контекст, Знач Область)

	Узел = Контекст.Узел();

	Если ТипЗнч(Узел) = Тип("ОпределениеТестНабора") Тогда
		Возврат Контекст;
	КонецЕсли;

	Если Область = ОбластиВременныхФайлов.Набор Или Узел.ТипОпределения() = ТипыОпределенийТестов.Контейнер Тогда
		Возврат Узел.Набор().Контекст();
	КонецЕсли;

	Возврат Контекст;

КонецФункции

Функция ОписаниеЭлемента(Элемент)

	Если ТипЗнч(Элемент) = Тип("КонтекстПоля") Тогда
		Возврат СтрШаблон("поля ""%1""", Элемент.Имя());
	КонецЕсли;

	Возврат СтрШаблон("параметра ""%1"" метода ""%2""", Элемент.Имя(), Элемент.Метод().Имя);

КонецФункции

Функция КлючОбъявления(Элемент)

	Если ТипЗнч(Элемент) = Тип("КонтекстПоля") Тогда
		Возврат "OneUnit.ВременныйПуть.Поле." + Элемент.Имя();
	КонецЕсли;

	Возврат СтрШаблон("OneUnit.ВременныйПуть.Параметр.%1.%2", Элемент.Метод().Имя, Элемент.Индекс());

КонецФункции

Процедура Проверить(Знач Область, Знач Очистка, Знач Расширение, Знач Место)

	Если Не ДопустимыеОбласти.Содержит(Область) Тогда

		ВызватьИсключение СтрШаблон(
			"Неизвестная область временного пути для %1: %2. Допустимы: %3",
			Место,
			Область,
			ДопустимыеОбласти.ПроцессорКоллекции().ВСтроку(", ")
		);

	КонецЕсли;

	Если Не ДопустимыеРежимыОчистки.Содержит(Очистка) Тогда

		ВызватьИсключение СтрШаблон(
			"Неизвестный режим очистки временного пути для %1: %2. Допустимы: %3",
			Место,
			Очистка,
			ДопустимыеРежимыОчистки.ПроцессорКоллекции().ВСтроку(", ")
		);

	КонецЕсли;

	Если ТипЗнч(Расширение) <> Тип("Строка") Тогда

		ВызватьИсключение СтрШаблон(
			"Расширение временного файла для %1 должно быть строкой. Получен тип %2",
			Место,
			ТипЗнч(Расширение)
		);

	КонецЕсли;

	Если СтрНачинаетсяС(Расширение, ".") Или НедопустимыеСимволы.ПроцессорКоллекции().ЛюбойСоответствует(
		"Символ -> СтрНайти(Расширение, Символ) > 0",
		Новый Структура("Расширение", Расширение)
	) Тогда

		ВызватьИсключение СтрШаблон(
			"Расширение временного файла для %1 должно быть суффиксом без пути и начальной точки",
			Место
		);

	КонецЕсли;

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(&Табакерка &Пластилин("ВременныйПуть") ВременныеПути)

	Пути = ВременныеПути;

	ДопустимыеОбласти = Списки.ИзЭлементов(ОбластиВременныхФайлов.Тест, ОбластиВременныхФайлов.Набор);

	ДопустимыеРежимыОчистки = Списки.ИзЭлементов(
		РежимыОчисткиВременныхФайлов.Всегда,
		РежимыОчисткиВременныхФайлов.ПриУспехе,
		РежимыОчисткиВременныхФайлов.Никогда
	);

	НедопустимыеСимволы = Списки.ИзЭлементов(
		"/",
		"\",
		"*",
		"?",
		":",
		"""",
		"<",
		">",
		"|",
		Символы.ПС,
		Символы.ВК,
		Символ(0)
	);

КонецПроцедуры
