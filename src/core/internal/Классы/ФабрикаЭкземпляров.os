// Создает экземпляры тестовых наборов - объекты их сценариев. Единственное место
// создания экземпляра набора: исполнитель, условия, источники параметров и совет
// изоляции получают экземпляры здесь, а не у определения набора

#Использовать collectionos
#Использовать "../../../shared"

Перем _Поделка;            // Поделка - Поделка текущего прогона, в которой зарегистрированы наборы
Перем _ПереносРезультатов; // ПереносРезультатов - Причины с готовым описанием

// Создает экземпляр тестового набора. Компанейский набор создается заново
// при каждом вызове, одиночка - один раз на поделку. Вывод создания перехватывается:
// autumn глотает исключение конструктора и пишет его в лог, и этот лог - корень
// причины отказа, а не вывод в консоль
//
// Параметры:
//  ОпределениеНабора - ОпределениеТестНабора - Определение набора
//
//  Возвращаемое значение:
//   Структура - Создание экземпляра:
//    * Экземпляр - Опциональный - Объект сценария набора, пустой - набор не удалось создать
//    * Вывод     - Строка - Перехваченный вывод конструктора; при отказе пустой - вывод в причине отказа
//    * Отказ     - Опциональный - Причина отказа (ИнформацияОбОшибке) «Не удаётся инстанцировать
//                  тестовый набор», по причине - перехваченный вывод создания; пустой - экземпляр создан
//
Функция Создать(ОпределениеНабора) Экспорт

	ПотокВывода = Новый ПотокВПамяти();
	ТестированиеСлужебный.НачатьПерехватВывода(ПотокВывода);

	Попытка
		Желудь = _Поделка.НайтиЖелудь(ОпределениеНабора.ИмяЖелудя());
	Исключение
		ТестированиеСлужебный.ЗавершитьПерехватВывода();
		ПотокВывода.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ТестированиеСлужебный.ЗавершитьПерехватВывода();

	Создание = Новый Структура(
		"Экземпляр, Вывод, Отказ",
		Новый Опциональный(Желудь, Истина),
		ТестированиеСлужебный.ПрочитатьПоток(ПотокВывода),
		Опциональные.Пустой()
	);

	ПотокВывода.Закрыть();

	Если Не Создание.Экземпляр.СодержитЗначение() Тогда
		Создание.Отказ = Новый Опциональный(НоваяОшибка(
			"Не удаётся инстанцировать тестовый набор",
			Неопределено,
			ПричинаИзВывода(Создание.Вывод)
		));
		Создание.Вывод = "";
	КонецЕсли;

	Возврат Создание;

КонецФункции

// Вызывает исключение отказа для кода, которому нужен был экземпляр набора,
// которого нет (условие, выражение источника, лямбда совета): настоящая причина -
// создание набора, ошибка кода - ее следствие. Цепочка: «Не удаётся инстанцировать
// тестовый набор», по причине - ошибка кода, по причине - вывод создания
//
// Параметры:
//  Создание   - см. Создать
//  ОшибкаКода - ИнформацияОбОшибке - Исключение кода, которому нужен был экземпляр
//  ВыводКода  - Строка - Перехваченный вывод кода: исключение несет его как контекст,
//               см. ТестированиеСлужебный.ВызватьСВыводом; пустая строка - вывод
//               перехватывает вызывающий
//
Процедура ВызватьОтказ(Создание, ОшибкаКода, Знач ВыводКода) Экспорт

	// Готовую ошибку повторно не выбросить - она обернется еще одним звеном,
	// поэтому звено кода пересоздается с причиной-корнем
	Следствие = НоваяОшибка(ОшибкаКода.Описание, ОшибкаКода.Параметры, Создание.Отказ.Получить().Причина);

	Если ПустаяСтрока(ВыводКода) Тогда
		ВызватьИсключение Новый ИнформацияОбОшибке(
			"Не удаётся инстанцировать тестовый набор",
			Неопределено,
			Следствие
		);
	КонецЕсли;

	ТестированиеСлужебный.ВызватьСВыводом(
		НоваяОшибка("Не удаётся инстанцировать тестовый набор", Неопределено, Следствие),
		ВыводКода
	);

КонецПроцедуры

Функция ПричинаИзВывода(Знач Вывод)

	Вывод = _ПереносРезультатов.РазвернутьЗаписиЛога(Вывод);

	Если Не ЗначениеЗаполнено(СокрЛП(Вывод)) Тогда
		Вывод = "<autumn не вывел причину>";
	КонецЕсли;

	Возврат _ПереносРезультатов.ПричинаСГотовымОписанием(
		"Не удалось создать желудь набора",
		СтрШаблон(
			"
			|По причине:
			|%1
			|",
			Вывод
		)
	);

КонецФункции

// Выброшенная ошибка: у невыброшенной нельзя прочитать модуль и строку
Функция НоваяОшибка(Знач Описание, Параметры, Причина)

	Попытка
		ВызватьИсключение Новый ИнформацияОбОшибке(Описание, Параметры, Причина);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин Поделка, &Пластилин ПереносРезультатов)
	_Поделка            = Поделка;
	_ПереносРезультатов = ПереносРезультатов;
КонецПроцедуры
