// Создание экземпляров тестовых наборов для исполнения, проверки условий
// и вычисления выражений. Экземпляр набора-одиночки хранится в контексте набора
// и используется в течение одного прогона.

#Использовать annotations
#Использовать collectionos
#Использовать lambdas
#Использовать "../../../shared"

Перем _Поделка;            // Поделка - Поделка текущего прогона, в которой зарегистрированы наборы
Перем _ПереносРезультатов; // ПереносРезультатов - Причины с готовым описанием
Перем ПубликаторСобытий;   // ПубликаторСобытий - Заполнение аргументов конструктора

// Создает экземпляр тестового набора для указанного узла.
// Для компанейского набора создает новый экземпляр, для одиночки использует
// экземпляр текущего прогона. Значения поставщиков разрешаются в контексте владельца;
// для одиночки и условий контейнера владельцем является набор.
// Возвращает экземпляр, перехваченный вывод и причину отказа создания.
//
// Параметры:
//  ОпределениеНабора - ОпределениеТестНабора - Определение набора
//  Владелец - ОпределениеТестНабора, ОпределениеТеста - Исполняемый узел, для которого
//             создается экземпляр: тест или набор
//
//  Возвращаемое значение:
//   см. ИтогСоздания
//
Функция Создать(ОпределениеНабора, Владелец) Экспорт

	Возврат ИтогСоздания(ТестированиеСлужебный.ВыполнитьСПерехватомВывода(
		ЭтотОбъект,
		"НайтиЭкземпляр",
		Списки.ИзЭлементов(ОпределениеНабора, Владелец)
	));

КонецФункции

// Создает экземпляр для проверки условий изолированного теста в родительской среде.
// Если конструктор содержит параметры с поставщиками, создание пропускается:
// результат содержит пустые Экземпляр и Отказ.
//
// Параметры:
//  ОпределениеНабора - ОпределениеТестНабора - Определение набора
//  Владелец - ОпределениеТеста - Узел, за который решают
//
//  Возвращаемое значение:
//   см. ИтогСоздания - без экземпляра и без отказа, если набор не создавался
//
Функция СоздатьВнеУзла(ОпределениеНабора, Владелец) Экспорт

	Если СигнатураСПоставщиками(ОпределениеНабора).СодержитЗначение() Тогда
		Возврат Новый Структура("Экземпляр, Вывод, Отказ", Опциональные.Пустой(), "", Опциональные.Пустой());
	КонецЕсли;

	Возврат Создать(ОпределениеНабора, Владелец);

КонецФункции

// Формирует результат создания экземпляра.
// При отсутствии экземпляра включает причину отказа и перехваченный вывод.
//
// Параметры:
//  Поиск - см. ТестированиеСлужебный.ВыполнитьСПерехватомВывода
//
//  Возвращаемое значение:
//   Структура - Создание экземпляра:
//    * Экземпляр - Опциональный - Объект сценария набора; пустой - экземпляр не получен
//    * Вывод     - Строка - Перехваченный вывод создания; при отказе также включен в его описание
//    * Отказ     - Опциональный - Ошибка создания (ИнформацияОбОшибке) с цепочкой причин;
//                  пустой - ошибки создания нет
//
Функция ИтогСоздания(Поиск)

	Создание = Новый Структура(
		"Экземпляр, Вывод, Отказ",
		Поиск.Значение,
		Поиск.Вывод,
		Опциональные.Пустой()
	);

	Если Не Создание.Экземпляр.СодержитЗначение() Тогда
		Создание.Отказ = Новый Опциональный(НоваяОшибка(
			"Не удаётся инстанцировать тестовый набор",
			Неопределено,
			ПричинаОтказа(Поиск.Ошибка, Создание.Вывод)
		));
	КонецЕсли;

	Возврат Создание;

КонецФункции

// Возвращает экземпляр одиночки текущего прогона или создает новый экземпляр набора
//
// Параметры:
//  ОпределениеНабора - ОпределениеТестНабора - Определение набора
//  Владелец - ОпределениеТестНабора, ОпределениеТеста - Исполняемый узел, для которого
//             создается экземпляр: тест или набор
//
//  Возвращаемое значение:
//   - Произвольный - Экземпляр набора
//   - Неопределено - Экземпляр не создан
//
Функция НайтиЭкземпляр(ОпределениеНабора, Владелец) Экспорт

	Если Не ОпределениеНабора.Одиночка() Тогда
		Возврат НовыйЭкземпляр(ОпределениеНабора, УзелВладельца(Владелец));
	КонецЕсли;

	// Экземпляр одиночки и ресурсы его конструктора принадлежат контексту набора.
	// Ключом кэша служит определение набора.
	КонтекстНабора = ОпределениеНабора.Контекст();

	Созданный = КонтекстНабора.Хранилище().Получить(ОпределениеНабора);

	Если Созданный.СодержитЗначение() Тогда
		Возврат Созданный.Получить();
	КонецЕсли;

	Экземпляр = НовыйЭкземпляр(ОпределениеНабора, ОпределениеНабора);

	// Упавший конструктор не запоминается: следующий узел создает набор заново
	Если Экземпляр <> Неопределено Тогда
		КонтекстНабора.Хранилище().Вставить(ОпределениеНабора, Экземпляр);
	КонецЕсли;

	Возврат Экземпляр;

КонецФункции

// Создает экземпляр без получения значений поставщиков.
// Параметры конструктора с поставщиками получают Неопределено; такой экземпляр
// не сохраняется в контексте набора. Если поставщиков нет, применяется обычное
// создание с поддержкой одиночки текущего прогона.
//
// Параметры:
//  ОпределениеНабора - ОпределениеТестНабора - Определение набора
//
//  Возвращаемое значение:
//   - Произвольный - Экземпляр набора
//   - Неопределено - Экземпляр не создан
//
Функция НайтиЭкземплярБезПоставщиков(ОпределениеНабора) Экспорт

	Если Не СигнатураСПоставщиками(ОпределениеНабора).СодержитЗначение() Тогда
		// Без поставщиков в конструкторе такой экземпляр ничем не отличается от обычного:
		// одиночка остается одной на прогон
		Возврат НайтиЭкземпляр(ОпределениеНабора, ОпределениеНабора);
	КонецЕсли;

	// Экземпляр без значений поставщиков всегда новый и не запоминается: одиночку
	// прогона создает исполнение, со значениями
	Возврат _Поделка.НайтиЖелудь(
		ОпределениеНабора.ИмяЖелудя(),
		БлестяшкиКонструктора(СигнатураСПоставщиками(ОпределениеНабора).Получить(), Опциональные.Пустой())
	);

КонецФункции

// Возвращает владельца ресурсов создаваемого экземпляра.
// Для контейнера владельцем является набор.
//
// Параметры:
//  Владелец - ОпределениеТестНабора, ОпределениеТеста - Узел, для которого создается экземпляр
//
//  Возвращаемое значение:
//   - ОпределениеТестНабора - Набор, которому принадлежат ресурсы
//   - ОпределениеТеста - Тест, которому принадлежат ресурсы
//
Функция УзелВладельца(Владелец)

	Если ТипЗнч(Владелец) = Тип("ОпределениеТеста")
		И Владелец.ТипОпределения() = ТипыОпределенийТестов.Контейнер Тогда
		Возврат Владелец.Набор();
	КонецЕсли;

	Возврат Владелец;

КонецФункции

// Создает новый экземпляр тестового набора
//
// Параметры:
//  ОпределениеНабора - ОпределениеТестНабора - Определение набора
//  Владелец - ОпределениеТестНабора, ОпределениеТеста - Узел, в контексте которого
//             поставщики дают значения параметрам конструктора
//
//  Возвращаемое значение:
//   - Произвольный - Экземпляр набора
//   - Неопределено - Экземпляр не создан
//
Функция НовыйЭкземпляр(ОпределениеНабора, Владелец)

	Сигнатура = СигнатураСПоставщиками(ОпределениеНабора);

	Если Не Сигнатура.СодержитЗначение() Тогда
		Возврат _Поделка.НайтиЖелудь(ОпределениеНабора.ИмяЖелудя());
	КонецЕсли;

	Аргументы = Сигнатура.Получить().СоздатьАргументы(Списки.ИзЭлементов());

	ПубликаторСобытий.ОпубликоватьСобытие(Владелец, "ЗаполнениеАргументов", Массивы.ИзЭлементов(Аргументы));

	Возврат _Поделка.НайтиЖелудь(
		ОпределениеНабора.ИмяЖелудя(),
		БлестяшкиКонструктора(Сигнатура.Получить(), Новый Опциональный(Аргументы))
	);

КонецФункции

// Сигнатура конструктора набора, если его параметрам нужны значения поставщиков
//
// Параметры:
//  ОпределениеНабора - ОпределениеТестНабора - Определение набора
//
//  Возвращаемое значение:
//   Опциональный - Сигнатура (СигнатураМетода); пустой - у конструктора нет параметров с поставщиками
//
Функция СигнатураСПоставщиками(ОпределениеНабора)

	Возврат ОпределениеНабора.НайтиСигнатуруКонструктора()
		.Фильтровать("Сигнатура -> Сигнатура.ЕстьПоставщики()");

КонецФункции

// Собирает блестяшки конструктора набора для autumn: параметры с поставщиками
// получают значения поставщиков, прочие блестяшки - Неопределено
//
// Параметры:
//  Сигнатура - СигнатураМетода - Сигнатура конструктора
//  Аргументы - Опциональный - Заполненные аргументы конструктора (АргументыВызова),
//              пустой - параметры с поставщиками получают Неопределено
//
//  Возвращаемое значение:
//   Массив из Произвольный - Блестяшки по порядку параметров
//
Функция БлестяшкиКонструктора(Сигнатура, Аргументы)

	Блестяшки = Новый Массив;
	Индекс    = 0;

	Для Каждого Параметр Из Сигнатура.Метод().Параметры Цикл

		Если Сигнатура.Поставщик(Индекс).СодержитЗначение() Тогда
			Блестяшки.Добавить(?(Аргументы.СодержитЗначение(), Аргументы.Получить().Значение(Индекс), Неопределено));
		ИначеЕсли РаботаСАннотациями.ПолучитьАннотацию(Параметр, "Блестяшка") <> Неопределено Тогда
			Блестяшки.Добавить(Неопределено);
		КонецЕсли;

		Индекс = Индекс + 1;

	КонецЦикла;

	Возврат Блестяшки;

КонецФункции

// Вычисляет выражение с доступом к полям и методам экземпляра набора.
// Параметры конструктора с поставщиками получают Неопределено, а созданный
// для такого конструктора экземпляр не сохраняется как одиночка.
// Если экземпляр не создан, выражение вычисляется без его захвата.
// Возвращает значение выражения и вывод создания и вычисления.
// При ошибке вызывает исключение с перехваченным выводом и причиной отказа создания, если она есть.
//
// Параметры:
//  ОпределениеНабора - ОпределениеТестНабора - Набор, экземпляр которого захватывает лямбда
//  Выражение - Строка - Лямбда-выражение без параметров
//
//  Возвращаемое значение:
//   Структура - Итог вычисления:
//    * Значение - Произвольный - Значение лямбды
//    * Вывод    - Строка - Вывод создания и лямбды
//
Функция ВычислитьНаЭкземпляре(ОпределениеНабора, Знач Выражение) Экспорт

	Вычисление = Лямбда.Выражение(Выражение).Интерфейс(ФункциональныеИнтерфейсы.Вызываемый());

	Создание = ИтогСоздания(ТестированиеСлужебный.ВыполнитьСПерехватомВывода(
		ЭтотОбъект,
		"НайтиЭкземплярБезПоставщиков",
		Списки.ИзЭлементов(ОпределениеНабора)
	));
	Создание.Экземпляр.ЕслиСодержитЗначение(Новый Действие(Вычисление, "ЗахватитьОбъект"));

	Выполнение = ТестированиеСлужебный.ВычислитьСПерехватомВывода(Вычисление);

	Если Выполнение.Ошибка.СодержитЗначение() Тогда

		// Без экземпляра причина - отказ создания, и вывод создания несет он
		Если Создание.Отказ.СодержитЗначение() Тогда
			ВызватьОтказ(Создание, Выполнение.Ошибка.Получить(), Выполнение.Вывод);
		КонецЕсли;

		ТестированиеСлужебный.ВызватьСВыводом(Выполнение.Ошибка.Получить(), Создание.Вывод + Выполнение.Вывод);

	КонецЕсли;

	// Лямбде экземпляр не понадобился: отказ отброшен, и вывод создания остается выводом
	Возврат Новый Структура(
		"Значение, Вывод",
		Выполнение.Значение.Иначе_(Неопределено),
		Создание.Вывод + Выполнение.Вывод
	);

КонецФункции

// Вызывает исключение об отказе создания экземпляра.
// В цепочку причин включает ошибку выполнявшегося кода и причину отказа создания.
// Вывод кода сохраняется в исключении.
//
// Параметры:
//  Создание   - см. Создать
//  ОшибкаКода - ИнформацияОбОшибке - Исключение кода, которому нужен был экземпляр
//  ВыводКода  - Строка - Перехваченный вывод кода: исключение несет его как контекст,
//               см. ТестированиеСлужебный.ВызватьСВыводом; пустая строка - вывод
//               перехватывает вызывающий
//
Процедура ВызватьОтказ(Создание, ОшибкаКода, Знач ВыводКода) Экспорт

	// Звено кода пересоздается с причиной-корнем, но показывает исходную ошибку:
	// ее модуль, строку и стек
	Следствие = ТестированиеСлужебный.ОшибкаСПричиной(ОшибкаКода, Создание.Отказ.Получить().Причина);

	Если ПустаяСтрока(ВыводКода) Тогда
		ВызватьИсключение Новый ИнформацияОбОшибке(
			"Не удаётся инстанцировать тестовый набор",
			Неопределено,
			Следствие
		);
	КонецЕсли;

	ТестированиеСлужебный.ВызватьСВыводом(
		НоваяОшибка("Не удаётся инстанцировать тестовый набор", Неопределено, Следствие),
		ВыводКода
	);

КонецПроцедуры

// Возвращает корень цепочки отказа: сбой поделки с выводом создания, а если сбоя
// не было - перехваченный лог autumn с исключением конструктора
//
// Параметры:
//  Сбой  - Опциональный - Исключение (ИнформацияОбОшибке) поиска желудя набора, пустой - сбоя не было
//  Вывод - Строка - Перехваченный вывод создания
//
//  Возвращаемое значение:
//   ИнформацияОбОшибке - Корень цепочки отказа
//
Функция ПричинаОтказа(Сбой, Знач Вывод)

	Если Сбой.СодержитЗначение() Тогда
		Возврат ТестированиеСлужебный.ОшибкаСВыводом(Сбой.Получить(), Вывод);
	КонецЕсли;

	Вывод = _ПереносРезультатов.РазвернутьЗаписиЛога(Вывод);

	Если Не ЗначениеЗаполнено(СокрЛП(Вывод)) Тогда
		Вывод = "<autumn не вывел причину>";
	КонецЕсли;

	Возврат _ПереносРезультатов.ПричинаСГотовымОписанием(
		"Не удалось создать желудь набора",
		СтрШаблон(
			"
			|По причине:
			|%1
			|",
			Вывод
		)
	);

КонецФункции

// Создает информацию об ошибке с заполненными сведениями о месте возникновения
Функция НоваяОшибка(Знач Описание, Параметры, Причина)

	Попытка
		ВызватьИсключение Новый ИнформацияОбОшибке(Описание, Параметры, Причина);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин Поделка,
	&Пластилин ПереносРезультатов,
	&Пластилин("ПубликаторСобытий") Публикатор)
	_Поделка            = Поделка;
	_ПереносРезультатов = ПереносРезультатов;
	ПубликаторСобытий   = Публикатор;
КонецПроцедуры
