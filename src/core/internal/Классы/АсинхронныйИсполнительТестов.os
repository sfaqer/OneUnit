// Исполнение наборов, контейнеров и тестов в текущей поделке.
// Проверяет условия, создает экземпляры наборов и выполняет методы жизненного цикла
// и тестовые методы. Исполнение дочерних узлов передает диспетчеру.
//
// У компанейского набора отдельные экземпляры используются для условий набора
// и ПередВсеми, для ПослеВсех и для каждого теста с его условиями и методами
// ПередКаждым/ПослеКаждого. Одиночка использует общий экземпляр в пределах прогона.
//
// Для подготовки экземпляра публикуется ИсполнениеЭкземплярНабора,
// для получения аргументов от поставщиков - ЗаполнениеАргументов.
// Вывод обработчиков включается в вывод узла; ошибка подготовки приводит к состоянию Сломан.

#Использовать collectionos
#Использовать "../../../shared"

Перем _ТабакеркаРезультатов;   // Табакерка - Результаты выполнения тестов
Перем _ВызовМетода;            // ВызовМетода - Вызов методов наборов и условий
Перем _ФабрикаЭкземпляров;     // ФабрикаЭкземпляров - Экземпляры тестовых наборов
Перем ПубликаторСобытий;       // ПубликаторСобытий - Подготовка экземпляра и заполнение аргументов
Перем ПроверкаУсловийИзоляции; // ПроверкаУсловийИзоляции - Условия изолированного узла, который не удалось обнаружить
Перем _Диспетчер;              // ДиспетчерТестов - Исполнение дочерних узлов

// Исполняет набор, контейнер или тест.
// Узел с ошибками обнаружения получает состояние Сломан, если не пропущен по условиям.
//
// Параметры:
//  Узел - ОпределениеТестНабора, ОпределениеТеста - Исполняемый узел
//
//  Возвращаемое значение:
//   РезультатВыполненияТеста - Результат узла
//
Функция Исполнить(Узел) Экспорт

    Если Не Узел.ОшибкиОбнаружения().Пусто() Тогда
        Возврат ИсполнитьНеобнаруженный(Узел);
    КонецЕсли;

    Если ТипЗнч(Узел) = Тип("ОпределениеТестНабора") Тогда
        Возврат ИсполнитьНабор(Узел);
    КонецЕсли;

    Если Узел.ТипОпределения() = ТипыОпределенийТестов.Контейнер Тогда
        Возврат ИсполнитьКонтейнер(Узел);
    КонецЕсли;

    Возврат ИсполнитьТест(Узел);

КонецФункции

// Состав набора текущей поделки уже сформирован обнаружителем
//
// Параметры:
//  Набор - ОпределениеТестНабора - Набор плана
//
Процедура Развернуть(Набор) Экспорт // BSLLS:UnusedParameters-off
КонецПроцедуры

Функция ИсполнитьНабор(Набор)

    Исполнение = НачатьИсполнение(Набор, Набор);

    Пропуск = ПропускПоУсловиям(Набор.Условия(), Исполнение);

    Если Пропуск.СодержитЗначение() Тогда
        Возврат Пропуск.Получить();
    КонецЕсли;

    // Отказ создания экземпляра - только после условий: выключенный узел
    // остается пропущенным, даже если экземпляр набора не создается

    Если Исполнение.Состояние <> СостоянияВыполненияТестов.Успех Тогда
        Возврат РезультатИз(Исполнение);
    КонецЕсли;

    ОписаниеЦикла = Набор.ЖизненныйЦикл();
    ПодготовитьКЭтапу(Исполнение, ОписаниеЦикла.ПередВсеми());

    Если Исполнение.Состояние = СостоянияВыполненияТестов.Успех Тогда
        ВызватьМетоды(Исполнение, ОписаниеЦикла.ПередВсеми());
    КонецЕсли;

    Если Исполнение.Состояние = СостоянияВыполненияТестов.Успех Тогда
        _Диспетчер.ИсполнитьДетей(Набор);
    КонецЕсли;

    Если ОписаниеЦикла.ПослеВсех().ТребуетПодготовки() Тогда

        ИсполнениеПослеВсех = НачатьИсполнение(Набор, Набор);

        Если ИсполнениеПослеВсех.Состояние = СостоянияВыполненияТестов.Успех Тогда
            ПодготовитьКЭтапу(ИсполнениеПослеВсех, ОписаниеЦикла.ПослеВсех());
        КонецЕсли;

        Если ИсполнениеПослеВсех.Состояние = СостоянияВыполненияТестов.Успех Тогда
            ВызватьМетоды(ИсполнениеПослеВсех, ОписаниеЦикла.ПослеВсех());
        КонецЕсли;

        ОбъединитьРезультатыВыполнения(Исполнение, ИсполнениеПослеВсех);

    КонецЕсли;

    Если Исполнение.Состояние = СостоянияВыполненияТестов.Успех
        И Набор.Дети().Пусто() Тогда

        Исполнение.Состояние = СостоянияВыполненияТестов.Пропущен;
        Исполнение.Причины.Добавить("В наборе не найдены тесты");

    КонецЕсли;

    Возврат РезультатИз(Исполнение);

КонецФункции

Функция ИсполнитьКонтейнер(Контейнер)

    Проверка = ПроверитьУсловия(Контейнер);

    Если Проверка.Пропуск.СодержитЗначение() Тогда
        Возврат Проверка.Пропуск.Получить();
    КонецЕсли;

    _Диспетчер.ИсполнитьДетей(Контейнер);

    // У контейнера нет своего кода: падения итераций - в их собственных
    // результатах (статистика считает только их), а контейнер, дошедший
    // до итераций, успешен
    Возврат Результат(СостоянияВыполненияТестов.Успех, Списки.ИзЭлементов(), Проверка.Вывод);

КонецФункции

// Формирует результат узла с ошибками обнаружения.
// Если условия не требуют пропуска, возвращает состояние Сломан и ошибки обнаружения.
// Условия изолированного узла проверяет ПроверкаУсловийИзоляции.
//
// Параметры:
//  Узел - ОпределениеТестНабора, ОпределениеТеста - Узел с ошибками обнаружения
//
//  Возвращаемое значение:
//   РезультатВыполненияТеста - Результат узла
//
Функция ИсполнитьНеобнаруженный(Узел)

    Если Узел.Изоляция().СодержитЗначение() Тогда
        Проверка = ПроверкаУсловийИзоляции.Проверить(Узел);
    Иначе
        Проверка = ПроверитьУсловия(Узел);
    КонецЕсли;

    Если Проверка.Пропуск.СодержитЗначение() Тогда
        Возврат Проверка.Пропуск.Получить();
    КонецЕсли;

    Причины = Новый СписокМассив;
    Вывод   = Проверка.Вывод;

    Для Каждого Ошибка Из Узел.ОшибкиОбнаружения() Цикл
        Разбор = ТестированиеСлужебный.РазобратьОшибку(Ошибка);
        Причины.Добавить(Разбор.Причина);
        Вывод = Вывод + Разбор.Вывод;
    КонецЦикла;

    Возврат Результат(СостоянияВыполненияТестов.Сломан, Причины, Вывод);

КонецФункции

// Проверяет условия контейнера или узла с ошибками обнаружения.
// При отсутствии условий возвращает пустой результат проверки.
//
// Параметры:
//  Узел - ОпределениеТестНабора, ОпределениеТеста - Проверяемый узел
//
//  Возвращаемое значение:
//   Структура - Итог проверки:
//    * Пропуск - Опциональный - Результат (РезультатВыполненияТеста) пропуска или упавшего
//                условия, пустой - узел исполняется
//    * Вывод   - Строка - Вывод создания экземпляра и условий
//
Функция ПроверитьУсловия(Узел)

    Проверка = Новый Структура("Пропуск, Вывод", Опциональные.Пустой(), "");

    Если Узел.Условия().Пусто() Тогда
        Возврат Проверка;
    КонецЕсли;

    Набор = ?(ТипЗнч(Узел) = Тип("ОпределениеТестНабора"), Узел, Узел.Набор());

    Исполнение = НачатьИсполнение(Набор, Узел);

    Проверка.Пропуск = ПропускПоУсловиям(Узел.Условия(), Исполнение);
    Проверка.Вывод   = ВыводБезОтказа(Исполнение);

    Возврат Проверка;

КонецФункции

Функция ИсполнитьТест(Тест)

    Набор = Тест.Набор();

    Исполнение = НачатьИсполнение(Набор, Тест);

    Пропуск = ПропускПоУсловиям(Тест.Условия(), Исполнение);

    Если Пропуск.СодержитЗначение() Тогда
        Возврат Пропуск.Получить();
    КонецЕсли;

    // Отказ создания экземпляра - только после условий, как у набора

    Если Исполнение.Состояние <> СостоянияВыполненияТестов.Успех Тогда
        Возврат РезультатИз(Исполнение);
    КонецЕсли;

    // Отказ подготовки, как и отказ создания, не дает вызвать ни один метод теста
    ОписаниеЦикла = Набор.ЖизненныйЦикл();
    ПодготовитьКЭтапу(Исполнение, ОписаниеЦикла.ПередКаждым());

    Если Исполнение.Состояние <> СостоянияВыполненияТестов.Успех Тогда
        Возврат РезультатИз(Исполнение);
    КонецЕсли;

    ВызватьМетоды(Исполнение, ОписаниеЦикла.ПередКаждым());

    Если Исполнение.Состояние = СостоянияВыполненияТестов.Успех Тогда

        ВызватьМетоды(
            Исполнение,
            ОписаниеЦикла.Тест(Тест.ИмяМетода()),
            Тест.Параметры(),
            Тест.Таймаут()
        );

    КонецЕсли;

    ВызватьМетоды(Исполнение, ОписаниеЦикла.ПослеКаждого());

    Возврат РезультатИз(Исполнение);

КонецФункции

// Создает экземпляр набора и начальное состояние исполнения узла.
// При успешном создании сохраняет вывод конструктора; при отказе возвращает
// состояние Сломан с причиной, содержащей вывод создания.
//
// Параметры:
//  Набор - ОпределениеТестНабора - Набор, экземпляр которого создается
//  Узел  - ОпределениеТестНабора, ОпределениеТеста - Исполняемый узел: экземпляр
//          создается для него, и методы набора получают значения поставщиков
//          в его контексте
//
//  Возвращаемое значение:
//   Структура - Исполнение на экземпляре:
//    * Состояние - Строка - Состояние выполнения, см. СостоянияВыполненияТестов;
//                  сразу после создания не Успех - экземпляр не создан
//    * Причины   - СписокМассив из ИнформацияОбОшибке, Строка - Причины состояния
//    * Вывод     - Строка - Перехваченный консольный вывод
//    * Набор     - ОпределениеТестНабора - Набор экземпляра
//    * Узел      - ОпределениеТестНабора, ОпределениеТеста - Исполняемый узел
//    * Создание  - РезультатСозданияЭкземпляра - Результат создания экземпляра
//
Функция НачатьИсполнение(Набор, Узел)

    Создание = _ФабрикаЭкземпляров.СоздатьДляИсполнения(Набор, Узел);

    Исполнение = НовыйРезультатВыполнения();
    Исполнение.Вставить("Набор", Набор);
    Исполнение.Вставить("Узел", Узел);
    Исполнение.Вставить("Создание", Создание);

    Если Создание.Состояние() = СостоянияСозданияЭкземпляра.ОшибкаСоздания Тогда

        Исполнение.Состояние = СостоянияВыполненияТестов.Сломан;
        Исполнение.Причины.Добавить(Создание.Причина());

    Иначе
        Исполнение.Вывод = Создание.Вывод();
    КонецЕсли;

    Возврат Исполнение;

КонецФункции

// Объединяет вывод создания экземпляра и исполнения.
// Используется, когда отказ создания не включается в причины результата.
//
// Параметры:
//  Исполнение - см. НачатьИсполнение
//
//  Возвращаемое значение:
//   Строка - Вывод создания и исполнения
//
Функция ВыводБезОтказа(Исполнение)

    Если Исполнение.Создание.Состояние() = СостоянияСозданияЭкземпляра.ОшибкаСоздания Тогда
        Возврат Исполнение.Создание.Вывод() + Исполнение.Вывод;
    КонецЕсли;

    Возврат Исполнение.Вывод;

КонецФункции

// Публикует событие ИсполнениеЭкземплярНабора после проверки условий узла.
// Сохраняет вывод обработчиков; при исключении устанавливает состояние Сломан.
//
// Параметры:
//  Исполнение - см. НачатьИсполнение
//
Процедура ПодготовитьЭкземпляр(Исполнение)

    Подготовка = ТестированиеСлужебный.ВыполнитьСПерехватомВывода(
        ПубликаторСобытий,
        "ОпубликоватьСобытие",
        Списки.ИзЭлементов(
            Исполнение.Узел,
            "ИсполнениеЭкземплярНабора",
            Массивы.ИзЭлементов(Исполнение.Создание.Экземпляр().Получить())
        )
    );

    Исполнение.Вывод = Исполнение.Вывод + Подготовка.Вывод;

    Если Подготовка.Ошибка.СодержитЗначение() Тогда

        Исполнение.Состояние = СостоянияВыполненияТестов.Сломан;
        Исполнение.Причины.Добавить(Подготовка.Ошибка.Получить());

    КонецЕсли;

КонецПроцедуры

// Готовит экземпляр, если этого требует этап.
//
// Параметры:
//  Исполнение - см. НачатьИсполнение
//  Этап       - ЭтапЖизненногоЦикла - Предстоящий этап
//
Процедура ПодготовитьКЭтапу(Исполнение, Этап)

    Если Этап.ТребуетПодготовки() Тогда
        ПодготовитьЭкземпляр(Исполнение);
    КонецЕсли;

КонецПроцедуры

// Вызывает методы этапа на экземпляре исполнения.
//
// Параметры:
//  Исполнение - см. НачатьИсполнение
//  Этап       - ЭтапЖизненногоЦикла - Вызываемые методы
//  Позиционные - ФиксированныйСписок, Неопределено - Значения параметров, Неопределено - параметров нет
//  Таймаут    - Число, Неопределено - Время на метод в миллисекундах, Неопределено - таймаут набора
//
Процедура ВызватьМетоды(Исполнение, Этап, Позиционные = Неопределено, Знач Таймаут = Неопределено)

    Значения = ?(Позиционные = Неопределено, Списки.ИзЭлементов(), Позиционные);
    ВремяНаМетод = ?(Таймаут = Неопределено, Исполнение.Набор.Таймаут(), Таймаут);

    Для Каждого ИмяМетода Из Этап.Методы() Цикл

        ОбъединитьРезультатыВыполнения(
            Исполнение,
            ВызватьМетодНабора(Исполнение, ИмяМетода, Значения, ВремяНаМетод)
        );

    КонецЦикла;

КонецПроцедуры

// Формирует аргументы и вызывает метод набора с указанным таймаутом.
// Если формирование аргументов завершилось ошибкой, возвращает состояние Сломан
// без вызова метода.
//
// Параметры:
//  Исполнение  - см. НачатьИсполнение
//  ИмяМетода   - Строка - Имя метода
//  Позиционные - ФиксированныйСписок из Произвольный - Позиционные значения вызова
//  Таймаут     - Число - Время на метод в миллисекундах, 0 - без ограничения
//
//  Возвращаемое значение:
//   см. ВызовМетода.Вызвать
//
Функция ВызватьМетодНабора(Исполнение, Знач ИмяМетода, Позиционные, Знач Таймаут)

    Сборка = СобратьАргументы(
        Исполнение.Узел,
        Исполнение.Набор.Сигнатура(ИмяМетода).СоздатьАргументы(Позиционные)
    );

    Если Сборка.Ошибка.СодержитЗначение() Тогда

        Возврат Новый Структура(
            "Состояние, Причины, Вывод",
            СостоянияВыполненияТестов.Сломан,
            Списки.ИзЭлементов(Сборка.Ошибка.Получить()),
            Сборка.Вывод
        );

    КонецЕсли;

    Вызов = _ВызовМетода.Вызвать(
        Исполнение.Создание.Экземпляр().Получить(),
        ИмяМетода,
        Сборка.Значение.Получить(),
        Таймаут
    );

    Вызов.Вывод = Сборка.Вывод + Вызов.Вывод;

    Возврат Вызов;

КонецФункции

// Формирует список аргументов вызова.
// При наличии параметров с поставщиками публикует событие ЗаполнениеАргументов
// и перехватывает вывод и исключения обработчиков.
//
// Параметры:
//  Узел      - ОпределениеТестНабора, ОпределениеТеста - Исполняемый узел
//  Аргументы - АргументыВызова - Аргументы вызова
//
//  Возвращаемое значение:
//   Структура - Итог формирования аргументов:
//    * Значение - Опциональный - Список аргументов (ФиксированныйСписок); пустой при ошибке
//    * Вывод    - Строка - Вывод обработчиков заполнения
//    * Ошибка   - Опциональный - Исключение (ИнформацияОбОшибке); пустой при успешном заполнении
//
Функция СобратьАргументы(Узел, Аргументы)

    Если Не Аргументы.ТребуютЗаполнения() Тогда
        Возврат Новый Структура(
            "Значение, Вывод, Ошибка",
            Новый Опциональный(Аргументы.Значения()),
            "",
            Опциональные.Пустой()
        );
    КонецЕсли;

    Возврат ТестированиеСлужебный.ВыполнитьСПерехватомВывода(
        ЭтотОбъект,
        "ЗаполнитьАргументы",
        Списки.ИзЭлементов(Узел, Аргументы)
    );

КонецФункции

// Публикует событие ЗаполнениеАргументов и возвращает заполненный список аргументов
//
// Параметры:
//  Узел      - ОпределениеТестНабора, ОпределениеТеста - Исполняемый узел
//  Аргументы - АргументыВызова - Аргументы вызова
//
//  Возвращаемое значение:
//   см. АргументыВызова.Значения
//
Функция ЗаполнитьАргументы(Узел, Аргументы) Экспорт
    ПубликаторСобытий.ОпубликоватьСобытие(Узел, "ЗаполнениеАргументов", Массивы.ИзЭлементов(Аргументы));
    Возврат Аргументы.Значения();
КонецФункции

// Проверяет условия набора или теста на экземпляре исполнения.
// Возвращает результат пропуска или ошибки условия. Вывод условий включается
// в этот результат либо в вывод продолжающегося исполнения.
//
// Параметры:
//  Условия    - ФиксированныйСписок, СписокМассив из Произвольный - Объекты аннотаций условий
//  Исполнение - см. НачатьИсполнение
//
//  Возвращаемое значение:
//   Опциональный - Результат (РезультатВыполненияТеста) пропуска или упавшего условия,
//                  пустой - определение выполняется
//
Функция ПропускПоУсловиям(Условия, Исполнение)

    Если Условия.Пусто() Тогда
        Возврат Опциональные.Пустой();
    КонецЕсли;

    Проверка = _ВызовМетода.Вызвать(
        ЭтотОбъект,
        "ПропуститьОпределение",
        Списки.ИзЭлементов(Условия, Исполнение.Создание),
        0
    );

    Если Проверка.Состояние <> СостоянияВыполненияТестов.Успех Тогда
        Возврат Новый Опциональный(Результат(
            Проверка.Состояние,
            Проверка.Причины,
            Исполнение.Вывод + Проверка.Вывод
        ));
    КонецЕсли;

    Решение = Проверка.Значение.Получить();

    Если Решение.Пропустить Тогда
        // Пропущенному узлу отказ создания не причина - вывод создания остается
        Возврат Новый Опциональный(Результат(
            СостоянияВыполненияТестов.Пропущен,
            Списки.ИзЭлементов(Решение.Причина),
            ВыводБезОтказа(Исполнение) + Проверка.Вывод
        ));
    КонецЕсли;

    Исполнение.Вывод = Исполнение.Вывод + Проверка.Вывод;

    Возврат Опциональные.Пустой();

КонецФункции

// Проверяет условия узла и возвращает решение о пропуске
//
// Параметры:
//  Условия  - ФиксированныйСписок, СписокМассив из Произвольный - Объекты аннотаций условий
//  Создание - РезультатСозданияЭкземпляра - экземпляра может не быть:
//             условию без обращения к набору экземпляр не нужен
//
//  Возвращаемое значение:
//   Структура - Решение по условиям:
//    * Пропустить - Булево - Истина - определение пропускается
//    * Причина    - Строка - Причина пропуска
//
Функция ПропуститьОпределение(Условия, Создание) Экспорт

    Результат = Новый Структура("Пропустить, Причина", Ложь, "");

    Попытка

        Причина = Условия
            .ПроцессорКоллекции()
            .Обработать("Условие -> Условие.Выполнять(Экземпляр)", Новый Структура("Экземпляр", Создание.Экземпляр()))
            .Фильтровать("Выполнять -> Выполнять.Результат = Ложь")
            .Обработать("Выполнять -> Выполнять.Причина")
            .ПолучитьПервый();

    Исключение

        // Причина - отказ создания, только если экземпляр создать не удалось,
        // а не если его и не создавали

        Если Создание.Состояние() <> СостоянияСозданияЭкземпляра.ОшибкаСоздания Тогда
            ВызватьИсключение;
        КонецЕсли;

        // Вывод условий перехватывает ВызовМетода
        _ФабрикаЭкземпляров.ВызватьОтказ(Создание, ИнформацияОбОшибке(), "");

    КонецПопытки;

    Если ЗначениеЗаполнено(Причина) Тогда

        Результат.Пропустить = Истина;
        Результат.Причина    = Причина;

    КонецЕсли;

    Возврат Результат;

КонецФункции

Функция НовыйРезультатВыполнения()

    Возврат Новый Структура(
        "Состояние, Причины, Вывод",
        СостоянияВыполненияТестов.Успех,
        Новый СписокМассив,
        ""
    );

КонецФункции

Процедура ОбъединитьРезультатыВыполнения(Первый, Второй)

    Первый.Состояние = СостоянияВыполненияТестов.НаихудшееСостояние(
        Первый.Состояние,
        Второй.Состояние
    );

    Первый.Причины.ДобавитьВсе(Второй.Причины);
    Первый.Вывод = Первый.Вывод + Второй.Вывод;

КонецПроцедуры

Функция РезультатИз(РезультатВыполнения)

    Возврат Результат(
        РезультатВыполнения.Состояние,
        РезультатВыполнения.Причины,
        РезультатВыполнения.Вывод
    );

КонецФункции

Функция Результат(Знач Состояние, Причины, Знач Вывод)
    Возврат _ТабакеркаРезультатов.Достать(Массивы.ИзЭлементов(Состояние, Причины, Вывод));
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
    &Табакерка &Пластилин("РезультатВыполненияТеста") ТабакеркаРезультатов,
    &Пластилин ВызовМетода,
    &Пластилин ФабрикаЭкземпляров,
    &Пластилин("ПубликаторСобытий") Публикатор,
    &Пластилин("ПроверкаУсловийИзоляции") ПроверкаУсловий,
    &Пластилин ДиспетчерТестов)

    _ТабакеркаРезультатов   = ТабакеркаРезультатов;
    _ВызовМетода            = ВызовМетода;
    _ФабрикаЭкземпляров     = ФабрикаЭкземпляров;
    ПубликаторСобытий       = Публикатор;
    ПроверкаУсловийИзоляции = ПроверкаУсловий;
    _Диспетчер              = ДиспетчерТестов;

КонецПроцедуры
