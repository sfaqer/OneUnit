// Исполняет узлы тест-плана в текущей поделке: условия, создание экземпляра
// набора, методы жизненного цикла и тестовые методы. Возвращает результат узла,
// события исполнения публикует диспетчер; детей набора и контейнера исполнитель
// отдает обратно диспетчеру.

#Использовать collectionos

Перем _ТабакеркаРезультатов; // Табакерка - Результаты выполнения тестов
Перем _ВызовМетода;          // ВызовМетода - Вызов методов наборов и условий
Перем _ФабрикаЭкземпляров;   // ФабрикаЭкземпляров - Экземпляры тестовых наборов
Перем _Диспетчер;            // ДиспетчерТестов - Диспетчер, которому отдаются дети узла

// Исполняет набор или тест
//
// Параметры:
//  Узел - ОпределениеТестНабора, ОпределениеТеста - Исполняемый узел
//
//  Возвращаемое значение:
//   РезультатВыполненияТеста - Результат узла
//
Функция Исполнить(Узел) Экспорт

    Если ТипЗнч(Узел) = Тип("ОпределениеТестНабора") Тогда
        Возврат ИсполнитьНабор(Узел);
    КонецЕсли;

    Возврат ИсполнитьТест(Узел);

КонецФункции

Функция ИсполнитьНабор(Набор)

    Пропуск = ПропускПоУсловиям(Набор);

    Если Пропуск.СодержитЗначение() Тогда
        Возврат Пропуск.Получить();
    КонецЕсли;

    Отказ = ОтказСоздания(Набор);

    Если Отказ.СодержитЗначение() Тогда
        Возврат Отказ.Получить();
    КонецЕсли;

    РезультатВыполнения = НовыйРезультатВыполнения();

    ОбъединитьРезультатыВыполнения(
        РезультатВыполнения,
        ОбработатьСобытияНабора(Набор, Набор.ПередВсеми())
    );

    Если РезультатВыполнения.Состояние = СостоянияВыполненияТестов.Успех Тогда
        _Диспетчер.ИсполнитьДетей(Набор);
    КонецЕсли;

    ОбъединитьРезультатыВыполнения(
        РезультатВыполнения,
        ОбработатьСобытияНабора(Набор, Набор.ПослеВсех())
    );

    Если РезультатВыполнения.Состояние = СостоянияВыполненияТестов.Успех
        И Набор.Дети().Пусто() Тогда
        РезультатВыполнения.Состояние = СостоянияВыполненияТестов.Пропущен;
        РезультатВыполнения.Причины.Добавить("В наборе не найдены тесты");
    КонецЕсли;

    Возврат РезультатИз(РезультатВыполнения);

КонецФункции

Функция ИсполнитьТест(Тест)

    Пропуск = ПропускПоУсловиям(Тест);

    Если Пропуск.СодержитЗначение() Тогда
        Возврат Пропуск.Получить();
    КонецЕсли;

    Если Тест.ТипОпределения() = ТипыОпределенийТестов.Контейнер Тогда

        _Диспетчер.ИсполнитьДетей(Тест);

        // Контейнер всегда зелёный
        Возврат Результат(СостоянияВыполненияТестов.Успех, Списки.ИзЭлементов(), "");

    КонецЕсли;

    Набор = Тест.Набор();

    РезультатВыполнения = НовыйРезультатВыполнения();

    ТестНабор = _ФабрикаЭкземпляров.Экземпляр(Набор).Получить();

    Для Каждого ИмяМетода Из Набор.ПередКаждым() Цикл

        ОбъединитьРезультатыВыполнения(
            РезультатВыполнения,
            _ВызовМетода.Вызвать(
                ТестНабор,
                ИмяМетода,
                Списки.ИзЭлементов(),
                Набор.Таймаут()
            )
        );

    КонецЦикла;

    Если РезультатВыполнения.Состояние = СостоянияВыполненияТестов.Успех Тогда

        ОбъединитьРезультатыВыполнения(
            РезультатВыполнения,
            _ВызовМетода.Вызвать(
                ТестНабор,
                Тест.ИмяМетода(),
                Тест.Параметры(),
                Тест.Таймаут()
            )
        );

    КонецЕсли;

    Для Каждого ИмяМетода Из Набор.ПослеКаждого() Цикл

        ОбъединитьРезультатыВыполнения(
            РезультатВыполнения,
            _ВызовМетода.Вызвать(
                ТестНабор,
                ИмяМетода,
                Списки.ИзЭлементов(),
                Набор.Таймаут()
            )
        );

    КонецЦикла;

    Возврат РезультатИз(РезультатВыполнения);

КонецФункции

Функция ОбработатьСобытияНабора(Набор, События)

    Результат = НовыйРезультатВыполнения();

    ТестНабор = _ФабрикаЭкземпляров.Экземпляр(Набор).Получить();

    Для Каждого ИмяМетода Из События Цикл

        ОбъединитьРезультатыВыполнения(
            Результат,
            _ВызовМетода.Вызвать(
                ТестНабор,
                ИмяМетода,
                Списки.ИзЭлементов(),
                Набор.Таймаут()
            )
        );

    КонецЦикла;

    Возврат Результат;

КонецФункции

// Проверяет условия набора или теста
//
// Параметры:
//  Определение - ОпределениеТестНабора, ОпределениеТеста - Проверяемое определение
//
//  Возвращаемое значение:
//   Опциональный - Результат (РезультатВыполненияТеста) пропуска или упавшего условия,
//                  пустой - определение выполняется
//
Функция ПропускПоУсловиям(Определение)

    Проверка = _ВызовМетода.Вызвать(ЭтотОбъект, "ПропуститьОпределение", Списки.ИзЭлементов(Определение), 0);

    Если Проверка.Состояние <> СостоянияВыполненияТестов.Успех Тогда
        Возврат Новый Опциональный(Результат(Проверка.Состояние, Проверка.Причины, Проверка.Вывод));
    КонецЕсли;

    Решение = Проверка.Значение.Получить();

    Если Решение.Пропустить Тогда
        Возврат Новый Опциональный(Результат(
            СостоянияВыполненияТестов.Пропущен,
            Списки.ИзЭлементов(Решение.Причина),
            ""
        ));
    КонецЕсли;

    Возврат Опциональные.Пустой();

КонецФункции

// Проверяет условия определения на экземпляре его набора. Экспортная, потому
// что вызывается через ВызовМетода
//
// Параметры:
//  Определение - ОпределениеТестНабора, ОпределениеТеста - Проверяемое определение
//
//  Возвращаемое значение:
//   Структура - Решение по условиям:
//    * Пропустить - Булево - Истина - определение пропускается
//    * Причина    - Строка - Причина пропуска
//
Функция ПропуститьОпределение(Определение) Экспорт

    Результат = Новый Структура("Пропустить, Причина", Ложь, "");

    Причина = Определение.Условия()
        .ПроцессорКоллекции()
        .Обработать("Условие -> Условие.Выполнять(Экземпляр)",
            Новый Структура("Экземпляр", _ФабрикаЭкземпляров.Экземпляр(Определение.Набор())))
        .Фильтровать("Выполнять -> Выполнять.Результат = Ложь")
        .Обработать("Выполнять -> Выполнять.Причина")
        .ПолучитьПервый();

    Если ЗначениеЗаполнено(Причина) Тогда

        Результат.Пропустить = Истина;
        Результат.Причина    = Причина;

    КонецЕсли;

    Возврат Результат;

КонецФункции

// Проверяет, что экземпляр набора создается
//
// Параметры:
//  Набор - ОпределениеТестНабора - Проверяемый набор
//
//  Возвращаемое значение:
//   Опциональный - Сломанный результат (РезультатВыполненияТеста), пустой - экземпляр создается
//
Функция ОтказСоздания(Набор)

    Создание = _ВызовМетода.Вызвать(_ФабрикаЭкземпляров, "Экземпляр", Списки.ИзЭлементов(Набор), 0);

    Если Создание.Состояние <> СостоянияВыполненияТестов.Успех Тогда
        Возврат Новый Опциональный(Результат(Создание.Состояние, Создание.Причины, Создание.Вывод));
    КонецЕсли;

    Если Создание.Значение.Получить().СодержитЗначение() Тогда
        Возврат Опциональные.Пустой();
    КонецЕсли;

    Попытка
        ВызватьИсключение "Не удаётся инстанцировать тестовый набор";
    Исключение
        Причина = ИнформацияОбОшибке();
    КонецПопытки;

    Возврат Новый Опциональный(Результат(
        СостоянияВыполненияТестов.Сломан,
        Списки.ИзЭлементов(Причина),
        Создание.Вывод
    ));

КонецФункции

Функция НовыйРезультатВыполнения()

    Возврат Новый Структура(
        "Состояние, Причины, Вывод",
        СостоянияВыполненияТестов.Успех,
        Новый СписокМассив,
        ""
    );

КонецФункции

Процедура ОбъединитьРезультатыВыполнения(Первый, Второй)

    Первый.Состояние = СостоянияВыполненияТестов.НаихудшееСостояние(
        Первый.Состояние,
        Второй.Состояние
    );

    Первый.Причины.ДобавитьВсе(Второй.Причины);
    Первый.Вывод = Первый.Вывод + Второй.Вывод;

КонецПроцедуры

Функция РезультатИз(РезультатВыполнения)

    Возврат Результат(
        РезультатВыполнения.Состояние,
        РезультатВыполнения.Причины,
        РезультатВыполнения.Вывод
    );

КонецФункции

Функция Результат(Знач Состояние, Причины, Знач Вывод)
    Возврат _ТабакеркаРезультатов.Достать(Массивы.ИзЭлементов(Состояние, Причины, Вывод));
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
    &Табакерка &Пластилин("РезультатВыполненияТеста") ТабакеркаРезультатов,
    &Пластилин ВызовМетода,
    &Пластилин ФабрикаЭкземпляров,
    &Пластилин ДиспетчерТестов)

    _ТабакеркаРезультатов = ТабакеркаРезультатов;
    _ВызовМетода          = ВызовМетода;
    _ФабрикаЭкземпляров   = ФабрикаЭкземпляров;
    _Диспетчер            = ДиспетчерТестов;

КонецПроцедуры
