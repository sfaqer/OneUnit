// Исполняет узлы тест-плана в текущей поделке: условия, создание экземпляра
// набора, методы жизненного цикла и тестовые методы. Возвращает результат узла,
// события исполнения публикует диспетчер; детей набора и контейнера исполнитель
// отдает обратно диспетчеру.
//
// Экземпляры компанейского набора: один - на условия набора и ПередВсеми, свой -
// на ПослеВсех, по одному на тест - на его условия, ПередКаждым, сам тест
// и ПослеКаждого. У одиночки фабрика каждый раз отдает один и тот же экземпляр.

#Использовать collectionos
#Использовать "../../../shared"

Перем _ТабакеркаРезультатов; // Табакерка - Результаты выполнения тестов
Перем _ВызовМетода;          // ВызовМетода - Вызов методов наборов и условий
Перем _ФабрикаЭкземпляров;   // ФабрикаЭкземпляров - Экземпляры тестовых наборов
Перем _Диспетчер;            // ДиспетчерТестов - Диспетчер, которому отдаются дети узла

// Исполняет набор или тест. Узел, который не удалось обнаружить, не исполняется:
// если условия его не выключили, он сломан своими ошибками обнаружения
//
// Параметры:
//  Узел - ОпределениеТестНабора, ОпределениеТеста - Исполняемый узел
//
//  Возвращаемое значение:
//   РезультатВыполненияТеста - Результат узла
//
Функция Исполнить(Узел) Экспорт

    Если Не Узел.ОшибкиОбнаружения().Пусто() Тогда
        Возврат ИсполнитьНеобнаруженный(Узел);
    КонецЕсли;

    Если ТипЗнч(Узел) = Тип("ОпределениеТестНабора") Тогда
        Возврат ИсполнитьНабор(Узел);
    КонецЕсли;

    Если Узел.ТипОпределения() = ТипыОпределенийТестов.Контейнер Тогда
        Возврат ИсполнитьКонтейнер(Узел);
    КонецЕсли;

    Возврат ИсполнитьТест(Узел);

КонецФункции

// Разворачивает состав набора для чистого обнаружения: состав набора текущей
// поделки обнаружитель уже внес в план
//
// Параметры:
//  Набор - ОпределениеТестНабора - Набор плана
//
Процедура Развернуть(Набор) Экспорт // BSLLS:UnusedParameters-off
КонецПроцедуры

Функция ИсполнитьНабор(Набор)

    Исполнение = НачатьИсполнение(Набор);

    Пропуск = ПропускПоУсловиям(Набор.Условия(), Исполнение);

    Если Пропуск.СодержитЗначение() Тогда
        Возврат Пропуск.Получить();
    КонецЕсли;

    // Отказ создания экземпляра - только после условий: выключенный узел
    // остается пропущенным, даже если экземпляр набора не создается
    Если Исполнение.Состояние <> СостоянияВыполненияТестов.Успех Тогда
        Возврат РезультатИз(Исполнение);
    КонецЕсли;

    ВызватьМетоды(Исполнение, Набор.ПередВсеми(), Набор.Таймаут());

    Если Исполнение.Состояние = СостоянияВыполненияТестов.Успех Тогда
        _Диспетчер.ИсполнитьДетей(Набор);
    КонецЕсли;

    Если Не Набор.ПослеВсех().Пусто() Тогда

        ИсполнениеПослеВсех = НачатьИсполнение(Набор);

        Если ИсполнениеПослеВсех.Состояние = СостоянияВыполненияТестов.Успех Тогда
            ВызватьМетоды(ИсполнениеПослеВсех, Набор.ПослеВсех(), Набор.Таймаут());
        КонецЕсли;

        ОбъединитьРезультатыВыполнения(Исполнение, ИсполнениеПослеВсех);

    КонецЕсли;

    Если Исполнение.Состояние = СостоянияВыполненияТестов.Успех
        И Набор.Дети().Пусто() Тогда
        Исполнение.Состояние = СостоянияВыполненияТестов.Пропущен;
        Исполнение.Причины.Добавить("В наборе не найдены тесты");
    КонецЕсли;

    Возврат РезультатИз(Исполнение);

КонецФункции

Функция ИсполнитьКонтейнер(Контейнер)

    Проверка = ПроверитьУсловия(Контейнер);

    Если Проверка.Пропуск.СодержитЗначение() Тогда
        Возврат Проверка.Пропуск.Получить();
    КонецЕсли;

    _Диспетчер.ИсполнитьДетей(Контейнер);

    // У контейнера нет своего кода: падения итераций - в их собственных
    // результатах (статистика считает только их), а контейнер, дошедший
    // до итераций, успешен
    Возврат Результат(СостоянияВыполненияТестов.Успех, Списки.ИзЭлементов(), Проверка.Вывод);

КонецФункции

// Узел, который не удалось обнаружить, сломан своими ошибками обнаружения, если
// его не выключили условия: выключенный узел остается пропущенным, как и при
// отказе создания экземпляра. Вывод, который несут ошибки, уходит в вывод результата
//
// Параметры:
//  Узел - ОпределениеТестНабора, ОпределениеТеста - Узел с ошибками обнаружения
//
//  Возвращаемое значение:
//   РезультатВыполненияТеста - Результат узла
//
Функция ИсполнитьНеобнаруженный(Узел)

    Проверка = ПроверитьУсловия(Узел);

    Если Проверка.Пропуск.СодержитЗначение() Тогда
        Возврат Проверка.Пропуск.Получить();
    КонецЕсли;

    Причины = Новый СписокМассив;
    Вывод   = Проверка.Вывод;

    Для Каждого Ошибка Из Узел.ОшибкиОбнаружения() Цикл
        Разбор = ТестированиеСлужебный.РазобратьОшибку(Ошибка);
        Причины.Добавить(Разбор.Причина);
        Вывод = Вывод + Разбор.Вывод;
    КонецЦикла;

    Возврат Результат(СостоянияВыполненияТестов.Сломан, Причины, Вывод);

КонецФункции

// Проверяет условия узла, которому экземпляр набора нужен только для них: контейнеру
// и узлу, который не удалось обнаружить. Отказ создания экземпляра такому узлу
// не причина, и вывод создания уходит в вывод узла
//
// Параметры:
//  Узел - ОпределениеТестНабора, ОпределениеТеста - Проверяемый узел
//
//  Возвращаемое значение:
//   Структура - Итог проверки:
//    * Пропуск - Опциональный - Результат (РезультатВыполненияТеста) пропуска или упавшего
//                условия, пустой - узел исполняется
//    * Вывод   - Строка - Вывод создания экземпляра и условий
//
Функция ПроверитьУсловия(Узел)

    Проверка = Новый Структура("Пропуск, Вывод", Опциональные.Пустой(), "");

    Если Узел.Условия().Пусто() Тогда
        Возврат Проверка;
    КонецЕсли;

    Набор = ?(ТипЗнч(Узел) = Тип("ОпределениеТестНабора"), Узел, Узел.Набор());

    Исполнение = НачатьИсполнение(Набор);

    Проверка.Пропуск = ПропускПоУсловиям(Узел.Условия(), Исполнение);
    Проверка.Вывод   = ВыводБезОтказа(Исполнение);

    Возврат Проверка;

КонецФункции

Функция ИсполнитьТест(Тест)

    Набор = Тест.Набор();

    Исполнение = НачатьИсполнение(Набор);

    Пропуск = ПропускПоУсловиям(Тест.Условия(), Исполнение);

    Если Пропуск.СодержитЗначение() Тогда
        Возврат Пропуск.Получить();
    КонецЕсли;

    // Отказ создания экземпляра - только после условий, как у набора
    Если Исполнение.Состояние <> СостоянияВыполненияТестов.Успех Тогда
        Возврат РезультатИз(Исполнение);
    КонецЕсли;

    ВызватьМетоды(Исполнение, Набор.ПередКаждым(), Набор.Таймаут());

    Если Исполнение.Состояние = СостоянияВыполненияТестов.Успех Тогда

        ОбъединитьРезультатыВыполнения(
            Исполнение,
            _ВызовМетода.Вызвать(
                Исполнение.Создание.Экземпляр.Получить(),
                Тест.ИмяМетода(),
                Тест.Параметры(),
                Тест.Таймаут()
            )
        );

    КонецЕсли;

    ВызватьМетоды(Исполнение, Набор.ПослеКаждого(), Набор.Таймаут());

    Возврат РезультатИз(Исполнение);

КонецФункции

// Создает экземпляр набора и начинает исполнение на нем: вывод конструктора
// попадает в вывод узла, отказ создания - в его причины, и тогда вывод создания
// несет отказ
//
// Параметры:
//  Набор - ОпределениеТестНабора - Набор, экземпляр которого создается
//
//  Возвращаемое значение:
//   Структура - Исполнение на экземпляре:
//    * Состояние - Строка - Состояние выполнения, см. СостоянияВыполненияТестов;
//                  сразу после создания не Успех - экземпляр не создан
//    * Причины   - СписокМассив из ИнформацияОбОшибке, Строка - Причины состояния
//    * Вывод     - Строка - Перехваченный консольный вывод
//    * Создание  - см. ФабрикаЭкземпляров.Создать
//
Функция НачатьИсполнение(Набор)

    Создание = _ФабрикаЭкземпляров.Создать(Набор);

    Исполнение = НовыйРезультатВыполнения();
    Исполнение.Вставить("Создание", Создание);

    Если Создание.Отказ.СодержитЗначение() Тогда
        Исполнение.Состояние = СостоянияВыполненияТестов.Сломан;
        Исполнение.Причины.Добавить(Создание.Отказ.Получить());
    Иначе
        Исполнение.Вывод = Создание.Вывод;
    КонецЕсли;

    Возврат Исполнение;

КонецФункции

// Возвращает вывод исполнения, отказ создания которого не стал причиной результата
// (узел пропущен условием, контейнеру экземпляр не понадобился): вывод создания
// несет отказ, и отброшенный отказ отдает его выводу исполнения
//
// Параметры:
//  Исполнение - см. НачатьИсполнение
//
//  Возвращаемое значение:
//   Строка - Вывод создания и исполнения
//
Функция ВыводБезОтказа(Исполнение)

    Если Исполнение.Создание.Отказ.СодержитЗначение() Тогда
        Возврат Исполнение.Создание.Вывод + Исполнение.Вывод;
    КонецЕсли;

    Возврат Исполнение.Вывод;

КонецФункции

// Вызывает методы жизненного цикла на экземпляре исполнения
//
// Параметры:
//  Исполнение   - см. НачатьИсполнение
//  ИменаМетодов - ФиксированныйСписок из Строка - Имена методов
//  Таймаут      - Число - Время на каждый метод в миллисекундах, 0 - без ограничения
//
Процедура ВызватьМетоды(Исполнение, ИменаМетодов, Знач Таймаут)

    Для Каждого ИмяМетода Из ИменаМетодов Цикл

        ОбъединитьРезультатыВыполнения(
            Исполнение,
            _ВызовМетода.Вызвать(
                Исполнение.Создание.Экземпляр.Получить(),
                ИмяМетода,
                Списки.ИзЭлементов(),
                Таймаут
            )
        );

    КонецЦикла;

КонецПроцедуры

// Проверяет условия набора или теста на экземпляре исполнения. Вывод условий
// не теряется: он в результате пропуска, а если определение выполняется -
// дополняет вывод исполнения
//
// Параметры:
//  Условия    - ФиксированныйСписок, СписокМассив из Произвольный - Объекты аннотаций условий
//  Исполнение - см. НачатьИсполнение
//
//  Возвращаемое значение:
//   Опциональный - Результат (РезультатВыполненияТеста) пропуска или упавшего условия,
//                  пустой - определение выполняется
//
Функция ПропускПоУсловиям(Условия, Исполнение)

    Если Условия.Пусто() Тогда
        Возврат Опциональные.Пустой();
    КонецЕсли;

    Проверка = _ВызовМетода.Вызвать(
        ЭтотОбъект,
        "ПропуститьОпределение",
        Списки.ИзЭлементов(Условия, Исполнение.Создание),
        0
    );

    Если Проверка.Состояние <> СостоянияВыполненияТестов.Успех Тогда
        Возврат Новый Опциональный(Результат(
            Проверка.Состояние,
            Проверка.Причины,
            Исполнение.Вывод + Проверка.Вывод
        ));
    КонецЕсли;

    Решение = Проверка.Значение.Получить();

    Если Решение.Пропустить Тогда
        // Пропущенному узлу отказ создания не причина - вывод создания остается
        Возврат Новый Опциональный(Результат(
            СостоянияВыполненияТестов.Пропущен,
            Списки.ИзЭлементов(Решение.Причина),
            ВыводБезОтказа(Исполнение) + Проверка.Вывод
        ));
    КонецЕсли;

    Исполнение.Вывод = Исполнение.Вывод + Проверка.Вывод;

    Возврат Опциональные.Пустой();

КонецФункции

// Проверяет условия определения на экземпляре его набора. Экспортная, потому
// что вызывается через ВызовМетода
//
// Параметры:
//  Условия  - ФиксированныйСписок, СписокМассив из Произвольный - Объекты аннотаций условий
//  Создание - см. ФабрикаЭкземпляров.Создать - экземпляра может не быть:
//             условию без обращения к набору экземпляр не нужен
//
//  Возвращаемое значение:
//   Структура - Решение по условиям:
//    * Пропустить - Булево - Истина - определение пропускается
//    * Причина    - Строка - Причина пропуска
//
Функция ПропуститьОпределение(Условия, Создание) Экспорт

    Результат = Новый Структура("Пропустить, Причина", Ложь, "");

    Попытка

        Причина = Условия
            .ПроцессорКоллекции()
            .Обработать("Условие -> Условие.Выполнять(Экземпляр)", Новый Структура("Экземпляр", Создание.Экземпляр))
            .Фильтровать("Выполнять -> Выполнять.Результат = Ложь")
            .Обработать("Выполнять -> Выполнять.Причина")
            .ПолучитьПервый();

    Исключение

        // Причина - отказ создания, только если экземпляр создать не удалось,
        // а не если его и не создавали
        Если Не Создание.Отказ.СодержитЗначение() Тогда
            ВызватьИсключение;
        КонецЕсли;

        // Вывод условий перехватывает ВызовМетода
        _ФабрикаЭкземпляров.ВызватьОтказ(Создание, ИнформацияОбОшибке(), "");

    КонецПопытки;

    Если ЗначениеЗаполнено(Причина) Тогда

        Результат.Пропустить = Истина;
        Результат.Причина    = Причина;

    КонецЕсли;

    Возврат Результат;

КонецФункции

Функция НовыйРезультатВыполнения()

    Возврат Новый Структура(
        "Состояние, Причины, Вывод",
        СостоянияВыполненияТестов.Успех,
        Новый СписокМассив,
        ""
    );

КонецФункции

Процедура ОбъединитьРезультатыВыполнения(Первый, Второй)

    Первый.Состояние = СостоянияВыполненияТестов.НаихудшееСостояние(
        Первый.Состояние,
        Второй.Состояние
    );

    Первый.Причины.ДобавитьВсе(Второй.Причины);
    Первый.Вывод = Первый.Вывод + Второй.Вывод;

КонецПроцедуры

Функция РезультатИз(РезультатВыполнения)

    Возврат Результат(
        РезультатВыполнения.Состояние,
        РезультатВыполнения.Причины,
        РезультатВыполнения.Вывод
    );

КонецФункции

Функция Результат(Знач Состояние, Причины, Знач Вывод)
    Возврат _ТабакеркаРезультатов.Достать(Массивы.ИзЭлементов(Состояние, Причины, Вывод));
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
    &Табакерка &Пластилин("РезультатВыполненияТеста") ТабакеркаРезультатов,
    &Пластилин ВызовМетода,
    &Пластилин ФабрикаЭкземпляров,
    &Пластилин ДиспетчерТестов)

    _ТабакеркаРезультатов = ТабакеркаРезультатов;
    _ВызовМетода          = ВызовМетода;
    _ФабрикаЭкземпляров   = ФабрикаЭкземпляров;
    _Диспетчер            = ДиспетчерТестов;

КонецПроцедуры
