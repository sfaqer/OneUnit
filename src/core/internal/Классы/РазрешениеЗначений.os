// Служба поставщиков значений параметров и полей тестовых наборов.
// При обнаружении формирует сигнатуры методов и описания полей.
// При исполнении обрабатывает события ЗаполнениеАргументов и ИсполнениеЭкземплярНабора.

#Использовать annotations
#Использовать collectionos
#Использовать fluent
#Использовать "../../../shared"

Перем Поделка;                       // Поделка - Среда регистрации поставщиков
Перем ПереносРезультатов;            // ПереносРезультатов - Причина отказа создания поставщика из лога autumn
Перем РазворачивательАннотаций;      // РазворачивательАннотаций - Мета-аннотации аннотаций параметров и полей
Перем ТабакеркаСигнатур;             // Табакерка - Сигнатуры методов
Перем ТабакеркаКонтекстовПараметров; // Табакерка - Контексты параметров для поставщиков
Перем ТабакеркаКонтекстовПолей;      // Табакерка - Контексты полей для поставщиков

// Читает сигнатуры методов и описания полей с поставщиками значений.
// Ошибки объявления возвращаются отдельно для каждого метода и поля.
// Регистрация поставщиков проверяется методами ОшибкаРегистрации и ОшибкаРегистрацииПоля.
//
// Параметры:
//  ОпределениеЖелудя - ОпределениеЖелудя - Определение желудя набора
//
//  Возвращаемое значение:
//   Структура - Чтение сигнатур:
//    * Сигнатуры   - КартаСоответствие из КлючИЗначение - Сигнатуры методов с верным объявлением:
//       ** Ключ     - Строка - Имя метода
//       ** Значение - СигнатураМетода - Сигнатура метода
//    * Ошибки      - КартаСоответствие из КлючИЗначение - Ошибки объявления остальных методов:
//       ** Ключ     - Строка - Имя метода
//       ** Значение - ИнформацияОбОшибке - Ошибка объявления
//    * Поля        - СписокМассив из КонтекстПоля - Поля с поставщиками и верным объявлением
//    * ОшибкиПолей - СписокМассив из ИнформацияОбОшибке - Ошибки объявления остальных полей
//
Функция ПрочитатьСигнатуры(ОпределениеЖелудя) Экспорт

	Чтение = Новый Структура(
		"Сигнатуры, Ошибки, Поля, ОшибкиПолей",
		Новый КартаСоответствие,
		Новый КартаСоответствие,
		Новый СписокМассив,
		Новый СписокМассив
	);

	ТипЖелудя = ОпределениеЖелудя.ТипЖелудя();

	// Свежие таблицы встроенного рефлектора: таблицы библиотеки reflector общие
	// на процесс, и autumn разворачивает аннотации параметров конструктора прямо
	// в них - повторное разворачивание задвоило бы мета-аннотации
	Рефлектор = Новый Рефлектор();

	Для Каждого Метод Из Рефлектор.ПолучитьТаблицуМетодов(ТипЖелудя) Цикл

		Попытка
			Чтение.Сигнатуры.Вставить(Метод.Имя, ПрочитатьСигнатуру(Метод, ТипЖелудя));
		Исключение
			Чтение.Ошибки.Вставить(Метод.Имя, ИнформацияОбОшибке());
		КонецПопытки;

	КонецЦикла;

	Для Каждого Поле Из Рефлектор.ПолучитьТаблицуСвойств(ТипЖелудя, Истина) Цикл

		Попытка
			ПрочитатьПоле(Поле, ТипЖелудя).ЕслиСодержитЗначение(Новый Действие(Чтение.Поля, "Добавить"));
		Исключение
			Чтение.ОшибкиПолей.Добавить(ИнформацияОбОшибке());
		КонецПопытки;

	КонецЦикла;

	Возврат Чтение;

КонецФункции

// Заполняет аргументы вызова значениями поставщиков в контексте указанного узла.
// Обработчик события ЗаполнениеАргументов. Ошибка поставщика включается в цепочку
// причин исключения с описанием параметра.
//
// Параметры:
//  Узел      - ОпределениеТестНабора, ОпределениеТеста - Узел, в контексте которого
//              поставщики дают значения
//  Аргументы - АргументыВызова - Заполняемые аргументы
//
&ПодпискаНаСобытие("ЗаполнениеАргументов")
Процедура ЗаполнитьАргументы(Узел, Аргументы) Экспорт

	Сигнатура = Узел.Набор().Сигнатура(Аргументы.Метод().Имя);

	КонтекстЗаполнения = Новый Структура(
		"Аргументы, Разрешение, Сигнатура, Контекст",
		Аргументы,
		ЭтотОбъект,
		Сигнатура,
		Узел.Контекст()
	);

	Аргументы.ИндексыЗаполняемыхПараметров().ПроцессорКоллекции()
		.Фильтровать("Индекс -> Сигнатура.Поставщик(Индекс).СодержитЗначение()", КонтекстЗаполнения)
		.ДляКаждого(
			"Индекс -> Аргументы.Установить(Индекс, Разрешение.ЗначениеПараметра(Сигнатура, Индекс, Контекст))",
			КонтекстЗаполнения
		);

КонецПроцедуры

// Заполняет поля экземпляра значениями поставщиков в контексте указанного узла.
// Обработчик события ИсполнениеЭкземплярНабора. Ошибка поставщика включается
// в цепочку причин исключения с описанием поля.
//
// Параметры:
//  Узел      - ОпределениеТестНабора, ОпределениеТеста - Узел, перед методами которого
//              готовится экземпляр
//  Экземпляр - Произвольный - Объект сценария набора
//
&ПодпискаНаСобытие("ИсполнениеЭкземплярНабора")
Процедура ЗаполнитьПоля(Узел, Экземпляр) Экспорт

	Набор = ?(ТипЗнч(Узел) = Тип("ОпределениеТестНабора"), Узел, Узел.Набор());

	Если Набор.ПоляСПоставщиками().Пусто() Тогда
		Возврат;
	КонецЕсли;

	Рефлектор = Новый Рефлектор();

	Набор.ПоляСПоставщиками().ДляКаждого(
		"Поле -> {
		|	Рефлектор.УстановитьСвойство(
		|		Экземпляр,
		|		Поле.Имя(),
		|		Разрешение.ЗначениеПоставщика(
		|			Поле.Поставщик(),
		|			Поле,
		|			Контекст,
		|			СтрШаблон(""Не удаётся разрешить поле %1"", Поле.Имя())
		|		)
		|	);
		|}",
		Новый Структура("Рефлектор, Экземпляр, Разрешение, Контекст", Рефлектор, Экземпляр, ЭтотОбъект, Узел.Контекст())
	);

КонецПроцедуры

Функция ПрочитатьСигнатуру(Метод, ТипЖелудя)

	РазворачивательАннотаций.РазвернутьАннотацииСвойства(Метод, ТипЖелудя);
	РазворачивательАннотаций.РазвернутьАннотацииСвойств(Метод.Параметры, ТипЖелудя);

	Поставщики = ПроцессорыКоллекций.ИзКоллекции(Метод.Параметры)
		.Обработать(
			"Параметр -> {
			|	Возврат Разрешение.ПоставщикЭлемента(
			|		Параметр,
			|		СтрШаблон(""параметра %1 метода %2"", Параметр.Имя, ИмяМетода)
			|	);
			|}",
			Новый Структура("Разрешение, ИмяМетода", ЭтотОбъект, Метод.Имя)
		)
		.Получить("СписокМассив");

	Возврат ТабакеркаСигнатур.Достать(Массивы.ИзЭлементов(Метод, Поставщики));

КонецФункции

// Создает контекст поля с поставщиком значения
//
// Параметры:
//  Поле      - СтрокаТаблицыЗначений - Метаданные поля
//  ТипЖелудя - Тип - Тип набора
//
//  Возвращаемое значение:
//   Опциональный - Контекст поля (КонтекстПоля), пустой - у поля нет поставщика
//
Функция ПрочитатьПоле(Поле, ТипЖелудя)

	РазворачивательАннотаций.РазвернутьАннотацииСвойства(Поле, ТипЖелудя);

	Поставщик = ПоставщикЭлемента(Поле, СтрШаблон("поля %1", Поле.Имя));

	Если Не Поставщик.СодержитЗначение() Тогда
		Возврат Опциональные.Пустой();
	КонецЕсли;

	Возврат Новый Опциональный(ТабакеркаКонтекстовПолей.Достать(Массивы.ИзЭлементов(Поле, Поставщик.Получить())));

КонецФункции

// Возвращает имя поставщика параметра или поля по его аннотациям
//
// Параметры:
//  Элемент  - СтрокаТаблицыЗначений - Данные параметра или поля с развернутыми аннотациями
//  Описание - Строка - Описание элемента в родительном падеже для ошибок, например
//             "параметра Каталог метода Тест"
//
//  Возвращаемое значение:
//   Опциональный - Имя поставщика (Строка), пустой - у элемента нет поставщика
//
Функция ПоставщикЭлемента(Элемент, Знач Описание) Экспорт

	Поставщики = ПроцессорыКоллекций.ИзКоллекции(
		РаботаСАннотациями.ПолучитьАннотации(Элемент, "ПоставщикЗначения")
	)
		.Обработать("Аннотация -> РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация)")
		.ВМассив();

	Если Поставщики.Количество() = 0 Тогда
		Возврат Опциональные.Пустой();
	КонецЕсли;

	Если Поставщики.Количество() > 1 Тогда
		ВызватьИсключение СтрШаблон(
			"У %1 несколько поставщиков: %2",
			Описание,
			СтрСоединить(Поставщики, ", ")
		);
	КонецЕсли;

	Возврат Новый Опциональный(Поставщики[0]);

КонецФункции

// Проверяет регистрацию поставщиков параметров метода в текущей поделке.
// Проверку выполняют в среде исполнения узла.
//
// Параметры:
//  Сигнатура - СигнатураМетода - Сигнатура метода
//
//  Возвращаемое значение:
//   Опциональный - Первая ошибка поиска поставщика (ИнформацияОбОшибке);
//                  пустой - все поставщики найдены
//
Функция ОшибкаРегистрации(Сигнатура) Экспорт

	Для Индекс = 0 По Сигнатура.Метод().Параметры.Количество() - 1 Цикл

		Поставщик = Сигнатура.Поставщик(Индекс);

		Если Не Поставщик.СодержитЗначение() Тогда
			Продолжить;
		КонецЕсли;

		Ошибка = ОшибкаПоиска(
			Поставщик.Получить(),
			СтрШаблон(
				" у параметра %1 метода %2",
				Сигнатура.Метод().Параметры.Получить(Индекс).Имя,
				Сигнатура.Метод().Имя
			)
		);

		Если Ошибка.СодержитЗначение() Тогда
			Возврат Ошибка;
		КонецЕсли;

	КонецЦикла;

	Возврат Опциональные.Пустой();

КонецФункции

// Проверяет, что поставщик поля зарегистрирован в текущей поделке, см. ОшибкаРегистрации
//
// Параметры:
//  Поле - КонтекстПоля - Поле с поставщиком
//
//  Возвращаемое значение:
//   Опциональный - Ошибка (ИнформацияОбОшибке) поиска поставщика, см. ОшибкаПоиска;
//                  пустой - поставщик найден
//
Функция ОшибкаРегистрацииПоля(Поле) Экспорт
	Возврат ОшибкаПоиска(Поле.Поставщик(), " у поля " + Поле.Имя());
КонецФункции

// Проверяет доступность поставщика по имени в текущей поделке.
// Отсутствие поставщика и исключения поиска возвращаются как ошибки.
//
// Параметры:
//  ИмяПоставщика - Строка - Имя желудя-поставщика
//  Где           - Строка - Уточнение элемента, например " у поля Каталог"
//
//  Возвращаемое значение:
//   Опциональный - Ошибка (ИнформацияОбОшибке): «Не найден поставщик ... желудь
//                  не зарегистрирован» или «Не удаётся найти поставщик ...» по причине
//                  исключения autumn; пустой - поставщик найден
//
Функция ОшибкаПоиска(Знач ИмяПоставщика, Знач Где)

	Попытка
		Определение = Поделка.ПолучитьОпределениеЖелудя(ИмяПоставщика);
	Исключение
		Возврат Новый Опциональный(ВыброшеннаяОшибка(
			СтрШаблон("Не удаётся найти поставщик %1%2", ИмяПоставщика, Где),
			ИнформацияОбОшибке()
		));
	КонецПопытки;

	Если Определение = Неопределено Тогда
		Возврат Новый Опциональный(ВыброшеннаяОшибка(
			СтрШаблон("Не найден поставщик %1%2: желудь не зарегистрирован", ИмяПоставщика, Где)
		));
	КонецЕсли;

	Возврат Опциональные.Пустой();

КонецФункции

// Создает информацию об ошибке с заполненными сведениями о месте возникновения
//
// Параметры:
//  Описание - Строка - Описание ошибки
//  Причина  - ИнформацияОбОшибке - Причина ошибки
//           - Неопределено - Причина не задана
//
//  Возвращаемое значение:
//   ИнформацияОбОшибке - Ошибка
//
Функция ВыброшеннаяОшибка(Знач Описание, Причина = Неопределено)

	Попытка
		ВызватьИсключение Новый ИнформацияОбОшибке(Описание, Неопределено, Причина);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

КонецФункции

// Получает значение параметра у поставщика в контексте исполнения.
//
// Параметры:
//  Сигнатура - СигнатураМетода - Сигнатура вызываемого метода
//  Индекс    - Число - Индекс параметра в сигнатуре, начиная с нуля
//  Контекст  - КонтекстИсполнения - Контекст узла
//
//  Возвращаемое значение:
//   Произвольный - Значение поставщика
//
Функция ЗначениеПараметра(Сигнатура, Знач Индекс, Контекст) Экспорт

	КонтекстПараметра = ТабакеркаКонтекстовПараметров.Достать(Массивы.ИзЭлементов(Сигнатура.Метод(), Индекс));

	Возврат ЗначениеПоставщика(
		Сигнатура.Поставщик(Индекс).Получить(),
		КонтекстПараметра,
		Контекст,
		СтрШаблон("Не удаётся разрешить параметр %1 метода %2", КонтекстПараметра.Имя(), Сигнатура.Метод().Имя)
	);

КонецФункции

// Получает значение у поставщика в указанном контексте.
// Ошибка поставщика включается в цепочку причин исключения с описанием элемента.
//
// Параметры:
//  ИмяПоставщика    - Строка - Имя желудя-поставщика
//  КонтекстЭлемента - КонтекстПараметра, КонтекстПоля - Элемент, которому нужно значение
//  Контекст         - КонтекстИсполнения - Контекст узла
//  ОписаниеОтказа   - Строка - Описание ошибки, которая оборачивает исключение поставщика
//
//  Возвращаемое значение:
//   Произвольный - Значение поставщика
//
Функция ЗначениеПоставщика(Знач ИмяПоставщика, КонтекстЭлемента, Контекст, Знач ОписаниеОтказа) Экспорт

	Поставщик = ЭкземплярПоставщика(ИмяПоставщика, ОписаниеОтказа);

	Попытка
		Возврат Поставщик.Значение(КонтекстЭлемента, Контекст);
	Исключение
		ВызватьИсключение Новый ИнформацияОбОшибке(ОписаниеОтказа, Неопределено, ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// Получает экземпляр поставщика и перехватывает вывод его создания.
// Если экземпляр не получен, вызывает исключение с причиной отказа.
//
// Параметры:
//  ИмяПоставщика  - Строка - Имя желудя-поставщика
//  ОписаниеОтказа - Строка - Описание ошибки, которая оборачивает отказ создания
//
//  Возвращаемое значение:
//   Произвольный - Желудь-поставщик
//
Функция ЭкземплярПоставщика(Знач ИмяПоставщика, Знач ОписаниеОтказа)

	Создание = ТестированиеСлужебный.ВыполнитьСПерехватомВывода(
		Поделка,
		"НайтиЖелудь",
		Списки.ИзЭлементов(ИмяПоставщика)
	);

	Если Создание.Ошибка.СодержитЗначение() Тогда
		ВызватьИсключение Новый ИнформацияОбОшибке(
			ОписаниеОтказа,
			Неопределено,
			ТестированиеСлужебный.ОшибкаСВыводом(Создание.Ошибка.Получить(), Создание.Вывод)
		);
	КонецЕсли;

	Если Не Создание.Значение.СодержитЗначение() Тогда
		ВызватьИсключение Новый ИнформацияОбОшибке(
			ОписаниеОтказа,
			Неопределено,
			ПричинаОтказаСоздания(ИмяПоставщика, Создание.Вывод)
		);
	КонецЕсли;

	ТестированиеСлужебный.ПередатьВывод(Создание.Вывод);

	Возврат Создание.Значение.Получить();

КонецФункции

// Причина отказа создания поставщика: перехваченный лог autumn с исключением
// конструктора, см. ФабрикаЭкземпляров
//
// Параметры:
//  ИмяПоставщика - Строка - Имя желудя-поставщика
//  Вывод         - Строка - Перехваченный вывод создания
//
//  Возвращаемое значение:
//   ИнформацияОбОшибке - Причина «Не удалось создать поставщик ...»
//
Функция ПричинаОтказаСоздания(Знач ИмяПоставщика, Знач Вывод)

	Вывод = ПереносРезультатов.РазвернутьЗаписиЛога(Вывод);

	Если Не ЗначениеЗаполнено(СокрЛП(Вывод)) Тогда
		Вывод = "<autumn не вывел причину>";
	КонецЕсли;

	Возврат ПереносРезультатов.ПричинаСГотовымОписанием(
		СтрШаблон("Не удалось создать поставщик %1", ИмяПоставщика),
		СтрШаблон(
			"
			|По причине:
			|%1
			|",
			Вывод
		)
	);

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин("Поделка") ПоделкаПрогона,
	&Пластилин("ПереносРезультатов") Перенос,
	&Пластилин("РазворачивательАннотаций") Разворачиватель,
	&Табакерка &Пластилин("СигнатураМетода") Сигнатуры,
	&Табакерка &Пластилин("КонтекстПараметра") КонтекстыПараметров,
	&Табакерка &Пластилин("КонтекстПоля") КонтекстыПолей)

	Поделка                       = ПоделкаПрогона;
	ПереносРезультатов            = Перенос;
	РазворачивательАннотаций      = Разворачиватель;
	ТабакеркаСигнатур             = Сигнатуры;
	ТабакеркаКонтекстовПараметров = КонтекстыПараметров;
	ТабакеркаКонтекстовПолей      = КонтекстыПолей;

КонецПроцедуры
