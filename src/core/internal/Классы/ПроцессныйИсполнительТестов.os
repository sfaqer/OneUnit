// Исполняет изолированные наборы и тесты в дочернем процессе (&Изолированный
// с уровнем "Процесс") и вклеивает их результаты в общий прогон. События
// исполнения изолированного набора приходят строками вывода процесса и
// ретранслируются в текущий прогон по ходу, так что для репортеров и статистики
// это обычные тесты; результаты изолированного теста переносятся из JSON-отчета
// дочернего прогона. Для чистого обнаружения (discover) состав изолированного
// набора обнаруживается дочерним процессом без исполнения тестов и вклеивается
// в план зеркалами.

#Использовать collectionos
#Использовать lambdas
#Использовать tempfiles
#Использовать fs
#Использовать "../../../shared"

Перем _ТабакеркаРезультатов;      // Табакерка - Результаты выполнения тестов
Перем _ТабакеркаРетрансляторов;   // Табакерка - Ретрансляторы событий изолированных наборов
Перем _ПубликаторСобытий;         // ПубликаторСобытий - Публикатор событий исполнения текущего прогона
Перем _Запускатель;               // ЗапускательТестирования - Запускатель дочерних прогонов
Перем _ПереносРезультатов;        // ПереносРезультатов - Перевод результатов из записей
Перем _РепортерПланJSON;          // РепортерПланJSON - Записи состава плана
Перем _Канал;                     // КаналСобытийИзоляции - Вывод совета в выводе дочернего процесса
Перем _ПроверкаУсловий;           // ПроверкаУсловийИзоляции - Условия узла до подъема среды
Перем _КаталогСтатистикиПокрытия; // Строка - Каталог статистики покрытия прогона, пустая строка - без покрытия
Перем _ПрерыватьПриПадении;       // Булево - Прекращать прогон после первого упавшего теста
Перем _Лог;                       // Лог - Лог ядра

// Исполняет изолированный набор или тест в дочернем процессе и возвращает его
// результат. События тестов набора ретранслируются в текущий прогон по ходу его
// исполнения, события итераций изолированного контейнера публикуются по итогам.
// Изолированный тест прогоняется набором, отфильтрованным до этого теста, - так
// у теста сохраняется полный жизненный цикл набора, а его условия проверяются
// в его среде, как условия изолированного набора. Но условия узла без импортов сначала
// проверяются здесь: ради выключенного ими узла процесс не запускается, см. ПроверкаУсловийИзоляции.
// Отказ изолированной среды не прерывает прогон - узел помечается сломанным
//
// Параметры:
//  Узел - ОпределениеТестНабора, ОпределениеТеста - Изолированный набор или тест
//
//  Возвращаемое значение:
//   РезультатВыполненияТеста - Результат узла
//
Функция Исполнить(Узел) Экспорт

	Проверка = _ПроверкаУсловий.Проверить(Узел);

	Если Проверка.Пропуск.СодержитЗначение() Тогда
		Возврат Проверка.Пропуск.Получить();
	КонецЕсли;

	Если ТипЗнч(Узел) = Тип("ОпределениеТестНабора") Тогда
		Результат = ИсполнитьНабор(Узел);
	Иначе
		Результат = ИсполнитьТест(Узел, Узел.Набор());
	КонецЕсли;

	Возврат Результат.ДобавитьПредшествующийВывод(Проверка.Вывод);

КонецФункции

// Обнаруживает состав изолированного набора дочерним процессом, не исполняя
// тесты, и наполняет набор зеркалами обнаруженных определений - для чистого
// обнаружения (discover), на состав которого опираются внешние инструменты
//
// Параметры:
//  Набор - ОпределениеТестНабора - Изолированный набор
//
Процедура Развернуть(Набор) Экспорт

	МенеджерВременныхФайлов = Новый МенеджерВременныхФайлов();

	Попытка
		Состав = СоставДочернегоОбнаружения(Набор, МенеджерВременныхФайлов);
	Исключение
		МенеджерВременныхФайлов.Удалить();
		ВызватьИсключение;
	КонецПопытки;

	МенеджерВременныхФайлов.Удалить();

	НовыйРетранслятор(Набор).ВклеитьСостав(Состав);

КонецПроцедуры

// Запускает дочерний процесс обнаружения файла изолированного набора с записью
// состава плана в JSON-файл и возвращает прочитанный состав
//
// Параметры:
//  ОпределениеНабора - ОпределениеТестНабора - Изолированный набор
//  МенеджерВременныхФайлов - МенеджерВременныхФайлов - Менеджер временных файлов прогона
//
//  Возвращаемое значение:
//   см. РепортерПланJSON.СоставПлана
//
Функция СоставДочернегоОбнаружения(ОпределениеНабора, МенеджерВременныхФайлов)

	ПутьКПлану = МенеджерВременныхФайлов.НовоеИмяФайла("json");

	Детальки = Новый Соответствие;
	Детальки.Вставить("КаталогиТестов", Новый Массив);
	Детальки.Вставить("ФайлыТестов", Массивы.ИзЭлементов(ОпределениеНабора.Путь()));
	Детальки.Вставить("ИскатьВПодкаталогах", Ложь);
	Детальки.Вставить("РежимВыводаЛога", РежимыВыводаЛога.Ничего);
	Детальки.Вставить("ВыполняетсяВИзоляции", Истина);

	ПараметрыЗапуска = _Запускатель.ПараметрыЗапуска();

	ПараметрыЗапуска.Импорты       = Импорты(ОпределениеНабора, ОпределениеНабора);
	ПараметрыЗапуска.ЛямбдаСовета  = ОпределениеНабора.Изоляция().Получить().ЛямбдаСовета;
	ПараметрыЗапуска.РаскладкаЛога = "РаскладкаЛогOneUnit";

	Результат = _Запускатель.ВыполнитьОбнаружениеПлана(
		Детальки,
		ПутьКПлану,
		_Лог,
		ПараметрыЗапуска
	);

	Состав = _РепортерПланJSON.ПрочитатьСостав(ПутьКПлану);

	Если Не Состав.СодержитЗначение() Тогда

		// Краткая причина - на узле плана, вывод ребенка - в ее подробном описании.
		// Вывод совета удачного обнаружения не нужен, а при отказе - часть его вывода
		Вывод = _Канал.РазобратьВывод(Результат.Вывод);

		_ПереносРезультатов.ВызватьПричинуСВыводом(
			"Дочернее обнаружение завершилось аварийно, не сформировав план",
			Вывод.ВыводСовета + Вывод.Вывод
		);

	КонецЕсли;

	Возврат Состав.Получить();

КонецФункции

Функция ИсполнитьНабор(Набор)

	Ретранслятор = НовыйРетранслятор(Набор);

	ОшибкаСреды = Опциональные.Пустой();

	Попытка
		ТранслироватьДочернийПроцесс(Набор, Ретранслятор);
	Исключение
		// Дочерний прогон не удалось запустить
		ОшибкаСреды = Новый Опциональный(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Ретранслятор.Завершить("", ОшибкаСреды);

КонецФункции

Функция ИсполнитьТест(Тест, ОпределениеНабора)

	МенеджерВременныхФайлов = Новый МенеджерВременныхФайлов();

	Попытка
		Прогон = ВыполнитьВДочернемПроцессе(
			Тест,
			ОпределениеНабора,
			МенеджерВременныхФайлов,
			Тест.ИмяМетода()
		);
	Исключение
		МенеджерВременныхФайлов.Удалить();
		Возврат РезультатСломан(ИнформацияОбОшибке());
	КонецПопытки;

	МенеджерВременныхФайлов.Удалить();

	Возврат РезультатТестаСреды(Тест, ОпределениеНабора, Прогон).ДобавитьПредшествующийВывод(Прогон.ВыводСовета);

КонецФункции

Функция РезультатТестаСреды(Тест, ОпределениеНабора, Прогон)

	Если Не Прогон.Отчет.СодержитЗначение() Тогда
		Возврат РезультатСломан(_ПереносРезультатов.ПричинаСВыводом(
			"Дочерний прогон изолированного теста завершился аварийно, не сформировав отчет",
			Прогон.Вывод
		));
	КонецЕсли;

	Отчет           = Прогон.Отчет.Получить();
	РезультатНабора = РезультатНабораИзОтчета(ОпределениеНабора.Имя(), Отчет);

	Если РезультатНабора.Состояние() <> СостоянияВыполненияТестов.Успех Тогда
		// Набор в изолированной среде не выполнился (например, упал ПередВсеми) -
		// тест наследует его состояние, причины и вывод
		Возврат РезультатНабора;
	КонецЕсли;

	Возврат РезультатТестаИзОтчета(Тест, Отчет, Прогон.Вывод);

КонецФункции

// Возвращает результат изолированного теста по результатам дочернего прогона.
// Для контейнера дополнительно публикует события исполнения его итераций
//
// Параметры:
//  Тест - ОпределениеТеста - Определение изолированного теста или контейнера
//  Отчет - см. ПереносРезультатов.РезультатыОтчета
//  Вывод - Строка - Захваченный вывод дочернего прогона
//
//  Возвращаемое значение:
//   РезультатВыполненияТеста - Результат теста
//
Функция РезультатТестаИзОтчета(Тест, Отчет, Знач Вывод)

	Если Тест.ТипОпределения() = ТипыОпределенийТестов.Контейнер Тогда

		// Контейнер, пропущенный в дочерней среде (например, по своему условию),
		// приходит в отчете записью уровня контейнера, как набор: его итерации
		// не исполнялись и событий не получают
		РезультатКонтейнера = Отчет.Наборы.Получить(Тест.ПолноеИмя());

		Если РезультатКонтейнера.СодержитЗначение() Тогда
			Возврат РезультатКонтейнера.Получить();
		КонецЕсли;

		Для каждого Дитя Из Тест.Дети() Цикл

			_ПубликаторСобытий.ОпубликоватьСобытие(Дитя, "ИсполнениеТестНачало", Новый Массив);

			_ПубликаторСобытий.ОпубликоватьСобытие(
				Дитя,
				"ИсполнениеТестКонец",
				Массивы.ИзЭлементов(РезультатТеста(Отчет, Дитя, Вывод))
			);

		КонецЦикла;

		Возврат РезультатУспех();

	КонецЕсли;

	Возврат РезультатТеста(Отчет, Тест, Вывод);

КонецФункции

Функция РезультатТеста(Отчет, Тест, Знач Вывод)

	// Сломанный результат - только когда записи нет: причина разбирает весь
	// вывод дочернего прогона
	Возврат Новый Опциональный(
		Отчет.Тесты.ПроцессорКоллекции()
			.Фильтровать("ТестОтчета -> ТестОтчета.Тест = ИмяТеста", Новый Структура("ИмяТеста", Тест.Имя()))
			.Обработать("ТестОтчета -> ТестОтчета.Результат")
			.ПолучитьПервый(),
		Истина
	).ИначеПолучить(
		Лямбда.Выражение("() -> Исполнитель.РезультатТестаБезЗаписи(Тест, Вывод)")
			.Интерфейс(ФункциональныеИнтерфейсы.Вызываемый())
			.Контекст(Новый Структура("Исполнитель, Тест, Вывод", ЭтотОбъект, Тест, Вывод))
			.ВДействие()
	);

КонецФункции

// Возвращает сломанный результат теста, записи которого нет в отчете дочернего
// прогона. Экспортная, потому что ее вызывает лямбда, а лямбде доступны только
// экспортные методы
//
// Параметры:
//  Тест - ОпределениеТеста - Определение теста или итерации контейнера
//  Вывод - Строка - Захваченный вывод дочернего прогона
//
//  Возвращаемое значение:
//   РезультатВыполненияТеста - Сломанный результат с выводом дочернего прогона в причине
//
Функция РезультатТестаБезЗаписи(Тест, Знач Вывод) Экспорт

	Возврат РезультатСломан(_ПереносРезультатов.ПричинаТестНеВыполнен(
		Тест,
		"в отчете дочернего прогона нет записи этого теста",
		Вывод
	));

КонецФункции

// Запускает дочерний прогон файла изолированного набора с трансляцией событий
// исполнения: вывод процесса по мере поступления разбирает ретранслятор
//
// Параметры:
//  ОпределениеНабора - ОпределениеТестНабора - Изолированный набор
//  Ретранслятор - РетрансляторСобытийИзоляции - Ретранслятор событий набора
//
Процедура ТранслироватьДочернийПроцесс(ОпределениеНабора, Ретранслятор)

	ПараметрыЗапуска = ПараметрыДочернегоПрогона(ОпределениеНабора, ОпределениеНабора);

	ПараметрыЗапуска.ЛогВывода         = Ретранслятор;
	ПараметрыЗапуска.ТрансляцияСобытий = Истина;

	_Запускатель.ВыполнитьТестирование(
		ДеталькиДочернегоПрогона(ОпределениеНабора, ОпределениеНабора, ""),
		_Лог,
		ПараметрыЗапуска
	);

КонецПроцедуры

// Запускает дочерний прогон файла набора, отфильтрованного до изолированного
// теста, с формированием JSON-отчета и возвращает разобранный отчет
//
// Параметры:
//  Источник - ОпределениеТеста - Изолированный тест
//  ОпределениеНабора - ОпределениеТестНабора - Набор изолированного теста
//  МенеджерВременныхФайлов - МенеджерВременныхФайлов - Менеджер временных файлов прогона
//  ФильтрМетода - Строка - Имя тестового метода изолированного теста
//
//  Возвращаемое значение:
//   Структура - Результаты дочернего прогона:
//    * Отчет       - Опциональный - Результаты прогона, см. ПереносРезультатов.РезультатыОтчета;
//                    пустой - прогон не сформировал отчет
//    * Вывод       - Строка - Захваченный вывод прогона без сообщений канала
//    * ВыводСовета - Строка - Вывод лямбды совета, переданный сообщением канала
//
Функция ВыполнитьВДочернемПроцессе(Источник, ОпределениеНабора, МенеджерВременныхФайлов, Знач ФильтрМетода)

	ПутьКОтчету = МенеджерВременныхФайлов.НовоеИмяФайла("json");

	Детальки = ДеталькиДочернегоПрогона(Источник, ОпределениеНабора, ФильтрМетода);
	Детальки.Вставить("ПутьКОтчетуJSON", ПутьКОтчету);

	Результат = _Запускатель.ВыполнитьТестирование(
		Детальки,
		_Лог,
		ПараметрыДочернегоПрогона(Источник, ОпределениеНабора)
	);

	// Отчет запускателя - формат ответа MCP, отсутствие отчета он отдает Неопределено
	Отчет = Новый Опциональный(_Запускатель.ПрочитатьОтчет(ПутьКОтчету), Истина)
		.Обработать(Новый Действие(_ПереносРезультатов, "РезультатыОтчета"));

	Вывод = _Канал.РазобратьВывод(Результат.Вывод);

	Возврат Новый Структура(
		"Отчет, Вывод, ВыводСовета",
		Отчет,
		Вывод.Вывод,
		Вывод.ВыводСовета
	);

КонецФункции

// Возвращает детальки дочернего прогона изолированного набора или теста
//
// Параметры:
//  Источник - ОпределениеТестНабора, ОпределениеТеста - Определение с описанием изоляции
//  ОпределениеНабора - ОпределениеТестНабора - Набор изолированного прогона
//  ФильтрМетода - Строка - Имя тестового метода для изоляции одного теста,
//                 пустая строка - прогон всего набора
//
//  Возвращаемое значение:
//   Соответствие из КлючИЗначение - Детальки прогона, см. ЗапускательТестирования.ВыполнитьТестирование
//
Функция ДеталькиДочернегоПрогона(Источник, ОпределениеНабора, Знач ФильтрМетода)

	Детальки = Новый Соответствие;
	Детальки.Вставить("КаталогиТестов", Новый Массив);
	Детальки.Вставить("ФайлыТестов", Массивы.ИзЭлементов(ОпределениеНабора.Путь()));
	Детальки.Вставить("ИскатьВПодкаталогах", Ложь);
	Детальки.Вставить("Таймаут", Источник.Таймаут());
	Детальки.Вставить("РежимВыводаЛога", РежимыВыводаЛога.Ничего);
	Детальки.Вставить("ВыполняетсяВИзоляции", Истина);
	Детальки.Вставить("ТестовыеМетодыВключаемые", ФильтрМетода);
	Детальки.Вставить("ПрерыватьПриПервомПадении", _ПрерыватьПриПадении);

	Возврат Детальки;

КонецФункции

// Возвращает параметры запуска дочернего прогона изолированного набора или теста.
// Вывод дочернего прогона не транслируется в консоль родителя, чтобы не разрывать
// его собственный вывод: результаты тестов переносятся структурно, а захваченный
// вывод используется как причина при аварийном завершении прогона
//
// Параметры:
//  Источник - ОпределениеТестНабора, ОпределениеТеста - Определение с описанием изоляции
//  ОпределениеНабора - ОпределениеТестНабора - Набор изолированного прогона
//
//  Возвращаемое значение:
//   Структура - Параметры запуска, см. ЗапускательТестирования.ПараметрыЗапуска
//
Функция ПараметрыДочернегоПрогона(Источник, ОпределениеНабора)

	ПараметрыЗапуска = _Запускатель.ПараметрыЗапуска();

	ПараметрыЗапуска.Импорты                 = Импорты(Источник, ОпределениеНабора);
	ПараметрыЗапуска.ЛямбдаСовета            = Источник.Изоляция().Получить().ЛямбдаСовета;
	ПараметрыЗапуска.РаскладкаЛога           = "РаскладкаЛогOneUnit";
	ПараметрыЗапуска.ПутьКСтатистикеПокрытия = ПутьКСтатистикеПокрытия();

	Возврат ПараметрыЗапуска;

КонецФункции

// Возвращает полные пути импортов изолированного прогона: относительные пути
// аннотации разрешаются от каталога файла набора
//
// Параметры:
//  Источник - ОпределениеТестНабора, ОпределениеТеста - Определение с описанием изоляции
//  ОпределениеНабора - ОпределениеТестНабора - Набор изолированного прогона
//
//  Возвращаемое значение:
//   Массив из Строка - Имена библиотек и полные пути импортов
//
Функция Импорты(Источник, ОпределениеНабора)

	Импорты = Новый Массив;

	ИсходныйКаталог = ТекущийКаталог();
	УстановитьТекущийКаталог(Новый Файл(ОпределениеНабора.Путь()).Путь);

	Попытка

		Для каждого Импорт Из Источник.Изоляция().Получить().Импорты Цикл

			Если СтрНайти(Импорт, "/") > 0 Или СтрНайти(Импорт, "\") > 0 Тогда
				Импорты.Добавить(ФС.НормализоватьПуть(Импорт));
			Иначе
				Импорты.Добавить(Импорт);
			КонецЕсли;

		КонецЦикла;

	Исключение

		// Текущий каталог процесса общий с остальным прогоном - восстанавливаем
		// его перед тем, как отдать исключение дальше (например, при ошибке
		// ФС.НормализоватьПуть на неверном пути импорта)
		УстановитьТекущийКаталог(ИсходныйКаталог);
		ВызватьИсключение;

	КонецПопытки;

	УстановитьТекущийКаталог(ИсходныйКаталог);

	Возврат Импорты;

КонецФункции

Функция РезультатНабораИзОтчета(Знач ИмяНабора, Отчет)

	// Результат набора в отчете - только у набора, не дошедшего до своих тестов:
	// наихудшее состояние тестов родитель агрегирует по событиям сам
	Возврат Отчет.Наборы.ПолучитьИлиУмолчание(ИмяНабора, РезультатУспех());

КонецФункции

// Возвращает путь к файлу статистики покрытия изолированного дочернего процесса:
// исполнение кода в нем тоже попадает в покрытие - статистика пишется в каталог
// родительского прогона и мержится им в общие отчеты
//
//  Возвращаемое значение:
//   Строка - Путь к файлу статистики, пустая строка - покрытие не собирается
//
Функция ПутьКСтатистикеПокрытия()

	Если Не ЗначениеЗаполнено(_КаталогСтатистикиПокрытия) Тогда
		Возврат "";
	КонецЕсли;

	Возврат ОбъединитьПути(
		_КаталогСтатистикиПокрытия,
		СтрШаблон("stat_%1.json", Новый УникальныйИдентификатор)
	);

КонецФункции

Функция НовыйРетранслятор(ОпределениеНабора)
	Возврат _ТабакеркаРетрансляторов.Достать(Массивы.ИзЭлементов(ОпределениеНабора));
КонецФункции

Функция РезультатСломан(ИнформацияОбОшибке)
	Возврат Результат(СостоянияВыполненияТестов.Сломан, Списки.ИзЭлементов(ИнформацияОбОшибке));
КонецФункции

Функция РезультатУспех()
	Возврат Результат(СостоянияВыполненияТестов.Успех, Списки.ИзЭлементов());
КонецФункции

Функция Результат(Знач Состояние, Причины)
	Возврат _ТабакеркаРезультатов.Достать(Массивы.ИзЭлементов(Состояние, Причины, ""));
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин("РезультатВыполненияТеста") ТабакеркаРезультатов,
	&Табакерка &Пластилин("РетрансляторСобытийИзоляции") ТабакеркаРетрансляторов,
	&Пластилин ПубликаторСобытий,
	&Пластилин ЗапускательТестирования,
	&Пластилин ПереносРезультатов,
	&Пластилин РепортерПланJSON,
	&Пластилин КаналСобытийИзоляции,
	&Пластилин ПроверкаУсловийИзоляции,
	&Деталька("OneUnit.КаталогСтатистикиПокрытия", ЗначениеПоУмолчанию = "") КаталогСтатистикиПокрытия,
	&Деталька("OneUnit.ПрерыватьПриПервомПадении", ЗначениеПоУмолчанию = Ложь) ПрерыватьПриПадении,
	&Лог("oscript.lib.oneunit.core") Лог)

	_ТабакеркаРезультатов      = ТабакеркаРезультатов;
	_ТабакеркаРетрансляторов   = ТабакеркаРетрансляторов;
	_ПубликаторСобытий         = ПубликаторСобытий;
	_Запускатель               = ЗапускательТестирования;
	_ПереносРезультатов        = ПереносРезультатов;
	_РепортерПланJSON          = РепортерПланJSON;
	_Канал                     = КаналСобытийИзоляции;
	_ПроверкаУсловий           = ПроверкаУсловийИзоляции;
	_КаталогСтатистикиПокрытия = КаталогСтатистикиПокрытия;
	_ПрерыватьПриПадении       = ПрерыватьПриПадении;
	_Лог                       = Лог;

КонецПроцедуры
