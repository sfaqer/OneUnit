// Информация о повторении из описания текущего вызова.

#Использовать collectionos

// Параметры:
//  КонтекстЭлемента - КонтекстПараметра, КонтекстПоля - Параметр или поле, которому нужно значение
//  Контекст        - КонтекстИсполнения - Контекст текущего узла
//
// Возвращаемое значение:
//  ИнформацияОПовторении - Номер текущего повторения и общее количество
//
Функция Значение(КонтекстЭлемента, Контекст) Экспорт // BSLLS:UnusedParameters-off

	Узел = Контекст.Узел();

	Если ТипЗнч(Узел) = Тип("ОпределениеТеста") Тогда

		Повторение = Узел.Повторение();

		Если Повторение.СодержитЗначение() Тогда
			Возврат Повторение.Получить();
		КонецЕсли;

	КонецЕсли;

	ВызватьИсключение "Информация о повторении доступна только при выполнении повторяемого теста";

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
