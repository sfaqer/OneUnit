Перем _ТестовыеНаборы;
Перем _Таймаут;

Процедура ДобавитьТестовыйНабор(ТестовыйНабор) Экспорт
	_ТестовыеНаборы.Добавить(ТестовыйНабор);
КонецПроцедуры

Функция Дети() Экспорт
	Возврат Новый ФиксированныйСписок(_ТестовыеНаборы);
КонецФункции

Функция Таймаут() Экспорт
	Возврат _Таймаут;
КонецФункции

// Признак ошибок обнаружения в плане: узлы, состав или параметры которых
// не удалось обнаружить
//
//  Возвращаемое значение:
//   Булево - Истина - в плане есть узлы с ошибками обнаружения
//
Функция ЕстьОшибкиОбнаружения() Экспорт
	Возврат Дети().ПроцессорКоллекции().ЛюбойСоответствует("Набор -> Набор.ЕстьОшибкиОбнаружения()");
КонецФункции

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Деталька("OneUnit.Таймаут", ЗначениеПоУмолчанию = 0) Таймаут, &Пластилин Поделка)

	_ТестовыеНаборы = Новый СписокМассив;
	_Таймаут        = Таймаут;

КонецПроцедуры
