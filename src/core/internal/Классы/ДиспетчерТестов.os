// Управление исполнением и обнаружением узлов тест-плана.
// Передает узлы выбранным исполнителям, закрывает их контексты
// и публикует события начала и завершения с результатами.

#Использовать atomic
#Использовать collectionos
#Использовать "../../../shared"

Перем _Поделка;              // Поделка - Среда регистрации исполнителей
Перем _ПубликаторСобытий;    // ПубликаторСобытий - Публикатор событий исполнения
Перем _ТабакеркаРезультатов; // Табакерка - Результаты выполнения тестов
Перем _ПрерыватьПриПадении;  // Булево - Прекращать прогон после первого упавшего теста
Перем _Прервано;             // АтомарноеБулево - Прогон прекращен, оставшиеся узлы не запускаются

// Исполняет тест-план
//
// Параметры:
//  ТестПлан - ТестПлан - Составленный тест-план
//
Процедура Исполнить(ТестПлан) Экспорт

	// Поделка живет дольше одного прогона: без сброса повторный Тестировать()
	// не выполнил бы ни одного теста
	_Прервано.Установить(Ложь);

	// Начало плана - тоже под защитой: отказ закрывает открытые контексты, где бы ни случился
	Попытка
		_ПубликаторСобытий.ОпубликоватьСобытие(ТестПлан, "ИсполнениеТестПланНачало", Новый Массив);
		ИсполнитьДетей(ТестПлан);
	Исключение
		ЗакрытьПослеОтказа(ТестПлан, ИнформацияОбОшибке());
	КонецПопытки;

	_ПубликаторСобытий.ОпубликоватьСобытие(ТестПлан, "ИсполнениеТестПланКонец", Новый Массив);

КонецПроцедуры

// Разворачивает состав наборов плана, который обнаруживается только в их средах,
// не исполняя тесты
//
// Параметры:
//  ТестПлан - ТестПлан - Составленный тест-план
//
Процедура Развернуть(ТестПлан) Экспорт
	ТестПлан.Дети().ПроцессорКоллекции().ДляКаждого("Набор -> РазвернутьНабор(Набор)", ЭтотОбъект);
КонецПроцедуры

// Обнаруживает состав набора через его исполнителя.
// Исключения исполнителя добавляются к ошибкам обнаружения набора.
//
// Параметры:
//  Набор - ОпределениеТестНабора - Разворачиваемый набор
//
Процедура РазвернутьНабор(Набор) Экспорт

	Попытка
		_Поделка.НайтиЖелудь(Набор.Исполнитель()).Развернуть(Набор);
	Исключение
		Набор.ДобавитьОшибкуОбнаружения(ИнформацияОбОшибке());
	КонецПопытки;

	ЗакрытьПослеОбнаружения(Набор);

КонецПроцедуры

// Закрывает контексты набора и его потомков после обнаружения.
// Вывод действий передается в вывод обнаружения, исключения добавляются к ошибкам набора.
//
// Параметры:
//  Набор - ОпределениеТестНабора - Развернутый набор
//
Процедура ЗакрытьПослеОбнаружения(Набор)

	Закрытие = НовоеЗакрытие();

	ЗакрытьОткрытые(Набор, Закрытие);

	ТестированиеСлужебный.ПередатьВывод(Закрытие.Вывод);

	Закрытие.Причины.ДляКаждого(Новый Действие(Набор, "ДобавитьОшибкуОбнаружения"));

КонецПроцедуры

// Закрывает открытые контексты после исключения, прервавшего прогон,
// и передает исходное исключение вызывающему коду. Вывод закрытия и подробные
// описания его ошибок с цепочками причин добавляются к выводу исключения.
//
// Параметры:
//  ТестПлан - ТестПлан - Исполняемый тест-план
//  Ошибка   - ИнформацияОбОшибке - Исключение, прервавшее исполнение
//
Процедура ЗакрытьПослеОтказа(ТестПлан, Ошибка)

	Закрытие = НовоеЗакрытие();

	ЗакрытьОткрытые(ТестПлан, Закрытие);

	Вывод = Закрытие.Вывод + Закрытие.Причины.ПроцессорКоллекции()
		.Обработать("Причина -> ТестированиеСлужебный.ПодробноеОписаниеОшибки(""Исключение закрытия"", Причина)")
		.ВСтроку();

	ТестированиеСлужебный.ВызватьСВыводом(Ошибка, Вывод);

КонецПроцедуры

// Закрывает контексты поддерева без результата, начиная с потомков.
// Накапливает вывод и исключения действий закрытия.
//
// Параметры:
//  Узел     - ТестПлан, ОпределениеТестНабора, ОпределениеТеста - Корень поддерева
//  Закрытие - см. НовоеЗакрытие - Накопленный итог закрытия
//
Процедура ЗакрытьОткрытые(Узел, Закрытие)

	Для Каждого Дитя Из Узел.Дети() Цикл
		ЗакрытьОткрытые(Дитя, Закрытие);
	КонецЦикла;

	Если ТипЗнч(Узел) = Тип("ТестПлан") Тогда
		Возврат;
	КонецЕсли;

	Итог = Узел.Контекст().Закрыть(Опциональные.Пустой());

	Закрытие.Вывод = Закрытие.Вывод + Итог.Вывод;
	Закрытие.Причины.ДобавитьВсе(Итог.Причины);

КонецПроцедуры

// Итог закрытия нескольких контекстов
//
//  Возвращаемое значение:
//   Структура - Суммарный итог закрытия контекстов:
//    * Вывод   - Строка - Вывод действий закрытия
//    * Причины - СписокМассив из ИнформацияОбОшибке - Исключения действий закрытия
//
Функция НовоеЗакрытие()
	Возврат Новый Структура("Вывод, Причины", "", Новый СписокМассив);
КонецФункции

// Исполняет дочерние узлы в порядке, заданном родителем
//
// Параметры:
//  Узел - ТестПлан, ОпределениеТестНабора, ОпределениеТеста - Узел, дети которого исполняются
//
Процедура ИсполнитьДетей(Узел) Экспорт
	Узел.Дети().ПроцессорКоллекции().ДляКаждого("Дитя -> ИсполнитьУзел(Дитя)", ЭтотОбъект);
КонецПроцедуры

// Публикует начало узла, выполняет его через выбранный исполнитель
// и публикует завершение. Перед публикацией результата закрывает контексты
// узла и оставшихся открытыми потомков, добавляя итог закрытия к результату.
//
// Параметры:
//  Узел - ОпределениеТестНабора, ОпределениеТеста - Исполняемый узел
//
Процедура ИсполнитьУзел(Узел) Экспорт

	// Проверка на каждом узле: прогон прекращается и посреди набора,
	// его оставшиеся тесты тоже отмечаются
	Если _Прервано.Получить() Тогда
		ОтметитьНезапущенным(Узел);
		Возврат;
	КонецЕсли;

	ОпубликоватьНачало(Узел);

	// Ради узла, который не удалось обнаружить, изолированная среда не поднимается:
	// его условия проверяет исполнитель текущей поделки
	ИмяИсполнителя = ?(Узел.ОшибкиОбнаружения().Пусто(), Узел.Исполнитель(), ИсполнителиТестов.Асинхронный);

	Результат = _Поделка.НайтиЖелудь(ИмяИсполнителя).Исполнить(Узел);

	// Вывод обнаружения шаблона (например, выражения источника) - часть вывода контейнера
	Если Не ЭтоНабор(Узел) Тогда
		Результат.ДобавитьПредшествующийВывод(Узел.ВыводОбнаружения());
	КонецЕсли;

	ЗакрытьУзел(Узел, Результат);

	ОпубликоватьКонец(Узел, Результат);

КонецПроцедуры

// Закрывает контекст узла с его результатом и открытые контексты его потомков.
// Вывод и исключения закрытия добавляются к результату узла.
//
// Параметры:
//  Узел      - ОпределениеТестНабора, ОпределениеТеста - Завершенный узел
//  Результат - РезультатВыполненияТеста - Результат узла
//
Процедура ЗакрытьУзел(Узел, Результат)

	Закрытие = НовоеЗакрытие();

	Для Каждого Дитя Из Узел.Дети() Цикл
		ЗакрытьОткрытые(Дитя, Закрытие);
	КонецЦикла;

	Результат.ДобавитьЗакрытие(Закрытие);
	Результат.ДобавитьЗакрытие(Узел.Контекст().Закрыть(Новый Опциональный(Результат)));

КонецПроцедуры

// Обновляет признак падения по результату теста, полученному через событие завершения
//
// Параметры:
//  Тест - ОпределениеТеста - Завершенный тест
//  Результат - РезультатВыполненияТеста - Результат теста
//
&ПодпискаНаСобытие("ИсполнениеТестКонец")
Процедура ОтметитьПадениеТеста(Тест, Результат) Экспорт
	ОтметитьПадение(Тест, Результат);
КонецПроцедуры

// Набор может оказаться красным и без единого упавшего теста: сломанный конструктор,
// ошибка в ПередВсеми, отказ изолированной среды
//
// Параметры:
//  Набор - ОпределениеТестНабора - Завершенный набор
//  Результат - РезультатВыполненияТеста - Результат набора
//
&ПодпискаНаСобытие("ИсполнениеТестНаборКонец")
Процедура ОтметитьПадениеНабора(Набор, Результат) Экспорт
	ОтметитьПадение(Набор, Результат);
КонецПроцедуры

Процедура ОтметитьПадение(Узел, Результат)

	// Падение - это сломанный код: упавшее утверждение или ошибка исполнения.
	// Пропущенные и прерванные прогон не останавливают, они ничего не говорят
	// о работоспособности
	Если Результат.Состояние() = СостоянияВыполненияТестов.Ошибка
		Или Результат.Состояние() = СостоянияВыполненияТестов.Сломан Тогда

		// Зеркала изолированных тестов завершаются событиями ретранслятора,
		// поэтому их падения учитываются здесь независимо от прекращения прогона
		Узел.Контекст().ОтметитьПадение();

		Если _ПрерыватьПриПадении Тогда
			_Прервано.Установить(Истина);
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

// Публикует для незапущенного узла результат Пропущен и закрывает его контекст
// вместе с открытыми контекстами потомков.
//
// Параметры:
//  Узел - ОпределениеТестНабора, ОпределениеТеста - Незапущенный узел
//
Процедура ОтметитьНезапущенным(Узел)

	ОпубликоватьНачало(Узел);

	Результат = НовыйРезультат(
		СостоянияВыполненияТестов.Пропущен,
		Списки.ИзЭлементов("Прогон прекращён на первом падении")
	);

	// Контекст закрывается и у незапущенного узла, и у его потомков
	ЗакрытьУзел(Узел, Результат);

	ОпубликоватьКонец(Узел, Результат);

КонецПроцедуры

Функция НовыйРезультат(Знач Состояние, Причины)
	Возврат _ТабакеркаРезультатов.Достать(Массивы.ИзЭлементов(Состояние, Причины, ""));
КонецФункции

Процедура ОпубликоватьНачало(Узел)

	_ПубликаторСобытий.ОпубликоватьСобытие(
		Узел,
		?(ЭтоНабор(Узел), "ИсполнениеТестНаборНачало", "ИсполнениеТестНачало"),
		Новый Массив
	);

КонецПроцедуры

Процедура ОпубликоватьКонец(Узел, Результат)

	_ПубликаторСобытий.ОпубликоватьСобытие(
		Узел,
		?(ЭтоНабор(Узел), "ИсполнениеТестНаборКонец", "ИсполнениеТестКонец"),
		Массивы.ИзЭлементов(Результат)
	);

КонецПроцедуры

Функция ЭтоНабор(Узел)
	Возврат ТипЗнч(Узел) = Тип("ОпределениеТестНабора");
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин Поделка,
	&Пластилин ПубликаторСобытий,
	&Табакерка &Пластилин("РезультатВыполненияТеста") ТабакеркаРезультатов,
	&Деталька("OneUnit.ПрерыватьПриПервомПадении", ЗначениеПоУмолчанию = Ложь) ПрерыватьПриПадении)

	_Поделка              = Поделка;
	_ПубликаторСобытий    = ПубликаторСобытий;
	_ТабакеркаРезультатов = ТабакеркаРезультатов;
	_ПрерыватьПриПадении  = ПрерыватьПриПадении;
	_Прервано             = Новый АтомарноеБулево();

КонецПроцедуры
