// Раздает узлы тест-плана исполнителям и публикует события их исполнения:
// начало и конец плана и каждого розданного узла. Исполнителя узла диспетчер
// находит по имени, которое обнаружитель записал в узел. Исполнитель возвращает
// результат узла, а детей набора и контейнера отдает обратно диспетчеру.
//
// Прекращение прогона на первом падении - здесь же: узлы, до которых
// прекращенный прогон не дошел, отмечаются незапущенными.
//
// Для чистого обнаружения (discover) диспетчер раздает исполнителям наборы
// плана на разворачивание: исполнитель, который исполняет набор в своей среде,
// обнаруживает там его состав

#Использовать atomic
#Использовать collectionos

Перем _Поделка;              // Поделка - Поделка текущего прогона, в ней живут исполнители
Перем _ПубликаторСобытий;    // ПубликаторСобытий - Публикатор событий исполнения
Перем _ТабакеркаРезультатов; // Табакерка - Результаты выполнения тестов
Перем _ПрерыватьПриПадении;  // Булево - Прекращать прогон после первого упавшего теста
Перем _Прервано;             // АтомарноеБулево - Прогон прекращен, оставшиеся узлы не запускаются
Перем _Лог;                  // Лог - Лог ядра

// Исполняет тест-план
//
// Параметры:
//  ТестПлан - ТестПлан - Составленный тест-план
//
Процедура Исполнить(ТестПлан) Экспорт

	// Поделка живет дольше одного прогона: без сброса повторный Тестировать()
	// не выполнил бы ни одного теста
	_Прервано.Установить(Ложь);

	_ПубликаторСобытий.ОпубликоватьСобытие(ТестПлан, "ИсполнениеТестПланНачало", Новый Массив);

	ИсполнитьДетей(ТестПлан);

	_ПубликаторСобытий.ОпубликоватьСобытие(ТестПлан, "ИсполнениеТестПланКонец", Новый Массив);

КонецПроцедуры

// Разворачивает состав наборов плана, который обнаруживается только в их средах,
// не исполняя тесты
//
// Параметры:
//  ТестПлан - ТестПлан - Составленный тест-план
//
Процедура Развернуть(ТестПлан) Экспорт
	ТестПлан.Дети().ПроцессорКоллекции().ДляКаждого("Набор -> РазвернутьНабор(Набор)", ЭтотОбъект);
КонецПроцедуры

// Отдает набор его исполнителю на разворачивание. Отказ исполнителя не прерывает
// обнаружение - набор остается пустым. Экспортная, потому что ее вызывает лямбда
// обхода наборов, а лямбде доступны только экспортные методы
//
// Параметры:
//  Набор - ОпределениеТестНабора - Разворачиваемый набор
//
Процедура РазвернутьНабор(Набор) Экспорт

	Попытка
		_Поделка.НайтиЖелудь(Набор.Исполнитель()).Развернуть(Набор);
	Исключение

		_Лог.Предупреждение(СтрШаблон(
			"Не удалось обнаружить состав набора %1:%2%3",
			Набор.Имя(),
			Символы.ПС,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
		));

	КонецПопытки;

КонецПроцедуры

// Исполняет детей узла по порядку: наборы плана, тесты набора, итерации
// контейнера. Исполнитель набора или контейнера отдает сюда его детей
//
// Параметры:
//  Узел - ТестПлан, ОпределениеТестНабора, ОпределениеТеста - Узел, дети которого исполняются
//
Процедура ИсполнитьДетей(Узел) Экспорт
	Узел.Дети().ПроцессорКоллекции().ДляКаждого("Дитя -> ИсполнитьУзел(Дитя)", ЭтотОбъект);
КонецПроцедуры

// Исполняет узел: публикует его начало, отдает узел исполнителю и публикует
// конец с результатом исполнителя. Экспортная, потому что ее вызывает лямбда
// обхода детей, а лямбде доступны только экспортные методы
//
// Параметры:
//  Узел - ОпределениеТестНабора, ОпределениеТеста - Исполняемый узел
//
Процедура ИсполнитьУзел(Узел) Экспорт

	// Проверка на каждом узле: прогон прекращается и посреди набора,
	// его оставшиеся тесты тоже отмечаются
	Если _Прервано.Получить() Тогда
		ОтметитьНезапущенным(Узел);
		Возврат;
	КонецЕсли;

	ОпубликоватьНачало(Узел);

	Результат = _Поделка.НайтиЖелудь(Узел.Исполнитель()).Исполнить(Узел);

	ОпубликоватьКонец(Узел, Результат);

КонецПроцедуры

// Отмечает падение по результату любого теста прогона.
//
// Подписка, а не проверка по месту: результаты приходят разными путями - тесты
// текущей поделки и тесты изолированных сред, которые ретранслируются сюда
// по ходу их прогона
//
// Параметры:
//  Тест - ОпределениеТеста - Завершенный тест
//  Результат - РезультатВыполненияТеста - Результат теста
//
&ПодпискаНаСобытие("ИсполнениеТестКонец")
Процедура ОтметитьПадениеТеста(Тест, Результат) Экспорт
	ОтметитьПадение(Результат);
КонецПроцедуры

// Набор может оказаться красным и без единого упавшего теста: сломанный конструктор,
// ошибка в ПередВсеми, отказ изолированной среды
//
// Параметры:
//  Набор - ОпределениеТестНабора - Завершенный набор
//  Результат - РезультатВыполненияТеста - Результат набора
//
&ПодпискаНаСобытие("ИсполнениеТестНаборКонец")
Процедура ОтметитьПадениеНабора(Набор, Результат) Экспорт
	ОтметитьПадение(Результат);
КонецПроцедуры

Процедура ОтметитьПадение(Результат)

	Если Не _ПрерыватьПриПадении Или Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Падение - это сломанный код: упавшее утверждение или ошибка исполнения.
	// Пропущенные и прерванные прогон не останавливают, они ничего не говорят
	// о работоспособности
	Если Результат.Состояние() = СостоянияВыполненияТестов.Ошибка
		Или Результат.Состояние() = СостоянияВыполненияТестов.Сломан Тогда

		_Прервано.Установить(Истина);

	КонецЕсли;

КонецПроцедуры

// Отмечает пропущенным то, до чего прекращенный прогон не дошел.
//
// Прекращение не обрывает план: репортеры обходят план и спрашивают результат
// у каждого узла, а у незапущенного узла результата нет. Без этой отметки JUnit
// падал на пустом Опциональном, а изолированный набор терял результаты целиком -
// его дочерний прогон умирал на записи своего JSON-отчета. Заодно счетчики
// перестают показывать план короче, чем он есть.
//
// Параметры:
//  Узел - ОпределениеТестНабора, ОпределениеТеста - Незапущенный узел
//
Процедура ОтметитьНезапущенным(Узел)

	ОпубликоватьНачало(Узел);

	ОпубликоватьКонец(Узел, _ТабакеркаРезультатов.Достать(Массивы.ИзЭлементов(
		СостоянияВыполненияТестов.Пропущен,
		Списки.ИзЭлементов("Прогон прекращён на первом падении"),
		""
	)));

КонецПроцедуры

Процедура ОпубликоватьНачало(Узел)

	_ПубликаторСобытий.ОпубликоватьСобытие(
		Узел,
		?(ЭтоНабор(Узел), "ИсполнениеТестНаборНачало", "ИсполнениеТестНачало"),
		Новый Массив
	);

КонецПроцедуры

Процедура ОпубликоватьКонец(Узел, Результат)

	_ПубликаторСобытий.ОпубликоватьСобытие(
		Узел,
		?(ЭтоНабор(Узел), "ИсполнениеТестНаборКонец", "ИсполнениеТестКонец"),
		Массивы.ИзЭлементов(Результат)
	);

КонецПроцедуры

Функция ЭтоНабор(Узел)
	Возврат ТипЗнч(Узел) = Тип("ОпределениеТестНабора");
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин Поделка,
	&Пластилин ПубликаторСобытий,
	&Табакерка &Пластилин("РезультатВыполненияТеста") ТабакеркаРезультатов,
	&Деталька("OneUnit.ПрерыватьПриПервомПадении", ЗначениеПоУмолчанию = Ложь) ПрерыватьПриПадении,
	&Лог("oscript.lib.oneunit.core") Лог)

	_Поделка              = Поделка;
	_ПубликаторСобытий    = ПубликаторСобытий;
	_ТабакеркаРезультатов = ТабакеркаРезультатов;
	_ПрерыватьПриПадении  = ПрерыватьПриПадении;
	_Прервано             = Новый АтомарноеБулево();
	_Лог                  = Лог;

КонецПроцедуры
