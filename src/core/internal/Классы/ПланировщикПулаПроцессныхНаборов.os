// Планировщик параллельного прогона процессных наборов плана: до N воркеров
// oscript, события в порядке плана (головной слот — по мере строк, остальные —
// буфер до головы). Барьеры: не-процессные наборы и &Последовательный.
//
// Остановка воркера: 1commands возвращает объект Процess с методом Завершить()
// (см. шип в комментарии к ПрерватьАктивныеСлоты).

#Использовать collectionos
#Использовать "../../../shared"

Перем _Диспетчер;              // ДиспетчерТестов
Перем _ПроцессныйИсполнитель;  // ПроцессныйИсполнительТестов
Перем _Запускатель;            // ЗапускательТестирования
Перем _Параллельность;         // Число - Размер пула
Перем _ТаймаутВоркера;         // Число - Таймаут воркера в мс, 0 - выкл.
Перем _Лог;                    // Лог

// Исполняет детей тест-плана с учётом пула процессных наборов
//
// Параметры:
//  ТестПлан - ТестПлан - Корневой план
//
Процедура ИсполнитьДетейПлана(ТестПлан) Экспорт

	Дети = ТестПлан.Дети().ВМассив();
	Слоты = Новый СписокМассив;
	ИндексСледующего = 0;
	ИндексГоловы = 0;

	Пока ИндексГоловы < Дети.Количество() Или ЕстьНезавершенныеСлоты(Слоты) Цикл

		Если _Диспетчер.ПрогонПрерван() Тогда
			ДожатьИОчиститьСлоты(Слоты, ИндексГоловы, Дети);
			ПропуститьХвостПлана(Дети, ИндексСледующего);
			Возврат;
		КонецЕсли;

		Пока ИндексСледующего < Дети.Количество()
			И Слоты.Количество() < _Параллельность
			И Не _Диспетчер.ПрогонПрерван() Цикл

			Узел = Дети[ИндексСледующего];

			Если ЭтоБарьер(Узел) Тогда
				Прервать;
			КонецЕсли;

			Если Узел.Исполнитель() <> ИсполнителиТестов.Процессный Тогда
				Прервать;
			КонецЕсли;

			Слоты.Добавить(ЗапуститьСлот(Узел, ИндексСледующего, ИндексГоловы));
			ИндексСледующего = ИндексСледующего + 1;

		КонецЦикла;

		Если ИндексСледующего < Дети.Количество()
			И Слоты.Количество() = 0
			И Не _Диспетчер.ПрогонПрерван() Тогда

			_Диспетчер.ИсполнитьУзел(Дети[ИндексСледующего]);
			ИндексСледующего = ИндексСледующего + 1;
			ИндексГоловы = ИндексСледующего;
			Продолжить;

		КонецЕсли;

		ОпроситьСлоты(Слоты);

		Пока ИндексГоловы < Дети.Количество()
			И НайтиСлот(Слоты, ИндексГоловы).СодержитЗначение()
			И НайтиСлот(Слоты, ИндексГоловы).Получить().Завершен Цикл

			ЗавершитьИОпубликоватьСлот(НайтиСлот(Слоты, ИндексГоловы).Получить());
			УдалитьСлот(Слоты, ИндексГоловы);
			ИндексГоловы = ИндексГоловы + 1;

		КонецЦикла;

		ОбновитьГоловуСлотов(Слоты, ИндексГоловы);

		Если Слоты.Количество() = 0 И ИндексСледующего >= Дети.Количество() Тогда
			Прервать;
		КонецЕсли;

		Приостановить(20);

	КонецЦикла;

КонецПроцедуры

Функция ЭтоБарьер(Узел)

	Если ТипЗнч(Узел) <> Тип("ОпределениеТестНабора") Тогда
		Возврат Истина;
	КонецЕсли;

	Если Узел.Последовательный() Тогда
		Возврат Истина;
	КонецЕсли;

	Если Не Узел.ОшибкиОбнаружения().Пусто() Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Узел.Исполнитель() <> ИсполнителиТестов.Процессный;

КонецФункции

Функция ЗапуститьСлот(Набор, Знач ИндексПлана, Знач ИндексГоловы)

	Слот = Новый Структура;
	Слот.Вставить("Индекс", ИндексПлана);
	Слот.Вставить("Набор", Набор);
	Слот.Вставить("Завершен", Ложь);
	Слот.Вставить("Головной", Ложь);
	Слот.Вставить("Контекст", Неопределено);
	Слот.Вставить("Ретранслятор", Неопределено);
	Слот.Вставить("ОшибкаСреды", Опциональные.Пустой());

	Если _Диспетчер.ПрогонПрерван() Тогда
		Слот.Завершен = Истина;
		Возврат Слот;
	КонецЕсли;

	Пропуск = _ПроцессныйИсполнитель.ПропускНабора(Набор);

	Если Пропуск.СодержитЗначение() Тогда
		_Диспетчер.ОпубликоватьНачалоНабора(Набор);
		_Диспетчер.ОпубликоватьКонецНабора(Набор, Пропуск.Получить());
		Слот.Завершен = Истина;
		Возврат Слот;
	КонецЕсли;

	_Диспетчер.ОпубликоватьНачалоНабора(Набор);

	Ретранслятор = _ПроцессныйИсполнитель.НовыйРетранслятор(Набор);
	Ретранслятор.УстановитьОбработчикПадения(ЭтотОбъект);
	Ретранслятор.ПубликоватьМимоПерехвата();

	Если ИндексПлана > ИндексГоловы Тогда
		Ретранслятор.ОтложитьПубликацию();
	Иначе
		Слот.Головной = Истина;
	КонецЕсли;

	Идентификатор = Строка(Новый УникальныйИдентификатор);

	Попытка
		Слот.Контекст = _ПроцессныйИсполнитель.НачатьНаборВПуле(Набор, Ретранслятор, Идентификатор);
	Исключение
		Слот.ОшибкаСреды = Новый Опциональный(ИнформацияОбОшибке());
		Слот.Завершен = Истина;
	КонецПопытки;

	Слот.Ретранслятор = Ретранслятор;

	_Лог.Информация("Слот %1: старт набора %2", ИндексПлана, Набор.Имя());

	Возврат Слот;

КонецФункции

Процедура ОпроситьСлоты(Слоты)

	Для каждого Слот Из Слоты Цикл

		Если Слот.Завершен Или Слот.Контекст = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если _ТаймаутВоркера > 0
			И ТекущаяУниверсальнаяДатаВМиллисекундах() - Слот.Контекст.ВремяНачала > _ТаймаутВоркера Тогда

			_Лог.Ошибка("Слот %1: таймаут воркера набора %2", Слот.Индекс, Слот.Набор.Имя());
			_Запускатель.ПрерватьПрогон(Слот.Контекст);
			Слот.Завершен = Истина;

		Иначе
			Слот.Завершен = _Запускатель.ОпроситьПрогон(Слот.Контекст);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ЗавершитьИОпубликоватьСлот(Слот)

	Если Слот.Ретранслятор = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Результат = _ПроцессныйИсполнитель.ЗавершитьНаборВПуле(
		Слот.Ретранслятор,
		Слот.Контекст,
		Слот.ОшибкаСреды
	);

	Слот.Ретранслятор.ЗавершитьПубликациюМимоПерехвата();

	_Диспетчер.ОпубликоватьКонецНабора(Слот.Набор, Результат);

	_Лог.Информация("Слот %1: конец набора %2", Слот.Индекс, Слот.Набор.Имя());

КонецПроцедуры

Процедура ОбновитьГоловуСлотов(Слоты, Знач ИндексГоловы)

	Для каждого Слот Из Слоты Цикл

		Если Слот.Индекс = ИндексГоловы Тогда
			Если Не Слот.Головной Тогда
				Слот.Головной = Истина;
				Слот.Ретранслятор.СлитьОтложеннуюПубликацию();
			КонецЕсли;
		ИначеЕсли Слот.Индекс > ИндексГоловы Тогда
			Слот.Ретранслятор.ОтложитьПубликацию();
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ДожатьИОчиститьСлоты(Слоты, ИндексГоловы, Дети)

	ПрерватьАктивныеСлоты(Слоты);

	Пока ИндексГоловы < Дети.Количество() Цикл

		Найденный = НайтиСлот(Слоты, ИндексГоловы);

		Если Найденный.СодержитЗначение() Тогда
			Слот = Найденный.Получить();
			Если Не Слот.Завершен И Слот.Контекст <> Неопределено Тогда
				_Запускатель.ЗавершитьПрогон(Слот.Контекст);
			КонецЕсли;
			ЗавершитьИОпубликоватьСлот(Слот);
			УдалитьСлот(Слоты, ИндексГоловы);
		Иначе
			Прервать;
		КонецЕсли;

		ИндексГоловы = ИндексГоловы + 1;

	КонецЦикла;

КонецПроцедуры

// 1commands: Процесс.Завершить() доступен через Запускатель.ПрерватьПрогон
//
Процедура ПрерватьАктивныеСлоты(Слоты)

	Для каждого Слот Из Слоты Цикл
		Если Не Слот.Завершен И Слот.Контекст <> Неопределено Тогда
			_Запускатель.ПрерватьПрогон(Слот.Контекст);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПропуститьХвостПлана(Дети, Знач Индекс)

	Пока Индекс < Дети.Количество() Цикл
		_Диспетчер.ОтметитьНезапущенным(Дети[Индекс]);
		Индекс = Индекс + 1;
	КонецЦикла;

КонецПроцедуры

Функция ЕстьНезавершенныеСлоты(Слоты)

	Для каждого Слот Из Слоты Цикл
		Если Не Слот.Завершен Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция НайтиСлот(Слоты, Знач Индекс)

	Для каждого Слот Из Слоты Цикл
		Если Слот.Индекс = Индекс Тогда
			Возврат Новый Опциональный(Слот);
		КонецЕсли;
	КонецЦикла;

	Возврат Опциональные.Пустой();

КонецФункции

Процедура УдалитьСлот(Слоты, Знач Индекс)

	Для Позиция = 0 По Слоты.ВГраница() Цикл
		Если Слоты[Позиция].Индекс = Индекс Тогда
			Слоты.Удалить(Позиция);
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработатьПадение(Результат) Экспорт
	_Диспетчер.ОтметитьПадениеИзПланировщика(Результат);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин ДиспетчерТестов,
	&Пластилин ПроцессныйИсполнительТестов,
	&Пластилин ЗапускательТестирования,
	&Деталька("OneUnit.Параллельность", ЗначениеПоУмолчанию = 1) Параллельность,
	&Деталька("OneUnit.ТаймаутВоркераПроцесса", ЗначениеПоУмолчанию = 0) ТаймаутВоркера,
	&Лог("oscript.lib.oneunit.core") Лог)

	_Диспетчер             = ДиспетчерТестов;
	_ПроцессныйИсполнитель = ПроцессныйИсполнительТестов;
	_Запускатель           = ЗапускательТестирования;
	_Параллельность        = Макс(1, Параллельность);
	_ТаймаутВоркера        = ТаймаутВоркера;
	_Лог                   = Лог;

КонецПроцедуры
