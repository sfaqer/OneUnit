// Исполняет изолированные наборы и тесты в свежей поделке того же процесса
// (&Изолированный с уровнем "Поделка") и вклеивает их результаты в общий прогон.
// События исполнения изолированного набора ретранслируются в текущий прогон
// по ходу, так что для репортеров и статистики это обычные тесты.
// Для чистого обнаружения (discover) состав изолированного набора обнаруживается
// в свежей поделке без исполнения тестов и вклеивается в план зеркалами.

#Использовать autumn
#Использовать collectionos
#Использовать lambdas
#Использовать "../../../shared"

Перем _ТабакеркаРезультатов;    // Табакерка - Результаты выполнения тестов
Перем _ТабакеркаРетрансляторов; // Табакерка - Ретрансляторы событий изолированных наборов
Перем _ПубликаторСобытий;       // ПубликаторСобытий - Публикатор событий исполнения текущего прогона
Перем _ПостроительТочкиВхода;   // ПостроительТочкиВхода - Настройки деталек изолированной поделки
Перем _ПереносРезультатов;      // ПереносРезультатов - Причины отказов изолированной среды
Перем _РепортерПланJSON;        // РепортерПланJSON - Состав плана
Перем _ФабрикаЭкземпляров;      // ФабрикаЭкземпляров - Экземпляры тестовых наборов для лямбды совета
Перем _ПрерыватьПриПадении;     // Булево - Прекращать прогон после первого упавшего теста

// Исполняет изолированный набор или тест в свежей поделке и возвращает его
// результат. События тестов набора ретранслируются в текущий прогон по ходу его
// исполнения, события итераций изолированного контейнера публикуются по итогам.
// Изолированный тест прогоняется набором, отфильтрованным до этого теста, - так
// у теста сохраняется полный жизненный цикл набора, а его условия проверяются
// в его среде, как условия изолированного набора. Отказ изолированной среды
// не прерывает прогон - узел помечается сломанным
//
// Параметры:
//  Узел - ОпределениеТестНабора, ОпределениеТеста - Изолированный набор или тест
//
//  Возвращаемое значение:
//   РезультатВыполненияТеста - Результат узла
//
Функция Исполнить(Узел) Экспорт

	Если ТипЗнч(Узел) = Тип("ОпределениеТестНабора") Тогда
		Возврат ИсполнитьНабор(Узел);
	КонецЕсли;

	Возврат ИсполнитьТест(Узел, Узел.Набор());

КонецФункции

// Обнаруживает состав изолированного набора в свежей поделке, не исполняя тесты,
// и наполняет набор зеркалами обнаруженных определений - для чистого обнаружения
// (discover), на состав которого опираются внешние инструменты
//
// Параметры:
//  Набор - ОпределениеТестНабора - Изолированный набор
//
Процедура Развернуть(Набор) Экспорт

	Прогон = ВыполнитьВПоделке(Набор, Набор, "", Истина, Опциональные.Пустой());

	НовыйРетранслятор(Набор).ВклеитьСостав(_РепортерПланJSON.СоставПлана(Прогон.План));

КонецПроцедуры

Функция ИсполнитьНабор(Набор)

	Ретранслятор = НовыйРетранслятор(Набор);

	Вывод       = "";
	ОшибкаСреды = Опциональные.Пустой();

	Попытка
		Вывод = ВыполнитьВПоделке(
			Набор,
			Набор,
			"",
			Ложь,
			Новый Опциональный(Ретранслятор)
		).Вывод;
	Исключение
		ОшибкаСреды = Новый Опциональный(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Ретранслятор.Завершить(Вывод, ОшибкаСреды);

КонецФункции

Функция ИсполнитьТест(Тест, ОпределениеНабора)

	Попытка
		Прогон = ВыполнитьВПоделке(Тест, ОпределениеНабора, Тест.ИмяМетода(), Ложь, Опциональные.Пустой());
	Исключение
		Возврат РезультатСломан(ИнформацияОбОшибке());
	КонецПопытки;

	НайденныйНабор = НайтиДитя(Прогон.План, ОпределениеНабора.Имя());

	Если Не НайденныйНабор.СодержитЗначение() Тогда
		Возврат РезультатСломан(_ПереносРезультатов.ПричинаТестНеВыполнен(
			Тест,
			СтрШаблон("дочерний прогон не обнаружил набор %1", ОпределениеНабора.Имя()),
			Прогон.Вывод
		));
	КонецЕсли;

	НаборСреды      = НайденныйНабор.Получить();
	РезультатНабора = Прогон.Статистика.Результат(НаборСреды);

	Если РезультатНабора.Состояние() <> СостоянияВыполненияТестов.Успех Тогда
		// Набор в изолированной среде не выполнился (например, упал ПередВсеми) -
		// тест наследует его состояние и причины
		Возврат РезультатНабора;
	КонецЕсли;

	ТестСреды = НайтиДитя(НаборСреды, Тест.Имя());

	Если Не ТестСреды.СодержитЗначение() Тогда
		Возврат РезультатСломан(_ПереносРезультатов.ПричинаТестНеВыполнен(
			Тест,
			"в дочернем прогоне нет результата этого теста",
			Прогон.Вывод
		));
	КонецЕсли;

	Возврат РезультатПоддерева(ТестСреды.Получить(), Тест, Прогон.Статистика, Прогон.Вывод);

КонецФункции

// Возвращает результат узла изолированного прогона со временем выполнения,
// измеренным там. Для контейнера дополнительно публикует события исполнения
// итераций, сопоставляя их с детьми узла в плане родителя по именам
//
// Параметры:
//  УзелСреды - ОпределениеТеста - Узел изолированного прогона
//  Узел - ОпределениеТеста - Соответствующий узел в плане родителя
//  СтатистикаСреды - РепортерСтатистика - Статистика изолированного прогона
//  Вывод - Строка - Захваченный вывод дочернего прогона
//
//  Возвращаемое значение:
//   РезультатВыполненияТеста - Результат узла
//
Функция РезультатПоддерева(УзелСреды, Узел, СтатистикаСреды, Знач Вывод)

	Если Узел.ТипОпределения() <> ТипыОпределенийТестов.Контейнер Тогда
		Возврат СтатистикаСреды.Результат(УзелСреды).ПеренестиВремяВыполнения(
			СтатистикаСреды.СтатистикаТеста(УзелСреды).ПолучитьИлиУмолчание("ВремяВыполнения", 0)
		);
	КонецЕсли;

	РезультатКонтейнера = СтатистикаСреды.Результат(УзелСреды);

	Если РезультатКонтейнера.Состояние() <> СостоянияВыполненияТестов.Успех Тогда
		// Контейнер пропущен в изолированной среде (например, по своему условию):
		// его итерации не исполнялись и событий не получают
		Возврат РезультатКонтейнера;
	КонецЕсли;

	Для каждого Дитя Из Узел.Дети() Цикл

		_ПубликаторСобытий.ОпубликоватьСобытие(Дитя, "ИсполнениеТестНачало", Новый Массив);

		ДитяСреды = НайтиДитя(УзелСреды, Дитя.Имя());

		Если ДитяСреды.СодержитЗначение() Тогда
			РезультатДитя = РезультатПоддерева(ДитяСреды.Получить(), Дитя, СтатистикаСреды, Вывод);
		Иначе
			РезультатДитя = РезультатСломан(_ПереносРезультатов.ПричинаТестНеВыполнен(
				Дитя,
				"в дочернем прогоне нет результата этой итерации",
				Вывод
			));
		КонецЕсли;

		_ПубликаторСобытий.ОпубликоватьСобытие(
			Дитя,
			"ИсполнениеТестКонец",
			Массивы.ИзЭлементов(РезультатДитя)
		);

	КонецЦикла;

	Возврат РезультатУспех();

КонецФункции

// Создает свежую поделку по описанию изоляции, прогоняет в ней файл набора и
// возвращает результаты прогона
//
// Параметры:
//  Источник - ОпределениеТестНабора, ОпределениеТеста - Определение с описанием изоляции
//  ОпределениеНабора - ОпределениеТестНабора - Набор изолированного прогона
//  ФильтрМетода - Строка - Имя тестового метода для изоляции одного теста,
//                 пустая строка - прогон всего набора
//  ТолькоОбнаружение - Булево - Составить план, не исполняя тесты
//  Ретранслятор - Опциональный - Ретранслятор (РетрансляторСобытийИзоляции), которому
//                 свежая поделка транслирует события исполнения, пустой - без трансляции
//
//  Возвращаемое значение:
//   Структура - Результаты изолированного прогона:
//    * Поделка    - Поделка - Поделка изолированного прогона
//    * План       - ТестПлан - Выполненный тест-план
//    * Статистика - РепортерСтатистика - Статистика прогона
//    * Вывод      - Строка - Захваченный консольный вывод прогона
//
Функция ВыполнитьВПоделке(
	Источник,
	ОпределениеНабора,
	Знач ФильтрМетода,
	Знач ТолькоОбнаружение,
	Ретранслятор)

	Совет = ПостроитьСовет(Источник, ОпределениеНабора);

	Детальки = Новый Соответствие;
	Детальки.Вставить("КаталогиТестов", "");
	Детальки.Вставить("ФайлыТестов", ОпределениеНабора.Путь());
	Детальки.Вставить("Таймаут", Источник.Таймаут());
	Детальки.Вставить("ВыполняетсяВИзоляции", Истина);
	Детальки.Вставить("РежимВыводаЛога", РежимыВыводаЛога.Ничего);
	Детальки.Вставить("ТестовыеМетодыВключаемые", ФильтрМетода);
	Детальки.Вставить("ПрерыватьПриПервомПадении", _ПрерыватьПриПадении);

	Совет.ПолучитьСтроительМенеджераПараметров().ДобавитьПровайдерСоответствие(
		_ПостроительТочкиВхода.НастройкиДеталекПрогона(Детальки),
		_ПостроительТочкиВхода.ПриоритетДеталекПрогона(),
		"oneunit"
	);

	// Консольный вывод дочернего прогона (свой лог ошибок и статистики)
	// перехватывается, чтобы не разрывать вывод родителя: причины и выводы
	// тестов переносятся в результаты структурно
	ПотокВывода = Новый ПотокВПамяти();
	ТестированиеСлужебный.НачатьПерехватВывода(ПотокВывода);

	Попытка

		Поделка = Новый Поделка(Совет);
		Поделка.ЗапуститьПриложение();

		Если Ретранслятор.СодержитЗначение() Тогда
			Ретранслятор.Получить().ПубликоватьМимоПерехвата(ПотокВывода);
			Поделка.НайтиЖелудь("ТрансляторСобытийИзоляции", Массивы.ИзЭлементов(Ретранслятор.Получить()));
		КонецЕсли;

		Если ТолькоОбнаружение Тогда
			План = Поделка.НайтиЖелудь("МенеджерТестирования").Обнаружить();
		Иначе
			План = Поделка.НайтиЖелудь("МенеджерТестирования").Тестировать();
		КонецЕсли;

	Исключение
		ЗавершитьПерехватВывода(Ретранслятор);
		ПотокВывода.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	ЗавершитьПерехватВывода(Ретранслятор);

	Прогон = Новый Структура;
	Прогон.Вставить("Поделка", Поделка);
	Прогон.Вставить("План", План);
	Прогон.Вставить("Статистика", Поделка.НайтиЖелудь("РепортерСтатистика"));
	Прогон.Вставить("Вывод", ТестированиеСлужебный.ПрочитатьПоток(ПотокВывода));

	ПотокВывода.Закрыть();

	Возврат Прогон;

КонецФункции

Процедура ЗавершитьПерехватВывода(Ретранслятор)

	ТестированиеСлужебный.ЗавершитьПерехватВывода();

	Ретранслятор.ЕслиСодержитЗначение("Ретранслятор -> Ретранслятор.ЗавершитьПубликациюМимоПерехвата()");

КонецПроцедуры

// Строит совет создания изолированной поделки. При наличии лямбды совета
// исполняет ее в контексте набора, иначе возвращает совет по умолчанию.
//
// Параметры:
//  Источник - ОпределениеТестНабора, ОпределениеТеста - Определение с описанием изоляции
//  ОпределениеНабора - ОпределениеТестНабора - Набор изолированного прогона
//
//  Возвращаемое значение:
//   СоветДругогоМастера - Совет создания изолированной поделки
//
Функция ПостроитьСовет(Источник, ОпределениеНабора)

	ЛямбдаСовета = Источник.Изоляция().Получить().ЛямбдаСовета;

	Если Не ЗначениеЗаполнено(ЛямбдаСовета) Тогда
		Возврат Новый СоветДругогоМастера();
	КонецЕсли;

	Совет = Лямбда.Выражение(ЛямбдаСовета).Интерфейс(ФункциональныеИнтерфейсы.Вызываемый());

	// Набор, который не удалось создать, в изолированной среде сломается сам,
	// а совету без обращения к набору экземпляр не нужен
	_ФабрикаЭкземпляров.Экземпляр(ОпределениеНабора)
		.ЕслиСодержитЗначение(Новый Действие(Совет, "ЗахватитьОбъект"));

	Возврат Совет.ВДействие().Выполнить();

КонецФункции

// Ищет дочерний узел плана по имени: набор в плане, тест в наборе или итерацию
// в контейнере
//
// Параметры:
//  Родитель - ТестПлан, ОпределениеТестНабора, ОпределениеТеста - Узел плана изолированного прогона
//  Имя      - Строка - Имя дочернего узла
//
//  Возвращаемое значение:
//   Опциональный - Найденный узел (ОпределениеТестНабора, ОпределениеТеста), пустой - узла нет
//
Функция НайтиДитя(Родитель, Знач Имя)

	Возврат Новый Опциональный(
		Родитель.Дети().ПроцессорКоллекции()
			.Фильтровать("Дитя -> Дитя.Имя() = Имя", Новый Структура("Имя", Имя))
			.ПолучитьПервый(),
		Истина
	);

КонецФункции

Функция НовыйРетранслятор(ОпределениеНабора)
	Возврат _ТабакеркаРетрансляторов.Достать(Массивы.ИзЭлементов(ОпределениеНабора));
КонецФункции

Функция РезультатСломан(ИнформацияОбОшибке)
	Возврат Результат(СостоянияВыполненияТестов.Сломан, Списки.ИзЭлементов(ИнформацияОбОшибке));
КонецФункции

Функция РезультатУспех()
	Возврат Результат(СостоянияВыполненияТестов.Успех, Списки.ИзЭлементов());
КонецФункции

Функция Результат(Знач Состояние, Причины)
	Возврат _ТабакеркаРезультатов.Достать(Массивы.ИзЭлементов(Состояние, Причины, ""));
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин("РезультатВыполненияТеста") ТабакеркаРезультатов,
	&Табакерка &Пластилин("РетрансляторСобытийИзоляции") ТабакеркаРетрансляторов,
	&Пластилин ПубликаторСобытий,
	&Пластилин ПостроительТочкиВхода,
	&Пластилин ПереносРезультатов,
	&Пластилин РепортерПланJSON,
	&Пластилин ФабрикаЭкземпляров,
	&Деталька("OneUnit.ПрерыватьПриПервомПадении", ЗначениеПоУмолчанию = Ложь) ПрерыватьПриПадении)

	_ТабакеркаРезультатов    = ТабакеркаРезультатов;
	_ТабакеркаРетрансляторов = ТабакеркаРетрансляторов;
	_ПубликаторСобытий       = ПубликаторСобытий;
	_ПостроительТочкиВхода   = ПостроительТочкиВхода;
	_ПереносРезультатов      = ПереносРезультатов;
	_РепортерПланJSON        = РепортерПланJSON;
	_ФабрикаЭкземпляров      = ФабрикаЭкземпляров;
	_ПрерыватьПриПадении     = ПрерыватьПриПадении;

КонецПроцедуры
