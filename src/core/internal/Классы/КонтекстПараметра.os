// Описание параметра метода или конструктора тестового набора.
// Передается поставщику значения первым аргументом функции Значение.

#Использовать annotations

Перем Метод;  // СтрокаТаблицыЗначений - Данные метода с развернутыми аннотациями
Перем Индекс; // Число - Индекс параметра

// Метаданные метода с развернутыми аннотациями метода и его параметров
//
//  Возвращаемое значение:
//   СтрокаТаблицыЗначений - Данные метода: тестового, жизненного цикла или конструктора
//
Функция Метод() Экспорт
	Возврат Метод;
КонецФункции

// Индекс параметра среди параметров метода
//
//  Возвращаемое значение:
//   Число - Индекс, с нуля
//
Функция Индекс() Экспорт
	Возврат Индекс;
КонецФункции

// Имя параметра
//
//  Возвращаемое значение:
//   Строка - Имя параметра
//
Функция Имя() Экспорт
	Возврат Данные().Имя;
КонецФункции

// Метаданные параметра с развернутыми аннотациями
//
//  Возвращаемое значение:
//   СтрокаТаблицыЗначений - Данные параметра: Имя, ПоЗначению, ЕстьЗначениеПоУмолчанию,
//                           ЗначениеПоУмолчанию, Аннотации (развернутые)
//
Функция Данные() Экспорт
	Возврат Метод.Параметры.Получить(Индекс);
КонецФункции

// Первая аннотация параметра с указанным именем
//
// Параметры:
//  ИмяАннотации - Строка - Имя аннотации
//
//  Возвращаемое значение:
//   Опциональный - Аннотация (СтрокаТаблицыЗначений), пустой - аннотации нет
//
Функция Аннотация(Знач ИмяАннотации) Экспорт
	Возврат Новый Опциональный(РаботаСАннотациями.ПолучитьАннотацию(Данные(), ИмяАннотации), Истина);
КонецФункции

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Блестяшка ОписаниеМетода, &Блестяшка ИндексПараметра)
	Метод  = ОписаниеМетода;
	Индекс = ИндексПараметра;
КонецПроцедуры
