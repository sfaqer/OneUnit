// Контекст исполнения узла тест-плана: хранилище значений, результат узла,
// признак ошибок в поддереве и действия освобождения ресурсов.
// Каждый узел имеет собственный контекст, связанный с контекстом родителя.
// Контексты тестов и наборов закрываются перед публикацией их результатов.
// Ресурсы экземпляра одиночки и экземпляров для условий контейнера принадлежат набору.
// Регистрация действий закрытия поддерживается для контекстов тестов и наборов.

#Использовать atomic
#Использовать collectionos
#Использовать "../../../shared"

Перем Узел;        // ТестПлан, ОпределениеТестНабора, ОпределениеТеста - Узел контекста
Перем Хранилище;   // СинхронизированнаяКарта - Значения, связанные с узлом
Перем Закрытия;    // СписокМассив из Действие - Действия закрытия в порядке добавления
Перем Результат;   // Опциональный - Результат узла (РезультатВыполненияТеста), известен при закрытии
Перем ЕстьПадения; // АтомарноеБулево - Наличие ошибок у узла или его потомков
Перем Закрыт;      // Булево - Контекст закрыт, повторное закрытие ничего не меняет
Перем Блокировка;  // БлокировкаРесурса - Синхронизация регистрации действий и закрытия контекста

// Узел, который исполняется в контексте
//
//  Возвращаемое значение:
//   - ТестПлан - Узел прогона
//   - ОпределениеТестНабора - Узел набора
//   - ОпределениеТеста - Узел теста или контейнера
//
Функция Узел() Экспорт
	Возврат Узел;
КонецФункции

// Контекст родительского узла: набора у теста, контейнера у итерации, прогона у набора
//
//  Возвращаемое значение:
//   Опциональный - Контекст (КонтекстИсполнения) родителя, пустой - это контекст прогона
//
Функция Родитель() Экспорт

	Если ТипЗнч(Узел) = Тип("ТестПлан") Тогда
		Возврат Опциональные.Пустой();
	КонецЕсли;

	Возврат Новый Опциональный(Узел.Родитель().Контекст());

КонецФункции

// Хранилище значений, связанных с узлом
//
//  Возвращаемое значение:
//   СинхронизированнаяКарта - Значения по ключам, которые выбирают поставщики
//
Функция Хранилище() Экспорт
	Возврат Хранилище;
КонецФункции

// Регистрирует действие освобождения ресурсов при закрытии контекста.
// Действия выполняются в обратном порядке регистрации. Ошибка одного действия
// не отменяет выполнение остальных; вывод и ошибки возвращаются методом Закрыть.
// Для контекстов прогона и контейнера регистрация вызывает исключение.
//
// После закрытия контекста переданное действие выполняется синхронно в этом вызове;
// его исключение передается вызывающему коду.
// При таймауте тестового метода контекст теста закрывается после ПослеКаждого,
// без ожидания завершения фонового задания.
//
// Параметры:
//  Действие - Действие - Действие с одним параметром - этим контекстом
//
Процедура ПриЗакрытии(Действие) Экспорт

	Если ТипЗнч(Узел) = Тип("ТестПлан") Тогда
		ВызватьИсключение "У контекста прогона нет действий закрытия: их вывод и исключения "
			+ "не попали бы ни в один результат. Созданное должно принадлежать узлу - набору или тесту";
	КонецЕсли;

	Если ТипЗнч(Узел) = Тип("ОпределениеТеста") И Узел.ТипОпределения() = ТипыОпределенийТестов.Контейнер Тогда
		ВызватьИсключение "У контекста контейнера нет действий закрытия: его результат известен до итераций, "
			+ "и падение закрытия после них не учли бы. Созданное должно принадлежать набору или тесту";
	КонецЕсли;

	Блокировка.Заблокировать();

	Попытка

		БылЗакрыт = Закрыт;

		Если Не БылЗакрыт Тогда
			Закрытия.Добавить(Действие);
		КонецЕсли;

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Если БылЗакрыт Тогда
		Действие.Выполнить(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

// Результат узла, переданный при закрытии контекста
//
//  Возвращаемое значение:
//   Опциональный - Результат (РезультатВыполненияТеста), пустой - узел не закрыт
//                  или закрыт без результата: при чистом обнаружении или после
//                  исключения, прервавшего исполнение плана
//
Функция Результат() Экспорт
	Возврат Результат;
КонецФункции

// Признак наличия состояния Ошибка или Сломан у узла либо его потомков.
// Ошибка действия закрытия устанавливает признак до выполнения следующего действия.
//
//  Возвращаемое значение:
//   Булево - Истина - упал узел или кто-то из его потомков
//
Функция ЕстьПадения() Экспорт
	Возврат ЕстьПадения.Получить();
КонецФункции

// Устанавливает признак падения у текущего контекста и всех его родителей
//
Процедура ОтметитьПадение() Экспорт

	ЕстьПадения.Установить(Истина);

	Родитель().ЕслиСодержитЗначение("Родитель -> Родитель.ОтметитьПадение()");

КонецПроцедуры

// Закрывает контекст и выполняет зарегистрированные действия в обратном порядке.
// Возвращает их вывод и исключения. Повторный вызов возвращает пустой итог закрытия
// и сохраняет ранее установленный результат узла.
//
// Параметры:
//  РезультатУзла - Опциональный - Результат узла (РезультатВыполненияТеста), пустой - узел
//              закрывается без результата, см. Результат
//
//  Возвращаемое значение:
//   Структура - Итог закрытия:
//    * Вывод   - Строка - Вывод действий закрытия
//    * Причины - СписокМассив из ИнформацияОбОшибке - Исключения действий, пустой - все выполнились
//
Функция Закрыть(РезультатУзла) Экспорт

	Закрытие = Новый Структура("Вывод, Причины", "", Новый СписокМассив);

	// Под блокировкой: действие, которое добавят после этого, выполнится сразу
	// и увидит результат и падения узла
	Блокировка.Заблокировать();

	Попытка

		БылЗакрыт = Закрыт;

		Если Не БылЗакрыт Тогда

			Результат = РезультатУзла;

			Если РезультатУзла.СодержитЗначение() И ЭтоПадение(РезультатУзла.Получить().Состояние()) Тогда
				ОтметитьПадение();
			КонецЕсли;

			ДействияЗакрытия = Закрытия.ВМассив();
			Закрытия.Очистить();

			Закрыт = Истина;

		КонецЕсли;

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Если БылЗакрыт Тогда
		Возврат Закрытие;
	КонецЕсли;

	Индекс = ДействияЗакрытия.ВГраница();

	Пока Индекс >= 0 Цикл

		Выполнение = ТестированиеСлужебный.ВыполнитьСПерехватомВывода(
			ДействияЗакрытия[Индекс],
			"Выполнить",
			Списки.ИзЭлементов(ЭтотОбъект)
		);

		Закрытие.Вывод = Закрытие.Вывод + Выполнение.Вывод;

		Если Выполнение.Ошибка.СодержитЗначение() Тогда
			Закрытие.Причины.Добавить(Выполнение.Ошибка.Получить());
			ОтметитьПадение();
		КонецЕсли;

		Индекс = Индекс - 1;

	КонецЦикла;

	Возврат Закрытие;

КонецФункции

Функция ЭтоПадение(Знач Состояние)
	Возврат Состояние = СостоянияВыполненияТестов.Ошибка Или Состояние = СостоянияВыполненияТестов.Сломан;
КонецФункции

Процедура ПриСозданииОбъекта(Владелец)

	Узел        = Владелец;
	Хранилище   = Новый СинхронизированнаяКарта(Новый КартаСоответствие);
	Закрытия    = Новый СписокМассив;
	Результат   = Опциональные.Пустой();
	ЕстьПадения = Новый АтомарноеБулево();
	Закрыт      = Ложь;
	Блокировка  = Новый БлокировкаРесурса(ЭтотОбъект);

КонецПроцедуры
