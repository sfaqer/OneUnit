// Сведения о текущем узле исполнения для аннотации ИнформацияОТесте.

#Использовать collectionos

Перем ФабрикаИнформации; // Табакерка - Сведения о тестах и наборах

// Параметры:
//  КонтекстЭлемента - КонтекстПараметра, КонтекстПоля - Параметр или поле, которому нужно значение
//  Контекст        - КонтекстИсполнения - Контекст текущего узла
//
// Возвращаемое значение:
//  ИнформацияОТесте - Сведения о текущем тесте или наборе
//
Функция Значение(КонтекстЭлемента, Контекст) Экспорт // BSLLS:UnusedParameters-off

	Узел = Контекст.Узел();
	Метод = Опциональные.Пустой();

	Если ТипЗнч(Узел) = Тип("ОпределениеТеста") Тогда
		Метод = Новый Опциональный(Узел.ИмяМетода());
	КонецЕсли;

	Возврат ФабрикаИнформации.Достать(Массивы.ИзЭлементов(
		Узел.Имя(),
		Узел.Теги(),
		Узел.Набор().ТипСценария(),
		Метод
	));

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Табакерка &Пластилин("ИнформацияОТесте") ТабакеркаИнформации)
	ФабрикаИнформации = ТабакеркаИнформации;
КонецПроцедуры
