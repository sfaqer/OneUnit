// Вызывает методы так, как исполняется код тестов: в фоновом задании с таймаутом
// и с перехватом консольного вывода. Исключение метода становится состоянием
// выполнения: упавшее утверждение - Ошибка, прерывание предположением - Прерван,
// любое другое - Сломан

#Использовать async
#Использовать collectionos
#Использовать "../../../shared"

// Вызывает метод объекта и возвращает итог вызова
//
// Параметры:
//  Объект    - Произвольный - Объект, метод которого вызывается
//  ИмяМетода - Строка - Имя экспортного метода
//  Параметры - ФиксированныйСписок из Произвольный - Значения параметров метода
//  Таймаут   - Число - Время на выполнение метода в миллисекундах, 0 - без ограничения
//
//  Возвращаемое значение:
//   Структура - Итог вызова:
//    * Состояние - Строка - Состояние выполнения, см. СостоянияВыполненияТестов
//    * Причины   - ФиксированныйСписок из ИнформацияОбОшибке - Исключение метода, пустой - метод выполнился
//    * Вывод     - Строка - Перехваченный консольный вывод метода
//    * Значение  - Опциональный - Значение, которое вернул метод, пустой - метод упал или ничего не вернул
//
Функция Вызвать(Объект, Знач ИмяМетода, Параметры, Знач Таймаут) Экспорт

	Выполнение = ТестированиеСлужебный.ВыполнитьСПерехватомВывода(
		ЭтотОбъект,
		"ДождатьсяВызова",
		Списки.ИзЭлементов(Новый Действие(Объект, ИмяМетода), Параметры, Таймаут)
	);

	Состояние = СостоянияВыполненияТестов.Успех;
	Причины   = Списки.ИзЭлементов();

	Если Выполнение.Ошибка.СодержитЗначение() Тогда

		Причина = Выполнение.Ошибка.Получить();

		// Опустим первый стек, это служебный re-throw от async
		Если ЗначениеЗаполнено(Причина.Причина) Тогда
			Причина = Причина.Причина;
		КонецЕсли;

		Состояние = СостояниеИсключения(Причина);
		Причины   = Списки.ИзЭлементов(Причина);

	КонецЕсли;

	Возврат Новый Структура(
		"Состояние, Причины, Вывод, Значение",
		Состояние,
		Причины,
		Выполнение.Вывод,
		Выполнение.Значение
	);

КонецФункции

// Выполняет делегат в фоновом задании и ждет его завершения. Экспортная, потому что
// вызывается через ТестированиеСлужебный.ВыполнитьСПерехватомВывода
//
// Параметры:
//  Делегат   - Действие - Вызываемый метод
//  Параметры - ФиксированныйСписок из Произвольный - Значения параметров метода
//  Таймаут   - Число - Время ожидания в миллисекундах, 0 - без ограничения
//
//  Возвращаемое значение:
//   Произвольный - Значение, которое вернул метод
//
Функция ДождатьсяВызова(Делегат, Параметры, Знач Таймаут) Экспорт
	Возврат Обещания.ВыполнитьДелегат(Делегат, Параметры.ВМассив(), Истина).Получить(Таймаут);
КонецФункции

Функция СостояниеИсключения(Причина)

	Если ТипЗнч(Причина.Параметры) = Тип("ИсключениеОшибкаУтверждения") Тогда
		Состояние = СостоянияВыполненияТестов.Ошибка;
	ИначеЕсли ТипЗнч(Причина.Параметры) = Тип("ИсключениеТестПрерван") Тогда
		Состояние = СостоянияВыполненияТестов.Прерван;
	Иначе
		Состояние = СостоянияВыполненияТестов.Сломан;
	КонецЕсли;

	Возврат Состояние;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
