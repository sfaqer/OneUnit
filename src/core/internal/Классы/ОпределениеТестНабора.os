#Использовать collectionos
#Использовать fluent

Перем _Дети;
Перем _Определение;
Перем _Родитель;
Перем _Имя;
Перем _Таймаут;
Перем ЖизненныйЦикл; // ЖизненныйЦиклНабора - Конструктор и этапы исполнения набора
Перем _Теги;
Перем ПутьКФайлу; // Опциональный - Путь к исходному файлу (Строка); пустой - файл неизвестен
Перем _Условия;
Перем _Изоляция;
Перем _Исполнитель;
Перем _ОшибкиОбнаружения;
Перем Сигнатуры;             // КартаСоответствие из КлючИЗначение - Сигнатуры (СигнатураМетода) методов по именам

Перем ПоляСПоставщиками; // ФиксированныйСписок из КонтекстПоля - Поля, значения которых дают поставщики
Перем Контекст;          // КонтекстИсполнения - Контекст исполнения набора
Перем Одиночка;          // Булево - Набор-одиночка: экземпляр один на прогон

Перем ДетиОтсортированы;
Перем ВыводОбнаружения; // Строка - Вывод обнаружения набора в изолированной среде

Функция Родитель() Экспорт
	Возврат _Родитель;
КонецФункции

Функция Дети() Экспорт

	Если Не ДетиОтсортированы Тогда
		_Дети.Сортировать("Первый, Второй ->
			|	Если Первый.Порядок() > Второй.Порядок() Тогда
			|		Возврат 1;
			|	ИначеЕсли Первый.Порядок() < Второй.Порядок() Тогда
			|		Возврат -1;
			|	Иначе
			|		Возврат 0;
			|	КонецЕсли;
			|"
		);

		ДетиОтсортированы = Истина;

	КонецЕсли;

	Возврат Новый ФиксированныйСписок(_Дети);

КонецФункции

Функция Теги() Экспорт
	Возврат Новый ФиксированныйСписок(_Теги);
КонецФункции

// Имя желудя набора в поделке, экземпляры набора создаются по нему
//
//  Возвращаемое значение:
//   Строка - Имя класса сценария набора
//
Функция ИмяЖелудя() Экспорт
	Возврат _Определение.Имя();
КонецФункции

// Тип сценария тестового набора.
//
// Возвращаемое значение:
//  Тип - Тип, экземпляры которого создаются для набора
//
Функция ТипСценария() Экспорт
	Возврат _Определение.ТипЖелудя();
КонецФункции

Функция Таймаут() Экспорт
	Возврат ?(ЗначениеЗаполнено(_Таймаут), _Таймаут, Родитель().Таймаут());
КонецФункции

// Возвращает известный путь к исходному файлу набора.
//
// Возвращаемое значение:
//  Опциональный - Путь (Строка); пустой - у набора нет известного исходного файла
//
Функция Путь() Экспорт
	Возврат ПутьКФайлу;
КонецФункции

Функция Имя() Экспорт
	Возврат _Имя;
КонецФункции

Функция ПолноеИмя() Экспорт
	Возврат Имя();
КонецФункции

Функция Условия() Экспорт
	Возврат Новый ФиксированныйСписок(_Условия);
КонецФункции

// Описание изоляции набора, если набор изолированный
//
//  Возвращаемое значение:
//   Опциональный - Описание изоляции (см. ОбнаружительТестов.ИзоляцияАннотации),
//                  пустой - набор выполняется обычным образом
//
Функция Изоляция() Экспорт
	Возврат _Изоляция;
КонецФункции

// Имя желудя-исполнителя набора
//
//  Возвращаемое значение:
//   Строка - Имя исполнителя, см. ИсполнителиТестов
//
Функция Исполнитель() Экспорт
	Возврат _Исполнитель;
КонецФункции

// Набор, к которому относится узел: для набора - он сам
//
//  Возвращаемое значение:
//   ОпределениеТестНабора - Этот набор
//
Функция Набор() Экспорт
	Возврат ЭтотОбъект;
КонецФункции

// Ошибки обнаружения набора: состав набора не удалось обнаружить
//
//  Возвращаемое значение:
//   ФиксированныйСписок из ИнформацияОбОшибке - Ошибки, пустой - набор обнаружен
//
Функция ОшибкиОбнаружения() Экспорт
	Возврат Новый ФиксированныйСписок(_ОшибкиОбнаружения);
КонецФункции

// Вывод обнаружения набора в изолированной среде
//
//  Возвращаемое значение:
//   Строка - Вывод совета и обнаружения, пустая строка - вывода нет
//
Функция ВыводОбнаружения() Экспорт
	Возврат ВыводОбнаружения;
КонецФункции

// Дополняет вывод обнаружения набора.
// Удаляет пробельные символы по краям фрагментов и соединяет непустые переводом строки.
//
// Параметры:
//  Вывод - Строка - Вывод обнаружения
//
Процедура ДобавитьВыводОбнаружения(Знач Вывод) Экспорт

	ВыводОбнаружения = ПроцессорыКоллекций.ИзНабора(ВыводОбнаружения, Вывод)
		.Обработать("Фрагмент -> СокрЛП(Фрагмент)")
		.Фильтровать("Фрагмент -> Не ПустаяСтрока(Фрагмент)")
		.ВСтроку(Символы.ПС);

КонецПроцедуры

// Отмечает ошибку обнаружения набора: узел остается в плане и отчитывается
// сломанным с этой причиной
//
// Параметры:
//  Причина - ИнформацияОбОшибке - Ошибка обнаружения
//
Процедура ДобавитьОшибкуОбнаружения(Причина) Экспорт
	_ОшибкиОбнаружения.Добавить(Причина);
КонецПроцедуры

// Признак ошибок обнаружения у набора или его потомков
//
//  Возвращаемое значение:
//   Булево - Истина - в поддереве есть узлы с ошибками обнаружения
//
Функция ЕстьОшибкиОбнаружения() Экспорт

	Возврат Не _ОшибкиОбнаружения.Пусто()
		Или Дети().ПроцессорКоллекции().ЛюбойСоответствует("Дитя -> Дитя.ЕстьОшибкиОбнаружения()");

КонецФункции

// Возвращает сигнатуру метода по имени.
// Вызывает исключение, если сигнатура отсутствует.
//
// Параметры:
//  ИмяМетода - Строка - Имя метода
//
//  Возвращаемое значение:
//   СигнатураМетода - Сигнатура метода
//
Функция Сигнатура(Знач ИмяМетода) Экспорт
	Возврат Сигнатуры.Получить(ИмяМетода).ИначеВызватьИсключение(
		Новый ИнформацияОбОшибке(
			СтрШаблон("Не найдена сигнатура метода %1 в тестовом наборе %2", ИмяМетода, Имя()),
			Неопределено
		)
	);
КонецФункции

// Ищет сигнатуру конструктора набора
//
//  Возвращаемое значение:
//   Опциональный - Сигнатура (СигнатураМетода), пустой - набор создается завязью
//                  без параметров или объявление конструктора неверное
//
Функция НайтиСигнатуруКонструктора() Экспорт
	Возврат ЖизненныйЦикл.Конструктор();
КонецФункции

// Описание конструктора и этапов исполнения набора.
//
// Возвращаемое значение:
//  ЖизненныйЦиклНабора - Общее описание для обнаружения и исполнения
//
Функция ЖизненныйЦикл() Экспорт
	Возврат ЖизненныйЦикл;
КонецФункции

// Поля набора с поставщиками значений
//
//  Возвращаемое значение:
//   ФиксированныйСписок из КонтекстПоля - Поля с поставщиками
//
Функция ПоляСПоставщиками() Экспорт
	Возврат ПоляСПоставщиками;
КонецФункции

// Контекст исполнения набора
//
//  Возвращаемое значение:
//   КонтекстИсполнения - Контекст набора
//
Функция Контекст() Экспорт
	Возврат Контекст;
КонецФункции

// Признак использования одного экземпляра набора в пределах прогона
//
//  Возвращаемое значение:
//   Булево - Истина - набор одиночка
//
Функция Одиночка() Экспорт
	Возврат Одиночка;
КонецФункции

Функция ПередВсеми() Экспорт
	Возврат ЖизненныйЦикл.ПередВсеми().Методы();
КонецФункции

Функция ПередКаждым() Экспорт
	Возврат ЖизненныйЦикл.ПередКаждым().Методы();
КонецФункции

Функция ПослеВсех() Экспорт
	Возврат ЖизненныйЦикл.ПослеВсех().Методы();
КонецФункции

Функция ПослеКаждого() Экспорт
	Возврат ЖизненныйЦикл.ПослеКаждого().Методы();
КонецФункции

Процедура ДобавитьТест(ОпределениеТеста) Экспорт
	ДетиОтсортированы = Ложь;
	_Дети.Добавить(ОпределениеТеста);
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Представление, СтандартнаяОбработка) // BSLLS:UnusedLocalMethod-off
	СтандартнаяОбработка = Ложь;
	Представление = СтрШаблон(
		"%1 (%2)",
		_Имя,
		ПутьКФайлу.Иначе_("Не удалось определить путь к тестовому набору")
	);
КонецПроцедуры

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(
	&Пластилин ПутиКТестовымНаборам,
	&Табакерка &Пластилин("ЖизненныйЦиклНабора") ОписанияЦикла,
	&Блестяшка Определение,
	&Блестяшка Родитель,
	&Блестяшка Таймаут,
	&Блестяшка Теги,
	&Блестяшка Условия,
	&Блестяшка МетодыЖизненногоЦикла,
	&Блестяшка Изоляция,
	&Блестяшка Исполнитель,
	&Блестяшка СигнатурыМетодов,
	&Блестяшка ОписаниеКонструктора,
	&Блестяшка ЗаполняемыеПоля,
	&Блестяшка НаборОдиночка)

	_Дети              = Новый СписокМассив;
	_Определение       = Определение;
	_Родитель          = Родитель;
	_Таймаут           = Таймаут;
	_Теги              = Теги;
	_Условия           = Условия;
	ЖизненныйЦикл     = ОписанияЦикла.Достать(Массивы.ИзЭлементов(
		МетодыЖизненногоЦикла,
		?(Определение.Завязь().ЭтоКонструктор(), Определение.Завязь().ДанныеМетода().Имя, ""),
		ОписаниеКонструктора
	));
	_Изоляция          = Изоляция;
	_Исполнитель       = Исполнитель;
	_ОшибкиОбнаружения = Новый СписокМассив;
	ВыводОбнаружения = "";
	Сигнатуры          = СигнатурыМетодов;

	ПоляСПоставщиками     = Новый ФиксированныйСписок(ЗаполняемыеПоля);
	Контекст              = Новый КонтекстИсполнения(ЭтотОбъект);
	Одиночка              = НаборОдиночка;

	ПутьКФайлу = ПутиКТестовымНаборам.Получить(Строка(Определение.ТипЖелудя()));

	_Имя = СтрЗаменить(Определение.Имя(), "oneunit_testsuite_", "");

	ДетиОтсортированы = Истина;

КонецПроцедуры
