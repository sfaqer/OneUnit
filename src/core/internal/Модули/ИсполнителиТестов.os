// Имена желудей-исполнителей узлов тест-плана: обнаружитель записывает в узел
// имя его исполнителя, диспетчер находит исполнителя по нему

Перем Асинхронный Экспорт;
Перем Поделочный Экспорт;
Перем Процессный Экспорт;

Асинхронный = "АсинхронныйИсполнительТестов";
Поделочный  = "ПоделочныйИсполнительТестов";
Процессный  = "ПроцессныйИсполнительТестов";
