// Сведения о конкретном вызове параметризованного теста.

#Использовать collectionos

Перем Номер; // Число - Номер вызова, начиная с единицы
Перем Аргументы; // ФиксированныйСписок из Произвольный - Аргументы источника

// Возвращает номер вызова среди значений источников текущего тестового метода.
//
// Возвращаемое значение:
//  Число - Номер вызова, начиная с единицы
//
Функция НомерВызова() Экспорт
	Возврат Номер;
КонецФункции

// Возвращает аргументы, предоставленные источником для текущего вызова.
// Список доступен только для чтения.
//
// Возвращаемое значение:
//  ФиксированныйСписок из Произвольный - Аргументы источника
//
Функция Аргументы() Экспорт
	Возврат Аргументы;
КонецФункции

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Блестяшка НомерВызова, &Блестяшка АргументыВызова)

	Номер = НомерВызова;
	Аргументы = Списки.Скопировать(АргументыВызова);

КонецПроцедуры
