// Сведения о текущем тесте или тестовом наборе.

#Использовать collectionos

Перем ОтображаемоеИмя; // Строка - Имя текущего узла
Перем Теги;            // ФиксированноеМножество из Строка - Теги узла без повторений
Перем Набор;           // Тип - Тип сценария тестового набора
Перем Метод;           // Опциональный - ИнформацияОМетоде, пустой - узел набора

// Возвращает отображаемое имя текущего теста или набора.
// Для повторения и параметризованного вызова возвращает имя конкретной итерации.
//
// Возвращаемое значение:
//  Строка - Отображаемое имя
//
Функция ОтображаемоеИмя() Экспорт
	Возврат ОтображаемоеИмя;
КонецФункции

// Возвращает теги текущего узла, включая теги тестового набора.
//
// Возвращаемое значение:
//  ФиксированноеМножество из Строка - Теги без повторений
//
Функция Теги() Экспорт
	Возврат Теги;
КонецФункции

// Возвращает тип сценария тестового набора.
//
// Возвращаемое значение:
//  Тип - Тип сценария, которому принадлежит текущий тест
//
Функция Набор() Экспорт
	Возврат Набор;
КонецФункции

// Возвращает описание исходного тестового метода.
// Для повторения и параметризованного вызова возвращает метод шаблона.
//
// Возвращаемое значение:
//  Опциональный - ИнформацияОМетоде; пустой - текущий узел является набором
//
Функция Метод() Экспорт
	Возврат Метод;
КонецФункции

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин("ИнформацияОМетоде") ОписанияМетодов,
	&Блестяшка ИмяУзла,
	&Блестяшка ТегиУзла,
	&Блестяшка ТипНабора,
	&Блестяшка ТестовыйМетод)

	ОтображаемоеИмя = ИмяУзла;
	Теги = Новый ФиксированноеМножество(Новый МножествоСоответствие(ТегиУзла));
	Набор = ТипНабора;
	Метод = Опциональные.Пустой();

	Если ТестовыйМетод.СодержитЗначение() Тогда

		Метод = Новый Опциональный(ОписанияМетодов.Достать(Массивы.ИзЭлементов(
			ТестовыйМетод.Получить(),
			ТипНабора
		)));

	КонецЕсли;

КонецПроцедуры
