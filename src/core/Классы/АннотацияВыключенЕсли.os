#Использовать lambdas

Перем _Условие; // Проверяемое лямбда выражение
Перем _Причина; // Причина пропуска теста

// Аннотация определяет что тест будет выключен в случае если переданное выражение вернет `Истина`
//
// Параметры:
//  Значение - Строка - [Лямбда-выражение](https://github.com/oscript-library/lambdas) без параметров, которое
//   должно вернуть `Булево`, `Истина` - тест будет пропущен, `Ложь` - тест будет выполнен, лямбда захватывает
//   объект тестового набора, так что ему доступны публичные\приватные поля объекта а так же экспортные методы
//  Причина  - Строка - Причина почему тест пропущен, которая будет указана в отчете о тестировании
//
// Пример:
//  1.
//  // Выключен всегда
//  //
//  &Тест
//  &ВыключенЕсли("() -> Истина", Причина = "Я никогда не буду выполнен")
//  Процедура Тест() Экспорт
//   
//  2.
//  // Включен всегда
//  //
//  &Тест
//  &ВыключенЕсли("() -> Ложь")
//  Процедура Тест() Экспорт
//   
//  3.
//  // Выключен если сегодня среда
//  //
//  &Тест
//  &ВыключенЕсли("() -> ДеньНедели(ТекущаяДата()) = 3", Причина = "It's wednesday, my dudes")
//  Процедура Тест() Экспорт
//   
//  4.
//  // МойТестовыйСценарий.os
//  //
//  Перем Поле;
//   
//  // Проверка поля сценария
//  //
//  &Тест
//  &ВыключенЕсли("() -> Поле", Причина = "В поле сценария была истина")
//  Процедура Тест() Экспорт
//   
//  5.
//  // МойТестовыйСценарий.os
//  //
//   
//  // Проверка метода сценария
//  //
//  &Тест
//  &ВыключенЕсли("() -> ПропуститьТест()", Причина = "Метод ПропуститьТест вернул истина")
//  Процедура Тест() Экспорт
//  КонецПроцедуры
//   
//  Функция ПропуститьТест() Экспорт
//      Возврат Истина;
//  КонецФункции
//
&Аннотация("ВыключенЕсли")
Процедура ПриСозданииОбъекта(Значение, Причина = "Условие переданное в ВыключенЕсли вернуло Истина")
	_Условие = Значение;
	_Причина = Причина;
КонецПроцедуры

// Проверяет условие на экземпляре набора
//
// Параметры:
//  Экземпляр - Опциональный - Объект сценария набора, пустой - экземпляра нет (набор
//              не удалось создать или условие изолированного набора проверяется вне его
//              среды): выражение проверяется без захвата, условию без обращения к набору
//              экземпляр не нужен
//
//  Возвращаемое значение:
//   Структура - Итог проверки:
//    * Результат - Булево - Истина - тест или набор выполняется
//    * Причина   - Строка - Причина пропуска, пустая строка - не пропускается
//
Функция Выполнять(Экземпляр) Экспорт

	Результат = Новый Структура("Результат, Причина", Истина, "");

	Условие = Лямбда.Выражение(_Условие).Интерфейс(ФункциональныеИнтерфейсы.Вызываемый());
	Экземпляр.ЕслиСодержитЗначение(Новый Действие(Условие, "ЗахватитьОбъект"));

	Выключен = Условие.ВДействие().Выполнить();

	Если Выключен Тогда
		Результат.Результат = Ложь;
		Результат.Причина = _Причина;
	КонецЕсли;

	Возврат Результат;

КонецФункции
