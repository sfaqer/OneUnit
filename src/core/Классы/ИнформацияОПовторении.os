// Сведения о конкретном повторении повторяемого теста.

Перем Номер;      // Число - Номер повторения, начиная с единицы
Перем Количество; // Число - Общее количество повторений

// Возвращает номер текущего повторения.
//
// Возвращаемое значение:
//  Число - Номер повторения, начиная с единицы
//
Функция ТекущееПовторение() Экспорт
	Возврат Номер;
КонецФункции

// Возвращает общее количество повторений теста.
//
// Возвращаемое значение:
//  Число - Количество повторений
//
Функция ВсегоПовторений() Экспорт
	Возврат Количество;
КонецФункции

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Блестяшка НомерПовторения, &Блестяшка КоличествоПовторений)

	Номер = НомерПовторения;
	Количество = КоличествоПовторений;

КонецПроцедуры
