// Описание исходного тестового метода.

Перем Имя;   // Строка - Имя метода в сценарии
Перем Набор; // Тип - Тип сценария, в котором объявлен метод

// Возвращает имя метода в сценарии тестового набора.
//
// Возвращаемое значение:
//  Строка - Имя метода
//
Функция Имя() Экспорт
	Возврат Имя;
КонецФункции

// Возвращает тип сценария, в котором объявлен метод.
//
// Возвращаемое значение:
//  Тип - Тип сценария тестового набора
//
Функция Набор() Экспорт
	Возврат Набор;
КонецФункции

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(&Блестяшка ИмяМетода, &Блестяшка ТипНабора)

	Имя = ИмяМетода;
	Набор = ТипНабора;

КонецПроцедуры
