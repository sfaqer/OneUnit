#Использовать autumn
#Использовать autumn-logos
#Использовать autumn-event-publisher
#Использовать collectionos
#Использовать annotations
#Использовать "../internal"

Перем _ОбнаружительТестов; // Объект отвечающий за составление тест плана
Перем _ДиспетчерТестов;    // Объект отвечающий за исполнение тест плана

// Запускает тестирование проекта в соответствии с настройками окружения
//
// Возвращаемое значение:
//  ТестПлан - Составленный и исполненный по окружению тест план
//
Функция Тестировать() Экспорт

	// Состав изолированных наборов при исполнении не разворачивается заранее:
	// их исполнители вклеивают в план фактические результаты их прогонов
	ТестПлан = _ОбнаружительТестов.Обнаружить();

	_ДиспетчерТестов.Исполнить(ТестПлан);

	Возврат ТестПлан;

КонецФункции

// Составляет и возвращает тест план. Изолированные наборы разворачиваются
// в собственных средах - план показывает их фактический состав
//
// Возвращаемое значение:
//  ТестПлан - Составленный по окружению тест план
//
Функция Обнаружить() Экспорт

	ТестПлан = _ОбнаружительТестов.Обнаружить();

	_ДиспетчерТестов.Развернуть(ТестПлан);

	Возврат ТестПлан;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин ОбнаружительТестов,
	&Пластилин ДиспетчерТестов)

	_ОбнаружительТестов = ОбнаружительТестов;
	_ДиспетчерТестов    = ДиспетчерТестов;

КонецПроцедуры
