	);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Тест", "Тест")
&ИсточникЗначение("ПередКаждым", "Тест,ПередКаждым")
&ИсточникЗначение("ПолеПервое", "Тест,ПередКаждым,ПослеКаждого,ПолеПервое")
&ИсточникЗначение("", "Тест,ПередКаждым,ПослеКаждого,ПолеПервое,ПолеВторое")
Процедура ПроверкаРегистрацииСохраняетПорядокИНеПовторяетМетоды(ОшибкаНа, ОжидаемыеВызовы) Экспорт

	Проверка = ПроверкаРегистрацииСЖурналом();
	Проверка.ОшибкаНа = ОшибкаНа;
	Проверка.Вызовы = Новый СписокМассив;

	Поделка = ПоделкаНабора("НаборДляПроверкиПорядкаРегистрации");
	Проверка.Разрешение = Поделка.НайтиЖелудь("РазрешениеЗначений");
	Обнаружитель = Поделка.НайтиЖелудь("ОбнаружительТестов");
	Рефлектор = Новый Рефлектор;
	Рефлектор.УстановитьСвойство(Обнаружитель, "РазрешениеЗначений", Проверка);

	План = Обнаружитель.Обнаружить();
	Набор = ПрогоныТестов.НайтиНабор(План, "НаборДляПроверкиПорядкаРегистрации");
	Тест = ПрогоныТестов.НайтиТест(Набор, "Тест");
	Ошибки = Тест.ОшибкиОбнаружения();

	Ожидаем.Что(СтрСоединить(Проверка.Вызовы.ВМассив(), ",")).Равно(ОжидаемыеВызовы);
	Ожидаем.Что(Ошибки.Количество()).Равно(?(ПустаяСтрока(ОшибкаНа), 0, 1));

	Если Не Ошибки.Пусто() Тогда
		Ожидаем.Что(Ошибки.Получить(0).Описание).Равно(ОшибкаНа);
	КонецЕсли;

КонецПроцедуры

// Регистрацию поставщика проверяет узел, который получает значение: поле перед
// методами теста и ПередКаждым получают значения для теста, и незарегистрированный
// поставщик ломает тест, а не набор
&ПараметризованныйТест
&ИсточникЗначение("НаборСНезарегистрированнымПоставщикомПоля", "у поля Поле")
&ИсточникЗначение("НаборСНезарегистрированнымПоставщикомПередКаждым", "у параметра П метода ПередКаждым")
Процедура НезарегистрированныйПоставщикДляТестаЛомаетТест(ИмяНабора, Где) Экспорт

	Прогон = ПрогнатьНабор(ИмяНабора);

	РезультатНабора = Прогон.Статистика.Результат(ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора));
	Результат       = РезультатТеста(Прогон, ИмяНабора, "Тест");

	Ожидаем.Что(РезультатНабора.Состояние(), РезультатНабора.ОписанияПричин()).Равно(СостоянияВыполненияТестов.Успех);
	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Ожидаем.Что(Результат.ОписанияПричин().Получить(0)).Равно(
		СтрШаблон("Не найден поставщик ПоставщикКоторогоНет %1: желудь не зарегистрирован", Где)
	);

КонецПроцедуры

// Поставщика поля для методов уровня набора проверяет набор.
&ПараметризованныйТест
&ИсточникЗначение("НаборСНезарегистрированнымПоставщикомПоляИПередВсеми")
&ИсточникЗначение("НаборСНезарегистрированнымПоставщикомПоляИПослеВсех")
Процедура НезарегистрированныйПоставщикПоляЛомаетНаборСМетодами(ИмяНабора) Экспорт

	Прогон = ПрогнатьНабор(ИмяНабора);

	Результат = Прогон.Статистика.Результат(ПрогоныТестов.НайтиНабор(
		Прогон.План,
		ИмяНабора
	));

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Ожидаем.Что(Результат.ОписанияПричин().Получить(0)).Равно(
		"Не найден поставщик ПоставщикКоторогоНет у поля Поле: желудь не зарегистрирован"
	);

КонецПроцедуры

#КонецОбласти

Функция ОбнаружитьНаборДляФабрики(Знач ИмяНабора)

	ЖурналВыполнения.Очистить();
	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.КаталогиТестов", "");
	Детальки.Вставить("OneUnit.ФайлыТестов", "./tests/fixtures/resolvers/" + ИмяНабора + ".os");
	Поделка = ПрогоныТестов.СоздатьПоделку(Детальки);
	План = Поделка.НайтиЖелудь("МенеджерТестирования").Обнаружить();
	Возврат Новый Структура(
		"Поделка, Набор, Фабрика",
		Поделка,
		ПрогоныТестов.НайтиНабор(План, ИмяНабора),
		Поделка.НайтиЖелудь("ФабрикаЭкземпляров")
	);

КонецФункции

Функция ПрогнатьНабор(Знач ИмяНабора)

	ЖурналВыполнения.Очистить();

	Возврат ПрогоныТестов.Прогнать(
		ИмяНабора,
		"",
		"./tests/fixtures/resolvers/" + ИмяНабора + ".os"
	);

КонецФункции

// Проверка поставщиков с журналом обращений и заданной ошибкой
Функция ПроверкаРегистрацииСЖурналом()

	Возврат ЗагрузитьСценарийИзСтроки(
		"Перем Вызовы Экспорт;
		|Перем ОшибкаНа Экспорт;
		|Перем Разрешение Экспорт;
		|
		|Функция ПрочитатьСигнатуры(ОпределениеЖелудя) Экспорт
		|	Возврат Разрешение.ПрочитатьСигнатуры(ОпределениеЖелудя);
		|КонецФункции
		|
		|Функция ОшибкаРегистрации(Сигнатура) Экспорт
		|	Имя = Сигнатура.Метод().Имя;
		|	Если Имя = ""ПриСозданииОбъекта"" Тогда
		|		Возврат Опциональные.Пустой();
		|	КонецЕсли;
		|	Возврат ОшибкаЭлемента(Имя);
		|КонецФункции
		|
		|Функция ОшибкаРегистрацииПоля(Поле) Экспорт
		|	Возврат ОшибкаЭлемента(Поле.Имя());
		|КонецФункции
		|
		|Функция ОшибкаЭлемента(Имя)
		|	Вызовы.Добавить(Имя);
		|	Если Имя = ОшибкаНа Тогда
		|		Возврат Новый Опциональный(Новый ИнформацияОбОшибке(Имя, Неопределено));
		|	КонецЕсли;
		|	Возврат Опциональные.Пустой();
		|КонецФункции",
		Новый Структура("Опциональные", Опциональные)
	);

КонецФункции

// Подстановка отказа при регистрации действия и подготовке списка к закрытию
Функция СписокДействийСОшибкой()

	Возврат ЗагрузитьСценарийИзСтроки(
		"Процедура Добавить(Действие) Экспорт
		|	Сбой();
		|КонецПроцедуры
		|
		|Функция ВМассив() Экспорт
		|	Сбой();
		|	Возврат Новый Массив;
		|КонецФункции
		|
		|Процедура Сбой()
		|	Попытка
		|		ВызватьИсключение ""Причина ошибки списка"";
		|	Исключение
		|		ВызватьИсключение Новый ИнформацияОбОшибке(""Ошибка списка действий"", , ИнформацияОбОшибке());
		|	КонецПопытки;
		|КонецПроцедуры"
	);

КонецФункции

Процедура ДействиеЗакрытия(Контекст) Экспорт // BSLLS:UnusedParameters-off
КонецПроцедуры

// Снимает подписку РазрешениеЗначений на заполнение аргументов: значения
// параметров с поставщиками никто не дает
Процедура ОтписатьРазрешениеЗначений(Поделка)

	Публикатор = Поделка.НайтиЖелудь("ПубликаторСобытий");
	Разрешение = Поделка.НайтиЖелудь("РазрешениеЗначений");

	УдалитьОбработчик Публикатор.ЗаполнениеАргументов, Разрешение.ЗаполнитьАргументы;

КонецПроцедуры

// Поделка с одним набором фикстур - для сценариев из нескольких вызовов менеджера
Функция ПоделкаНабора(Знач ИмяНабора)

	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.КаталогиТестов", "");
	Детальки.Вставить("OneUnit.ФайлыТестов", "./tests/fixtures/resolvers/" + ИмяНабора + ".os");
	Детальки.Вставить("OneUnit.ТестовыеНаборыВключаемые", ИмяНабора);

	Возврат ПрогоныТестов.СоздатьПоделку(Детальки);

КонецФункции

Функция АргументыМетода(Знач ИмяМетода, Позиционные)

	План = ПоделкаНабора("НаборСПоставщикамиПараметров").НайтиЖелудь("МенеджерТестирования").Обнаружить();
	Набор = ПрогоныТестов.НайтиНабор(План, "НаборСПоставщикамиПараметров");

	Возврат Набор.Сигнатура(ИмяМетода).СоздатьАргументы(Позиционные);

КонецФункции

Функция РезультатТеста(Прогон, Знач ИмяНабора, Знач ИмяТеста)

	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);

	Возврат Прогон.Статистика.Результат(ПрогоныТестов.НайтиТест(Набор, ИмяТеста));

КонецФункции

// Индекс записи в журнале; записи нет - тест падает с содержимым журнала
Функция ИндексЗаписи(Знач Запись)

	Индекс = ЖурналВыполнения.Записи.Найти(Запись);

	Ожидаем.Что(Индекс, СтрШаблон(
		"Запись ""%1"" в журнале:%2%3",
		Запись,
		Символы.ПС,
		СтрСоединить(ЖурналВыполнения.Записи, Символы.ПС)
	)).Не_().ЭтоНеопределено();

	Возврат Индекс;

КонецФункции

Функция КоличествоЗаписейНачинающихсяС(Знач Начало)

	Количество = 0;

	Для Каждого Элемент Из ЖурналВыполнения.Записи Цикл
		Если СтрНачинаетсяС(Элемент, Начало) Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Количество;

КонецФункции

Функция КоличествоЗаписей(Знач Запись)

	Количество = 0;

	Для Каждого Элемент Из ЖурналВыполнения.Записи Цикл
		Если Элемент = Запись Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Количество;

КонецФункции
