// Тесты поставщиков значений (&ПоставщикЗначения): значения параметров методов,
// конструкторов и полей наборов, контексты исполнения узлов и их закрытие.

#Использовать asserts
#Использовать "./support"
#Использовать ".."

#Область ЗначенияПараметров

&Тест
Процедура ПараметрыМетодовИКонструктораПолучаютЗначенияПоставщика() Экспорт

	Прогон = ПрогнатьНабор("НаборСПоставщикамиПараметров");

	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, "НаборСПоставщикамиПараметров");

	Ожидаем.Что(Прогон.Статистика.Результат(Набор).Состояние()).Равно(СостоянияВыполненияТестов.Успех);

	Статистика = Прогон.Статистика.СтатистикаТестПлана();

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовОбнаружено", 0)).Равно(5);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0)).Равно(5);

	ИндексЗаписи("ПередВсеми ПередВсеми");
	ИндексЗаписи("ПослеВсех ПослеВсех");

	// Хранилище контекста теста общее для его методов: ПередКаждым спросил первым
	ИндексЗаписи("ПередКаждым 1");
	ИндексЗаписи("Тест 2 Конструктор");

КонецПроцедуры

&Тест
Процедура ПоставщикаСпрашиваютВКонтекстеУзлаВызова() Экспорт

	ПрогнатьНабор("НаборСПоставщикамиПараметров");

	// Методы жизненного цикла набора - в контексте набора
	ИндексЗаписи("Поставщик ПередВсеми.Значение[0] для НаборСПоставщикамиПараметров");
	ИндексЗаписи("Поставщик ПослеВсех.Значение[0] для НаборСПоставщикамиПараметров");

	// Методы теста - в контексте теста
	ИндексЗаписи("Поставщик ПередКаждым.Номер[0] для Тест");
	ИндексЗаписи("Поставщик Тест.Номер[0] для Тест");

	// Конструктор - в контексте узла, для которого создается экземпляр
	ИндексЗаписи("Поставщик ПриСозданииОбъекта.Значение[0] для НаборСПоставщикамиПараметров");
	ИндексЗаписи("Поставщик ПриСозданииОбъекта.Значение[0] для Тест");

КонецПроцедуры

&Тест
Процедура ПозиционныеЗначенияЗаполняютПараметрыБезПоставщика() Экспорт

	ПрогнатьНабор("НаборСПоставщикамиПараметров");

	ИндексЗаписи("Параметризованный 1 Середина 2");
	ИндексЗаписи("СУмолчанием 1 5 Последний");
	ИндексЗаписи("ПоИмени 1 Середина 3");
	ИндексЗаписи("ВсеНеопределено Неопределено Последний");

КонецПроцедуры

&Тест
Процедура ВыводПоставщикаИЗакрытияВходитВВыводУзла() Экспорт

	Прогон = ПрогнатьНабор("НаборСПоставщикамиПараметров");

	Вывод = РезультатТеста(Прогон, "НаборСПоставщикамиПараметров", "Тест").Вывод();

	ВыводПоставщика = СтрНайти(Вывод, "Вывод поставщика Тест.Номер");
	ВыводЗакрытия   = СтрНайти(Вывод, "Вывод закрытия Тест.Номер");

	Ожидаем.Что(ВыводПоставщика, Вывод).Больше(0);
	Ожидаем.Что(ВыводЗакрытия, Вывод).Больше(ВыводПоставщика);

КонецПроцедуры

&Тест
Процедура АргументыВозвращаютЛюбойПараметрПоИндексу() Экспорт

	Аргументы = АргументыМетода("Параметризованный", Списки.ИзЭлементов(1, 2));

	// Позиционные значения доступны и до заполнения параметра поставщика
	Ожидаем.Что(Аргументы.Значение(0)).Равно(1);
	Ожидаем.Что(Аргументы.Значение(2)).Равно(2);

	Параметры = Новый Массив;
	Параметры.Добавить(1);

	Ожидаем.Что(Аргументы).Метод("Значение", Параметры).ВыбрасываетИсключение(
		"Значение параметра Б метода Параметризованный не установлено"
	);

	// Полученное Неопределено отличается от еще не заполненного параметра
	Аргументы.Установить(1, Неопределено);
	Ожидаем.Что(Аргументы.Значение(1)).ЭтоНеопределено();

	Значения = Аргументы.Значения();
	Ожидаем.Что(Значения.Количество()).Равно(3);
	Ожидаем.Что(Значения.Получить(0)).Равно(1);
	Ожидаем.Что(Значения.Получить(1)).ЭтоНеопределено();
	Ожидаем.Что(Значения.Получить(2)).Равно(2);

	Параметры.Добавить(Неопределено);
	Ожидаем.Что(Аргументы).Метод("Установить", Параметры).ВыбрасываетИсключение(
		"Значение параметра Б метода Параметризованный уже получено"
	);

КонецПроцедуры

&Тест
Процедура АргументыСохраняютNullИОбъектныеЗначения() Экспорт

	Значения = Новый СписокМассив;
	Значения.Добавить(Null);
	Значения.Добавить(Новый Структура);
	Значения.Добавить(Опциональные.Пустой());

	Для Каждого Значение Из Значения Цикл

		Аргументы = АргументыМетода("Параметризованный", Списки.ИзЭлементов(1, 2));
		Аргументы.Установить(1, Значение);

		Ожидаем.Что(Аргументы.Значение(1)).Равно(Значение);
		Ожидаем.Что(Аргументы.Значения().Получить(1)).Равно(Значение);

		Параметры = Новый Массив;
		Параметры.Добавить(1);
		Параметры.Добавить(Неопределено);

		Ожидаем.Что(Аргументы).Метод("Установить", Параметры).ВыбрасываетИсключение(
			"Значение параметра Б метода Параметризованный уже получено"
		);

		Ожидаем.Что(Аргументы.Значение(1)).Равно(Значение);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура АргументыРазличаютУмолчаниеИПереданноеНеопределено() Экспорт

	Аргументы = АргументыМетода("СУмолчанием", Списки.ИзЭлементов(1));
	Аргументы.Установить(2, "Последний");

	Ожидаем.Что(Аргументы.Значение(1)).Равно(5);
	Ожидаем.Что(Аргументы.Значения().Получить(1)).Равно(5);

	Аргументы = АргументыМетода("СУмолчанием", Списки.ИзЭлементов(1, Неопределено));
	Аргументы.Установить(2, "Последний");

	Ожидаем.Что(Аргументы.Значение(1)).ЭтоНеопределено();
	Ожидаем.Что(Аргументы.Значения().Получить(1)).ЭтоНеопределено();

	Аргументы = АргументыМетода("Параметризованный", Списки.ИзЭлементов(1));
	Аргументы.Установить(1, "Середина");

	Ожидаем.Что(Аргументы.Значение(2)).ЭтоНеопределено();
	Ожидаем.Что(Аргументы.Значения().Получить(2)).ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура АргументыСохраняютСписокВызоваБезПоставщиков() Экспорт

	Аргументы = АргументыМетода("БезПоставщиков", Списки.ИзЭлементов(1));

	Ожидаем.Что(Аргументы.Значение(0)).Равно(1);
	Ожидаем.Что(Аргументы.Значение(1)).Равно(5);
	Ожидаем.Что(Аргументы.Значения().Количество()).Равно(1);

	// Пропущенный обязательный аргумент должен остаться пропущенным при вызове
	Аргументы = АргументыМетода("БезПоставщиков", Списки.ИзЭлементов());
	Ожидаем.Что(Аргументы.Значения().Пусто()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура АргументыСохраняютЛишниеПозиционныеЗначения() Экспорт

	Аргументы = АргументыМетода("Параметризованный", Списки.ИзЭлементов(1, 2, 3));
	Аргументы.Установить(1, "Середина");

	Значения = Аргументы.Значения();
	Ожидаем.Что(Значения.Количество()).Равно(4);
	Ожидаем.Что(Значения.Получить(2)).Равно(2);
	Ожидаем.Что(Значения.Получить(3)).Равно(3);

КонецПроцедуры

&Тест
Процедура ЗаполняемыйПараметрНеТребуетПоставщика() Экспорт

	Метод = АргументыМетода("БезПоставщиков", Списки.ИзЭлементов()).Метод();
	Аргументы = Новый АргументыВызова(Метод, Списки.ИзЭлементов(1), Списки.ИзЭлементов(1));

	Ожидаем.Что(Аргументы.ТребуютЗаполнения()).ЭтоИстина();
	Ожидаем.Что(Аргументы.Значение(0)).Равно(1);

	Аргументы.Установить(1, Неопределено);

	Ожидаем.Что(Аргументы.Значение(1)).ЭтоНеопределено();
	Ожидаем.Что(Аргументы.Значения().Количество()).Равно(2);
	Ожидаем.Что(Аргументы.Значения().Получить(1)).ЭтоНеопределено();

	Параметры = Новый Массив;
	Параметры.Добавить(1);
	Параметры.Добавить(5);

	Ожидаем.Что(Аргументы).Метод("Установить", Параметры).ВыбрасываетИсключение(
		"Значение параметра Б метода БезПоставщиков уже получено"
	);

КонецПроцедуры

#КонецОбласти

#Область Закрытие

&ПараметризованныйТест
&ИсточникЗначение("ПриЗакрытии")
&ИсточникЗначение("Закрыть")
Процедура ИсключениеВКритическомУчасткеОсвобождаетБлокировку(ИмяМетода) Экспорт

	План = ПоделкаНабора("НаборСПоставщикамиПараметров").НайтиЖелудь("МенеджерТестирования").Обнаружить();
	Набор = ПрогоныТестов.НайтиНабор(План, "НаборСПоставщикамиПараметров");
	Контекст = Новый КонтекстИсполнения(Набор);

	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(Контекст, "Закрытия", СписокДействийСОшибкой());
	Блокировка = Рефлектор.ПолучитьСвойство(Контекст, "Блокировка");

	Аргумент = ?(
		ИмяМетода = "ПриЗакрытии",
		Новый Действие(ЭтотОбъект, "ДействиеЗакрытия"),
		Опциональные.Пустой()
	);
	Параметры = Списки.ИзЭлементов(Аргумент).ВМассив();

	Ошибка = Опциональные.Пустой();

	Попытка
		Рефлектор.ВызватьМетод(Контекст, ИмяМетода, Параметры);
	Исключение
		Ошибка = Новый Опциональный(ИнформацияОбОшибке());
	КонецПопытки;

	// Разблокировка без захвата вызывает исключение. При утечке захвата этот вызов
	// снимет его, чтобы проверка не оставила заблокированный ресурс
	БлокировкаОсвобождена = Ложь;

	Попытка
		Блокировка.Разблокировать();
	Исключение
		БлокировкаОсвобождена = Истина;
	КонецПопытки;

	Ожидаем.Что(БлокировкаОсвобождена, "Блокировка снята после исключения").ЭтоИстина();
	Ожидаем.Что(Ошибка.СодержитЗначение(), "Исключение из критического участка передано вызывающему").ЭтоИстина();
	Ожидаем.Что(Ошибка.Получить().Описание).Равно("Ошибка списка действий");
	Ожидаем.Что(Ошибка.Получить().Причина.Описание).Равно("Причина ошибки списка");

КонецПроцедуры

&Тест
Процедура КонтекстЗакрываетсяПоЗавершенииУзлаВОбратномПорядке() Экспорт

	ПрогнатьНабор("НаборСПоставщикамиПараметров");

	Тест = ИндексЗаписи("Тест 2 Конструктор");

	// Спрашивали конструктор, ПередКаждым, тест - закрываются наоборот
	ЗакрытиеТеста        = ИндексЗаписи("Закрыт Тест: Тест.Номер Успех падения=Нет");
	ЗакрытиеПередКаждым  = ИндексЗаписи("Закрыт Тест: ПередКаждым.Номер Успех падения=Нет");
	ЗакрытиеКонструктора = ИндексЗаписи("Закрыт Тест: ПриСозданииОбъекта.Значение Успех падения=Нет");

	Ожидаем.Что(ЗакрытиеТеста).Больше(Тест);
	Ожидаем.Что(ЗакрытиеПередКаждым).Больше(ЗакрытиеТеста);
	Ожидаем.Что(ЗакрытиеКонструктора).Больше(ЗакрытиеПередКаждым);

	// Набор закрывается после своего последнего метода
	Ожидаем.Что(ИндексЗаписи("Закрыт НаборСПоставщикамиПараметров: ПослеВсех.Значение Успех падения=Нет"))
		.Больше(ИндексЗаписи("ПослеВсех ПослеВсех"));

КонецПроцедуры

&Тест
Процедура ЗакрытиеВидитРезультатУзлаИПадения() Экспорт

	ПрогнатьНабор("НаборСПоставщикомИПадающимТестом");

	ИндексЗаписи("Закрыт Падающий: Падающий.П Ошибка падения=Да");
	ИндексЗаписи("Закрыт Зеленый: Зеленый.П Успех падения=Нет");

	// Набор сам успешен, но в нем упал тест
	ИндексЗаписи("Закрыт НаборСПоставщикомИПадающимТестом: ПередВсеми.П Успех падения=Да");

КонецПроцедуры

&Тест
Процедура ДействиеПослеЗакрытияВыполняетсяСразу() Экспорт

	Прогон = ПрогнатьНабор("НаборСТаймаутомИПозднимЗакрытием");

	// Метод, прерванный таймаутом, еще работает в фоне - ждем, пока он закончит
	Приостановить(1000);

	Результат = РезультатТеста(Прогон, "НаборСТаймаутомИПозднимЗакрытием", "Тест");

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);

	// Контекст закрыт по таймауту, не дожидаясь метода
	Ожидаем.Что(ИндексЗаписи("Закрыт Тест: Тест.Контекст Сломан падения=Да"))
		.Меньше(ИндексЗаписи("Позднее закрытие Сломан"));

	// Действие, добавленное после закрытия, выполнено сразу - до того, как добавивший
	// пошел дальше
	Ожидаем.Что(ИндексЗаписи("Позднее закрытие Сломан"))
		.Меньше(ИндексЗаписи("Позднее действие добавлено"));

КонецПроцедуры

&Тест
Процедура ИсключениеЗакрытияЛомаетУзел() Экспорт

	Прогон = ПрогнатьНабор("НаборСПадающимПоставщиком");

	Результат = РезультатТеста(Прогон, "НаборСПадающимПоставщиком", "ПадениеЗакрытия");

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Ожидаем.Что(Результат.ОписанияПричин().Получить(0)).Содержит("Закрытие не смогло");

	// Вывод узла не теряется
	Ожидаем.Что(СтрНайти(Результат.Вывод(), "Вывод теста ПадениеЗакрытия"), Результат.Вывод()).Больше(0);

КонецПроцедуры

&Тест
Процедура ОшибкаЗакрытияВиднаОстальнымДействиямИПредкам() Экспорт

	Прогон = ПрогнатьНабор("НаборСПадениемЗакрытия");

	Набор     = ПрогоныТестов.НайтиНабор(Прогон.План, "НаборСПадениемЗакрытия");
	Тест      = ПрогоныТестов.НайтиТест(Набор, "Тест");
	Результат = Прогон.Статистика.Результат(Тест);

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Ожидаем.Что(Результат.Причины().Количество()).Равно(1);
	Ожидаем.Что(Результат.ОписанияПричин().Получить(0)).Содержит("Закрытие не смогло");

	// Закрытие П падает первым. Следующее действие уже видит падение, хотя
	// сам метод теста выполнился успешно
	ИндексЗаписи("Закрыт Тест: Тест.Наблюдатель Успех падения=Да");

	// Набор сам успешен, но закрывается с падением в поддереве. Значение конструктора
	// одиночки создано первым и закрывается последним
	Ожидаем.Что(Прогон.Статистика.Результат(Набор).Состояние()).Равно(СостоянияВыполненияТестов.Успех);
	Ожидаем.Что(ИндексЗаписи("Закрыт НаборСПадениемЗакрытия: ПриСозданииОбъекта.Значение Успех падения=Да"))
		.Больше(ИндексЗаписи("Закрыт НаборСПадениемЗакрытия: ПередВсеми.П Успех падения=Да"));

	Ожидаем.Что(Тест.Контекст().ЕстьПадения()).ЭтоИстина();
	Ожидаем.Что(Набор.Контекст().ЕстьПадения()).ЭтоИстина();
	Ожидаем.Что(Прогон.План.Контекст().ЕстьПадения()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КонтекстуПрогонаДействиеЗакрытияНеДобавить() Экспорт

	// У прогона нет результата, в который попали бы вывод и исключения закрытия
	План = ПоделкаНабора("НаборСПоставщикамиПараметров").НайтиЖелудь("ТестПлан");

	Параметры = Новый Массив;
	Параметры.Добавить(Новый Действие(ЭтотОбъект, "ДействиеЗакрытия"));

	Ожидаем.Что(План.Контекст())
		.Метод("ПриЗакрытии", Параметры)
		.ВыбрасываетИсключение("У контекста прогона нет действий закрытия");

КонецПроцедуры

&Тест
Процедура СозданноеДляУсловийКонтейнераПринадлежитНабору() Экспорт

	Прогон = ПрогнатьНабор("НаборСКонтейнеромИПоставщиком");

	// Экземпляр самого набора и экземпляр для условия контейнера: оба принадлежат набору
	Ожидаем.Что(КоличествоЗаписей("Поставщик ПриСозданииОбъекта.Значение[0] для НаборСКонтейнеромИПоставщиком"))
		.Равно(2);
	Ожидаем.Что(КоличествоЗаписей("Закрыт НаборСКонтейнеромИПоставщиком: ПриСозданииОбъекта.Значение Успех падения=Нет"))
		.Равно(2);
	Ожидаем.Что(КоличествоЗаписейНачинающихсяС("Поставщик ПриСозданииОбъекта.Значение[0] для Шаблон")).Равно(0);
	Ожидаем.Что(КоличествоЗаписейНачинающихсяС("Закрыт Шаблон:")).Равно(0);

	// Результат контейнера известен до итераций: закрытие после них его бы не учло
	Контейнер = ПрогоныТестов.НайтиТест(
		ПрогоныТестов.НайтиНабор(Прогон.План, "НаборСКонтейнеромИПоставщиком"),
		"Шаблон"
	);

	Параметры = Новый Массив;
	Параметры.Добавить(Новый Действие(ЭтотОбъект, "ДействиеЗакрытия"));

	Ожидаем.Что(Контейнер.Контекст())
		.Метод("ПриЗакрытии", Параметры)
		.ВыбрасываетИсключение("У контекста контейнера нет действий закрытия");

КонецПроцедуры

// Контекст закрывается и у потомка, до которого исполнение не дошло: подписчик
// заранее добавил действие в контекст теста, а набор выключен или упал в ПередВсеми
&ПараметризованныйТест
&ИсточникЗначение("НаборВыключенныйСЗакрытиемТеста")
&ИсточникЗначение("НаборСПадающимПередВсемиИЗакрытиемТеста")
Процедура КонтекстНеисполненногоТестаЗакрываетсяСНабором(ИмяНабора) Экспорт

	ЖурналВыполнения.Очистить();

	Поделка = ПоделкаНабора(ИмяНабора);

	// Подписку добавляет напильник при создании желудя
	Поделка.НайтиЖелудь("ПодписчикЗакрытийЗаранее");
	Поделка.НайтиЖелудь("МенеджерТестирования").Тестировать();

	Ожидаем.Что(КоличествоЗаписей("Закрыт заранее Тест")).Равно(1);

КонецПроцедуры

// Подписчик падает посреди набора - на его тесте
&Тест
Процедура ИсключениеПодписчикаЗакрываетОткрытыеКонтексты() Экспорт

	ЖурналВыполнения.Очистить();

	Поделка = ПоделкаНабора("НаборСПадающимПодписчиком");

	// Подписку добавляет напильник при создании желудя
	Поделка.НайтиЖелудь("ПадающийПодписчикСобытий");

	Ошибка = Неопределено;

	Попытка
		Поделка.НайтиЖелудь("МенеджерТестирования").Тестировать();
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Исключение подписчика прерывает прогон и выходит из него
	Ожидаем.Что(Ошибка, "Прогон прерван исключением подписчика").Не_().ЭтоНеопределено();
	Ожидаем.Что(Ошибка.Описание).Содержит("Подписчик не смог");

	// Набор, который оно прервало, закрыт без результата
	ИндексЗаписи("Закрыт НаборСПадающимПодписчиком: ПриСозданииОбъекта.Значение - падения=Нет");

КонецПроцедуры

// Ошибка закрытия не заменяет отказ прогона и сохраняет свою цепочку причин в его выводе
&Тест
Процедура ОтказПрогонаСохраняетПричинуОшибкиЗакрытия() Экспорт

	Поделка = ПоделкаНабора("НаборСПадающимПодписчикомИЗакрытием");

	Поделка.НайтиЖелудь("ПадающийПодписчикСобытий");

	Ошибка = Неопределено;

	Попытка
		Поделка.НайтиЖелудь("МенеджерТестирования").Тестировать();
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	Ожидаем.Что(Ошибка, "Прогон прерван исключением подписчика").Не_().ЭтоНеопределено();
	Ожидаем.Что(Ошибка.Описание).Содержит("Подписчик не смог");

	ЦепочкиПричин.ПроверитьВывод(Ошибка, "Закрытие не смогло");
	ЦепочкиПричин.ПроверитьВывод(Ошибка, "Корневая причина закрытия");
	ЦепочкиПричин.ПроверитьВывод(Ошибка, "Вывод перед ошибкой закрытия");
	ЦепочкиПричин.ПроверитьВывод(Ошибка, "Вывод закрытия ПриСозданииОбъекта.Контекст");

КонецПроцедуры

#КонецОбласти

#Область Отказы

&Тест
Процедура ИсключениеПоставщикаЛомаетТестДоВызоваМетода() Экспорт

	Прогон = ПрогнатьНабор("НаборСПадающимПоставщиком");

	Результат = РезультатТеста(Прогон, "НаборСПадающимПоставщиком", "ПадениеПоставщика");

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);

	ЦепочкиПричин.ПроверитьЗвенья(Результат.Причины().Получить(0), Массивы.ИзЭлементов(
		"Не удаётся разрешить параметр П метода ПадениеПоставщика",
		"Поставщик не смог"
	));

	Ожидаем.Что(ЖурналВыполнения.Записи.Найти("ПадениеПоставщика выполнен")).ЭтоНеопределено();
	Ожидаем.Что(СтрНайти(Результат.Вывод(), "Вывод поставщика ПадениеПоставщика.П"), Результат.Вывод()).Больше(0);

КонецПроцедуры

// autumn глотает исключение конструктора поставщика и возвращает Неопределено:
// причина отказа - его лог, а не обращение к Неопределено
&Тест
Процедура ПадениеКонструктораПоставщикаЛомаетТестСВернойПричиной() Экспорт

	Прогон = ПрогнатьНабор("НаборССозданиемПоставщиков");

	Результат = РезультатТеста(Прогон, "НаборССозданиемПоставщиков", "ПадающийКонструкторПоставщика");

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);

	ЦепочкиПричин.ПроверитьЗвенья(Результат.Причины().Получить(0), Массивы.ИзЭлементов(
		"Не удаётся разрешить параметр П метода ПадающийКонструкторПоставщика",
		"Конструктор поставщика не смог"
	));

	Ожидаем.Что(Результат.Причины().Получить(0).Причина.Описание)
		.Равно("Не удалось создать поставщик ПоставщикСПадающимКонструктором");

	Ожидаем.Что(ЖурналВыполнения.Записи.Найти("ПадающийКонструкторПоставщика выполнен")).ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура ВыводКонструктораПоставщикаВходитВВыводУзла() Экспорт

	Прогон = ПрогнатьНабор("НаборССозданиемПоставщиков");

	Результат = РезультатТеста(Прогон, "НаборССозданиемПоставщиков", "ВыводКонструктораПоставщика");

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Успех);
	Ожидаем.Что(Результат.Вывод()).Содержит("Вывод конструктора поставщика");

КонецПроцедуры

&Тест
Процедура ИсключениеПоставщикаКонструктораЛомаетНабор() Экспорт

	Прогон = ПрогнатьНабор("НаборСПадающимПоставщикомКонструктора");

	Набор     = ПрогоныТестов.НайтиНабор(Прогон.План, "НаборСПадающимПоставщикомКонструктора");
	Результат = Прогон.Статистика.Результат(Набор);

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);

	ЦепочкиПричин.ПроверитьЗвенья(Результат.Причины().Получить(0), Массивы.ИзЭлементов(
		"Не удаётся инстанцировать тестовый набор",
		"Не удаётся разрешить параметр П метода ПриСозданииОбъекта",
		"Поставщик не смог"
	));

КонецПроцедуры

&Тест
Процедура БезПодписчикаЗаполненияТестЛомаетсяДоВызова() Экспорт

	ЖурналВыполнения.Очистить();

	Поделка = ПоделкаНабора("НаборСПадающимПоставщиком");
	ОтписатьРазрешениеЗначений(Поделка);

	План = Поделка.НайтиЖелудь("МенеджерТестирования").Тестировать();

	Результат = Поделка.НайтиЖелудь("РепортерСтатистика").Результат(ПрогоныТестов.НайтиТест(
		ПрогоныТестов.НайтиНабор(План, "НаборСПадающимПоставщиком"),
		"ПадениеПоставщика"
	));

	// Незаполненный аргумент приводит к ошибке до вызова тестового метода
	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);

	ЦепочкиПричин.ПроверитьЗвенья(Результат.Причины().Получить(0), Массивы.ИзЭлементов(
		"Значение параметра П метода ПадениеПоставщика не установлено"
	));

	Ожидаем.Что(ЖурналВыполнения.Записи.Найти("ПадениеПоставщика выполнен")).ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура БезПодписчикаЗаполненияНаборНеСоздается() Экспорт

	Поделка = ПоделкаНабора("НаборСПадающимПоставщикомКонструктора");
	ОтписатьРазрешениеЗначений(Поделка);

	План = Поделка.НайтиЖелудь("МенеджерТестирования").Тестировать();

	Результат = Поделка.НайтиЖелудь("РепортерСтатистика").Результат(
		ПрогоныТестов.НайтиНабор(План, "НаборСПадающимПоставщикомКонструктора")
	);

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);

	ЦепочкиПричин.ПроверитьЗвенья(Результат.Причины().Получить(0), Массивы.ИзЭлементов(
		"Не удаётся инстанцировать тестовый набор",
		"Значение параметра П метода ПриСозданииОбъекта не установлено"
	));

КонецПроцедуры

&Тест
Процедура ЗначениеПараметраНеЗадаетсяДважды() Экспорт

	ЖурналВыполнения.Очистить();

	Поделка = ПоделкаНабора("НаборДляДублирующегоПодписчика");
	Поделка.НайтиЖелудь("ДублирующийПодписчикАргументов");

	План = Поделка.НайтиЖелудь("МенеджерТестирования").Тестировать();

	Результат = Поделка.НайтиЖелудь("РепортерСтатистика").Результат(ПрогоныТестов.НайтиТест(
		ПрогоныТестов.НайтиНабор(План, "НаборДляДублирующегоПодписчика"),
		"Тест"
	));

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);

	ЦепочкиПричин.ПроверитьЗвенья(Результат.Причины().Получить(0), Массивы.ИзЭлементов(
		"Значение параметра П метода Тест уже получено"
	));

	Ожидаем.Что(ЖурналВыполнения.Записи.Найти("Тест выполнен")).ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура ПозиционномуПараметруЗначениеПоставщикаНеЗадать() Экспорт

	План = ПоделкаНабора("НаборСПоставщикамиПараметров").НайтиЖелудь("МенеджерТестирования").Обнаружить();

	Аргументы = ПрогоныТестов.НайтиНабор(План, "НаборСПоставщикамиПараметров")
		.Сигнатура("Параметризованный").СоздатьАргументы(Списки.ИзЭлементов(1, 2));

	Параметры = Новый Массив;
	Параметры.Добавить(0);
	Параметры.Добавить("Значение поставщика");

	Ожидаем.Что(Аргументы).Метод("Установить", Параметры).ВыбрасываетИсключение(
		"Параметр А метода Параметризованный недоступен для заполнения"
	);

КонецПроцедуры

&Тест
Процедура НеверноеОбъявлениеПараметраЛомаетТолькоСвойТест() Экспорт

	Прогон = ПрогнатьНабор("НаборСНевернымиПоставщиками");

	Ожидаем.Что(Прогон.План.ЕстьОшибкиОбнаружения()).ЭтоИстина();

	Результат = РезультатТеста(Прогон, "НаборСНевернымиПоставщиками", "ДваПоставщика");

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Ожидаем.Что(Результат.ОписанияПричин().Получить(0)).Содержит(
		"У параметра П метода ДваПоставщика несколько поставщиков: ПоставщикЗначенийТестов, ПоставщикЗначенийТестов"
	);

	Результат = РезультатТеста(Прогон, "НаборСНевернымиПоставщиками", "НезарегистрированныйПоставщик");

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Ожидаем.Что(Результат.ОписанияПричин().Получить(0)).Содержит(
		"Не найден поставщик ПоставщикКоторогоНет у параметра П метода НезарегистрированныйПоставщик: желудь не зарегистрирован"
	);

	// Источник не заполняет параметр, значение которого дает поставщик
	Результат = РезультатТеста(Прогон, "НаборСНевернымиПоставщиками", "ИмяСПоставщиком");

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Ожидаем.Что(Результат.ОписанияПричин().Получить(0)).Содержит(
		"значение параметра П дает поставщик значения"
	);

	Результат = РезультатТеста(Прогон, "НаборСНевернымиПоставщиками", "ВерныйТест");

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Успех);

КонецПроцедуры

// autumn бросает исключение, когда прозвище поставщика неоднозначно: оно ломает
// только свой тест, а не обнаружение плана
&Тест
Процедура НеоднозначныйПоставщикЛомаетТолькоСвойТест() Экспорт

	Прогон = ПрогнатьНабор("НаборСНеоднозначнымПоставщиком");

	Результат = РезультатТеста(Прогон, "НаборСНеоднозначнымПоставщиком", "Неоднозначный");

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);

	ЦепочкиПричин.ПроверитьЗвенья(Результат.Причины().Получить(0), Массивы.ИзЭлементов(
		"Не удаётся найти поставщик НеоднозначныйПоставщик у параметра Значение метода Неоднозначный",
		"Найдено несколько желудей"
	));

	Ожидаем.Что(ЖурналВыполнения.Записи.Найти("Неоднозначный выполнен")).ЭтоНеопределено();
	ИндексЗаписи("Зеленый выполнен");

КонецПроцедуры

&Тест
Процедура НеверноеОбъявлениеПараметраМетодаЖизненногоЦиклаЛомаетНабор() Экспорт

	Прогон = ПрогнатьНабор("НаборСНевернымПоставщикомПередВсеми");

	Набор     = ПрогоныТестов.НайтиНабор(Прогон.План, "НаборСНевернымПоставщикомПередВсеми");
	Результат = Прогон.Статистика.Результат(Набор);

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Ожидаем.Что(Результат.ОписанияПричин().Получить(0)).Содержит(
		"Не найден поставщик ПоставщикКоторогоНет у параметра П метода ПередВсеми: желудь не зарегистрирован"
	);

КонецПроцедуры

#КонецОбласти

#Область ВладельцыЭкземпляров

&ПараметризованныйТест
&ИсточникЗначение("НаборОдиночкаСПоставщиком", "Первый", Ложь, "НеСоздавался")
&ИсточникЗначение("НаборСПолемОтПоставщика", "Тест", Истина, "НеСоздавался")
&ИсточникЗначение("НаборСПолемОтПоставщика", "Тест", Ложь, "Создан")
Процедура ФабрикаЯвноОпределяетСозданиеДляУсловийИзоляции(ИмяНабора, ИмяТеста, ДляНабора, Состояние) Экспорт

	Обнаружение = ОбнаружитьНаборДляФабрики(ИмяНабора);
	Узел = ?(ДляНабора, Обнаружение.Набор, ПрогоныТестов.НайтиТест(Обнаружение.Набор, ИмяТеста));
	Создание = Обнаружение.Фабрика.СоздатьДляУсловийИзоляции(Обнаружение.Набор, Узел);

	Ожидаем.Что(Создание.Состояние()).Равно(Состояние);
	Ожидаем.Что(Создание.Экземпляр().СодержитЗначение()).Равно(Состояние = СостоянияСозданияЭкземпляра.Создан);
	Ожидаем.Что(КоличествоЗаписейНачинающихсяС("Поставщик ")).Равно(0);

КонецПроцедуры

&Тест
Процедура ВычисленияНеЗаменяютОдиночкуИсполнения() Экспорт

	Обнаружение = ОбнаружитьНаборДляФабрики("НаборОдиночкаСПоставщиком");
	Набор = Обнаружение.Набор;
	Фабрика = Обнаружение.Фабрика;
	Итог = Обнаружение.Поделка.НайтиЖелудь("РезультатВыполненияТеста", Массивы.ИзЭлементов(
		СостоянияВыполненияТестов.Успех,
		Списки.ИзЭлементов(),
		""
	));

	Попытка

		ПервоеВычисление = Фабрика.СоздатьДляВычисления(Набор);
		ВтороеВычисление = Фабрика.СоздатьДляВычисления(Набор);
		Ожидаем.Что(ПервоеВычисление.Состояние()).Равно(СостоянияСозданияЭкземпляра.Создан);
		Ожидаем.Что(ВтороеВычисление.Состояние()).Равно(СостоянияСозданияЭкземпляра.Создан);
		Ожидаем.Что(ПервоеВычисление.Экземпляр().Получить())
			.Не_().Равно(ВтороеВычисление.Экземпляр().Получить());
		Ожидаем.Что(КоличествоЗаписейНачинающихсяС("Поставщик ")).Равно(0);

		ПервоеИсполнение = Фабрика.СоздатьДляИсполнения(Набор, Набор);
		ВтороеИсполнение = Фабрика.СоздатьДляИсполнения(Набор, Набор);
		Ожидаем.Что(ПервоеИсполнение.Состояние()).Равно(СостоянияСозданияЭкземпляра.Создан);
		Ожидаем.Что(ВтороеИсполнение.Состояние()).Равно(СостоянияСозданияЭкземпляра.Создан);
		Ожидаем.Что(ПервоеИсполнение.Экземпляр().Получить()).Равно(ВтороеИсполнение.Экземпляр().Получить());
		Ожидаем.Что(ПервоеИсполнение.Экземпляр().Получить())
			.Не_().Равно(ПервоеВычисление.Экземпляр().Получить());
		Ожидаем.Что(КоличествоЗаписейНачинающихсяС("Поставщик ")).Равно(1);

	Исключение

		Набор.Контекст().Закрыть(Новый Опциональный(Итог));
		ВызватьИсключение;

	КонецПопытки;

	Закрытие = Набор.Контекст().Закрыть(Новый Опциональный(Итог));
	Ожидаем.Что(Закрытие.Причины.Пусто()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОдиночкаПолучаетЗначениеКонструктораОднаждыВКонтекстеНабора() Экспорт

	ПрогнатьНабор("НаборОдиночкаСПоставщиком");

	Ожидаем.Что(КоличествоЗаписей("Поставщик ПриСозданииОбъекта.Значение[0] для НаборОдиночкаСПоставщиком")).Равно(1);
	Ожидаем.Что(КоличествоЗаписей("Конструктор одиночки Одиночка")).Равно(1);

	// Созданное для одиночки живет, пока не закончится ее набор
	Ожидаем.Что(ИндексЗаписи("Закрыт НаборОдиночкаСПоставщиком: ПриСозданииОбъекта.Значение Успех падения=Нет"))
		.Больше(ИндексЗаписи("Второй"));

КонецПроцедуры

&Тест
Процедура ОдиночкаСоздаетсяЗановоВКаждомПрогоне() Экспорт

	Прогон = ПрогнатьНабор("НаборОдиночкаСПоставщиком");

	ЖурналВыполнения.Записать("Повторный прогон");
	Прогон.Поделка.НайтиЖелудь("МенеджерТестирования").Тестировать();

	// Первый прогон закрыл созданное для своей одиночки
	Ожидаем.Что(ИндексЗаписи("Закрыт НаборОдиночкаСПоставщиком: ПриСозданииОбъекта.Значение Успех падения=Нет"))
		.Меньше(ИндексЗаписи("Повторный прогон"));

	// Второй прогон не получает закрытое: одиночка создается заново со своим значением
	Ожидаем.Что(КоличествоЗаписей("Поставщик ПриСозданииОбъекта.Значение[0] для НаборОдиночкаСПоставщиком")).Равно(2);
	Ожидаем.Что(КоличествоЗаписей("Конструктор одиночки Одиночка")).Равно(2);
	Ожидаем.Что(КоличествоЗаписей("Закрыт НаборОдиночкаСПоставщиком: ПриСозданииОбъекта.Значение Успех падения=Нет"))
		.Равно(2);

КонецПроцедуры

&Тест
Процедура ОбнаружениеИПрогонСоздаютСвоиОдиночки() Экспорт

	ЖурналВыполнения.Очистить();

	Менеджер = ПоделкаНабора("НаборОдиночкаСПоставщикомИВыражением").НайтиЖелудь("МенеджерТестирования");

	Менеджер.Обнаружить();
	ЖурналВыполнения.Записать("Прогон после обнаружения");
	Менеджер.Тестировать();

	Граница = ИндексЗаписи("Прогон после обнаружения");

	// Обнаружение вычисляет выражение источника на одиночке без значений поставщиков
	// и не запоминает ее: и в Обнаружить, и в обнаружении Тестировать
	Ожидаем.Что(ИндексЗаписи("Конструктор одиночки Неопределено")).Меньше(Граница);
	Ожидаем.Что(КоличествоЗаписей("Конструктор одиночки Неопределено")).Равно(2);

	// Одиночку прогона, со значениями, создает исполнение - одну на обе итерации
	Ожидаем.Что(ИндексЗаписи("Конструктор одиночки Выражение")).Больше(Граница);
	Ожидаем.Что(КоличествоЗаписей("Конструктор одиночки Выражение")).Равно(1);
	Ожидаем.Что(КоличествоЗаписей("Поставщик ПриСозданииОбъекта.Значение[0] для НаборОдиночкаСПоставщикомИВыражением"))
		.Равно(1);
	Ожидаем.Что(КоличествоЗаписей("Закрыт НаборОдиночкаСПоставщикомИВыражением: ПриСозданииОбъекта.Значение Успех падения=Нет"))
		.Равно(1);

КонецПроцедуры

&Тест
Процедура ПриОбнаруженииПоставщиковНеСпрашивают() Экспорт

	Прогон = ПрогнатьНабор("НаборСПоставщикомИВыражением");

	// Экземпляр для выражения источника создан при обнаружении без значений
	// поставщиков: их получают только экземпляры исполнения - набора и итерации
	Ожидаем.Что(КоличествоЗаписей("Конструктор получил Неопределено")).Равно(1);
	Ожидаем.Что(ИндексЗаписи("Конструктор получил Неопределено"))
		.Меньше(ИндексЗаписи("Конструктор получил Выражение"));

	Ожидаем.Что(КоличествоЗаписей("Поставщик ПриСозданииОбъекта.Значение[0] для НаборСПоставщикомИВыражением"))
		.Равно(1);
	Ожидаем.Что(КоличествоЗаписей("Закрыт НаборСПоставщикомИВыражением: ПриСозданииОбъекта.Значение Успех падения=Нет"))
		.Равно(1);
	Ожидаем.Что(ИндексЗаписи("Закрыт НаборСПоставщикомИВыражением: ПриСозданииОбъекта.Значение Успех падения=Нет"))
		.Больше(ИндексЗаписи("Закрыт [1]: ПриСозданииОбъекта.Значение Успех падения=Нет"));

	// Итерацию выражение дало
	Шаблон = ПрогоныТестов.НайтиТест(ПрогоныТестов.НайтиНабор(Прогон.План, "НаборСПоставщикомИВыражением"), "Тест");
	Ожидаем.Что(Шаблон.Дети().Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ИзолированныйНаборПолучаетЗначенияВСвоейСреде() Экспорт

	Прогон = ПрогнатьНабор("ИзолированныйНаборСПоставщиком");

	Результат = РезультатТеста(Прогон, "ИзолированныйНаборСПоставщиком", "Тест");

	Ожидаем.Что(Результат.Состояние(), Результат.ОписанияПричин()).Равно(СостоянияВыполненияТестов.Успех);

КонецПроцедуры

&Тест
Процедура ПроцессноИзолированныйНаборПолучаетЗначенияВСвоейСреде() Экспорт

	Прогон = ПрогнатьНабор("ИзолированныйПроцессныйНаборСПоставщиком");

	Результат = РезультатТеста(Прогон, "ИзолированныйПроцессныйНаборСПоставщиком", "Тест");

	Ожидаем.Что(Результат.Состояние(), Результат.ОписанияПричин()).Равно(СостоянияВыполненияТестов.Успех);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ИзолированныйНаборОдиночкаСЗакрытием")
&ИсточникЗначение("ИзолированныйПроцессныйНаборОдиночкаСЗакрытием")
Процедура ЗакрытиеИзолированнойОдиночкиВРезультатеНабора(ИмяНабора) Экспорт

	Прогон = ПрогнатьНабор(ИмяНабора);

	Результат = Прогон.Статистика.Результат(ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора));

	// Значения конструктора одиночки закрываются с набором в его среде: исключение
	// закрытия ломает набор, а вывод закрытия остается в его выводе
	Ожидаем.Что(Результат.Состояние(), Результат.ОписанияПричин()).Равно(СостоянияВыполненияТестов.Сломан);
	Ожидаем.Что(Результат.ОписанияПричин().Получить(0)).Содержит("Закрытие не смогло");
	Ожидаем.Что(Результат.Вывод()).Содержит("Вывод закрытия ПриСозданииОбъекта.Наблюдатель");

КонецПроцедуры

// Регистрацию поставщика изолированного набора проверяет его среда: при чистом
// обнаружении ошибка обнаружения набора приходит из среды составом плана. У набора
// уровня "Поделка" лямбда совета обращается к методу набора - экземпляр для нее
// создан в родителе без значений поставщиков
&ПараметризованныйТест
&ИсточникЗначение("ИзолированныйНаборСНезарегистрированнымПоставщикомИСоветомНаЭкземпляре")
&ИсточникЗначение("ИзолированныйПроцессныйНаборСНезарегистрированнымПоставщиком")
Процедура ОшибкаОбнаруженияВСредеДоходитДоРодителя(ИмяНабора) Экспорт

	План  = ПоделкаНабора(ИмяНабора).НайтиЖелудь("МенеджерТестирования").Обнаружить();
	Набор = ПрогоныТестов.НайтиНабор(План, ИмяНабора);

	Ожидаем.Что(План.ЕстьОшибкиОбнаружения()).ЭтоИстина();
	Ожидаем.Что(Набор.ОшибкиОбнаружения()).ИмеетДлину(1);
	Ожидаем.Что(Набор.ОшибкиОбнаружения().Получить(0).Описание).Равно(
		"Не найден поставщик ПоставщикКоторогоНет у параметра Значение метода ПриСозданииОбъекта: "
			+ "желудь не зарегистрирован"
	);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ИзолированныйНаборДляПодписчика", 1)
&ИсточникЗначение("ИзолированныйПроцессныйНаборДляПодписчика", 1)
&ИсточникЗначение("НаборСИзолированнымиШаблонамиДляПодписчика", 2)
Процедура КонтекстыЗеркалЗакрываютсяДоПубликацииКонца(ИмяНабора, КоличествоЗеркал) Экспорт

	ЖурналВыполнения.Очистить();

	Поделка = ПоделкаНабора(ИмяНабора);

	// Подписчик родителя добавляет действие закрытия в контекст каждого теста,
	// и зеркала - тоже: конец зеркала публикует не диспетчер
	Поделка.НайтиЖелудь("ПодписчикЗакрытияЗеркал");
	Поделка.НайтиЖелудь("МенеджерТестирования").Тестировать();

	Ожидаем.Что(
		КоличествоЗаписейНачинающихсяС("Подписчик закрыл "),
		СтрСоединить(ЖурналВыполнения.Записи, Символы.ПС)
	).Равно(КоличествоЗеркал);

	// Действие закрытия видит результат зеркала
	Для Каждого Запись Из ЖурналВыполнения.Записи Цикл
		Если СтрНачинаетсяС(Запись, "Подписчик закрыл ") Тогда
			Ожидаем.Что(СтрЗаканчиваетсяНа(Запись, " Успех"), Запись).ЭтоИстина();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ИзолированныйНаборСНезарегистрированнымПоставщикомИСоветомНаЭкземпляре")
&ИсточникЗначение("ИзолированныйПроцессныйНаборСНезарегистрированнымПоставщиком")
Процедура НезарегистрированныйПоставщикЛомаетИзолированныйНаборВЕгоСреде(ИмяНабора) Экспорт

	Прогон = ПрогнатьНабор(ИмяНабора);

	Результат = Прогон.Статистика.Результат(ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора));

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Ожидаем.Что(СтрСоединить(Результат.ОписанияПричин().ВМассив(), Символы.ПС)).Содержит(
		"Не найден поставщик ПоставщикКоторогоНет у параметра Значение метода ПриСозданииОбъекта: "
			+ "желудь не зарегистрирован"
	);

КонецПроцедуры

// Условия изолированного теста родитель проверяет до подъема среды, но экземпляр
// набора с поставщиками в конструкторе для этого не создает: значение поставщика
// в родителе другое, и условие, решенное по нему, ложно выключило бы тест
&Тест
Процедура УсловиеИзолированногоТестаНаЗначенииПоставщикаРешаетСреда() Экспорт

	Прогон = ПрогнатьНабор("НаборСИзолированнымиТестамиИУсловиемНаПоставщике");

	Для Каждого ИмяТеста Из СтрРазделить("ПоделочныйТест,ПроцессныйТест", ",") Цикл

		Результат = РезультатТеста(Прогон, "НаборСИзолированнымиТестамиИУсловиемНаПоставщике", ИмяТеста);

		Ожидаем.Что(
			Результат.Состояние(),
			ИмяТеста + ": " + СтрСоединить(Результат.ОписанияПричин().ВМассив(), Символы.ПС)
		).Равно(СостоянияВыполненияТестов.Успех);

	КонецЦикла;

КонецПроцедуры

// Изолированный тест с неверным объявлением исполняется в родителе ради своих
// условий, но поставщиков и тогда не спрашивают: условие по значению поставщика
// родителя скрыло бы ошибку объявления
&Тест
Процедура УсловиеНеобнаруженногоИзолированногоТестаНеСкрываетОшибку() Экспорт

	Прогон = ПрогнатьНабор("НаборСИзолированнымиТестамиИУсловиемНаПоставщике");

	Для Каждого ИмяТеста Из СтрРазделить("ПоделочныйТестСНевернымОбъявлением,ПроцессныйТестСНевернымОбъявлением", ",") Цикл

		Результат = РезультатТеста(Прогон, "НаборСИзолированнымиТестамиИУсловиемНаПоставщике", ИмяТеста);

		Ожидаем.Что(Результат.Состояние(), ИмяТеста).Равно(СостоянияВыполненияТестов.Сломан);
		Ожидаем.Что(Результат.ОписанияПричин().Получить(0)).Содержит(
			СтрШаблон("У параметра П метода %1 несколько поставщиков", ИмяТеста)
		);

	КонецЦикла;

КонецПроцедуры

// Поставщика включает совет изоляции: он есть только в среде узла, и родитель
// не отвергает изолированный узел, проверяя регистрацию у себя
&ПараметризованныйТест
&ИсточникЗначение("ИзолированныйНаборСПоставщикомИзСовета")
&ИсточникЗначение("ИзолированныйПроцессныйНаборСПоставщикомИзСовета")
&ИсточникЗначение("НаборСИзолированнымиТестамиСПоставщикомИзСовета")
Процедура ПоставщикИзСоветаИзоляцииДаетЗначенияВСредеУзла(ИмяНабора) Экспорт

	Прогон = ПрогнатьНабор(ИмяНабора);

	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);

	РезультатНабора = Прогон.Статистика.Результат(Набор);

	Ожидаем.Что(
		РезультатНабора.Состояние(),
		СтрСоединить(РезультатНабора.ОписанияПричин().ВМассив(), Символы.ПС)
	).Равно(СостоянияВыполненияТестов.Успех);

	Ожидаем.Что(Набор.Дети().Количество()).Больше(0);

	Для Каждого Тест Из Набор.Дети() Цикл

		Результат = Прогон.Статистика.Результат(Тест);

		Ожидаем.Что(
			Результат.Состояние(),
			Тест.Имя() + ": " + СтрСоединить(Результат.ОписанияПричин().ВМассив(), Символы.ПС)
		).Равно(СостоянияВыполненияТестов.Успех);

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ЗначенияПолей

&Тест
Процедура ПолеЗаполняетсяПередЕдинственнымЭтапомПослеВсех() Экспорт

	ИмяНабора = "НаборСПолемОтПоставщикаИПослеВсех";
	Прогон = ПрогнатьНабор(ИмяНабора);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	Результат = Прогон.Статистика.Результат(Набор);

	Ожидаем.Что(Результат.Состояние(), Результат.ОписанияПричин()).Равно(СостоянияВыполненияТестов.Успех);
	Ожидаем.Что(КоличествоЗаписей("Поставщик Поле.Номер для " + ИмяНабора)).Равно(1);
	Ожидаем.Что(КоличествоЗаписей("Поставщик Поле.Номер для Тест")).Равно(1);
	Ожидаем.Что(ИндексЗаписи("ПослеВсех 1")).Больше(ИндексЗаписи("Тест 1"));

КонецПроцедуры

&Тест
Процедура ПолеЗаполняетсяПослеУсловийПередМетодамиУзла() Экспорт

	Прогон = ПрогнатьНабор("НаборСПолемОтПоставщика");

	Статистика = Прогон.Статистика.СтатистикаТестПлана();

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовОбнаружено", 0)).Равно(2);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0)).Равно(2);

	// Конструктор отрабатывает раньше, чем заполняется поле
	ИндексЗаписи("Конструктор без поля");

	// Набор - в своем контексте, перед ПередВсеми
	ИндексЗаписи("ПередВсеми 1");
	ИндексЗаписи("Поставщик Поле.Номер для НаборСПолемОтПоставщика");

	// Тест - в своем контексте, перед ПередКаждым: поле спросили раньше параметра
	ИндексЗаписи("Поставщик Поле.Номер для Тест");
	ИндексЗаписи("ПередКаждым 1 2");
	ИндексЗаписи("Тест 1");
	ИндексЗаписи("Шаблон 1");

	// Набор, тест и итерация шаблона; экземпляру обнаружения и экземпляру условия
	// контейнера поле не заполняется
	Ожидаем.Что(КоличествоЗаписейНачинающихсяС("Поставщик Поле.Номер для ")).Равно(3);
	// Экземпляр обнаружения принадлежит набору, но поле заполняется только перед ПередВсеми
	Ожидаем.Что(КоличествоЗаписей("Поставщик Поле.Номер для НаборСПолемОтПоставщика")).Равно(1);
	Ожидаем.Что(ЖурналВыполнения.Записи.Найти("Поставщик Поле.Номер для Шаблон")).ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура ПолеОдиночкиЗаполняетсяЗановоДляКаждогоТеста() Экспорт

	ПрогнатьНабор("НаборОдиночкаСПолемОтПоставщика");

	// Хранилище у каждого теста свое - счетчик в каждом с единицы
	ИндексЗаписи("Первый 1");
	ИндексЗаписи("Второй 1");

	ИндексЗаписи("Закрыт Первый: Поле.Номер Успех падения=Нет");
	ИндексЗаписи("Закрыт Второй: Поле.Номер Успех падения=Нет");

	// Методов у экземпляра набора нет: для набора поле не заполняется
	Ожидаем.Что(КоличествоЗаписейНачинающихсяС("Поставщик Поле.Номер для ")).Равно(2);

КонецПроцедуры

&Тест
Процедура ИсключениеПоставщикаПоляЛомаетТестДоЕгоМетодов() Экспорт

	Прогон = ПрогнатьНабор("НаборСПадающимПоставщикомПоля");

	Результат = РезультатТеста(Прогон, "НаборСПадающимПоставщикомПоля", "Тест");

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);

	ЦепочкиПричин.ПроверитьЗвенья(Результат.Причины().Получить(0), Массивы.ИзЭлементов(
		"Не удаётся разрешить поле Поле",
		"Поставщик не смог"
	));

	Ожидаем.Что(ЖурналВыполнения.Записи.Найти("ПередКаждым выполнен")).ЭтоНеопределено();
	Ожидаем.Что(ЖурналВыполнения.Записи.Найти("Тест выполнен")).ЭтоНеопределено();
	Ожидаем.Что(ЖурналВыполнения.Записи.Найти("ПослеКаждого выполнен")).ЭтоНеопределено();

	Ожидаем.Что(СтрНайти(Результат.Вывод(), "Вывод поставщика Поле.Поле"), Результат.Вывод()).Больше(0);

КонецПроцедуры

&Тест
Процедура ИсключениеПоставщикаПоляЛомаетНаборДоПередВсеми() Экспорт

	Прогон = ПрогнатьНабор("НаборСПадающимПоставщикомПоляПередВсеми");

	Набор     = ПрогоныТестов.НайтиНабор(Прогон.План, "НаборСПадающимПоставщикомПоляПередВсеми");
	Результат = Прогон.Статистика.Результат(Набор);

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);

	ЦепочкиПричин.ПроверитьЗвенья(Результат.Причины().Получить(0), Массивы.ИзЭлементов(
		"Не удаётся разрешить поле Поле",
		"Поставщик не смог"
	));

	Ожидаем.Что(ЖурналВыполнения.Записи.Найти("ПередВсеми выполнен")).ЭтоНеопределено();
	Ожидаем.Что(ЖурналВыполнения.Записи.Найти("Тест выполнен")).ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура НеверноеОбъявлениеПоляЛомаетНабор() Экспорт

	Прогон = ПрогнатьНабор("НаборСНевернымиПолями");

	Набор     = ПрогоныТестов.НайтиНабор(Прогон.План, "НаборСНевернымиПолями");
	Результат = Прогон.Статистика.Результат(Набор);

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);

	Ожидаем.Что(СтрСоединить(Результат.ОписанияПричин().ВМассив(), Символы.ПС)).Содержит(
