// Представление собственных ошибок наборов в JUnit XML.

#Использовать asserts
#Использовать collectionos
#Использовать fluent
#Использовать "./support"
#Использовать ".."

&ПараметризованныйТест
&ИсточникЗначение("НаборСломанныйКонструктор", "execution", "Конструктор набора сломан намеренно")
&ИсточникЗначение("НаборСВыводомИСломаннымПередВсеми", "execution", "ПередВсеми сломан намеренно")
&ИсточникЗначение("ОбеАннотацииРесурса", "temp-resources", "несколько поставщиков")
Процедура СбойДоТестовДаётОшибочныйTestcase(ИмяНабора, Каталог, Причина) Экспорт

	Прогон = Прогнать(ИмяНабора, Каталог);
	Отчёт = ПрочитатьОтчёт(ПутьОтчёта(ИмяНабора));
	Случаи = НайтиЭлементы(Отчёт, "testcase");
	Ожидаем.Что(Случаи.Количество()).Равно(1);
	ПроверитьСчётчики(Отчёт, 1, 1);
	ПроверитьСчётчики(НайтиЭлементы(Отчёт, "testsuite").Получить(0), 1, 1);
	Ожидаем.Что(Атрибут(Случаи.Получить(0), "classname")).Равно(ИмяНабора);
	Ошибки = НайтиЭлементы(Случаи.Получить(0), "error");
	Ожидаем.Что(Ошибки.Количество()).Равно(1);
	Ожидаем.Что(Ошибки.Получить(0).Текст).Содержит(Причина);
	Ожидаем.Что(Прогон.Статистика.СтатистикаТестПлана().ПолучитьИлиУмолчание("ТестовОбнаружено", 0)).Равно(0);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("СбойУровняНабораJUnit", "Конструктор")
&ИсточникЗначение("СбойУровняНабораJUnit", "ПередВсеми")
&ИсточникЗначение("ПоделочныйСбойНабораJUnit", "Конструктор")
&ИсточникЗначение("ПроцессныйСбойНабораJUnit", "Конструктор")
Процедура РанняяОшибкаНабораСохраняетсяПриИзоляции(ИмяНабора, Режим) Экспорт

	Ключ = ИмяНабора + "." + Режим;
	Прогнать(ИмяНабора, "results", Ключ, Режим);
	Отчёт = ПрочитатьОтчёт(ПутьОтчёта(Ключ));
	ПроверитьСчётчики(Отчёт, 1, 1);
	Случай = НайтиЭлементы(Отчёт, "testcase").Получить(0);
	Ожидаем.Что(Атрибут(Случай, "classname")).Равно(ИмяНабора);
	Ожидаем.Что(НайтиЭлементы(Случай, "error").Получить(0).Текст)
		.Содержит(?(Режим = "Конструктор", "Ошибка конструктора <&>", "Ошибка ПередВсеми <&>"));

	Если Режим = "Конструктор" Тогда
		Ожидаем.Что(НайтиЭлементы(Случай, "error").Получить(0).Текст).Содержит("Вывод конструктора <&>");
	Иначе
		Ожидаем.Что(НайтиЭлементы(Случай, "system-out").Получить(0).Текст).Содержит("Вывод конструктора <&>");
	КонецЕсли;

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ПередВсемиУтверждение", 1, 0, 1)
&ИсточникЗначение("ПослеВсех", 2, 1, 0)
&ИсточникЗначение("ПослеВсехУтверждение", 2, 0, 1)
&ИсточникЗначение("Закрытие", 2, 1, 0)
Процедура СобственнаяОшибкаНабораВиднаОтдельноОтДетей(Режим, Всего, Ошибок, Падений) Экспорт

	Прогон = Прогнать("СбойУровняНабораJUnit", "results", Режим);
	Отчёт = ПрочитатьОтчёт(ПутьОтчёта(Режим));
	Случаи = НайтиЭлементы(Отчёт, "testcase");
	Ожидаем.Что(Случаи.Количество()).Равно(Всего);
	ПроверитьСчётчики(Отчёт, Всего, Ошибок, Падений);
	ПроверитьСчётчики(НайтиЭлементы(Отчёт, "testsuite").Получить(0), Всего, Ошибок, Падений);
	Ожидаем.Что(НайтиЭлементы(Отчёт, "error").Количество()).Равно(Ошибок);
	Ожидаем.Что(НайтиЭлементы(Отчёт, "failure").Количество()).Равно(Падений);
	Ожидаем.Что(Прогон.Статистика.СтатистикаТестПлана().ПолучитьИлиУмолчание("ТестовОбнаружено", 0))
		.Равно(Всего - 1);

	Если Всего > 1 Тогда

		Ожидаем.Что(Случаи.ПроцессорКоллекции().ЛюбойСоответствует(
			"Случай -> Случай.Атрибуты.Получить(""name"").Получить() = ""Проверка"""
		)).ЭтоИстина();

	КонецЕсли;

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Успех", 0, 0)
&ИсточникЗначение("ОшибкаТеста", 1, 0)
&ИсточникЗначение("ПропускТеста", 0, 1)
&ИсточникЗначение("ПрерываниеТеста", 0, 1)
Процедура СостояниеДетейНеСоздаётЛишнийTestcase(Режим, Падений, Пропущено) Экспорт

	Прогнать("СбойУровняНабораJUnit", "results", Режим);
	Отчёт = ПрочитатьОтчёт(ПутьОтчёта(Режим));
	ПроверитьСчётчики(Отчёт, 1, 0, Падений, Пропущено);
	Ожидаем.Что(НайтиЭлементы(Отчёт, "testcase").Количество()).Равно(1);
	Ожидаем.Что(Атрибут(НайтиЭлементы(Отчёт, "testcase").Получить(0), "name")).Равно("Проверка");

КонецПроцедуры

&Тест
Процедура ПустойПланНеПолучаетСлужебныхТестов() Экспорт

	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.ПутьКОтчетуJUnit", ПутьОтчёта("ПустойПлан"));
	ПрогоныТестов.Прогнать("НеСуществующийПустойПлан", "", "", Детальки);
	Отчёт = ПрочитатьОтчёт(ПутьОтчёта("ПустойПлан"));
	ПроверитьСчётчики(Отчёт, 0, 0);
	Ожидаем.Что(НайтиЭлементы(Отчёт, "testcase").Количество()).Равно(0);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ПослеВсех")
&ИсточникЗначение("Закрытие")
&ИсточникЗначение("ПослеВсехУтверждение")
Процедура СлужебныйTestcaseСохраняетПричиныИВывод(Режим) Экспорт

	Прогон = Прогнать("СбойУровняНабораJUnit", "results", Режим);
	Отчёт = ПрочитатьОтчёт(ПутьОтчёта(Режим));
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, "СбойУровняНабораJUnit");
	Результат = Прогон.Статистика.Результат(Набор);
	Случай = НайтиЭлементы(Отчёт, "testcase").Получить(0);
	Ожидаем.Что(Атрибут(Случай, "name")).Равно("СбойУровняНабораJUnit.containerError");
	Ожидаем.Что(Атрибут(Случай, "time")).Равно("0");
	Ожидаем.Что(Атрибут(Случай, "file")).Равно(Набор.Путь().Получить());
	Ожидаем.Что(НайтиЭлементы(Случай, "system-out").Получить(0).Текст).Содержит(Результат.Вывод());
	ТипОшибки = ?(Режим = "ПослеВсехУтверждение", "failure", "error");
	Ошибка = НайтиЭлементы(Случай, ТипОшибки).Получить(0);
	Ожидаем.Что(Атрибут(Ошибка, "message")).Содержит("<&>");
	Ожидаем.Что(Ошибка.Текст).Содержит("<&>");

	Если Режим <> "ПослеВсехУтверждение" Тогда
		Ожидаем.Что(Ошибка.Текст).Содержит("Вложенная причина <&>");
	КонецЕсли;

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Источник", 1, 1)
&ИсточникЗначение("Условие", 1, 1)
&ИсточникЗначение("Пропуск", 0, 0)
&ИсточникЗначение("Успех", 2, 0)
Процедура СчётчикиВложенногоКонтейнераСогласованы(Режим, Всего, Ошибок) Экспорт

	Ключ = "Контейнер." + Режим;
	Прогнать("СбойКонтейнераJUnit", "results", Ключ, Режим);
	Отчёт = ПрочитатьОтчёт(ПутьОтчёта(Ключ));
	ПроверитьСчётчики(Отчёт, Всего, Ошибок);
	Ожидаем.Что(НайтиЭлементы(Отчёт, "testsuite").Количество()).Равно(?(Режим = "Источник", 1, 2));
	Ожидаем.Что(НайтиЭлементы(Отчёт, "testcase").Количество()).Равно(Всего);

	Если Ошибок > 0 Тогда

		Случай = НайтиЭлементы(Отчёт, "testcase").Получить(0);
		Ожидаем.Что(Атрибут(Случай, "name")).Равно(?(Режим = "Источник", "Шаблон", "Шаблон.containerError"));
		Ожидаем.Что(Атрибут(Случай, "classname")).Равно("СбойКонтейнераJUnit");

	КонецЕсли;

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ПустойНаборJUnit", "results")
&ИсточникЗначение("НаборВыключенныйСоСломаннымКонструктором", "execution")
Процедура ПропущенныйИПустойНаборНеПолучаетОшибочныйTestcase(ИмяНабора, Каталог) Экспорт

	Прогон = Прогнать(ИмяНабора, Каталог);
	Отчёт = ПрочитатьОтчёт(ПутьОтчёта(ИмяНабора));
	Ожидаем.Что(Атрибут(Отчёт, "errors")).Равно("0");
	Ожидаем.Что(Атрибут(Отчёт, "failures")).Равно("0");
	Ожидаем.Что(НайтиЭлементы(Отчёт, "testcase").Количество())
		.Равно(Прогон.Статистика.СтатистикаТестПлана().ПолучитьИлиУмолчание("ТестовОбнаружено", 0));

КонецПроцедуры

Функция Прогнать(Знач ИмяНабора, Знач Каталог, Знач Режим = "", Знач ТочкаСбоя = "")

	Ключ = ?(ПустаяСтрока(Режим), ИмяНабора, Режим);
	Детальки = Новый Соответствие;
	Детальки.Вставить("JUnit.Сбой", ?(ПустаяСтрока(ТочкаСбоя), Режим, ТочкаСбоя));
	Детальки.Вставить("OneUnit.ПутьКОтчетуJUnit", ПутьОтчёта(Ключ));
	Возврат ПрогоныТестов.ПрогнатьОднажды(
		"JUnit.Контейнеры." + Ключ,
		ИмяНабора,
		"",
		"./tests/fixtures/" + Каталог + "/" + ИмяНабора + ".os",
		Детальки
	);

КонецФункции

Функция ПутьОтчёта(Знач Ключ)
	Возврат ПрогоныТестов.ВременныйПуть("JUnit.Контейнеры." + Ключ, "xml");
КонецФункции

Процедура ПроверитьСчётчики(Узел, Всего, Ошибок, Падений = 0, Пропущено = 0)

	Ожидаем.Что(Число(Атрибут(Узел, "tests"))).Равно(Всего);
	Ожидаем.Что(Число(Атрибут(Узел, "errors"))).Равно(Ошибок);
	Ожидаем.Что(Число(Атрибут(Узел, "failures"))).Равно(Падений);
	Ожидаем.Что(Число(Атрибут(Узел, "skipped"))).Равно(Пропущено);

КонецПроцедуры

Функция Атрибут(Узел, Знач Имя)
	Возврат Узел.Атрибуты.Получить(Имя).Получить();
КонецФункции

Функция НайтиЭлементы(Узел, Знач Имя)

	Результат = Новый СписокМассив;

	Если Узел.Имя = Имя Тогда
		Результат.Добавить(Узел);
	КонецЕсли;

	Для Каждого Дитя Из Узел.Дети Цикл
		Результат.ДобавитьВсе(НайтиЭлементы(Дитя, Имя));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПрочитатьОтчёт(Знач Путь)

	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(Путь);
	Стек = Новый СписокМассив;
	Корень = Новый Структура("Дети, Текст", Новый СписокМассив, "");
	Стек.Добавить(Корень);

	Пока Чтение.Прочитать() Цикл

		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда

			Узел = ПрочитатьУзелXML(Чтение);
			Стек.Получить(Стек.ВГраница()).Дети.Добавить(Узел);
			Стек.Добавить(Узел);

		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Стек.УдалитьПоИндексу(Стек.ВГраница());
		ИначеЕсли Чтение.ИмеетЗначение Тогда

			Узел = Стек.Получить(Стек.ВГраница());
			Узел.Текст = Узел.Текст + Чтение.Значение;

		КонецЕсли;

	КонецЦикла;

	Чтение.Закрыть();
	Результат = Корень.Дети.Получить(0);
	ПроверитьСогласованностьСчётчиков(Результат);
	Возврат Результат;

КонецФункции

// Возвращаемое значение:
//  Структура - Узел прочитанного XML:
//   * Имя - Строка - Имя элемента
//   * Атрибуты - КартаСоответствие из КлючИЗначение - Атрибуты элемента:
//    ** Ключ - Строка - Имя атрибута
//    ** Значение - Строка - Значение атрибута
//   * Дети - СписокМассив из см. ПрочитатьУзелXML - Дочерние элементы
//   * Текст - Строка - Текст элемента
//
Функция ПрочитатьУзелXML(Чтение)

	Атрибуты = Новый КартаСоответствие;

	Для Индекс = 0 По Чтение.КоличествоАтрибутов() - 1 Цикл
		Атрибуты.Вставить(Чтение.ИмяАтрибута(Индекс), Чтение.ПолучитьАтрибут(Индекс));
	КонецЦикла;

	Возврат Новый Структура("Имя, Атрибуты, Дети, Текст", Чтение.Имя, Атрибуты, Новый СписокМассив, "");

КонецФункции

Процедура ПроверитьСогласованностьСчётчиков(Узел)

	Наборы = НайтиЭлементы(Узел, "testsuite");
	Наборы.Добавить(Узел);

	Для Каждого Набор Из Наборы Цикл

		ПроверитьСчётчики(
			Набор,
			НайтиЭлементы(Набор, "testcase").Количество(),
			НайтиЭлементы(Набор, "error").Количество(),
			НайтиЭлементы(Набор, "failure").Количество(),
			НайтиЭлементы(Набор, "skipped").Количество()
		);

	КонецЦикла;

КонецПроцедуры
