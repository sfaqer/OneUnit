// Тесты служебного модуля ТестированиеСлужебный

#Использовать asserts
#Использовать collectionos
#Использовать lambdas
#Использовать ".."

&Тест
Процедура КраткоеОписаниеСодержитТекстОшибки() Экспорт

	Описание = ТестированиеСлужебный.КраткоеОписаниеОшибки(ПерехватитьИсключение("МояТестоваяОшибка"));

	Ожидаем.Что(СтрНайти(Описание, "МояТестоваяОшибка")).Больше(0);
	Ожидаем.Что(СтрНайти(Описание, "Стек трейс:")).Равно(0);

КонецПроцедуры

&Тест
Процедура КраткоеОписаниеУбираетМаркерУтверждения() Экспорт

	Попытка
		Утверждения.ПроверитьИстину(Ложь, "ТекстПроверкиУтверждения");
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
	КонецПопытки;

	Описание = ТестированиеСлужебный.КраткоеОписаниеОшибки(ИнформацияОбОшибке);

	Ожидаем.Что(СтрНайти(Описание, "ТекстПроверкиУтверждения")).Больше(0);
	Ожидаем.Что(СтрНайти(Описание, "[Failed]")).Равно(0);

КонецПроцедуры

&Тест
Процедура ПодробноеОписаниеСодержитПрефиксИМестоОшибки() Экспорт

	Описание = ТестированиеСлужебный.ПодробноеОписаниеОшибки(
		"МойПрефикс",
		ПерехватитьИсключение("МояПодробнаяОшибка")
	);

	Ожидаем.Что(СтрНайти(Описание, "МойПрефикс:")).Больше(0);
	Ожидаем.Что(СтрНайти(Описание, "МояПодробнаяОшибка")).Больше(0);
	Ожидаем.Что(СтрНайти(Описание, "ТестированиеСлужебныйТесты")).Больше(0);

КонецПроцедуры

&Тест
Процедура ОшибкаСПричинойПоказываетИсходнуюОшибку() Экспорт

	// Пересозданное звено прозрачно: описание, модуль и строку показывает исходная
	// ошибка, а не место пересоздания, причину - звено
	Исходная = ПерехватитьИсключение("ИсходнаяОшибка");
	Причина  = ПерехватитьИсключение("НоваяПричина");

	Звено = ТестированиеСлужебный.ОшибкаСПричиной(Исходная, Причина);

	Ожидаем.Что(ТестированиеСлужебный.КраткоеОписаниеОшибки(Звено))
		.Равно(ТестированиеСлужебный.КраткоеОписаниеОшибки(Исходная));

	Описание = ТестированиеСлужебный.ПодробноеОписаниеОшибки("Причина", Звено);

	МестоИсходной = СтрШаблон("(%1:%2)", Исходная.ИмяМодуля, Исходная.НомерСтроки);
	МестоЗвена    = СтрШаблон("(%1:%2)", Звено.ИмяМодуля, Звено.НомерСтроки);

	Ожидаем.Что(СтрНайти(Описание, МестоИсходной), Описание).Больше(0);
	Ожидаем.Что(СтрНайти(Описание, МестоЗвена), Описание).Равно(0);

	ПричинаВОписании = СтрНайти(Описание, "По причине:");

	Ожидаем.Что(ПричинаВОписании, Описание).Больше(СтрНайти(Описание, "ИсходнаяОшибка"));
	Ожидаем.Что(СтрНайти(Описание, "НоваяПричина"), Описание).Больше(ПричинаВОписании);

КонецПроцедуры

&Тест
Процедура РазворачиваниеСпискаНаборовИзКаталоговИФайлов() Экспорт

	Файлы = ТестированиеСлужебный.РазвернутьСписокТестовыхНаборов(
		Массивы.ИзЭлементов("./tests/fixtures/execution"),
		Массивы.ИзЭлементов("./tests/fixtures/Тест.os"),
		Ложь
	);

	// Сверяется состав, а не длина: длина сошлась бы и у списка из чужих файлов.
	// Ожидание при этом строится по каталогу, а не константой - иначе тест падал бы
	// у каждого, кто добавит фикстуру
	Ожидаемые = Новый Соответствие;

	Для Каждого Фикстура Из НайтиФайлы("./tests/fixtures/execution", "*.os") Цикл
		Ожидаемые.Вставить(Фикстура.ПолноеИмя, Истина);
	КонецЦикла;

	Ожидаемые.Вставить(Новый Файл("./tests/fixtures/Тест.os").ПолноеИмя, Истина);

	Ожидаем.Что(Файлы).ИмеетДлину(Ожидаемые.Количество());

	Для Каждого Файл Из Файлы Цикл
		Ожидаем.Что(Ожидаемые.Получить(Файл.ПолноеИмя), "Развёрнут " + Файл.ПолноеИмя).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура РазворачиваниеСпискаНаборовУчитываетРекурсию() Экспорт

	БезРекурсии = ТестированиеСлужебный.РазвернутьСписокТестовыхНаборов(
		Массивы.ИзЭлементов("./tests/support"),
		Массивы.ИзЭлементов(),
		Ложь
	);

	Ожидаем.Что(БезРекурсии).ИмеетДлину(0);

	СРекурсией = ТестированиеСлужебный.РазвернутьСписокТестовыхНаборов(
		Массивы.ИзЭлементов("./tests/support"),
		Массивы.ИзЭлементов(),
		Истина
	);

	Ожидаем.Что(СРекурсией).ИмеетДлину(3);

КонецПроцедуры

&Тест
Процедура ПерехватВыводаПоддерживаетВложенность() Экспорт

	ВнешнийПоток    = Новый ПотокВПамяти();
	ВнутреннийПоток = Новый ПотокВПамяти();

	// Сам тест выполняется под перехватом исполнителя,
	// так что вложенные перехваты начинаются со второго уровня
	ТестированиеСлужебный.НачатьПерехватВывода(ВнешнийПоток);
	Сообщить("ЗаписьВоВнешнийПоток");

	ТестированиеСлужебный.НачатьПерехватВывода(ВнутреннийПоток);
	Сообщить("ЗаписьВоВнутреннийПоток");
	ТестированиеСлужебный.ЗавершитьПерехватВывода();

	// После завершения вложенного перехвата вывод должен вернуться
	// в объемлющий поток, а не в системную консоль
	Сообщить("ПовторнаяЗаписьВоВнешнийПоток");
	ТестированиеСлужебный.ЗавершитьПерехватВывода();

	Внешний    = ПрочитатьПоток(ВнешнийПоток);
	Внутренний = ПрочитатьПоток(ВнутреннийПоток);

	Ожидаем.Что(СтрНайти(Внешний, "ЗаписьВоВнешнийПоток")).Больше(0);
	Ожидаем.Что(СтрНайти(Внешний, "ПовторнаяЗаписьВоВнешнийПоток")).Больше(0);
	Ожидаем.Что(СтрНайти(Внешний, "ЗаписьВоВнутреннийПоток")).Равно(0);

	Ожидаем.Что(СтрНайти(Внутренний, "ЗаписьВоВнутреннийПоток")).Больше(0);
	Ожидаем.Что(СтрНайти(Внутренний, "ЗаписьВоВнешнийПоток")).Равно(0);

КонецПроцедуры

&Тест
Процедура ВыполнениеСПерехватомВыводаВозвращаетЗначениеИВывод() Экспорт

	Выполнение = ТестированиеСлужебный.ВыполнитьСПерехватомВывода(
		ЭтотОбъект,
		"НапечататьИВернуть",
		Списки.ИзЭлементов("ЗначениеВыполнения")
	);

	Ожидаем.Что(Выполнение.Значение.Получить()).Равно("ЗначениеВыполнения");
	Ожидаем.Что(СтрНайти(Выполнение.Вывод, "ВыводВыполнения")).Больше(0);
	Ожидаем.Что(Выполнение.Ошибка.СодержитЗначение()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ВыполнениеСПерехватомВыводаЗавершаетПерехватПриИсключении() Экспорт

	ВнешнийПоток = Новый ПотокВПамяти();

	// Сам тест выполняется под перехватом исполнителя - объемлющий перехват свой
	ТестированиеСлужебный.НачатьПерехватВывода(ВнешнийПоток);

	Выполнение = ТестированиеСлужебный.ВыполнитьСПерехватомВывода(
		ЭтотОбъект,
		"НапечататьИУпасть",
		Списки.ИзЭлементов()
	);

	// Упавший метод не оставил свой перехват на вершине стека
	Сообщить("ЗаписьПослеВыполнения");
	ТестированиеСлужебный.ЗавершитьПерехватВывода();

	Внешний = ПрочитатьПоток(ВнешнийПоток);
	Ошибка  = ТестированиеСлужебный.КраткоеОписаниеОшибки(Выполнение.Ошибка.Получить());

	Ожидаем.Что(Выполнение.Значение.СодержитЗначение()).ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Ошибка, "ОшибкаВыполнения"), Ошибка).Больше(0);
	Ожидаем.Что(СтрНайти(Выполнение.Вывод, "ВыводПередОшибкой")).Больше(0);
	Ожидаем.Что(СтрНайти(Внешний, "ЗаписьПослеВыполнения")).Больше(0);
	Ожидаем.Что(СтрНайти(Внешний, "ВыводПередОшибкой")).Равно(0);

КонецПроцедуры

&Тест
Процедура ВычислениеСПерехватомВыводаЛовитОшибкуКомпиляцииЛямбды() Экспорт

	// Лямбда компилируется при вычислении: обращение к методу, которого нет, -
	// ошибка вычисления, а не исключение вызывающему
	Выполнение = ТестированиеСлужебный.ВычислитьСПерехватомВывода(
		Лямбда.Выражение("() -> МетодаНет()").Интерфейс(ФункциональныеИнтерфейсы.Вызываемый())
	);

	Ошибка = ТестированиеСлужебный.ПодробноеОписаниеОшибки("Причина", Выполнение.Ошибка.Получить());

	Ожидаем.Что(Выполнение.Значение.СодержитЗначение()).ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Ошибка, "МетодаНет"), Ошибка).Больше(0);

КонецПроцедуры

&Тест
Процедура ВыполнениеМимоПерехватаВыводаПишетВОбъемлющийПоток() Экспорт

	ВнешнийПоток    = Новый ПотокВПамяти();
	ВнутреннийПоток = Новый ПотокВПамяти();

	ТестированиеСлужебный.НачатьПерехватВывода(ВнешнийПоток);
	ТестированиеСлужебный.НачатьПерехватВывода(ВнутреннийПоток);

	ТестированиеСлужебный.ВыполнитьМимоПерехватаВывода(
		ЭтотОбъект,
		"Напечатать",
		Списки.ИзЭлементов("ЗаписьМимоПерехвата")
	);

	// Перехват возвращается на вершину стека и после исключения метода
	Попытка
		ТестированиеСлужебный.ВыполнитьМимоПерехватаВывода(ЭтотОбъект, "НапечататьИУпасть", Списки.ИзЭлементов());
	Исключение
		Сообщить("ЗаписьПослеИсключения");
	КонецПопытки;

	ТестированиеСлужебный.ЗавершитьПерехватВывода();
	ТестированиеСлужебный.ЗавершитьПерехватВывода();

	Внешний    = ПрочитатьПоток(ВнешнийПоток);
	Внутренний = ПрочитатьПоток(ВнутреннийПоток);

	Ожидаем.Что(СтрНайти(Внешний, "ЗаписьМимоПерехвата")).Больше(0);
	Ожидаем.Что(СтрНайти(Внешний, "ВыводПередОшибкой")).Больше(0);
	Ожидаем.Что(СтрНайти(Внешний, "ЗаписьПослеИсключения")).Равно(0);

	Ожидаем.Что(СтрНайти(Внутренний, "ЗаписьПослеИсключения")).Больше(0);
	Ожидаем.Что(СтрНайти(Внутренний, "ЗаписьМимоПерехвата")).Равно(0);

КонецПроцедуры

Функция НапечататьИВернуть(Знач Значение) Экспорт
	Сообщить("ВыводВыполнения");
	Возврат Значение;
КонецФункции

Процедура НапечататьИУпасть() Экспорт
	Сообщить("ВыводПередОшибкой");
	ВызватьИсключение "ОшибкаВыполнения";
КонецПроцедуры

Процедура Напечатать(Знач Текст) Экспорт
	Сообщить(Текст);
КонецПроцедуры

Функция ПрочитатьПоток(Поток)

	Поток.СброситьБуферы();
	Поток.Перейти(0);

	ЧтениеТекста = Новый ЧтениеТекста();
	ЧтениеТекста.Открыть(Поток, Консоль.КодировкаВыходногоПотока);
	Результат = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();

	Возврат Результат;

КонецФункции

Функция ПерехватитьИсключение(Текст)

	Попытка
		ВызватьИсключение Текст;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

КонецФункции
