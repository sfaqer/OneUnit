// Сохранение результатов исполненных узлов и вывода их окружения.

#Использовать asserts
#Использовать collectionos
#Использовать fluent
#Использовать tempfiles
#Использовать "./support"
#Использовать ".."
#Использовать "../src/shared"

&ПослеВсех
Процедура УдалитьВременныеФайлы() Экспорт
	ВременныеФайлы.Удалить();
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ПослеВсех")
&ИсточникЗначение("Закрытие")
&ИсточникЗначение("Успех")
Процедура JSONСохраняетДетейПослеПозднейОшибкиНабора(Режим) Экспорт

	Прогон = ПрогонСПозднейОшибкой(Режим);
	Отчет = ПрочитатьJSONОтчета(ПутьОтчета(Режим, "json"));

	Ожидаем.Что(Отчет.statistics.total).Равно(4);
	Ожидаем.Что(Отчет.tests.Количество()).Равно(4);
	Ожидаем.Что(Отчет.statistics.failed).Равно(2);
	Ожидаем.Что(Отчет.statistics.passed).Равно(2);

	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, "НаборСПозднейОшибкой");
	Контейнер = ПрогоныТестов.НайтиТест(Набор, "Шаблон");
	ПроверитьДлительностьНабора(Отчет, Набор, Прогон.Статистика.СтатистикаНабора(Набор));
	ПроверитьДлительностьНабора(Отчет, Контейнер, Прогон.Статистика.СтатистикаТеста(Контейнер));

	Падающий = ЗаписьТеста(Отчет, "Падающий");
	Ожидаем.Что(Падающий.status).Равно("failed");
	Ожидаем.Что(Падающий.output).Содержит("Вывод падающего ребенка");
	Ожидаем.Что(Падающий.message).Содержит("Ошибка дочернего теста");
	Ожидаем.Что(ЗаписьТеста(Отчет, "Успешный").status).Равно("passed");

	Если Режим <> "Успех" Тогда

		ПроблемаНабора = ПроцессорыКоллекций.ИзКоллекции(Отчет.problems)
			.Фильтровать("Запись -> Не Запись.Свойство(""test"")")
			.ПолучитьПервый();
		Ожидаем.Что(ПроблемаНабора).Не_().ЭтоНеопределено();
		Ожидаем.Что(ПроблемаНабора.details).Содержит("Вложенная причина");

	КонецЕсли;

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ПослеВсех")
&ИсточникЗначение("Закрытие")
&ИсточникЗначение("Успех")
Процедура JUnitСохраняетДетейПослеПозднейОшибкиНабора(Режим) Экспорт

	ПрогонСПозднейОшибкой(Режим);
	Отчет = ПрочитатьJUnit(ПутьОтчета(Режим, "xml"));

	Ожидаем.Что(Отчет.Тесты.Количество()).Равно(?(Режим = "Успех", 4, 5));
	Ожидаем.Что(Отчет.Тесты.Содержит("Падающий")).ЭтоИстина();
	Ожидаем.Что(Отчет.Тесты.Содержит("Успешный")).ЭтоИстина();
	Ожидаем.Что(Отчет.ОшибкиУтверждений).Равно(2);
	Ожидаем.Что(Отчет.Текст).Содержит("Вывод падающего ребенка");
	Ожидаем.Что(Отчет.Текст).Содержит("Вывод успешного ребенка");

	Если Режим <> "Успех" Тогда

		Ожидаем.Что(Отчет.Тесты.Содержит("НаборСПозднейОшибкой.containerError")).ЭтоИстина();
		Ожидаем.Что(Отчет.ОшибкиВыполнения).Равно(1);
		Ожидаем.Что(Отчет.Текст).Содержит("Вложенная причина");

	КонецЕсли;

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ПадающийПоделочный")
&ИсточникЗначение("ПадающийПроцессный")
&ИсточникЗначение("ПадающийСЗакрытиемПоделочный")
&ИсточникЗначение("ПадающийСЗакрытиемПроцессный")
Процедура ИзолированныйТестСохраняетПричинуПриОшибкеОкружения(ИмяМетода) Экспорт

	Прогон = ПрогонИзолированногоМетода(ИмяМетода);
	Тест = ИзолированныйТест(Прогон, ИмяМетода);
	Результат = Прогон.Статистика.Результат(Тест);
	Описания = ПодробныеПричины(Результат);

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Ожидаем.Что(Описания).Содержит("Ошибка изолированного теста");
	Ожидаем.Что(Описания).Содержит("Вложенная причина окружения");
	Ожидаем.Что(Результат.Вывод()).Содержит("Вывод падающего изолированного теста");
	Ожидаем.Что(Результат.Вывод()).Содержит("Вывод ПередВсеми окружения");
	Ожидаем.Что(ЧислоВхождений(Результат.Вывод(), "Вывод падающего изолированного теста")).Равно(1);
	Ожидаем.Что(Результат.Вывод()).Не_().Содержит("Тестов ошибочных");
	Ожидаем.Что(Результат.ПеренесенноеВремяВыполнения().СодержитЗначение()).ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("УспешныйПоделочный")
&ИсточникЗначение("УспешныйПроцессный")
Процедура ИзолированныйТестСохраняетВыводУспешногоОкружения(ИмяМетода) Экспорт

	Прогон = ПрогонИзолированногоМетода(ИмяМетода);
	Результат = Прогон.Статистика.Результат(ИзолированныйТест(Прогон, ИмяМетода));
	Вывод = Результат.Вывод();

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Успех);
	Ожидаем.Что(Вывод).Содержит("Вывод конструктора окружения");
	Ожидаем.Что(Вывод).Содержит("Вывод ПередВсеми окружения");
	Ожидаем.Что(Вывод).Содержит("Вывод ПослеВсех окружения");
	Ожидаем.Что(Вывод).Содержит("Вывод закрытия ПередВсеми.Контекст");
	Ожидаем.Что(ЧислоВхождений(Вывод, "Вывод успешного изолированного теста")).Равно(1);
	Ожидаем.Что(ЧислоВхождений(Вывод, "Вывод ПередВсеми окружения")).Равно(1);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ШаблонПоделочный")
&ИсточникЗначение("ШаблонПроцессный")
Процедура ОшибкаОкруженияКонтейнераНеСкрываетИтерации(ИмяМетода) Экспорт

	Прогон = ПрогонИзолированногоМетода(ИмяМетода);
	Контейнер = ИзолированныйТест(Прогон, ИмяМетода);
	Результат = Прогон.Статистика.Результат(Контейнер);
	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Ожидаем.Что(ПодробныеПричины(Результат)).Содержит("Ошибка ПослеВсех окружения");

	ПроверитьИтерации(Прогон, Контейнер);
	JSONОтчет = ПрочитатьJSONОтчета(ПутьОтчета("Изоляция." + ИмяМетода, "json"));
	JUnitОтчет = ПрочитатьJUnit(ПутьОтчета("Изоляция." + ИмяМетода, "xml"));
	Ожидаем.Что(JSONОтчет.tests.Количество()).Равно(2);
	Ожидаем.Что(JUnitОтчет.Тесты.Количество()).Равно(3);
	Ожидаем.Что(JUnitОтчет.Тесты.Содержит(ИмяМетода + ".containerError")).ЭтоИстина();
	Ожидаем.Что(JUnitОтчет.ОшибкиВыполнения).Равно(1);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("УспешныйШаблонПоделочный")
&ИсточникЗначение("УспешныйШаблонПроцессный")
Процедура ИзолированныйКонтейнерСохраняетСвойВывод(ИмяМетода) Экспорт

	Прогон = ПрогонИзолированногоМетода(ИмяМетода);
	Контейнер = ИзолированныйТест(Прогон, ИмяМетода);
	Результат = Прогон.Статистика.Результат(Контейнер);

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Успех);
	Ожидаем.Что(Результат.Вывод()).Содержит("Вывод условия контейнера в среде");
	Ожидаем.Что(Результат.Вывод()).Содержит("Вывод ПередВсеми окружения");
	ПроверитьИтерации(Прогон, Контейнер);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ИзолированноеОбнаружениеСВыводом")
&ИсточникЗначение("ПроцессноеОбнаружениеСВыводом")
Процедура ПланСохраняетВыводИзолированногоОбнаружения(ИмяНабора) Экспорт

	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.КаталогиТестов", "");
	Детальки.Вставить("OneUnit.ФайлыТестов", "./tests/fixtures/results/" + ИмяНабора + ".os");
	Детальки.Вставить("OneUnit.ТестовыеНаборыВключаемые", ИмяНабора);
	Поделка = ПрогоныТестов.СоздатьПоделку(Детальки);
	План = Поделка.НайтиЖелудь("МенеджерТестирования").Обнаружить();
	Репортер = Поделка.НайтиЖелудь("РепортерПланJSON");

	Состав = Репортер.СоставПлана(План);
	ПроверитьВыводОбнаружения(Состав.Получить(0));

	Путь = ВременныеФайлы.НовоеИмяФайла("json");
	Репортер.ЗаписатьПлан(План, Путь);
	Копия = Репортер.ПрочитатьСостав(Путь).Получить();
	ПроверитьВыводОбнаружения(Копия.Получить(0));

КонецПроцедуры

&Тест
Процедура ВыводОбнаруженияРазделяетНепустыеФрагменты() Экспорт

	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.КаталогиТестов", "");
	Детальки.Вставить("OneUnit.ФайлыТестов", "./tests/fixtures/results/НаборСПозднейОшибкой.os");
	Детальки.Вставить("OneUnit.ТестовыеНаборыВключаемые", "НаборСПозднейОшибкой");
	Поделка = ПрогоныТестов.СоздатьПоделку(Детальки);
	План = Поделка.НайтиЖелудь("МенеджерТестирования").Обнаружить();
	Набор = ПрогоныТестов.НайтиНабор(План, "НаборСПозднейОшибкой");

	Набор.ДобавитьВыводОбнаружения("");
	Набор.ДобавитьВыводОбнаружения("  Первая" + Символы.Таб);
	Набор.ДобавитьВыводОбнаружения("Вторая");
	Набор.ДобавитьВыводОбнаружения("");
	Набор.ДобавитьВыводОбнаружения(Символы.ПС + Символы.Таб + " ");
	Набор.ДобавитьВыводОбнаружения(Символы.ПС + Символы.Таб + " ");
	Ожидаем.Что(Набор.ВыводОбнаружения()).Равно("Первая" + Символы.ПС + "Вторая");

	Набор.ДобавитьВыводОбнаружения(Символы.ПС + "Третья" + Символы.ПС);
	Набор.ДобавитьВыводОбнаружения("Четвертая");
	Набор.ДобавитьВыводОбнаружения(Символы.ВК + Символы.ПС + "Пятая");
	Ожидаем.Что(Набор.ВыводОбнаружения()).Равно(
		"Первая" + Символы.ПС + "Вторая" + Символы.ПС + "Третья" + Символы.ПС
			+ "Четвертая" + Символы.ПС + "Пятая"
	);

	Набор.ДобавитьВыводОбнаружения("  Шестая" + Символы.ПС + "  Продолжение" + Символы.ПС + Символы.ПС + "Седьмая  ");
	Ожидаем.Что(Набор.ВыводОбнаружения()).Равно(
		"Первая" + Символы.ПС + "Вторая" + Символы.ПС + "Третья" + Символы.ПС
			+ "Четвертая" + Символы.ПС + "Пятая" + Символы.ПС + "Шестая" + Символы.ПС
			+ "  Продолжение" + Символы.ПС + Символы.ПС + "Седьмая"
	);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ПропущенныйШаблонПоделочный")
&ИсточникЗначение("ПропущенныйШаблонПроцессный")
Процедура ПропущенныйВСредеКонтейнерНеПубликуетИтерации(ИмяМетода) Экспорт

	Прогон = ПрогонИзолированногоМетода(ИмяМетода);
	Контейнер = ИзолированныйТест(Прогон, ИмяМетода);
	Ожидаем.Что(Прогон.Статистика.Результат(Контейнер).Состояние()).Равно(СостоянияВыполненияТестов.Пропущен);
	Контейнер.Дети().ДляКаждого(
		"Дитя -> Ожидаем.Что(Статистика.НайтиРезультат(Дитя).Пустой()).ЭтоИстина()",
		Новый Структура("Статистика", Прогон.Статистика)
	);
	Ожидаем.Что(Прогон.Статистика.СтатистикаТестПлана().ПолучитьИлиУмолчание("ТестовОбнаружено", 0)).Равно(0);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ИзолированныйНаборСПозднейОшибкой")
&ИсточникЗначение("ПроцессныйНаборСПозднейОшибкой")
Процедура ОтчетыСохраняютДетейИзолированногоСломанногоНабора(ИмяНабора) Экспорт

	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.ПутьКОтчетуJSON", ПутьОтчета(ИмяНабора, "json"));
	Детальки.Вставить("OneUnit.ПутьКОтчетуJUnit", ПутьОтчета(ИмяНабора, "xml"));
	ПрогоныТестов.Прогнать(ИмяНабора, "", "./tests/fixtures/results/" + ИмяНабора + ".os", Детальки);
	Отчет = ПрочитатьJSONОтчета(ПутьОтчета(ИмяНабора, "json"));
	JUnitОтчет = ПрочитатьJUnit(ПутьОтчета(ИмяНабора, "xml"));
	Ожидаем.Что(Отчет.statistics.total).Равно(4);
	Ожидаем.Что(Отчет.tests.Количество()).Равно(4);
	Ожидаем.Что(JUnitОтчет.Тесты.Количество()).Равно(5);
	Ожидаем.Что(JUnitОтчет.Тесты.Содержит(ИмяНабора + ".containerError")).ЭтоИстина();
	Ожидаем.Что(JUnitОтчет.ОшибкиВыполнения).Равно(1);
	Ожидаем.Что(JUnitОтчет.ОшибкиУтверждений).Равно(2);
	Ожидаем.Что(ЗаписьТеста(Отчет, "Падающий").message).Содержит("Ошибка дочернего теста");
	Ожидаем.Что(JUnitОтчет.Текст).Содержит("Ошибка ПослеВсех изолированного набора");
	Ожидаем.Что(JUnitОтчет.Текст).Содержит("Ошибка закрытия изолированного набора");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(Истина)
&ИсточникЗначение(Ложь)
Процедура ОбъединениеОкруженияСохраняетИсходныеРезультатыИВремя(ЕстьВремя) Экспорт

	Поделка = ПоделкаБезТестов();
	Результат = Поделка.НайтиЖелудь("РезультатВыполненияТеста", Массивы.ИзЭлементов(
		СостоянияВыполненияТестов.Ошибка,
		Списки.ИзЭлементов("Причина теста"),
		"Тест|"
	));
	Окружение = Поделка.НайтиЖелудь("РезультатВыполненияТеста", Массивы.ИзЭлементов(
		СостоянияВыполненияТестов.Сломан,
		Списки.ИзЭлементов("Причина окружения"),
		"Окружение|"
	));

	Если ЕстьВремя Тогда
		Результат.ПеренестиВремяВыполнения(7);
	КонецЕсли;

	Окружение.ПеренестиВремяВыполнения(13);
	Итог = Поделка.НайтиЖелудь("ПереносРезультатов").РезультатСОкружением(Результат, Окружение);
	Ожидаем.Что(Итог.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Ожидаем.Что(Итог.Вывод()).Равно("Окружение|" + Символы.ПС + "Тест|");
	Ожидаем.Что(Итог.Причины().Количество()).Равно(2);
	Ожидаем.Что(Итог.Причины().Получить(0)).Равно("Причина теста");
	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Ошибка);
	Ожидаем.Что(Результат.Вывод()).Равно("Тест|");
	Ожидаем.Что(Результат.Причины().Количество()).Равно(1);
	Ожидаем.Что(Окружение.Вывод()).Равно("Окружение|");
	Ожидаем.Что(Итог.ПеренесенноеВремяВыполнения().СодержитЗначение()).Равно(ЕстьВремя);

	Если ЕстьВремя Тогда
		Ожидаем.Что(Итог.ПеренесенноеВремяВыполнения().Получить()).Равно(7);
	КонецЕсли;

КонецПроцедуры

&Тест
Процедура ПереносОтчетаСохраняетРезультатыНабораИТеста() Экспорт

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку("{""suites"":[{""suite"":""Набор"",""status"":""broken"",""message"":""Сбой набора"","
		+ """output"":""Вывод набора"",""duration_ms"":13}],""problems"":[],"
		+ """skipped_tests"":[],""tests"":[{""suite"":""Набор"",""test"":""Тест"","
		+ """status"":""failed"",""message"":""Сбой теста"",""output"":""Вывод теста"",""duration_ms"":9}]}");
	Отчет = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Результаты = ПоделкаБезТестов().НайтиЖелудь("ПереносРезультатов").РезультатыОтчета(Отчет);
	Ожидаем.Что(Результаты.Наборы.Получить("Набор").Получить().Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Ожидаем.Что(Результаты.Наборы.Получить("Набор").Получить().Вывод()).Равно("Вывод набора");
	Ожидаем.Что(Результаты.Наборы.Получить("Набор").Получить().ПеренесенноеВремяВыполнения().Получить()).Равно(13);
	Ожидаем.Что(Результаты.Тесты.Количество()).Равно(1);
	Тест = Результаты.Тесты.Получить(0).Результат;
	Ожидаем.Что(Тест.Состояние()).Равно(СостоянияВыполненияТестов.Ошибка);
	Ожидаем.Что(Тест.Вывод()).Равно("Вывод теста");
	Ожидаем.Что(Тест.ПеренесенноеВремяВыполнения().Получить()).Равно(9);

КонецПроцедуры

&Тест
Процедура ПланСохраняетПустыеВыводИОшибкиВсехУзлов() Экспорт

	Репортер = ПоделкаБезТестов().НайтиЖелудь("РепортерПланJSON");
	Путь = ВременныеФайлы.НовоеИмяФайла("json");
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8NoBOM);
	Запись.Записать("{""suites"":[{""suite"":""Набор"",""output"":"""",""errors"":[],""tests"":[{""test"":""Шаблон"","
		+ """method"":""Шаблон"",""output"":"""",""errors"":[],""children"":[{""test"":""[1]"","
		+ """method"":""Шаблон"",""output"":"""",""errors"":[]}]}]}]}");
	Запись.Закрыть();
	Состав = Репортер.ПрочитатьСостав(Путь).Получить();
	Ожидаем.Что(Состав.Получить(0).Вывод).Равно("");
	Ожидаем.Что(Состав.Получить(0).Тесты.Получить(0).Вывод).Равно("");
	Ожидаем.Что(Состав.Получить(0).Тесты.Получить(0).Дети.Количество()).Равно(1);
	Ожидаем.Что(Состав.Получить(0).Тесты.Получить(0).Дети.Получить(0).Вывод).Равно("");
	Записи = Репортер.ЗаписиСостава(Состав);
	Ожидаем.Что(Записи.Получить(0).output).Равно("");
	Ожидаем.Что(Записи.Получить(0).tests.Получить(0).output).Равно("");
	Ожидаем.Что(Записи.Получить(0).tests.Получить(0).children.Получить(0).output).Равно("");
	Ожидаем.Что(Записи.Получить(0).errors.Количество()).Равно(0);
	Ожидаем.Что(Записи.Получить(0).tests.Получить(0).errors.Количество()).Равно(0);
	Ожидаем.Что(Записи.Получить(0).tests.Получить(0).children.Получить(0).errors.Количество()).Равно(0);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("{}")
&ИсточникЗначение("null")
&ИсточникЗначение("[]")
&ИсточникЗначение("""Повреждено""")
&ИсточникЗначение("{""current"":1}")
&ИсточникЗначение("{""total"":2}")
Процедура ПланСНекорректнымПовторениемОстаётсяНеразобранным(ПовторениеJSON) Экспорт

	Репортер = ПоделкаБезТестов().НайтиЖелудь("РепортерПланJSON");
	Путь = ВременныеФайлы.НовоеИмяФайла("json");
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8NoBOM);
	Запись.Записать(ПланПовторенияJSON(ПовторениеJSON));
	Запись.Закрыть();

	Ожидаем.Что(Репортер.ПрочитатьСостав(Путь).Пустой()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НекорректныйПланСохраняетВыводДочернегоОбнаружения() Экспорт

	ИмяНабора = "ПроцессноеОбнаружениеСВыводом";
	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.КаталогиТестов", "");
	Детальки.Вставить("OneUnit.ФайлыТестов", "./tests/fixtures/results/" + ИмяНабора + ".os");
	Детальки.Вставить("OneUnit.ТестовыеНаборыВключаемые", ИмяНабора);
	Поделка = ПрогоныТестов.СоздатьПоделку(Детальки);
	Запускатель = ЗагрузитьСценарийИзСтроки(
		"Перем ТекстПлана Экспорт;
		|Перем ПараметрыПрогона Экспорт;
		|
		|Функция ПараметрыЗапуска() Экспорт
		|	Возврат ПараметрыПрогона;
		|КонецФункции
		|
		|Функция ВыполнитьОбнаружениеПлана(Детальки, Путь, Лог, Параметры) Экспорт
		|
		|	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8NoBOM);
		|	Запись.Записать(ТекстПлана);
		|	Запись.Закрыть();
		|	Возврат Новый Структура(""Вывод"", ""Вывод повреждённого дочернего обнаружения"");
		|
		|КонецФункции"
	);
	Запускатель.ПараметрыПрогона = Поделка.НайтиЖелудь("ЗапускательТестирования").ПараметрыЗапуска();
	Запускатель.ТекстПлана = ПланПовторенияJSON("{}", ИмяНабора);
	Поделка.НайтиЖелудь("ПроцессныйИсполнительТестов", Массивы.ИзЭлементов(
		Неопределено,
		Неопределено,
		Неопределено,
		Запускатель,
		Поделка.НайтиЖелудь("ПереносРезультатов"),
		Поделка.НайтиЖелудь("РепортерПланJSON"),
		Поделка.НайтиЖелудь("КаналСобытийИзоляции"),
		Неопределено,
		"",
		Ложь,
		Неопределено
	));
	План = Поделка.НайтиЖелудь("МенеджерТестирования").Обнаружить();
	Набор = ПрогоныТестов.НайтиНабор(План, ИмяНабора);

	Ожидаем.Что(План.ЕстьОшибкиОбнаружения()).ЭтоИстина();
	Ожидаем.Что(Набор.Дети().Количество()).Равно(0);
	Ожидаем.Что(Набор.ОшибкиОбнаружения().Количество()).Равно(1);
	Ошибка = Набор.ОшибкиОбнаружения().Получить(0);
	Ожидаем.Что(Ошибка.Описание).Содержит("Дочернее обнаружение завершилось аварийно, не сформировав план");
	ОписаниеОшибки = ТестированиеСлужебный.ПодробноеОписаниеОшибки("Причина", Ошибка);
	Ожидаем.Что(ОписаниеОшибки).Содержит("Вывод дочернего прогона:");
	Ожидаем.Что(ОписаниеОшибки).Содержит("Вывод повреждённого дочернего обнаружения");

КонецПроцедуры

Функция ПланПовторенияJSON(Знач ПовторениеJSON, Знач ИмяНабора = "Набор")

	Возврат СтрШаблон(
		"{""suites"":[{
		|	""suite"":""%2"", ""output"":"""", ""errors"":[],
		|	""tests"":[{
		|		""test"":""Повторение"", ""method"":""Повтор"", ""output"":"""", ""errors"":[],
		|		""repetition"":%1
		|	}]
		|}]}",
		ПовторениеJSON,
		ИмяНабора
	);

КонецФункции

Функция ПоделкаБезТестов()

	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.КаталогиТестов", "");
	Детальки.Вставить("OneUnit.ФайлыТестов", "");
	Возврат ПрогоныТестов.СоздатьПоделку(Детальки);

КонецФункции

Процедура ПроверитьВыводОбнаружения(Набор)

	Ожидаем.Что(Набор.Свойство("Вывод")).ЭтоИстина();
	Ожидаем.Что(Набор.Вывод).Содержит("Вывод совета обнаружения");
	Контейнер = Набор.Тесты.Получить(0);
	Ожидаем.Что(Контейнер.Свойство("Вывод")).ЭтоИстина();
	Ожидаем.Что(Контейнер.Вывод).Содержит("Вывод конструктора обнаружения");
	Ожидаем.Что(Контейнер.Вывод).Содержит("Вывод источника обнаружения");
	Ожидаем.Что(Контейнер.Дети.Количество()).Равно(2);

КонецПроцедуры

Процедура ПроверитьИтерации(Прогон, Контейнер)

	Ожидаем.Что(Контейнер.Дети().Количество()).Равно(2);
	Первый = Прогон.Статистика.НайтиРезультат(Контейнер.Дети().Получить(0));
	Второй = Прогон.Статистика.НайтиРезультат(Контейнер.Дети().Получить(1));
	Ожидаем.Что(Первый.СодержитЗначение(), "Результат первой итерации опубликован").ЭтоИстина();
	Ожидаем.Что(Второй.СодержитЗначение(), "Результат второй итерации опубликован").ЭтоИстина();
	Ожидаем.Что(Первый.Получить().Состояние()).Равно(СостоянияВыполненияТестов.Ошибка);
	Ожидаем.Что(Второй.Получить().Состояние()).Равно(СостоянияВыполненияТестов.Успех);
	Ожидаем.Что(Первый.Получить().Вывод()).Содержит("Вывод изолированной итерации 1");
	Ожидаем.Что(Второй.Получить().Вывод()).Содержит("Вывод изолированной итерации 2");

КонецПроцедуры

Функция ПрогонИзолированногоМетода(Знач ИмяМетода)

	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.ТестовыеМетодыВключаемые", ИмяМетода);
	Детальки.Вставить("OneUnit.ПутьКОтчетуJSON", ПутьОтчета("Изоляция." + ИмяМетода, "json"));
	Детальки.Вставить("OneUnit.ПутьКОтчетуJUnit", ПутьОтчета("Изоляция." + ИмяМетода, "xml"));
	Возврат ПрогоныТестов.ПрогнатьОднажды(
		"СохранениеИзолированныхРезультатов." + ИмяМетода,
		"НаборСИзолированнымиРезультатами",
		"",
		"./tests/fixtures/results/НаборСИзолированнымиРезультатами.os",
		Детальки
	);

КонецФункции

Функция ИзолированныйТест(Прогон, Знач ИмяМетода)

	Возврат ПрогоныТестов.НайтиТест(
		ПрогоныТестов.НайтиНабор(Прогон.План, "НаборСИзолированнымиРезультатами"),
		ИмяМетода
	);

КонецФункции

Функция ПодробныеПричины(Результат)

	Возврат Результат.Причины().ПроцессорКоллекции()
		.Обработать("Причина -> ТестированиеСлужебный.ПодробноеОписаниеОшибки(""Причина"", Причина)")
		.ВСтроку();

КонецФункции

Функция ЧислоВхождений(Знач Текст, Знач Фрагмент)
	Возврат (СтрДлина(Текст) - СтрДлина(СтрЗаменить(Текст, Фрагмент, ""))) / СтрДлина(Фрагмент);
КонецФункции

Процедура ПроверитьДлительностьНабора(Отчет, Узел, Статистика)

	Запись = ПроцессорыКоллекций.ИзКоллекции(Отчет.suites)
		.Фильтровать("Запись -> Запись.suite = ИмяУзла", Новый Структура("ИмяУзла", Узел.ПолноеИмя()))
		.ПолучитьПервый();
	Длительность = Статистика.ПолучитьИлиУмолчание("ВремяВыполнения", 0);

	Ожидаем.Что(Длительность).Больше(0);
	Ожидаем.Что(Запись.duration_ms).Равно(Длительность);

КонецПроцедуры

Функция ПрогонСПозднейОшибкой(Знач Режим)

	Детальки = Новый Соответствие;
	Детальки.Вставить("СохранениеРезультатов.Режим", Режим);
	Детальки.Вставить("OneUnit.ПутьКОтчетуJSON", ПутьОтчета(Режим, "json"));
	Детальки.Вставить("OneUnit.ПутьКОтчетуJUnit", ПутьОтчета(Режим, "xml"));

	Возврат ПрогоныТестов.ПрогнатьОднажды(
		"СохранениеРезультатов." + Режим,
		"НаборСПозднейОшибкой",
		"",
		"./tests/fixtures/results/НаборСПозднейОшибкой.os",
		Детальки
	);

КонецФункции

Функция ПутьОтчета(Знач Режим, Знач Расширение)
	Возврат ПрогоныТестов.ВременныйПуть("СохранениеРезультатов." + Режим + "." + Расширение, Расширение);
КонецФункции

Функция ПрочитатьJSONОтчета(Знач Путь)

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Отчет = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Отчет;

КонецФункции

Функция ПрочитатьТекстОтчета(Знач Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Текст;

КонецФункции

Функция ПрочитатьJUnit(Знач Путь)

	Текст = ПрочитатьТекстОтчета(Путь);
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(Текст);
	Тесты = Новый СписокМассив;
	ОшибкиУтверждений = 0;
	ОшибкиВыполнения = 0;

	Пока Чтение.Прочитать() Цикл

		Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;

		Если Чтение.Имя = "testcase" Тогда
			Тесты.Добавить(Чтение.ПолучитьАтрибут("name"));
		ИначеЕсли Чтение.Имя = "failure" Тогда
			ОшибкиУтверждений = ОшибкиУтверждений + 1;
		ИначеЕсли Чтение.Имя = "error" Тогда
			ОшибкиВыполнения = ОшибкиВыполнения + 1;
		КонецЕсли;

	КонецЦикла;

	Чтение.Закрыть();
	Возврат Новый Структура(
		"Тесты, ОшибкиУтверждений, ОшибкиВыполнения, Текст",
		Тесты,
		ОшибкиУтверждений,
		ОшибкиВыполнения,
		Текст
	);

КонецФункции

Функция ЗаписьТеста(Отчет, Знач Имя)

	Возврат ПроцессорыКоллекций.ИзКоллекции(Отчет.tests)
		.Фильтровать("Запись -> Запись.test = Имя", Новый Структура("Имя", Имя))
		.ПолучитьПервый();

КонецФункции
