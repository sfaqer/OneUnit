КонецПроцедуры

Процедура ПроверитьТестНабор(ТестНабор, Имя, Теги, Таймаут, Условия, ЖизненныйЦикл,
	ЭтоОдиночка = Ложь, ПроверятьТестНабор = Истина, ИмяФайла = "")

	Если ПустаяСтрока(ИмяФайла) Тогда
		ИмяФайла = Имя;
	КонецЕсли;

	Путь = ОбъединитьПути(".", "tests", "fixtures", ИмяФайла + ".os");

	Ожидаем.Что(ТестНабор).ИмеетТип("ОпределениеТестНабора");

	Ожидаем.Что(ТестНабор.Имя()).Равно(Имя);
	Ожидаем.Что(ТестНабор.ПолноеИмя()).Равно(Имя);
	Ожидаем.Что(ТестНабор.Путь().Получить()).Равно(Путь);
	Ожидаем.Что(Строка(ТестНабор)).Равно(Имя + " (" + Путь + ")");

	Экземпляр = ФабрикаЭкземпляров.СоздатьДляИсполнения(ТестНабор, ТестНабор).Экземпляр();

	Если Не ПроверятьТестНабор Тогда
		Ожидаем.Что(Экземпляр.СодержитЗначение()).ЭтоЛожь();
	ИначеЕсли ЭтоОдиночка Тогда

		Ожидаем.Что(Экземпляр.Получить()).ИмеетТип("oneunit_testsuite_" + Имя);
		ПовторноеСоздание = ФабрикаЭкземпляров.СоздатьДляИсполнения(ТестНабор, ТестНабор);
		Ожидаем.Что(Экземпляр.Получить()).Равно(ПовторноеСоздание.Экземпляр().Получить());

	Иначе

		Ожидаем.Что(Экземпляр.Получить()).ИмеетТип("oneunit_testsuite_" + Имя);
		ПовторноеСоздание = ФабрикаЭкземпляров.СоздатьДляИсполнения(ТестНабор, ТестНабор);
		Ожидаем.Что(Экземпляр.Получить()).Не_().Равно(ПовторноеСоздание.Экземпляр().Получить());

	КонецЕсли;

	Ожидаем.Что(ТестНабор.Таймаут()).Равно(Таймаут);

	Ожидаем.Что(ТестНабор.Теги())
		.ИмеетТип("ФиксированныйСписок")
		.ИмеетДлину(Теги.Количество());

	Ожидаем.Что(ТестНабор.Теги().СодержитВсе(Теги)).Равно(Истина);

	Ожидаем.Что(ТестНабор.Условия())
		.ИмеетТип("ФиксированныйСписок")
		.ИмеетДлину(Условия);

	Для каждого МетодЖизненногоЦикла Из ЖизненныйЦикл.КлючиИЗначения() Цикл

		Результат = Рефлектор.ВызватьМетод(ТестНабор, МетодЖизненногоЦикла.Ключ);

		Ожидаем.Что(Результат)
			.ИмеетТип("ФиксированныйСписок")
			.ИмеетДлину(МетодЖизненногоЦикла.Значение.Количество());

		Ожидаем.Что(Результат.СодержитВсе(МетодЖизненногоЦикла.Значение)).Равно(Истина);

	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьТест(Тест, Тип, ИмяМетода, Имя, ПолноеИмя, Путь, Таймаут, Параметры, Теги, Условия)

	Ожидаем.Что(Тест).ИмеетТип("ОпределениеТеста");
	Ожидаем.Что(Тест.ТипОпределения()).Равно(Тип);
	Ожидаем.Что(Тест.ИмяМетода()).Равно(ИмяМетода);
	Ожидаем.Что(Тест.Имя()).Равно(Имя);
	Ожидаем.Что(Тест.ПолноеИмя()).Равно(ПолноеИмя);
	Ожидаем.Что(Тест.Путь().Получить()).Равно(Путь);
	Ожидаем.Что(Тест.Таймаут()).Равно(Таймаут);

	Ожидаем.Что(Тест.Параметры())
		.ИмеетТип("ФиксированныйСписок")
		.ИмеетДлину(Параметры.Количество());

	Ожидаем.Что(Тест.Параметры().СодержитВсе(Параметры)).Равно(Истина);

	Ожидаем.Что(Тест.Теги())
		.ИмеетТип("ФиксированныйСписок")
		.ИмеетДлину(Теги.Количество());

	Ожидаем.Что(Тест.Теги().СодержитВсе(Теги)).Равно(Истина);

	Ожидаем.Что(Тест.Условия())
		.ИмеетТип("ФиксированныйСписок")
		.ИмеетДлину(Условия);

КонецПроцедуры

#Область ФабричныеНаборы

&Тест
Процедура ФабричныеНаборыОбнаруживаютсяСВернымиИменамиИПутями() Экспорт

	Поделка = ПоделкаСФабричнымиНаборами();
	План = Поделка.НайтиЖелудь("МенеджерТестирования").Обнаружить();
	Ожидаем.Что(План.Дети().Количество()).Равно(3);

	Имена = План.Дети().ПроцессорКоллекции()
		.Обработать("Набор -> Набор.Имя()")
		.Получить("СписокМассив");

	Для Индекс = 1 По 3 Цикл
		Ожидаем.Что(Имена.Содержит("ФабричныйНабор" + Формат(Индекс, "ЧГ=0"))).ЭтоИстина();
	КонецЦикла;

	ОжидаемыйПуть = Новый Файл("./tests/fixtures/registrations/НаборДляЗавязей.os");

	Для Каждого Набор Из План.Дети() Цикл

		Ожидаем.Что(Набор.ТипСценария()).Равно(Тип("oneunit_testsuite_НаборДляЗавязей"));
		Ожидаем.Что(Новый Файл(Набор.Путь().Получить()).ПолноеИмя).Равно(ОжидаемыйПуть.ПолноеИмя);
		Ожидаем.Что(Набор.Дети().Количество()).Равно(1);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ФабричныеНаборыВыполняютКаждуюЗавязь() Экспорт

	Поделка = ПоделкаСФабричнымиНаборами();
	Поделка.НайтиЖелудь("МенеджерТестирования").Тестировать();
	Статистика = Поделка.НайтиЖелудь("РепортерСтатистика").СтатистикаТестПлана();

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовОбнаружено", 0)).Равно(3);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0)).Равно(3);

КонецПроцедуры

&Тест
&Изолированный(Уровень = "Процесс")
Процедура ОбнаруживаютсяВсеЗарегистрированныеВПоделкеНаборы() Экспорт

	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.КаталогиТестов", "");
	Детальки.Вставить("OneUnit.ФайлыТестов", "./tests/fixtures/registrations/ЧужойНаборДляЗавязей.os");
	Детальки.Вставить("OneUnit.РежимВыводаЛога", РежимыВыводаЛога.Ничего);
	ПрогоныТестов.СоздатьПоделку(Детальки);

	Детальки.Вставить("OneUnit.ФайлыТестов", "");
	Поделка = ПрогоныТестов.СоздатьПоделку(Детальки);
	Определения = Поделка.ПолучитьОпределенияЖелудей("ТестовыйНабор");
	Ожидаем.Что(Определения.Количество()).Равно(1);

	План = Поделка.НайтиЖелудь("МенеджерТестирования").Обнаружить();
	Ожидаем.Что(План.Дети().Количество()).Равно(Определения.Количество());
	Набор = План.Дети().Получить(0);
	Ожидаем.Что(Набор.ТипСценария()).Равно(Тип("oneunit_testsuite_ЧужойНаборДляЗавязей"));
	Ожидаем.Что(Набор.Путь().Пустой()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ФабричныеНаборыПодчиняютсяФильтруПрогона() Экспорт

	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.КаталогиТестов", "");
	Детальки.Вставить("OneUnit.ФайлыТестов", "./tests/fixtures/registrations/ЧужойНаборДляЗавязей.os");
	Детальки.Вставить("OneUnit.РежимВыводаЛога", РежимыВыводаЛога.Ничего);
	ПрогоныТестов.СоздатьПоделку(Детальки);

	Поделка = ПоделкаСФабричнымиНаборами();

	Ожидаем.Что(Поделка.ПолучитьОпределениеЖелудя("oneunit_testsuite_ЧужойНаборДляЗавязей"))
		.Не_().ЭтоНеопределено();

	План = Поделка.НайтиЖелудь("МенеджерТестирования").Обнаружить();
	Ожидаем.Что(План.Дети().Количество()).Равно(3);

	Для Каждого Набор Из План.Дети() Цикл
		Ожидаем.Что(Набор.ТипСценария()).Равно(Тип("oneunit_testsuite_НаборДляЗавязей"));
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура НаборИзПамятиОбнаруживаетсяИВыполняется() Экспорт

	Поделка = ПоделкаСНаборомИзПамяти();
	Менеджер = Поделка.НайтиЖелудь("МенеджерТестирования");
	План = Менеджер.Обнаружить();
	Ожидаем.Что(План.Дети().Количество()).Равно(1);

	Набор = План.Дети().Получить(0);
	Ожидаем.Что(Набор.Имя()).Равно("НаборИзПамяти");
	Ожидаем.Что(Набор.Путь().Пустой()).ЭтоИстина();
	Ожидаем.Что(Строка(Набор)).Содержит("Не удалось определить путь к тестовому набору");
	Ожидаем.Что(Набор.Дети().Количество()).Равно(1);
	Ожидаем.Что(Набор.Дети().Получить(0).Имя()).Равно("ПроверкаИзПамяти");
	Ожидаем.Что(Набор.Дети().Получить(0).Путь().Пустой()).ЭтоИстина();

	План = Менеджер.Тестировать();
	Статистика = Поделка.НайтиЖелудь("РепортерСтатистика").СтатистикаТестПлана();
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовОбнаружено", 0)).Равно(1);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0)).Равно(1);

	Тест = План.Дети().Получить(0).Дети().Получить(0);
	Результат = Поделка.НайтиЖелудь("РепортерСтатистика").Результат(Тест);
	Ожидаем.Что(Результат.Вывод()).Содержит("Набор из памяти выполнен");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("РепортерJUnit", "file")
&ИсточникЗначение("РепортерGenericExecution", "path")
&ИсточникЗначение("РепортерOpenTestReport", "path")
Процедура ОтчётыНабораИзПамятиЗаписываютПустойПуть(ИмяРепортера, Атрибут) Экспорт

	Поделка = ПоделкаСНаборомИзПамяти();
	МенеджерФайлов = Новый МенеджерВременныхФайлов;
	ПутьОтчёта = МенеджерФайлов.НовоеИмяФайла("xml");

	Попытка

		Поделка.НайтиЖелудь(ИмяРепортера, Массивы.ИзЭлементов(ПутьОтчёта));
		Поделка.НайтиЖелудь("МенеджерТестирования").Тестировать();

		Чтение = Новый ЧтениеТекста(ПутьОтчёта, КодировкаТекста.UTF8);
		Отчёт = Чтение.Прочитать();
		Чтение.Закрыть();

		Ожидаем.Что(Отчёт).Содержит(Атрибут + "=""""");
		Ожидаем.Что(Отчёт).Не_().Содержит("Не удалось определить путь к тестовому набору");

	Исключение

		МенеджерФайлов.Удалить();
		ВызватьИсключение;

	КонецПопытки;

	МенеджерФайлов.Удалить();

КонецПроцедуры

&Тест
Процедура НаборИзПамятиНеПопадаетВЧужуюПоделку() Экспорт

	Поделка = ПоделкаСНаборомИзПамяти();
	СвойПлан = Поделка.НайтиЖелудь("МенеджерТестирования").Обнаружить();
	Ожидаем.Что(СвойПлан.Дети().Количество()).Равно(1);

	ЧужаяПоделка = ПоделкаСФабричнымиНаборами();
	Ожидаем.Что(ЧужаяПоделка.ПолучитьОпределениеЖелудя("НаборИзПамяти")).ЭтоНеопределено();
	План = ЧужаяПоделка.НайтиЖелудь("МенеджерТестирования").Обнаружить();
	Ожидаем.Что(План.Дети().Количество()).Равно(3);

	Для Каждого Набор Из План.Дети() Цикл
		Ожидаем.Что(Набор.ТипСценария()).Равно(Тип("oneunit_testsuite_НаборДляЗавязей"));
	КонецЦикла;

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("")
&ИсточникЗначение("Поделка")
&Изолированный(Уровень = "Процесс")
Процедура ПодключённыйКСистемеТиповНаборОбнаруживаетсяБезФайла(УровеньИзоляции) Экспорт

	ИмяТипа = ЗарегистрироватьНаборИзПамяти(Истина, УровеньИзоляции);
	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.КаталогиТестов", "");
	Детальки.Вставить("OneUnit.ФайлыТестов", "");
	Детальки.Вставить("OneUnit.ТестовыеНаборыВключаемые", СтрЗаменить(ИмяТипа, "oneunit_testsuite_", ""));
	Детальки.Вставить("OneUnit.РежимВыводаЛога", РежимыВыводаЛога.Ничего);
	Поделка = ПрогоныТестов.СоздатьПоделку(Детальки);

	Менеджер = Поделка.НайтиЖелудь("МенеджерТестирования");
	План = Менеджер.Обнаружить();
	Ожидаем.Что(План.Дети().Количество()).Равно(1);
	Набор = План.Дети().Получить(0);
	Ожидаем.Что(Набор.ТипСценария()).Равно(Тип(ИмяТипа));
	Ожидаем.Что(Набор.Путь().Пустой()).ЭтоИстина();
	Ожидаем.Что(Набор.Дети().Количество()).Равно(1);

	План = Менеджер.Тестировать();
	Репортер = Поделка.НайтиЖелудь("РепортерСтатистика");
	Ожидаем.Что(Репортер.СтатистикаТестПлана().ПолучитьИлиУмолчание("ТестовУспешно", 0)).Равно(1);
	Тест = План.Дети().Получить(0).Дети().Получить(0);
	Ожидаем.Что(Репортер.Результат(Тест).Вывод()).Содержит("Набор из памяти выполнен");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ИзолированныйФайловыйНабор", 1)
&ИсточникЗначение("ПроцессныйФайловыйНабор", 1)
&ИсточникЗначение("ФайловыйНаборСИзолированнымиМетодами", 2)
&Изолированный(Уровень = "Процесс")
Процедура ИзоляцияНеВыполняетПосторонниеТипыИзИмпортов(ИмяНабора, ЧислоТестов) Экспорт

	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.КаталогиТестов", "");
	Детальки.Вставить("OneUnit.ФайлыТестов", "./tests/fixtures/registrations/" + ИмяНабора + ".os");
	Детальки.Вставить("OneUnit.ТестовыеНаборыВключаемые", ИмяНабора);
	Детальки.Вставить("OneUnit.РежимВыводаЛога", РежимыВыводаЛога.Ничего);
	Поделка = ПрогоныТестов.СоздатьПоделку(Детальки);

	Менеджер = Поделка.НайтиЖелудь("МенеджерТестирования");
	План = Менеджер.Обнаружить();
	Ожидаем.Что(План.Дети().Количество()).Равно(1);
	Ожидаем.Что(План.Дети().Получить(0).Дети().Количество()).Равно(ЧислоТестов);

	МенеджерФайлов = Новый МенеджерВременныхФайлов;
	Маркер = МенеджерФайлов.НовоеИмяФайла("txt");
	УдалитьФайлы(Маркер);
	УстановитьПеременнуюСреды("ONEUNIT_FOREIGN_SET_MARKER", Маркер);

	Попытка

		Менеджер.Тестировать();
		Ожидаем.Что(ФС.Существует(Маркер)).ЭтоЛожь();

	Исключение

		МенеджерФайлов.Удалить();
		ВызватьИсключение;

	КонецПопытки;

	МенеджерФайлов.Удалить();
	Статистика = Поделка.НайтиЖелудь("РепортерСтатистика").СтатистикаТестПлана();
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовОбнаружено", 0)).Равно(ЧислоТестов);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0)).Равно(ЧислоТестов);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Точка.Имени")
&ИсточникЗначение("Имя+[x](y){1}?^$|")
&ИсточникЗначение("Имя, с пробелом")
&ИсточникЗначение("Имя\обратная")
&Изолированный(Уровень = "Процесс")
Процедура ФильтрИзоляцииОтбираетИмяБуквально(ИмяНабора) Экспорт

	ИмяТипаНабора = ЗарегистрироватьНаборИзПамяти();
	Построитель = Новый ПостроительДекоратора;
	Построитель.Метод(Новый Метод("ПриСозданииОбъекта")
		.Аннотация(Новый Аннотация("Дуб"))
		.ЭтоПроцедура());

	Для Индекс = 0 По 1 Цикл

		Имя = ?(Индекс = 0, ИмяНабора, ИмяНабора + "Другой");
		Построитель.Метод(Новый Метод("СоздатьНабор" + Формат(Индекс, "ЧГ=0"))
			.Аннотация(Новый Аннотация("Прозвище").Параметр("ТестовыйНабор"))
			.Аннотация(Новый Аннотация("Характер").Параметр("Компанейский"))
			.Аннотация(Новый Аннотация("Завязь")
				.Параметр(Имя)
				.Параметр(ИмяТипаНабора, "Тип"))
			.ТелоМетода("Возврат Новый " + ИмяТипаНабора + ";")
			.Публичный());

	КонецЦикла;

	ИмяТипаФабрики = "ФабрикаНаборов_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	Построитель.ЗарегистрироватьВСистемеТипов(ИмяТипаФабрики);

	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.КаталогиТестов", "");
	Детальки.Вставить("OneUnit.ФайлыТестов", "");
	Детальки.Вставить("OneUnit.РежимВыводаЛога", РежимыВыводаЛога.Ничего);
	Детальки.Вставить(
		"OneUnit.ТестовыеНаборыВключаемые",
		ТестированиеСлужебный.ЭкранироватьИмяНабораДляФильтра(ИмяНабора)
	);
	Поделка = ПрогоныТестов.СоздатьПоделку(Детальки);

	Менеджер = Поделка.НайтиЖелудь("МенеджерТестирования");
	План = Менеджер.Обнаружить();
	Ожидаем.Что(План.Дети().Количество()).Равно(1);
	Ожидаем.Что(План.Дети().Получить(0).Имя()).Равно(ИмяНабора);

	Менеджер.Тестировать();
	Статистика = Поделка.НайтиЖелудь("РепортерСтатистика").СтатистикаТестПлана();
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0)).Равно(1);

КонецПроцедуры

Функция ЗарегистрироватьНаборИзПамяти(АннотироватьКонструктор = Ложь, УровеньИзоляции = "")

	ИмяТипа = "oneunit_testsuite_ДинамическийНабор_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	Построитель = Новый ПостроительДекоратора;
	Конструктор = Новый Метод("ПриСозданииОбъекта").ЭтоПроцедура();

	Если АннотироватьКонструктор Тогда
		Конструктор.Аннотация(Новый Аннотация("ТестовыйНабор"));
	КонецЕсли;

	Если ЗначениеЗаполнено(УровеньИзоляции) Тогда
		Конструктор.Аннотация(Новый Аннотация("Изолированный").Параметр(УровеньИзоляции, "Уровень"));
	КонецЕсли;

	Построитель.Метод(Конструктор);
	Построитель.Метод(Новый Метод("ПроверкаИзПамяти")
		.Аннотация(Новый Аннотация("Тест"))
		.ТелоМетода("Сообщить(""Набор из памяти выполнен"");")
		.Публичный()
		.ЭтоПроцедура());
	Построитель.ЗарегистрироватьВСистемеТипов(ИмяТипа);

	Возврат ИмяТипа;

КонецФункции

Функция ПоделкаСНаборомИзПамяти()

	ИмяТипа = ЗарегистрироватьНаборИзПамяти();
	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.КаталогиТестов", "");
	Детальки.Вставить("OneUnit.ФайлыТестов", "");
	Детальки.Вставить("OneUnit.ТестовыеНаборыВключаемые", "НаборИзПамяти");
	Детальки.Вставить("OneUnit.РежимВыводаЛога", РежимыВыводаЛога.Ничего);
	Поделка = ПрогоныТестов.СоздатьПоделку(Детальки);

	Поделка.ДобавитьЗавязь(СтрШаблон(
		"&ТестовыйНабор &Завязь(""НаборИзПамяти"", Тип = ""%1"")
		|() -> Возврат Новый %1;",
		ИмяТипа
	));

	Возврат Поделка;

КонецФункции

Функция ПоделкаСФабричнымиНаборами()

	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.КаталогиТестов", "");
	Детальки.Вставить("OneUnit.ФайлыТестов", "./tests/fixtures/registrations/НаборДляЗавязей.os");
	Детальки.Вставить("OneUnit.ТестовыеНаборыВключаемые", "ФабричныйНабор[1-3]");
	Детальки.Вставить("OneUnit.РежимВыводаЛога", РежимыВыводаЛога.Ничего);

	Совет = Новый СоветДругогоМастера;
	Совет.ПолучитьСтроительМенеджераПараметров().ДобавитьПровайдерСоответствие(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Для Индекс = 1 По 3 Цикл

		Поделка.ДобавитьЗавязь(СтрШаблон(
			"&ТестовыйНабор &Завязь(""ФабричныйНабор%1"", Тип = ""oneunit_testsuite_НаборДляЗавязей"")
			|() -> Возврат Новый oneunit_testsuite_НаборДляЗавязей;",
			Формат(Индекс, "ЧГ=0")
		));

	КонецЦикла;

	Возврат Поделка;

КонецФункции

#КонецОбласти

Функция НоваяПоделка()

	Детальки = Новый Соответствие;
	Возврат ПрогоныТестов.СоздатьПоделкуФикстур(Детальки, "./tests/fixtures");

КонецФункции

Рефлектор = Новый Рефлектор();
