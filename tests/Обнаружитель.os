			ТипыОпределенийТестов.Тест,
			"ИсточникЗначение",
			СтрШаблон("[%1, %2]", Сч * 2 - 1, Сч * 2),
			СтрШаблон("ПараметризованныйТест.ИсточникЗначение.[%1, %2]", Сч * 2 - 1, Сч * 2),
			ОбъединитьПути(".", "tests", "fixtures", "ПараметризованныйТест.os"),
