&ПослеВсех
Процедура УдалитьОставшиесяРесурсы() Экспорт
	ОчисткаПроверокРесурсов.Удалить();
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("НаборСВременнымиРесурсами")
&ИсточникЗначение("ПоделочныйНаборСРесурсами")
&ИсточникЗначение("ПроцессныйНаборСРесурсами")
Процедура ПараметрыКонструктораМетодовИПоляПолучаютРесурсы(ИмяНабора) Экспорт

	Прогон = ПрогнатьНабор(ИмяНабора);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	РезультатНабора = Прогон.Статистика.Результат(Набор);
	Ожидаем.Что(РезультатНабора.Состояние(), РезультатНабора.ОписанияПричин()).Равно(СостоянияВыполненияТестов.Успех);
	ЗаписиНабора = ПрочитатьЗаписи(РезультатНабора.Вывод());
	Ожидаем.Что(ЗаписиНабора.Количество()).Больше(0);

	Для Каждого Тест Из Набор.Дети() Цикл

		Результат = Прогон.Статистика.Результат(Тест);
		Ожидаем.Что(Результат.Состояние(), Результат.ОписанияПричин()).Равно(СостоянияВыполненияТестов.Успех);
		Записи = ПрочитатьЗаписи(Результат.Вывод());
		Ожидаем.Что(Записи.Количество()).Равно(16);
		ПроверитьУдалённыеПути(Записи);

	КонецЦикла;

	ПроверитьУдалённыеПути(ЗаписиНабора);

КонецПроцедуры

&Тест
Процедура ПоляОбластиТестРазличаютсяАОбластиНаборСовпадают() Экспорт

	ИмяНабора = "НаборСВременнымиРесурсами";
	Прогон = ПрогнатьНабор(ИмяНабора);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	Первый = ПрочитатьЗаписи(Прогон.Статистика.Результат(Набор.Дети().Получить(0)).Вывод());
	Второй = ПрочитатьЗаписи(Прогон.Статистика.Результат(Набор.Дети().Получить(1)).Вывод());

	Для Каждого Имя Из Списки.ИзЭлементов("КаталогТеста", "ФайлТеста", "КаталогКонструктора") Цикл
		Ожидаем.Что(ПутьЗаписи(Первый, "Тест", Имя)).Не_().Равно(ПутьЗаписи(Второй, "Тест", Имя));
	КонецЦикла;

	Ожидаем.Что(ПутьЗаписи(Первый, "Тест", "КаталогНабора"))
		.Равно(ПутьЗаписи(Второй, "Тест", "КаталогНабора"));
	Ожидаем.Что(СтрЗаканчиваетсяНа(ПутьЗаписи(Первый, "Тест", "ФайлТеста"), ".json")).ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ВсегдаУспех", Ложь)
&ИсточникЗначение("ВсегдаОшибка", Ложь)
&ИсточникЗначение("ПриУспехеУспех", Ложь)
&ИсточникЗначение("ПриУспехеОшибка", Истина)
&ИсточникЗначение("НикогдаУспех", Истина)
&ИсточникЗначение("НикогдаОшибка", Истина)
&ИсточникЗначение("ПустыеНикогда", Ложь)
&ИсточникЗначение("ТолькоЧтение", Ложь)
Процедура РежимОчисткиУчитываетРезультатИПустоту(ИмяМетода, Сохранён) Экспорт

	ИмяНабора = "НаборСРежимамиОчистки";
	Прогон = ПрогнатьНабор(ИмяНабора);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	Тест = ПрогоныТестов.НайтиТест(Набор, ИмяМетода);
	Результат = Прогон.Статистика.Результат(Тест);

	Если СтрНайти(ИмяМетода, "Ошибка") = 0 Тогда
		Ожидаем.Что(Результат.Состояние(), Результат.ОписанияПричин()).Равно(СостоянияВыполненияТестов.Успех);
	КонецЕсли;

	Записи = ПрочитатьЗаписи(Результат.Вывод());
	Ожидаем.Что(Записи.Количество()).Равно(2);

	Для Каждого Запись Из Записи Цикл

		Ожидаем.Что(ФС.Существует(Запись.path), Запись.path).Равно(Сохранён);

		Если Сохранён Тогда
			Ожидаем.Что(Результат.Вывод()).Содержит(": " + Запись.path);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ПадениеТестаСохраняетРесурсОбластиНабора() Экспорт

	ИмяНабора = "ОбластьНабораСПадением";
	Прогон = ПрогнатьНабор(ИмяНабора);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	Первый = ПрочитатьЗаписи(Прогон.Статистика.Результат(Набор.Дети().Получить(0)).Вывод());
	Второй = ПрочитатьЗаписи(Прогон.Статистика.Результат(Набор.Дети().Получить(1)).Вывод());
	Путь = Первый.Получить(0).path;
	Ожидаем.Что(Второй.Получить(0).path).Равно(Путь);
	Ожидаем.Что(ФС.КаталогСуществует(Путь)).ЭтоИстина();
	Ожидаем.Что(Прогон.Статистика.Результат(Набор).Вывод()).Содержит(": " + Путь);

КонецПроцедуры

&Тест
Процедура ПараметрыОбластиНаборОбщиеДляВызововИЭкземпляров() Экспорт

	ИмяНабора = "ПараметрыОбластиНабор";
	Прогон = ПрогнатьНабор(ИмяНабора);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	Вызовы = Набор.Дети().Получить(0).Дети();
	Первый = ПрочитатьЗаписи(Прогон.Статистика.Результат(Вызовы.Получить(0)).Вывод());
	Второй = ПрочитатьЗаписи(Прогон.Статистика.Результат(Вызовы.Получить(1)).Вывод());
	Ожидаем.Что(Первый.Количество()).Равно(2);
	Ожидаем.Что(Второй.Количество()).Равно(2);
	Ожидаем.Что(Первый.Получить(0).path).Равно(Второй.Получить(0).path);
	Ожидаем.Что(Первый.Получить(1).path).Равно(Второй.Получить(1).path);
	ПроверитьУдалённыеПути(Первый);

КонецПроцедуры

&Тест
Процедура ИзолированныеМетодыПолучаютСобственныеРесурсы() Экспорт

	ИмяНабора = "ИзолированныеВременныеРесурсы";
	Прогон = ПрогнатьНабор(ИмяНабора);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	ПутиНаборов = Новый МножествоСоответствие;

	Для Каждого Тест Из Набор.Дети() Цикл

		Результат = Прогон.Статистика.Результат(Тест);
		Ожидаем.Что(Результат.Состояние(), Результат.ОписанияПричин()).Равно(СостоянияВыполненияТестов.Успех);
		Записи = ПрочитатьЗаписи(Результат.Вывод());
		Ожидаем.Что(Записи.Количество()).Равно(3);
		ПутиНаборов.Добавить(ПутьЗаписи(Записи, "Тест", "КаталогНабора"));
		ПроверитьУдалённыеПути(Записи);

	КонецЦикла;

	Ожидаем.Что(ПутиНаборов.Количество()).Равно(2);

КонецПроцедуры

