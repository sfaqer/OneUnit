	Описание = ТестированиеСлужебный.ПодробноеОписаниеОшибки("Причина", Результат.Причины().Получить(0));
	Ожидаем.Что(Описание).Содержит("Неизвестная область временного пути для поля ""РабочийКаталог""");
	Ожидаем.Что(Результат.Вывод()).Не_().Содержит("UNEXPECTED_RESOURCE_BODY");

КонецПроцедуры

