&ПараметризованныйТест
&ИсточникЗначение("Область", "Неизвестная область", "Каталог")
&ИсточникЗначение("Очистка", "Неизвестный режим очистки", "Файл")
&ИсточникЗначение("Расширение", "Расширение временного файла", "Файл")
&ИсточникЗначение("ТипРасширения", "должно быть строкой", "Файл")
Процедура ОшибочнаяНастройкаНеВызываетТест(ИмяМетода, ТекстОшибки, ИмяПараметра) Экспорт

	Прогон = ПрогнатьНабор("ОшибочныеНастройкиРесурса");
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, "ОшибочныеНастройкиРесурса");
	Результат = Прогон.Статистика.Результат(ПрогоныТестов.НайтиТест(Набор, ИмяМетода));
	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Описание = ТестированиеСлужебный.ПодробноеОписаниеОшибки("Причина", Результат.Причины().Получить(0));
	Ожидаем.Что(Описание).Содержит(ТекстОшибки);
	Ожидаем.Что(Описание).Содержит(
		СтрШаблон("для параметра ""%1"" метода ""%2""", ИмяПараметра, ИмяМетода)
	);
	Ожидаем.Что(Результат.Вывод()).Не_().Содержит("UNEXPECTED_RESOURCE_BODY");

КонецПроцедуры

&Тест
Процедура ОшибкаНастройкиПоляСодержитЕгоИмя() Экспорт

	Прогон = ПрогнатьНабор("ОшибочнаяНастройкаПоля");
