&Тест
Процедура СохранённыеПутиВключаютсяВJSONИJUnit() Экспорт

	ИмяНабора = "СохранениеВПроцессе";
	JSONПуть = ОчисткаПроверокРесурсов.ПутьОтчёта("json");
	JUnitПуть = ОчисткаПроверокРесурсов.ПутьОтчёта("xml");
	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.ПутьКОтчетуJSON", JSONПуть);
	Детальки.Вставить("OneUnit.ПутьКОтчетуJUnit", JUnitПуть);
	Прогон = ПрогоныТестов.Прогнать(ИмяНабора, "", ПутьНабора(ИмяНабора), Детальки);
	СобратьПути(Прогон.План, Прогон.Статистика);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	Записи = ПрочитатьЗаписи(Прогон.Статистика.Результат(Набор.Дети().Получить(0)).Вывод());
	Ожидаем.Что(Записи.Количество()).Равно(2);
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(JSONПуть);
	JSONОтчёт = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	ЧтениеТекста = Новый ЧтениеТекста(JUnitПуть, КодировкаТекста.UTF8);
	JUnitОтчёт = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();

	Для Каждого Запись Из Записи Цикл

		Ожидаем.Что(JSONОтчёт.tests.Получить(0).output).Содержит(": " + Запись.path);
		Ожидаем.Что(JUnitОтчёт).Содержит(Запись.path);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ПараллельныеЗапросыПолучаютОдинПутьОбластиНабора() Экспорт

	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.КаталогиТестов", "");
	Детальки.Вставить("OneUnit.ФайлыТестов", ПутьНабора("ПараметрыОбластиНабор"));
	Детальки.Вставить("OneUnit.ТестовыеНаборыВключаемые", "ПараметрыОбластиНабор");
	Поделка = ПрогоныТестов.СоздатьПоделку(Детальки);
	Набор = ПрогоныТестов.НайтиНабор(Поделка.НайтиЖелудь("МенеджерТестирования").Обнаружить(), "ПараметрыОбластиНабор");
	Элемент = Поделка.НайтиЖелудь("КонтекстПараметра", Массивы.ИзЭлементов(Набор.Сигнатура("Повтор").Метод(), 0));
	Контекст = Набор.Дети().Получить(0).Дети().Получить(0).Контекст();
	Поставщик = Поделка.НайтиЖелудь("ПоставщикВременногоПути");
	Задания = Новый СписокМассив;

	Для Номер = 1 По 8 Цикл

		Задания.Добавить(
			Обещания.ВыполнитьДелегат(
				Новый Действие(ЭтотОбъект, "ПараллельныйЗапросПути"),
				Новый Массив(Массивы.ИзЭлементов(Поставщик, Элемент, Контекст)),
				Истина
			)
		);

	КонецЦикла;

	Пути = Новый МножествоСоответствие;

	Для Каждого Задание Из Задания Цикл
		Пути.Добавить(Задание.Получить(60000));
	КонецЦикла;

	Ожидаем.Что(Пути.Количество()).Равно(1);
	Набор.Контекст().Закрыть(Опциональные.Пустой());

	Для Каждого Путь Из Пути Цикл
		Ожидаем.Что(ФС.Существует(Путь)).ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

Функция ПараллельныйЗапросПути(Поставщик, Элемент, Контекст) Экспорт
	Возврат Поставщик.Значение(Элемент, Контекст);
КонецФункции

&Тест
Процедура СменаКаталогаВременныхФайловНеМешаетОчистке() Экспорт

	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.КаталогиТестов", "");
	Детальки.Вставить("OneUnit.ФайлыТестов", ПутьНабора("ПараметрыОбластиНабор"));
	Детальки.Вставить("OneUnit.ТестовыеНаборыВключаемые", "ПараметрыОбластиНабор");
	Поделка = ПрогоныТестов.СоздатьПоделку(Детальки);
	План = Поделка.НайтиЖелудь("МенеджерТестирования").Обнаружить();
	Набор = ПрогоныТестов.НайтиНабор(План, "ПараметрыОбластиНабор");
	Контекст = Новый КонтекстИсполнения(Набор);
	Каталог = Поделка.НайтиЖелудь("ВременныйПуть", Массивы.ИзЭлементов(Истина, "tmp", "Всегда"));
	Файл = Поделка.НайтиЖелудь("ВременныйПуть", Массивы.ИзЭлементов(Ложь, "tmp", "Всегда"));
	ПутьКаталога = Каталог.Открыть(Контекст);
	ПутьФайла = Файл.Открыть(Контекст);
	Переменные = Новый Структура(
		"TEMP, TMP, TMPDIR",
		ПолучитьПеременнуюСреды("TEMP"),
		ПолучитьПеременнуюСреды("TMP"),
		ПолучитьПеременнуюСреды("TMPDIR")
	);

	Попытка

		Для Каждого Переменная Из Переменные Цикл
			УстановитьПеременнуюСреды(Переменная.Ключ, ПутьКаталога);
		КонецЦикла;

		Итог = Контекст.Закрыть(Опциональные.Пустой());
		КаталогОстался = ФС.Существует(ПутьКаталога);
		ФайлОстался = ФС.Существует(ПутьФайла);

	Исключение

		ВосстановитьПеременныеСреды(Переменные);
		Контекст.Закрыть(Опциональные.Пустой());
		Каталог.Закрыть(Контекст);
		Файл.Закрыть(Контекст);
		ВызватьИсключение;

	КонецПопытки;

	ВосстановитьПеременныеСреды(Переменные);
	Каталог.Закрыть(Контекст);
	Файл.Закрыть(Контекст);
	Ожидаем.Что(Итог.Причины.Количество()).Равно(0);
	Ожидаем.Что(КаталогОстался).ЭтоЛожь();
	Ожидаем.Что(ФайлОстался).ЭтоЛожь();

КонецПроцедуры

Процедура ВосстановитьПеременныеСреды(Переменные)

	Для Каждого Переменная Из Переменные Цикл
		УстановитьПеременнуюСреды(Переменная.Ключ, Переменная.Значение);
	КонецЦикла;

КонецПроцедуры

Функция ПрогнатьНабор(Знач ИмяНабора)

	Прогон = ПрогоныТестов.ПрогнатьОднажды("temp-resources:" + ИмяНабора, ИмяНабора, "", ПутьНабора(ИмяНабора));
	СобратьПути(Прогон.План, Прогон.Статистика);
	Возврат Прогон;

КонецФункции

Процедура СобратьПути(Узел, Статистика)

	Результат = Статистика.НайтиРезультат(Узел);

	Если Результат.СодержитЗначение() Тогда
		ПрочитатьЗаписи(Результат.Получить().Вывод());
	КонецЕсли;

	Для Каждого Дитя Из Узел.Дети() Цикл
		СобратьПути(Дитя, Статистика);
	КонецЦикла;

КонецПроцедуры

Функция ПутьНабора(Знач ИмяНабора)
	Возврат "./tests/fixtures/temp-resources/" + ИмяНабора + ".os";
КонецФункции

Процедура ПроверитьУдалённыеПути(Записи)

	Для Каждого Запись Из Записи Цикл
		Ожидаем.Что(ФС.Существует(Запись.path), Запись.path).ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

Функция ПутьЗаписи(Записи, Знач Этап, Знач Имя)

	Возврат Записи.ПроцессорКоллекции()
		.Фильтровать("Запись -> Запись.phase = Этап И Запись.name = Имя", Новый Структура("Этап, Имя", Этап, Имя))
		.Обработать("Запись -> Запись.path")
		.ПолучитьПервый();

КонецФункции

Функция ПрочитатьЗаписи(Знач Вывод)

	Записи = ПроцессорыКоллекций.ИзКоллекции(СтрРазделить(Вывод, Символы.ПС))
		.Фильтровать("Строка -> СтрНачинаетсяС(Строка, ""TEMP_RESOURCE:"")")
		.Обработать(
			"Строка -> {
			|	Чтение = Новый ЧтениеJSON;
			|	Чтение.УстановитьСтроку(Сред(Строка, СтрДлина(""TEMP_RESOURCE:"") + 1));
			|	Запись = ПрочитатьJSON(Чтение);
			|	Чтение.Закрыть();
			|	Возврат Запись;
			|}"
		)
		.Получить("СписокМассив");

	Записи.ДляКаждого("Запись -> ОчисткаПроверокРесурсов.Учесть(Запись.path)");
	Возврат Записи;

КонецФункции
