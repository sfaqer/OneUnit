&Тест
Процедура ОдиночкаОбновляетПоляАКонструкторПринадлежитНабору() Экспорт

	ИмяНабора = "ОдиночкаСРесурсами";
	Прогон = ПрогнатьНабор(ИмяНабора);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	Первый = ПрочитатьЗаписи(Прогон.Статистика.Результат(Набор.Дети().Получить(0)).Вывод());
	Второй = ПрочитатьЗаписи(Прогон.Статистика.Результат(Набор.Дети().Получить(1)).Вывод());
	Ожидаем.Что(ПутьЗаписи(Первый, "Тест", "КаталогКонструктора"))
		.Равно(ПутьЗаписи(Второй, "Тест", "КаталогКонструктора"));
	Ожидаем.Что(ПутьЗаписи(Первый, "Тест", "КаталогТеста"))
		.Не_().Равно(ПутьЗаписи(Второй, "Тест", "КаталогТеста"));
