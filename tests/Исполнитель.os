КонецПроцедуры

&Тест
Процедура ПадениеВПередВсемиЛомаетНабор() Экспорт

	Результат = РезультатНабора("НаборПадающий");

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Ожидаем.Что(Результат.ОписанияПричин()).ИмеетДлину(2);
	Ожидаем.Что(СтрНайти(Результат.ОписанияПричин().Получить(0), "ЯУпал")).Больше(0);
	Ожидаем.Что(СтрНайти(Результат.ОписанияПричин().Получить(1), "ЯТожеУпал")).Больше(0);

	// Тесты набора со сломанным ПередВсеми не должны запускаться
	Статистика = СтатистикаНабора("НаборПадающий");
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовОбнаружено", 0)).Равно(0);

