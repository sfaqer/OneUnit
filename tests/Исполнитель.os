#КонецОбласти

#Область ТестыЖизненногоЦикла

&Тест
Процедура ЖизненныйЦиклВыполняетсяПоПорядку() Экспорт

	Результат = РезультатНабора("НаборЖизненныйЦикл");

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Успех);

	Ожидаем.Что(ЖурналВыполнения.Записи).РавноМассиву(СтрРазделить(
		"ПередВсеми,ПередКаждым,Первый,ПослеКаждого,ПередКаждым,Второй,ПослеКаждого,ПослеВсех",
		","
	));

КонецПроцедуры

#КонецОбласти

#Область ТестыПрерыванияПриПадении

&Тест
Процедура ПриПаденииОставшиесяТестыНеЗапускаются() Экспорт

	Прогон = ПрогонСПрерыванием();
	Набор  = ПрогоныТестов.НайтиНабор(Прогон.План, "НаборПрерываемый");

	Ожидаем.Что(Прогон.Статистика.Результат(ПрогоныТестов.НайтиТест(Набор, "Зеленый")).Состояние())
		.Равно(СостоянияВыполненияТестов.Успех);

	Ожидаем.Что(Прогон.Статистика.Результат(ПрогоныТестов.НайтиТест(Набор, "Падающий")).Состояние())
		.Равно(СостоянияВыполненияТестов.Ошибка);

	// в наборе три теста, а исполнились два: до третьего дело не дошло
	Статистика = Прогон.Статистика.СтатистикаТестПлана();

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0), "Успешных").Равно(1);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовОшибка", 0), "Упавших").Равно(1);

КонецПроцедуры

&Тест
Процедура ПриПаденииНаборСворачиваетсяШтатно() Экспорт

	// Прогон прекращается, но не обрывается: ПослеКаждого упавшего теста и ПослеВсех
	// набора обязаны отработать - там закрываются файлы, соединения и всё прочее,
	// что набор открыл

	ПрогонСПрерыванием();

	Ожидаем.Что(ЖурналВыполнения.Записи).РавноМассиву(СтрРазделить(
		"ПередВсеми,Зеленый,ПослеКаждого,Падающий,ПослеКаждого,ПослеВсех",
		","
	));

КонецПроцедуры

&Тест
Процедура ПадениеВИзоляцииПрекращаетПрогон() Экспорт

	// Изолированный набор идёт своей средой, а его тесты переэмитятся в общий прогон.
	// Падение там - такое же падение, и следующие наборы запускаться не должны

	Прогон = ПрогонСИзоляциейИПрерыванием();

	Статистика = Прогон.Статистика.СтатистикаТестПлана();

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовОшибка", 0), "Упавших").Равно(1);

	// второй набор идёт после красного изолированного и запуститься не должен
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0), "Успешных").Равно(0);

КонецПроцедуры

&Тест
Процедура НезапущенныйТестПопадаетВОтчетПропущенным() Экспорт

	// Репортёры обходят план и спрашивают результат у каждого узла. Без результата
	// у незапущенного теста JUnit падал на пустом Опциональном, а изолированный набор
	// терял результаты целиком

	Прогон = ПрогонСПрерыванием();
	Набор  = ПрогоныТестов.НайтиНабор(Прогон.План, "НаборПрерываемый");

	Ожидаем.Что(Прогон.Статистика.Результат(ПрогоныТестов.НайтиТест(Набор, "ПослеПадения")).Состояние())
		.Равно(СостоянияВыполненияТестов.Пропущен);

	// План обнаружил три теста, и столько же обязан показать счётчик
	Статистика = Прогон.Статистика.СтатистикаТестПлана();

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовОбнаружено", 0), "Обнаружено").Равно(3);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовПропущено", 0), "Пропущено").Равно(1);

КонецПроцедуры

&Тест
Процедура ОтчетJUnitПишетсяПриПрекращении() Экспорт

	// Отчёт обходит план и просит результат у каждого узла: на незапущенном тесте
	// прогон падал необработанным исключением, а файл не создавался вовсе

	ПрогонСПрерыванием();

	ПроверитьОтчет(ПрогоныТестов.ВременныйПуть("ОтчетПрерванногоJUnit", "xml"), "ПослеПадения");

КонецПроцедуры

&Тест
Процедура ПадениеКонструктораПрекращаетПрогон() Экспорт

	// Набор бывает красным без единого упавшего теста. Для мутационного тестирования
	// это рядовой случай: мутант ломает конструктор набора, а не отдельную проверку

	Прогон = ПрогонСоСломаннымНабором("ПрогонСоСломаннымКонструктором", "НаборСломанныйКонструктор");

	Статистика = Прогон.Статистика.СтатистикаТестПлана();

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("НаборовСломано", 0), "Сломанных наборов").Равно(1);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0), "Успешных тестов").Равно(0);

КонецПроцедуры

&Тест
Процедура ПадениеПередВсемиПрекращаетПрогон() Экспорт

	Прогон = ПрогонСоСломаннымНабором("ПрогонСоСломаннымПередВсеми", "НаборСломанныйПередВсеми");

	Статистика = Прогон.Статистика.СтатистикаТестПлана();

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("НаборовСломано", 0), "Сломанных наборов").Равно(1);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0), "Успешных тестов").Равно(0);

КонецПроцедуры

&Тест
Процедура ПадениеИзолированногоТестаПрекращаетПрогон() Экспорт

	// Изолированный тест уходит из общего потока и возвращается результатом.
	// Прогон обязан остановиться на нём так же, как на обычном

	Прогон = ПрогонСИзолированнымТестом();
	Набор  = ПрогоныТестов.НайтиНабор(Прогон.План, "НаборСПадающимИзолированнымТестом");

	Ожидаем.Что(Прогон.Статистика.Результат(ПрогоныТестов.НайтиТест(Набор, "СоседПоНабору")).Состояние())
		.Равно(СостоянияВыполненияТестов.Пропущен);

	Статистика = Прогон.Статистика.СтатистикаТестПлана();

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0), "Успешных").Равно(0);

КонецПроцедуры

&Тест
Процедура НезапущенныйСлучайКонтейнераТожеПропускается() Экспорт

	// Случаи параметризованного теста живут в контейнере, а не прямо в наборе,
	// и обходятся своим циклом. Репортёры спускаются в контейнер, поэтому
	// результат нужен и его случаям

	ДопДетальки = Новый Соответствие;
	ДопДетальки.Вставить("OneUnit.ПрерыватьПриПервомПадении", Истина);
	ДопДетальки.Вставить(
		"OneUnit.ПутьКОтчетуJUnit",
		ПрогоныТестов.ВременныйПуть("ОтчетКонтейнераJUnit", "xml"));

	Прогон = ПрогоныТестов.ПрогнатьОднажды(
		"ПрогонСПрерываемымКонтейнером",
		"НаборСПрерываемымКонтейнером",
		"",
		"./tests/fixtures/execution/НаборСПрерываемымКонтейнером.os",
		ДопДетальки
	);

	Набор     = ПрогоныТестов.НайтиНабор(Прогон.План, "НаборСПрерываемымКонтейнером");
	Контейнер = ПрогоныТестов.НайтиТест(Набор, "ПадаетНаВтором");

	ПроверитьСостоянияДетей(Прогон, Контейнер, Массивы.ИзЭлементов(
		СостоянияВыполненияТестов.Успех,
		СостоянияВыполненияТестов.Ошибка,
		СостоянияВыполненияТестов.Пропущен
	));

	ПроверитьОтчет(ПрогоныТестов.ВременныйПуть("ОтчетКонтейнераJUnit", "xml"), "ПадаетНаВтором");

КонецПроцедуры

&Тест
Процедура ПовторныйПрогонПослеПрекращенияВыполняетТесты() Экспорт

	// Поделка живёт дольше одного прогона: без сброса отметки второй Тестировать()
	// молча не выполнил бы ни одного теста.
	// Прогон свой, не из кэша: он гоняется дважды и чужие ожидания бы сбил

	ДопДетальки = Новый Соответствие;
	ДопДетальки.Вставить("OneUnit.ПрерыватьПриПервомПадении", Истина);

	Прогон = ПрогоныТестов.Прогнать(
		"НаборКрасныхТестов",
		"",
		"./tests/fixtures/НаборКрасныхТестов.os",
		ДопДетальки
	);

	Прогон.Поделка.НайтиЖелудь("МенеджерТестирования").Тестировать();

	Статистика = Прогон.Статистика.СтатистикаТестПлана();

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовОшибка", 0), "Упавших во втором прогоне").Равно(1);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовПропущено", 0), "Пропущенных во втором прогоне").Равно(1);

КонецПроцедуры

&Тест
Процедура БезПрерыванияИдутВсеТесты() Экспорт

	Прогон = ПрогонБезПрерывания();
	Набор  = ПрогоныТестов.НайтиНабор(Прогон.План, "НаборПрерываемый");

	Ожидаем.Что(Прогон.Статистика.Результат(ПрогоныТестов.НайтиТест(Набор, "ПослеПадения")).Состояние())
		.Равно(СостоянияВыполненияТестов.Успех);

	Статистика = Прогон.Статистика.СтатистикаТестПлана();

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0), "Успешных").Равно(2);

КонецПроцедуры

#КонецОбласти

#Область ТестыУсловий

&Тест
Процедура БезусловноВыключенныеТестыПропускаются() Экспорт

	Результат = РезультатТеста("НаборСВыключеннымиТестами", "Выключен");

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Пропущен);
	Ожидаем.Что(Результат.ОписанияПричин().Получить(0)).Равно("На мне аннотация Выключен");

	Результат = РезультатТеста("НаборСВыключеннымиТестами", "ВыключенЕслиИстина");

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Пропущен);
	Ожидаем.Что(Результат.ОписанияПричин().Получить(0))
		.Равно("На мне аннотация ВыключенЕсли которая вернула истину");

	Результат = РезультатТеста("НаборСВыключеннымиТестами", "ВключенЕсли");

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Пропущен);
	Ожидаем.Что(Результат.ОписанияПричин().Получить(0))
		.Равно("На мне аннотация ВключенЕсли которая вернула Ложь");

КонецПроцедуры

&Тест
Процедура УсловияНаОперационнуюСистему() Экспорт

	// На любой ОС ровно один из трёх ВыключенНаОС срабатывает,
	// и ровно один из трёх ВключенНаОС разрешает выполнение
	Ожидаем.Что(КоличествоПропущенных(Списки.ИзЭлементов(
		"ВыключенНаОСWindows", "ВыключенНаОСLinux", "ВыключенНаОСMacOS"))).Равно(1);

	Ожидаем.Что(КоличествоПропущенных(Списки.ИзЭлементов(
		"ВключенНаОСWindows", "ВключенНаОСLinux", "ВключенНаОСMacOS"))).Равно(2);

КонецПроцедуры

&Тест
Процедура УсловияНаВерсиюOneScript() Экспорт

	// Результат зависит от версии движка, но тесты фикстуры самопроверяющиеся:
	// каждый либо пропущен условием, либо успешно проверил версию внутри себя
	ИменаТестов = Списки.ИзЭлементов(
		"ВыключенДляOneScriptМладшеДвойки",
		"ВыключенДляOneScriptСтаршеДвойки",
		"ВключенДляOneScriptМладшеДвойки",
		"ВключенДляOneScriptСтаршеДвойки"
	);

	Для каждого ИмяТеста Из ИменаТестов Цикл

		Состояние = РезультатТеста("НаборСВыключеннымиТестами", ИмяТеста).Состояние();

		Ожидаем.Что(
			Состояние = СостоянияВыполненияТестов.Успех
				Или Состояние = СостоянияВыполненияТестов.Пропущен,
			СтрШаблон("Состояние теста %1: %2", ИмяТеста, Состояние)
		).ЭтоИстина();

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ТестыОтчетов

&Тест
Процедура ОтчетыФормируются() Экспорт

	Прогон();

	ПроверитьОтчет(ПрогоныТестов.ВременныйПуть("ОтчетJUnit", "xml"), "<testsuites");
	ПроверитьОтчет(ПрогоныТестов.ВременныйПуть("ОтчетGenericExecution", "xml"), "<testExecutions");
	ПроверитьОтчет(ПрогоныТестов.ВременныйПуть("ОтчетOpenTestReport", "xml"), "<e:events");

КонецПроцедуры

&Тест
Процедура РежимПлоскогоЛогаРаботает() Экспорт

	Прогон = ПрогонПлоскогоЛога();

	Статистика = Прогон.Статистика.СтатистикаТестПлана();

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0)).Равно(11);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовОшибка", 0)).Равно(1);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовСломано", 0)).Равно(1);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("НаборовПропущено", 0)).Равно(1);

КонецПроцедуры

&Тест
Процедура ПланОбнаруженияВыводитсяВЛог() Экспорт

	// Режим дерева: репортер основного прогона
	Прогон   = Прогон();
	Репортер = Прогон.Поделка.НайтиЖелудь("РепортерЛогДерево");

	Буфер = Новый ПотокВПамяти();

	ТестированиеСлужебный.НачатьПерехватВывода(Буфер);
	Репортер.ВывестиТестПлан(Прогон.План);
	ТестированиеСлужебный.ЗавершитьПерехватВывода();

	Вывод = ПрогоныТестов.ПрочитатьПоток(Буфер);

	Ожидаем.Что(СтрНайти(Вывод, "НаборКомпанейский"), "Дерево содержит набор").Больше(0);
	Ожидаем.Что(СтрНайти(Вывод, "ИсточникЗначение"), "Дерево содержит контейнер").Больше(0);

	// Режим плоского списка: репортер прогона плоского лога
	Прогон   = ПрогонПлоскогоЛога();
	Репортер = Прогон.Поделка.НайтиЖелудь("РепортерЛогПлоскийСписок");

	Буфер = Новый ПотокВПамяти();

	ТестированиеСлужебный.НачатьПерехватВывода(Буфер);
	Репортер.ВывестиТестПлан(Прогон.План);
	ТестированиеСлужебный.ЗавершитьПерехватВывода();

	Вывод = ПрогоныТестов.ПрочитатьПоток(Буфер);

	Ожидаем.Что(СтрНайти(Вывод, "Тест.Тест1"), "Плоский список содержит полное имя").Больше(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Прогон()

	ВключаемыеНаборы = Новый Массив;
	ВключаемыеНаборы.Добавить("НаборБезКонструктора");
	ВключаемыеНаборы.Добавить("НаборВыключенный");
	ВключаемыеНаборы.Добавить("НаборКомпанейский");
	ВключаемыеНаборы.Добавить("НаборОдиночка");
	ВключаемыеНаборы.Добавить("НаборПадающий");
	ВключаемыеНаборы.Добавить("НаборПрерванный");
	ВключаемыеНаборы.Добавить("НаборСПрерваннымиТестами");
	ВключаемыеНаборы.Добавить("НаборПадающийВКонструкторе");
	ВключаемыеНаборы.Добавить("НаборКрасныхТестов");
	ВключаемыеНаборы.Добавить("НаборБезТестов");
	ВключаемыеНаборы.Добавить("СломанныйНабор");
	ВключаемыеНаборы.Добавить("ПовторяемыйТест");
	ВключаемыеНаборы.Добавить("ПараметризованныйТест");
	ВключаемыеНаборы.Добавить("Тест");
	ВключаемыеНаборы.Добавить("НаборСВыключеннымиТестами");
	ВключаемыеНаборы.Добавить("__Тест_Набор_Со_Странным_Именем_1");
	ВключаемыеНаборы.Добавить("НаборСТаймаутом");
	ВключаемыеНаборы.Добавить("НаборСВыводом");
	ВключаемыеНаборы.Добавить("НаборЖизненныйЦикл");
	ВключаемыеНаборы.Добавить("НаборСОшибкой");
	ВключаемыеНаборы.Добавить("НаборСПадающимУсловием");

	ФайлыТестов = Новый Массив;
	ФайлыТестов.Добавить("./tests/fixtures/execution/НаборСТаймаутом.os");
	ФайлыТестов.Добавить("./tests/fixtures/execution/НаборСВыводом.os");
	ФайлыТестов.Добавить("./tests/fixtures/execution/НаборЖизненныйЦикл.os");
	ФайлыТестов.Добавить("./tests/fixtures/execution/НаборСОшибкой.os");
	ФайлыТестов.Добавить("./tests/fixtures/execution/НаборСПадающимУсловием.os");

	ДопДетальки = Новый Соответствие;
	ДопДетальки.Вставить("OneUnit.РежимВыводаЛога", РежимыВыводаЛога.Дерево);
	ДопДетальки.Вставить(
		"OneUnit.ПутьКОтчетуJUnit",
		ПрогоныТестов.ВременныйПуть("ОтчетJUnit", "xml"));
	ДопДетальки.Вставить(
		"OneUnit.ПутьКОтчетуGenericExecution",
		ПрогоныТестов.ВременныйПуть("ОтчетGenericExecution", "xml"));
	ДопДетальки.Вставить(
		"OneUnit.ПутьКОтчетуOpenTestReport",
		ПрогоныТестов.ВременныйПуть("ОтчетOpenTestReport", "xml"));

	Возврат ПрогоныТестов.ПрогнатьОднажды(
		"ОсновнойПрогон",
		СтрСоединить(ВключаемыеНаборы, ","),
		"./tests/fixtures",
		СтрСоединить(ФайлыТестов, ","),
		ДопДетальки
	);

КонецФункции

// Прогон одного набора с прерыванием на первом падении. Журнал выполнения
// глобальный, поэтому набор в прогоне ровно один: иначе записи перемешались бы.
Функция ПрогонСПрерыванием()

	ДопДетальки = Новый Соответствие;
	ДопДетальки.Вставить("OneUnit.ПрерыватьПриПервомПадении", Истина);

	// Отчёт пишется этим же прогоном: повторный прогон того же набора перетёр бы
	// глобальный журнал выполнения, на который смотрит соседний тест
	ДопДетальки.Вставить(
		"OneUnit.ПутьКОтчетуJUnit",
		ПрогоныТестов.ВременныйПуть("ОтчетПрерванногоJUnit", "xml"));

	Возврат ПрогоныТестов.ПрогнатьОднажды(
		"ПрогонСПрерыванием",
		"НаборПрерываемый",
		"",
		"./tests/fixtures/execution/НаборПрерываемый.os",
		ДопДетальки
	);

КонецФункции

// Красный набор, за ним зелёный обычный: второй запускаться не должен.
// Набор красен без единого упавшего теста - ломается конструктор или ПередВсеми.
Функция ПрогонСоСломаннымНабором(Ключ, ИмяНабора)

	ДопДетальки = Новый Соответствие;
	ДопДетальки.Вставить("OneUnit.ПрерыватьПриПервомПадении", Истина);

	ФайлыТестов = Новый Массив;
	ФайлыТестов.Добавить(СтрШаблон("./tests/fixtures/execution/%1.os", ИмяНабора));
	ФайлыТестов.Добавить("./tests/fixtures/Тест.os");

	Возврат ПрогоныТестов.ПрогнатьОднажды(
		Ключ,
		СтрШаблон("%1,Тест", ИмяНабора),
		"",
		СтрСоединить(ФайлыТестов, ","),
		ДопДетальки
	);

КонецФункции

Функция ПрогонСИзолированнымТестом()

	ДопДетальки = Новый Соответствие;
	ДопДетальки.Вставить("OneUnit.ПрерыватьПриПервомПадении", Истина);

	Возврат ПрогоныТестов.ПрогнатьОднажды(
		"ПрогонСИзолированнымТестом",
		"НаборСПадающимИзолированнымТестом",
		"",
		"./tests/fixtures/execution/НаборСПадающимИзолированнымТестом.os",
		ДопДетальки
	);

КонецФункции

// Красный изолированный набор, за ним зелёный обычный: второй запускаться не должен.
// Порядок наборов в плане - порядок файлов в списке.
Функция ПрогонСИзоляциейИПрерыванием()

	ДопДетальки = Новый Соответствие;
	ДопДетальки.Вставить("OneUnit.ПрерыватьПриПервомПадении", Истина);

	ФайлыТестов = Новый Массив;
	ФайлыТестов.Добавить("./tests/fixtures/isolation/ИзолированныйПоделочныйКрасныйНабор.os");
	ФайлыТестов.Добавить("./tests/fixtures/Тест.os");

	Возврат ПрогоныТестов.ПрогнатьОднажды(
		"ПрогонСИзоляциейИПрерыванием",
		"ИзолированныйПоделочныйКрасныйНабор,Тест",
		"",
		СтрСоединить(ФайлыТестов, ","),
		ДопДетальки
	);

КонецФункции

Функция ПрогонБезПрерывания()

	Возврат ПрогоныТестов.ПрогнатьОднажды(
		"ПрогонБезПрерывания",
		"НаборПрерываемый",
		"",
		"./tests/fixtures/execution/НаборПрерываемый.os"
	);

КонецФункции

Функция ПрогонПлоскогоЛога()

	ДопДетальки = Новый Соответствие;
	ДопДетальки.Вставить("OneUnit.РежимВыводаЛога", РежимыВыводаЛога.ПлоскийСписок);

	ФайлыТестов = Новый Массив;
	ФайлыТестов.Добавить("./tests/fixtures/Тест.os");
	ФайлыТестов.Добавить("./tests/fixtures/НаборКрасныхТестов.os");
	ФайлыТестов.Добавить("./tests/fixtures/НаборВыключенный.os");
	ФайлыТестов.Добавить("./tests/fixtures/ПовторяемыйТест.os");

	Возврат ПрогоныТестов.ПрогнатьОднажды(
		"ПлоскийЛог",
		"Тест,НаборКрасныхТестов,НаборВыключенный,ПовторяемыйТест",
		"",
		СтрСоединить(ФайлыТестов, ","),
		ДопДетальки
	);

КонецФункции

Функция РезультатТеста(ИмяНабора, ИмяТеста)

	Прогон = Прогон();
	Набор  = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);

	Возврат Прогон.Статистика.Результат(ПрогоныТестов.НайтиТест(Набор, ИмяТеста));

КонецФункции

Функция РезультатНабора(ИмяНабора)

	Прогон = Прогон();

	Возврат Прогон.Статистика.Результат(ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора));

КонецФункции

Функция СтатистикаНабора(ИмяНабора)

	Прогон = Прогон();

	Возврат Прогон.Статистика.СтатистикаНабора(ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора));

КонецФункции

Функция КоличествоПропущенных(ИменаТестов)

	Количество = 0;

	Для каждого ИмяТеста Из ИменаТестов Цикл

		Результат = РезультатТеста("НаборСВыключеннымиТестами", ИмяТеста);

		Если Результат.Состояние() = СостоянияВыполненияТестов.Пропущен Тогда
			Количество = Количество + 1;
		Иначе
			Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Успех);
		КонецЕсли;

	КонецЦикла;

	Возврат Количество;

КонецФункции

Процедура ПроверитьСостоянияДетей(Прогон, Контейнер, ОжидаемыеСостояния)

	Ожидаем.Что(Контейнер.Дети()).ИмеетДлину(ОжидаемыеСостояния.Количество());

	Для Индекс = 0 По ОжидаемыеСостояния.Количество() - 1 Цикл

		Результат = Прогон.Статистика.Результат(Контейнер.Дети().Получить(Индекс));

		Ожидаем.Что(
			Результат.Состояние(),
			СтрШаблон("Состояние ребёнка %1 контейнера %2", Индекс, Контейнер.Имя())
		).Равно(ОжидаемыеСостояния.Получить(Индекс));

	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьОтчет(ПутьКОтчету, ОжидаемоеСодержимое)

	Ожидаем.Что(Новый Файл(ПутьКОтчету).Существует(), "Отчёт существует: " + ПутьКОтчету).ЭтоИстина();

	ЧтениеТекста = Новый ЧтениеТекста(ПутьКОтчету, КодировкаТекста.UTF8);
	Содержимое   = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();

	Ожидаем.Что(Содержимое).Заполнено();

	Если ЗначениеЗаполнено(ОжидаемоеСодержимое) Тогда
		Ожидаем.Что(СтрНайти(Содержимое, ОжидаемоеСодержимое), "Содержимое отчёта " + ПутьКОтчету).Больше(0);
	КонецЕсли;

	// Отчёт должен быть корректным XML
	ЧтениеXML = Новый ЧтениеXML();
	ЧтениеXML.УстановитьСтроку(Содержимое);
	Пока ЧтениеXML.Прочитать() Цикл
		// чтение до конца документа, при некорректном XML будет выброшено исключение
	КонецЦикла;
	ЧтениеXML.Закрыть();

КонецПроцедуры

#КонецОбласти
