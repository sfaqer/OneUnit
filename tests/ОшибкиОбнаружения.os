// Тесты ошибок обнаружения тестов на некорректных фикстурах
//
// Внимание: у этого сценария намеренно нет конструктора с аннотацией &ТестовыйНабор,
// см. пояснение в Исполнитель.os

#Использовать asserts
#Использовать "./support"
#Использовать ".."

// Аннотации с невалидной ОС нельзя проверять через фикстуру:
// они разворачиваются при сканировании типов на старте каждой поделки,
// и подключённый сценарий с такой аннотацией ломает все последующие поделки процесса.
// Поэтому конструкторы аннотаций проверяются напрямую.

&Тест
Процедура НеизвестнаяОСВАннотацииВключенНаОСВызываетИсключение() Экспорт

	Попытка
		Аннотация = Новый АннотацияВключенНаОС("Amiga");
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
	КонецПопытки;

	Ожидаем.Что(ИнформацияОбОшибке).Не_().ЭтоНеопределено();
	Ожидаем.Что(СтрНайти(ИнформацияОбОшибке.Описание, "В аннотации ВключенНаОС")).Больше(0);

КонецПроцедуры

&Тест
Процедура НеизвестнаяОСВАннотацииВыключенНаОСВызываетИсключение() Экспорт

	Попытка
		Аннотация = Новый АннотацияВыключенНаОС("Amiga");
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
	КонецПопытки;

	Ожидаем.Что(ИнформацияОбОшибке).Не_().ЭтоНеопределено();
	Ожидаем.Что(СтрНайти(ИнформацияОбОшибке.Описание, "В аннотации ВыключенНаОС")).Больше(0);

КонецПроцедуры

&Тест
Процедура НеверныйКлючИсточникаJSONЛомаетТолькоШаблон() Экспорт

	// Ошибка поставщика параметров ломает свой шаблон, а не обнаружение плана:
	// шаблон становится тестом с ошибкой обнаружения, сосед обнаруживается
	План  = ПланОбнаружения("НаборСНевернымКлючомJSON");
	Набор = ПрогоныТестов.НайтиНабор(План, "НаборСНевернымКлючомJSON");

	Ожидаем.Что(План.ЕстьОшибкиОбнаружения()).ЭтоИстина();

	Шаблон = ПрогоныТестов.НайтиТест(Набор, "ТестСНевернымКлючом");

	Ожидаем.Что(Шаблон.ТипОпределения()).Равно(ТипыОпределенийТестов.Тест);
	Ожидаем.Что(Шаблон.ОшибкиОбнаружения()).ИмеетДлину(1);
	Ожидаем.Что(СтрНайти(Шаблон.ОшибкиОбнаружения().Получить(0).Описание, "нет параметра с именем: НеТотПараметр"))
		.Больше(0);

	Ожидаем.Что(ПрогоныТестов.НайтиТест(Набор, "СоседнийТест").ОшибкиОбнаружения()).ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ШаблонСОшибкойОбнаруженияСломанПриИсполнении() Экспорт

	Прогон = ПрогоныТестов.ПрогнатьОднажды(
		"ПрогонНабораСНевернымКлючомJSON",
		"НаборСНевернымКлючомJSON",
		"",
		"./tests/fixtures/broken/НаборСНевернымКлючомJSON.os"
	);

	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, "НаборСНевернымКлючомJSON");

	Результат = Прогон.Статистика.Результат(ПрогоныТестов.НайтиТест(Набор, "ТестСНевернымКлючом"));

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Ожидаем.Что(СтрНайти(Результат.ОписанияПричин().Получить(0), "НеТотПараметр")).Больше(0);

	Ожидаем.Что(Прогон.Статистика.Результат(ПрогоныТестов.НайтиТест(Набор, "СоседнийТест")).Состояние())
		.Равно(СостоянияВыполненияТестов.Успех);

	Статистика = Прогон.Статистика.СтатистикаТестПлана();

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовСломано", 0)).Равно(1);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("НаборовСломано", 0)).Равно(1);

КонецПроцедуры

&Тест
Процедура ОшибкаОбнаруженияВидНаУзлеВДеревеПлана() Экспорт

	Поделка = ПоделкаОбнаружения("НаборСНевернымКлючомJSON");
	План    = Поделка.НайтиЖелудь("МенеджерТестирования").Обнаружить();

	Буфер = Новый ПотокВПамяти();

	ТестированиеСлужебный.НачатьПерехватВывода(Буфер);
	Поделка.НайтиЖелудь("РепортерЛогДерево").ВывестиТестПлан(План);
	ТестированиеСлужебный.ЗавершитьПерехватВывода();

	Вывод = ПрогоныТестов.ПрочитатьПоток(Буфер);

	// Причина выведена в строке самого шаблона, а не отдельным сообщением
	Для Каждого СтрокаВывода Из СтрРазделить(Вывод, Символы.ПС, Ложь) Цикл
		Если СтрНайти(СтрокаВывода, "ТестСНевернымКлючом") > 0 Тогда
			Ожидаем.Что(СтрНайти(СтрокаВывода, "НеТотПараметр"), СтрокаВывода).Больше(0);
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "В дереве плана нет строки шаблона: " + Вывод;

КонецПроцедуры

&Тест
Процедура СломанныйКонструкторПерваяПричинаШаблона() Экспорт

	// Выражение источника обращается к методу набора, а набор не создался:
	// причина - конструктор, ошибка выражения - ее следствие
	План  = ПланОбнаружения("НаборСоСломаннымКонструкторомИИсточникомВыражением");
	Набор = ПрогоныТестов.НайтиНабор(План, "НаборСоСломаннымКонструкторомИИсточникомВыражением");

	Ошибка = ПрогоныТестов.НайтиТест(Набор, "ТестСоЗначениямиНабора").ОшибкиОбнаружения().Получить(0);

	Ожидаем.Что(Ошибка.Описание).Равно("Не удаётся инстанцировать тестовый набор");
	Ожидаем.Что(СтрНайти(Ошибка.Причина.Описание, "Значения")).Больше(0);

КонецПроцедуры

&Тест
Процедура НеверноеОбъявлениеИзоляцииЛомаетНабор() Экспорт

	// Неизвестный уровень изоляции ломает набор целиком, а не обнаружение плана:
	// тесты такого набора не обнаруживаются, при исполнении набор сломан
	План  = ПланОбнаружения("НаборСНеизвестнымУровнемИзоляции");
	Набор = ПрогоныТестов.НайтиНабор(План, "НаборСНеизвестнымУровнемИзоляции");

	Ожидаем.Что(Набор.Дети()).ИмеетДлину(0);
	Ожидаем.Что(Набор.ОшибкиОбнаружения()).ИмеетДлину(1);
	Ожидаем.Что(СтрНайти(Набор.ОшибкиОбнаружения().Получить(0).Описание, "неизвестный уровень изоляции: Галактика"))
		.Больше(0);

	Прогон = ПрогоныТестов.ПрогнатьОднажды(
		"ПрогонНабораСНеизвестнымУровнемИзоляции",
		"НаборСНеизвестнымУровнемИзоляции",
		"",
		"./tests/fixtures/broken/НаборСНеизвестнымУровнемИзоляции.os"
	);

	Результат = Прогон.Статистика.Результат(ПрогоныТестов.НайтиНабор(Прогон.План, "НаборСНеизвестнымУровнемИзоляции"));

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Ожидаем.Что(СтрНайти(Результат.ОписанияПричин().Получить(0), "Галактика")).Больше(0);

КонецПроцедуры

Функция ПланОбнаружения(ИмяНабора)
	Возврат ПоделкаОбнаружения(ИмяНабора).НайтиЖелудь("МенеджерТестирования").Обнаружить();
КонецФункции

Функция ПоделкаОбнаружения(ИмяНабора)

	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.КаталогиТестов", "");
	Детальки.Вставить("OneUnit.ФайлыТестов", СтрШаблон("./tests/fixtures/broken/%1.os", ИмяНабора));
	Детальки.Вставить("OneUnit.ТестовыеНаборыВключаемые", ИмяНабора);

	Возврат ПрогоныТестов.СоздатьПоделку(Детальки);

КонецФункции
