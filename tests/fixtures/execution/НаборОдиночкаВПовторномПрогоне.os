// Набор-одиночка без поставщиков: экземпляр один на прогон, и повторный прогон
// той же поделки создает свой - состояние прошлого прогона в нем не остается

#Использовать "../../support"

Перем Отметка; // Строка - Состояние, которое тест оставляет в экземпляре

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
	ЖурналВыполнения.Записать("Конструктор одиночки");
КонецПроцедуры

&Тест
Процедура Тест() Экспорт
	ЖурналВыполнения.Записать("Состояние до теста: " + ?(Отметка = Неопределено, "чистое", Отметка));
	Отметка = "прошлый прогон";
КонецПроцедуры
