// Набор для проверки прерывания на первом падении: первый тест зелёный,
// второй падает, третий не должен исполняться вовсе. Журнал выполнения
// показывает и то, что после падения отработали ПослеКаждого и ПослеВсех.

#Использовать asserts
#Использовать "../../support"

&ПередВсеми
Процедура ПередВсеми() Экспорт
	ЖурналВыполнения.Очистить();
	ЖурналВыполнения.Записать("ПередВсеми");
КонецПроцедуры

&Тест
&Порядок(1)
Процедура Зеленый() Экспорт
	ЖурналВыполнения.Записать("Зеленый");
КонецПроцедуры

&Тест
&Порядок(2)
Процедура Падающий() Экспорт
	ЖурналВыполнения.Записать("Падающий");
	Ожидаем.Что(Ложь, "Падение намеренное").ЭтоИстина();
КонецПроцедуры

&Тест
&Порядок(3)
Процедура ПослеПадения() Экспорт
	ЖурналВыполнения.Записать("ПослеПадения");
КонецПроцедуры

&ПослеКаждого
