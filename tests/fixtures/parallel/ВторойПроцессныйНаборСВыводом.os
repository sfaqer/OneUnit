#Использовать "Модули"

&ТестовыйНабор
&Порядок(2)
&Изолированный(Уровень = "Процесс")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&Тест
Процедура ВторойМаркер() Экспорт

	ОтметкиПараллельности.ОтметитьНачало("B");

	Если ОтметкиПараллельности.ОжидаетсяПерекрытие() Тогда
		ОтметкиПараллельности.ЖдатьСигнал("A", 5000);
	КонецЕсли;

	Сообщить("ONEUNIT_PARALLEL_MARKER_B");
	ОтметкиПараллельности.ОтметитьКонец("B");

КонецПроцедуры
