// Отметки начала и конца набора вне потока вывода.
// Родительский тест читает их из каталога временных файлов и проверяет интервалы.
// Файл expect-overlap.flag включает рукопожатие: каждый из пары ждёт старт другого
// и падает по таймауту, если наборы не шли одновременно.

Функция КаталогОтметок() Экспорт
	Возврат ОбъединитьПути(КаталогВременныхФайлов(), "oneunit-parallel-marks");
КонецФункции

Процедура ОчиститьОтметки() Экспорт

	Каталог = КаталогОтметок();

	Если (Новый Файл(Каталог)).Существует() Тогда
		УдалитьФайлы(Каталог, "*.*");
	КонецЕсли;

КонецПроцедуры

Процедура ОжидатьПерекрытие() Экспорт

	СоздатьКаталог(КаталогОтметок());

	Запись = Новый ЗаписьТекста(ОбъединитьПути(КаталогОтметок(), "expect-overlap.flag"));
	Запись.Записать("1");
	Запись.Закрыть();

КонецПроцедуры

Функция ОжидаетсяПерекрытие() Экспорт
	Возврат (Новый Файл(ОбъединитьПути(КаталогОтметок(), "expect-overlap.flag"))).Существует();
КонецФункции

Процедура ОтметитьНачало(Знач Имя) Экспорт
	ЗаписатьОтметку(Имя + "-start", ТекущаяУниверсальнаяДатаВМиллисекундах());
КонецПроцедуры

Процедура ОтметитьКонец(Знач Имя) Экспорт
	ЗаписатьОтметку(Имя + "-end", ТекущаяУниверсальнаяДатаВМиллисекундах());
КонецПроцедуры

Функция ПрочитатьОтметку(Знач Имя) Экспорт

	Чтение = Новый ЧтениеТекста(ОбъединитьПути(КаталогОтметок(), Имя + ".txt"));
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат Число(СокрЛП(Текст));

КонецФункции

Процедура ЖдатьСигнал(Знач Имя, Знач ТаймаутМс) Экспорт

	Путь = ОбъединитьПути(КаталогОтметок(), Имя + "-start.txt");
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Пока Не (Новый Файл(Путь)).Существует() Цикл

		Если ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало > ТаймаутМс Тогда
			ВызватьИсключение СтрШаблон(
				"Нет сигнала %1 за %2 мс: процессные наборы не выполнялись одновременно",
				Имя,
				ТаймаутМс
			);
		КонецЕсли;

		Приостановить(20);

	КонецЦикла;

КонецПроцедуры

Процедура ЗаписатьОтметку(Знач Имя, Знач Момент)

	Каталог = КаталогОтметок();
	СоздатьКаталог(Каталог);

	Запись = Новый ЗаписьТекста(ОбъединитьПути(Каталог, Имя + ".txt"));
	Запись.Записать(Формат(Момент, "ЧГ=0"));
	Запись.Закрыть();

КонецПроцедуры
