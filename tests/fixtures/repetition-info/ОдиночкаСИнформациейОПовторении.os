#Использовать asserts
#Использовать collectionos
#Использовать "Поддержка"

Перем СохранённыеПовторения;

&ИнформацияОПовторении
Перем ПовторениеПоля;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()

	СохранённыеПовторения = Новый СписокМассив;
	Сообщить("SINGLE_CONSTRUCTOR");

КонецПроцедуры

&ПовторяемыйТест(3)
Процедура Повтор(&ИнформацияОПовторении Повторение) Экспорт

	Ожидаем.Что(СохранённыеПовторения.Количество()).Равно(Повторение.ТекущееПовторение() - 1);
	ЗаписиПовторений.Записать("Тест", Повторение);
	ЗаписиПовторений.Записать("ПолеТеста", ПовторениеПоля);
	СохранённыеПовторения.Добавить(ПовторениеПоля);

	Для Индекс = 0 По СохранённыеПовторения.ВГраница() Цикл

		Снимок = СохранённыеПовторения.Получить(Индекс);
		Ожидаем.Что(Снимок.ТекущееПовторение()).Равно(Индекс + 1);
		Ожидаем.Что(Снимок.ВсегоПовторений()).Равно(3);

	КонецЦикла;

КонецПроцедуры
