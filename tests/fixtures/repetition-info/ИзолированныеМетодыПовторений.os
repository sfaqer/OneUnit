#Использовать "Поддержка"

&ИнформацияОПовторении
Перем ПовторениеПоля;

&ТестовыйНабор
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым(&ИнформацияОПовторении Повторение = "Резерв") Экспорт

	ЗаписиПовторений.Записать("ПередКаждым", Повторение);
	ЗаписиПовторений.Записать("ПолеПередКаждым", ПовторениеПоля);

КонецПроцедуры

&Изолированный
&ПовторяемыйТест(2, Имя = "Вызов {ТекущееПовторение}")
Процедура Повтор(&ИнформацияОПовторении Повторение = "Резерв") Экспорт

	ЗаписиПовторений.Записать("Тест", Повторение);
	ЗаписиПовторений.Записать("ПолеТеста", ПовторениеПоля);

КонецПроцедуры

&Изолированный(Уровень = "Процесс")
&ПовторяемыйТест(2)
Процедура Единственное(&ИнформацияОПовторении Повторение) Экспорт

	ЗаписиПовторений.Записать("Тест", Повторение);
	ЗаписиПовторений.Записать("ПолеТеста", ПовторениеПоля);

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого(&ИнформацияОПовторении Повторение = "Резерв") Экспорт

	ЗаписиПовторений.Записать("ПослеКаждого", Повторение);
	ЗаписиПовторений.Записать("ПолеПослеКаждого", ПовторениеПоля);

КонецПроцедуры
