#Использовать asserts
#Использовать collectionos
#Использовать "Поддержка"

Перем Снимки;

&ИнформацияОПараметризованномВызове
Перем ИнформацияПоля;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()

	Снимки = Новый СписокМассив;
	Сообщить("INVOCATION_SINGLE_CONSTRUCTOR");

КонецПроцедуры

&ПараметризованныйТест(Имя = "Одинаковое имя")
&ИсточникЗначение(11)
&ИсточникЗначение(22)
&ИсточникЗначение(22)
Процедура Значения(Значение, &ИнформацияОПараметризованномВызове Информация) Экспорт

	Ожидаем.Что(Информация.НомерВызова()).Равно(Снимки.Количество() + 1);
	Ожидаем.Что(Информация.Аргументы().Получить(0)).Равно(Значение);
	Снимки.Добавить(ИнформацияПоля);

	Для Индекс = 0 По Снимки.ВГраница() Цикл

		Снимок = Снимки.Получить(Индекс);
		Ожидаем.Что(Снимок.НомерВызова()).Равно(Индекс + 1);
		Ожидаем.Что(Снимок.Аргументы().Получить(0)).Равно(?(Индекс = 0, 11, 22));

	КонецЦикла;

	ЗаписиПараметризованныхВызовов.Записать("Тест", Информация);
	ЗаписиПараметризованныхВызовов.Записать("ПолеТеста", ИнформацияПоля);

КонецПроцедуры
