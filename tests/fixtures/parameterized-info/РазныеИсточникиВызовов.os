&ТестовыйНабор
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПараметризованныйТест(Имя = "Одинаковое имя")
&ИсточникЗначение("Значение")
&ИсточникЗначение("Значение")
&ИсточникНеопределено
&ИсточникJSON("[{""Значение"":""JSON1""},{""Значение"":""JSON2""}]")
&ИсточникПеречисление("НаправлениеПоиска")
&ИсточникВыражение("() -> Списки.ИзЭлементов(Списки.ИзЭлементов(""Выражение"")).ПроцессорКоллекции()")
Процедура Значения(Значение, &ИнформацияОПараметризованномВызове Информация) Экспорт

	Ожидаем.Что(Информация.Аргументы().Количество()).Равно(1);
	Ожидаем.Что(Информация.Аргументы().Получить(0)).Равно(Значение);
	ЗаписиПараметризованныхВызовов.Записать("Тест", Информация);
	Сообщить("SOURCE_VALUE:" + Строка(Значение));

КонецПроцедуры
