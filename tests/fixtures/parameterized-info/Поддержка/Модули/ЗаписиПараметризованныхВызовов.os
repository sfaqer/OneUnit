#Использовать asserts

Процедура Записать(Знач Этап, Информация) Экспорт

	Ожидаем.Что(Информация).ИмеетТип("ИнформацияОПараметризованномВызове");
	Данные = Новый Структура(
		"phase, number, count, types",
		Этап,
		Информация.НомерВызова(),
		Информация.Аргументы().Количество(),
		Информация.Аргументы().ПроцессорКоллекции()
			.Обработать("Аргумент -> Строка(ТипЗнч(Аргумент))")
			.ВМассив()
	);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Данные);
	Сообщить("INVOCATION_INFO:" + Запись.Закрыть());

КонецПроцедуры
