#Использовать asserts
#Использовать collectionos
#Использовать "Поддержка"

&ИнформацияОПараметризованномВызове
Перем ИнформацияПоля;

&ТестовыйНабор
&Изолированный(Уровень = "Поделка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым(&ИнформацияОПараметризованномВызове Информация = "Резерв") Экспорт

	ЗаписиПараметризованныхВызовов.Записать("ПередКаждым", Информация);
	ЗаписиПараметризованныхВызовов.Записать("ПолеПередКаждым", ИнформацияПоля);

КонецПроцедуры

&ПараметризованныйТест(Имя = "Одинаковое имя")
&ИсточникЗначение(11, "Первый")
&ИсточникЗначение(22, "Второй")
Процедура Значения(Число, &ИнформацияОПараметризованномВызове Информация, Строка) Экспорт

	Ожидаем.Что(Информация.Аргументы().Количество()).Равно(2);
	Ожидаем.Что(Информация.Аргументы().Получить(0)).Равно(Число);
	Ожидаем.Что(Информация.Аргументы().Получить(1)).Равно(Строка);
	ЗаписатьИнформацию(Информация);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникВыражение(
	"() -> {
	|	Возврат Списки.ИзЭлементов(Списки.ИзЭлементов(
	|		Новый СписокМассив(Списки.ИзЭлементов(33)),
	|		Тип(""Строка""),
	|		Неопределено
	|	)).ПроцессорКоллекции();
	|}"
)
Процедура Объекты(
	Список,
	ТипАргумента,
	Пустое,
	&ИнформацияОПараметризованномВызове Информация = "Резерв") Экспорт

	Ожидаем.Что(Информация.Аргументы().Количество()).Равно(3);
	Ожидаем.Что(Информация.Аргументы().Получить(0)).Равно(Список);
	Ожидаем.Что(Информация.Аргументы().Получить(1)).Равно(ТипАргумента);
	Ожидаем.Что(ТипАргумента).Равно(Тип("Строка"));
	Ожидаем.Что(Информация.Аргументы().Получить(2)).ЭтоНеопределено();
	Ожидаем.Что(Пустое).ЭтоНеопределено();
	Список.Добавить(44);
	Ожидаем.Что(Информация.Аргументы().Получить(0).Количество()).Равно(2);
	ЗаписатьИнформацию(Информация);

КонецПроцедуры

&ПараметризованныйТест(Имя = "Без аргументов")
&ИсточникВыражение("() -> Списки.ИзЭлементов(Списки.ИзЭлементов()).ПроцессорКоллекции()")
Процедура БезАргументов(&ИнформацияОПараметризованномВызове Информация) Экспорт

	Ожидаем.Что(Информация.Аргументы().Пусто()).ЭтоИстина();
	ЗаписатьИнформацию(Информация);

КонецПроцедуры

&ПараметризованныйТест(Имя = "Значения по умолчанию")
&ИсточникЗначение(11)
Процедура Умолчания(Первый, Второй = 99, &ИнформацияОПараметризованномВызове Информация = "Резерв") Экспорт

	Ожидаем.Что(Второй).Равно(99);
	Ожидаем.Что(Информация.Аргументы().Количество()).Равно(1);
	Ожидаем.Что(Информация.Аргументы().Получить(0)).Равно(Первый);
	ЗаписатьИнформацию(Информация);

КонецПроцедуры

&ПараметризованныйТест(Имя = "Одинаковое имя")
&ИсточникВыражение(
	"() -> {
	|	Аргументы = Списки.ИзЭлементов(55);
	|	Возврат Списки.ИзЭлементов(Аргументы, Аргументы).ПроцессорКоллекции();
	|}"
)
Процедура ОдинаковыеАргументы(Значение, &ИнформацияОПараметризованномВызове Информация) Экспорт

	Ожидаем.Что(Значение).Равно(55);
	Ожидаем.Что(Информация.Аргументы().Количество()).Равно(1);
	Ожидаем.Что(Информация.Аргументы().Получить(0)).Равно(Значение);
	ЗаписатьИнформацию(Информация);

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого(&ИнформацияОПараметризованномВызове Информация = "Резерв") Экспорт

	ЗаписиПараметризованныхВызовов.Записать("ПослеКаждого", Информация);
	ЗаписиПараметризованныхВызовов.Записать("ПолеПослеКаждого", ИнформацияПоля);

КонецПроцедуры

Процедура ЗаписатьИнформацию(Информация)

	ЗаписиПараметризованныхВызовов.Записать("Тест", Информация);
	ЗаписиПараметризованныхВызовов.Записать("ПолеТеста", ИнформацияПоля);

КонецПроцедуры
