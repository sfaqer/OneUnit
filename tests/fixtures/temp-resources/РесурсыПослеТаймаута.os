#Использовать fs
#Использовать "Поддержка"

&ВременныйКаталог
Перем Каталог;

&ТестовыйНабор
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&Тест
&Порядок(1)
&Таймаут(100)
Процедура ДержитФайл() Экспорт

	ЗаписиВременныхРесурсов.Записать("Таймаут", "Каталог", Каталог, Истина);
	Запись = Новый ЗаписьТекста(ФС.ОбъединитьПути(Каталог, "занят.txt"), КодировкаТекста.UTF8NoBOM);
	Запись.Записать("Данные");
	Приостановить(500);
	Запись.Закрыть();

КонецПроцедуры

&Тест
&Порядок(2)
&Таймаут(100)
Процедура ВосстанавливаетКаталог() Экспорт

	ЗаписиВременныхРесурсов.Записать("Таймаут", "ВосстановленныйКаталог", Каталог, Истина);
	Путь = Каталог;
	УдалитьФайлы(Путь);
	Приостановить(500);
	ФС.ОбеспечитьКаталог(Путь);
	ЗаписиВременныхРесурсов.Наполнить(Путь, Истина);

КонецПроцедуры

&Тест
&Порядок(3)
Процедура ЖдётФоновыйМетод() Экспорт
	Приостановить(1000);
КонецПроцедуры
