&ВременныйКаталог
Перем Каталог;

&ТестовыйНабор
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередВсеми
Процедура НачатьПроверку() Экспорт
	СинхронизацияТаймаутов.Начать();
КонецПроцедуры

&Тест
&Порядок(1)
&Таймаут(1000)
Процедура ДержитФайл() Экспорт

	СинхронизацияТаймаутов.Зарегистрировать("Файл", Каталог);
	Запись = Новый ЗаписьТекста(ОбъединитьПути(Каталог, "занят.txt"), КодировкаТекста.UTF8NoBOM);

	Попытка

		Запись.Записать("Данные");
		ЗаписиВременныхРесурсов.Записать("ФайлОткрыт", "Каталог", Каталог, Истина);
		СинхронизацияТаймаутов.ДождатьсяРазрешения();

	Исключение

		Запись.Закрыть();
		ВызватьИсключение;

	КонецПопытки;

	Запись.Закрыть();

КонецПроцедуры

&Тест
&Порядок(2)
&Таймаут(1000)
Процедура ВосстанавливаетКаталог() Экспорт

	Путь = Каталог;
	СинхронизацияТаймаутов.Зарегистрировать("Каталог", Путь);
	ЗаписиВременныхРесурсов.Записать("ОжидаетВосстановления", "ВосстановленныйКаталог", Путь, Истина);
	УдалитьФайлы(Путь);
	СинхронизацияТаймаутов.ДождатьсяРазрешения();
	ФС.ОбеспечитьКаталог(Путь);
	ЗаписиВременныхРесурсов.Наполнить(Путь, Истина);

КонецПроцедуры

&Тест
&Порядок(3)
Процедура ЖдётФоновыйМетод() Экспорт

	СинхронизацияТаймаутов.ЗавершитьФоновыеМетоды();
	Путь = СинхронизацияТаймаутов.ПутьВосстановленногоКаталога();
	Ожидаем.Что(ФС.ФайлСуществует(ОбъединитьПути(Путь, "данные.txt"))).ЭтоИстина();
	ЗаписиВременныхРесурсов.Записать("Восстановлен", "Каталог", Путь, Истина);
	Сообщить("TEMP_BACKGROUND_TASKS_COMPLETED");

КонецПроцедуры
