#Использовать asserts
#Использовать "Поддержка"

&ВременныйКаталог
Перем КаталогТеста;

&ВременныйФайл(Расширение = "json")
Перем ФайлТеста;

&ВременныйКаталог(Область = "Набор")
Перем КаталогНабора;

Перем КаталогКонструктора;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта(&ВременныйКаталог Каталог, &ИнформацияОТесте Информация)

	КаталогКонструктора = Каталог;
	ЗаписиВременныхРесурсов.Записать("Конструктор", Информация.ОтображаемоеИмя(), Каталог, Истина);

КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми(&ВременныйФайл Файл) Экспорт

	ЗаписиВременныхРесурсов.Записать("ПередВсеми", "Параметр", Файл, Ложь);
	ЗаписатьПоля("ПередВсеми");
	ЗаписиВременныхРесурсов.Наполнить(КаталогНабора, Истина);

КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым(&ВременныйКаталог Каталог) Экспорт

	ЗаписиВременныхРесурсов.Записать("ПередКаждым", "Параметр", Каталог, Истина);
	ЗаписатьПоля("ПередКаждым");
	Ожидаем.Что(Новый Файл(ФайлТеста).Размер()).Равно(0);

КонецПроцедуры

&Тест
&Порядок(1)
Процедура Первый(&ВременныйФайл(Расширение = "log") Файл) Экспорт

	ЗаписиВременныхРесурсов.Записать("Тест", "Параметр", Файл, Ложь);
	ЗаписатьПоля("Тест");
	ЗаписиВременныхРесурсов.Наполнить(КаталогТеста, Истина);
	ЗаписиВременныхРесурсов.Наполнить(ФайлТеста, Ложь);

КонецПроцедуры

&Тест
&Порядок(2)
Процедура Второй(&ВременныйФайл(Расширение = "log") Файл) Экспорт

	ЗаписиВременныхРесурсов.Записать("Тест", "Параметр", Файл, Ложь);
	ЗаписатьПоля("Тест");

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого(&ВременныйФайл Файл) Экспорт

	ЗаписиВременныхРесурсов.Записать("ПослеКаждого", "Параметр", Файл, Ложь);
	ЗаписатьПоля("ПослеКаждого");

КонецПроцедуры

&ПослеВсех
Процедура ПослеВсех(&ВременныйКаталог Каталог) Экспорт

	ЗаписиВременныхРесурсов.Записать("ПослеВсех", "Параметр", Каталог, Истина);
	ЗаписатьПоля("ПослеВсех");

КонецПроцедуры

Процедура ЗаписатьПоля(Знач Этап)

	ЗаписиВременныхРесурсов.Записать(Этап, "КаталогТеста", КаталогТеста, Истина);
	ЗаписиВременныхРесурсов.Записать(Этап, "ФайлТеста", ФайлТеста, Ложь);
	ЗаписиВременныхРесурсов.Записать(Этап, "КаталогНабора", КаталогНабора, Истина);
	ЗаписиВременныхРесурсов.Записать(Этап, "КаталогКонструктора", КаталогКонструктора, Истина);

КонецПроцедуры
