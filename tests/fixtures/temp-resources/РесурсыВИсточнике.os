#Использовать asserts
#Использовать collectionos
#Использовать "Поддержка"

Перем КаталогКонструктора;

&ВременныйФайл
Перем ФайлПоля;

&ТестовыйНабор
Процедура ПриСозданииОбъекта(&ВременныйКаталог Каталог)

	КаталогКонструктора = Каталог;

	Если Каталог = Неопределено Тогда
		Сообщить("RESOURCE_DISCOVERY_UNDEFINED");
	Иначе
		ЗаписиВременныхРесурсов.Записать("Конструктор", "Каталог", Каталог, Истина);
	КонецЕсли;

КонецПроцедуры

&ПараметризованныйТест
&ИсточникВыражение("() -> Данные()")
Процедура Значения(Значение, &ВременныйФайл Файл) Экспорт

	Ожидаем.Что(Значение).Равно(11);
	ЗаписиВременныхРесурсов.Записать("Тест", "Параметр", Файл, Ложь);
	ЗаписиВременныхРесурсов.Записать("Тест", "Поле", ФайлПоля, Ложь);
	ЗаписиВременныхРесурсов.Записать("Тест", "Конструктор", КаталогКонструктора, Истина);

КонецПроцедуры

Функция Данные() Экспорт

	Ожидаем.Что(КаталогКонструктора).ЭтоНеопределено();
	Ожидаем.Что(ФайлПоля).ЭтоНеопределено();
	Возврат ПроцессорыКоллекций.ИзНабора(Списки.ИзЭлементов(11));

КонецФункции
