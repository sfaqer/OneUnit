#Использовать "Поддержка"

&ВременныйКаталог(Область = "Набор")
Перем КаталогНабора;

&ТестовыйНабор
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&Тест
&Изолированный
Процедура Поделочный(&ВременныйКаталог Каталог, &ВременныйФайл Файл) Экспорт

	ЗаписиВременныхРесурсов.Записать("Тест", "Каталог", Каталог, Истина);
	ЗаписиВременныхРесурсов.Записать("Тест", "Файл", Файл, Ложь);
	ЗаписиВременныхРесурсов.Записать("Тест", "КаталогНабора", КаталогНабора, Истина);

КонецПроцедуры

&Тест
&Изолированный(Уровень = "Процесс")
Процедура Процессный(&ВременныйКаталог Каталог, &ВременныйФайл Файл) Экспорт

	ЗаписиВременныхРесурсов.Записать("Тест", "Каталог", Каталог, Истина);
	ЗаписиВременныхРесурсов.Записать("Тест", "Файл", Файл, Ложь);
	ЗаписиВременныхРесурсов.Записать("Тест", "КаталогНабора", КаталогНабора, Истина);

КонецПроцедуры
