#Использовать "Поддержка"

&ТестовыйНабор
&Изолированный(Уровень = "Процесс")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&Тест
Процедура Тест(
	&ВременныйКаталог(Очистка = "Никогда") Каталог,
	&ВременныйФайл(Очистка = "Никогда") Файл) Экспорт

	ЗаписиВременныхРесурсов.Наполнить(Каталог, Истина);
	ЗаписиВременныхРесурсов.Наполнить(Файл, Ложь);
	ЗаписиВременныхРесурсов.Записать("Тест", "Каталог", Каталог, Истина);
	ЗаписиВременныхРесурсов.Записать("Тест", "Файл", Файл, Ложь);

КонецПроцедуры
