&Тест
Процедура ПустыеНикогда(
	&ВременныйКаталог(Очистка = "Никогда") Каталог,
	&ВременныйФайл(Очистка = "Никогда") Файл) Экспорт

	ЗаписиВременныхРесурсов.Записать("ПустыеНикогда", "Каталог", Каталог, Истина);
	ЗаписиВременныхРесурсов.Записать("ПустыеНикогда", "Файл", Файл, Ложь);

КонецПроцедуры

&Тест
Процедура ТолькоЧтение(&ВременныйКаталог Каталог, &ВременныйФайл Файл) Экспорт

	Подготовить("ТолькоЧтение", Каталог, Файл);
	ОбъектФайла = Новый Файл(Файл);
	ОбъектФайла.УстановитьТолькоЧтение(Истина);
	ОбъектФайла = Новый Файл(ФС.ОбъединитьПути(Каталог, "данные.txt"));
	ОбъектФайла.УстановитьТолькоЧтение(Истина);

КонецПроцедуры

Процедура Подготовить(Знач Этап, Знач Каталог, Знач Файл)

	ЗаписиВременныхРесурсов.Наполнить(Каталог, Истина);
	ЗаписиВременныхРесурсов.Наполнить(Файл, Ложь);
	ЗаписиВременныхРесурсов.Записать(Этап, "Каталог", Каталог, Истина);
	ЗаписиВременныхРесурсов.Записать(Этап, "Файл", Файл, Ложь);

КонецПроцедуры
