#Использовать "Поддержка"

Перем КаталогКонструктора;

&ТестовыйНабор
Процедура ПриСозданииОбъекта(&ВременныйКаталог(Область = "Набор") Каталог)
	КаталогКонструктора = Каталог;
КонецПроцедуры

&ПовторяемыйТест(2)
Процедура Повтор(&ВременныйФайл(Область = "Набор") Файл) Экспорт

	ЗаписиВременныхРесурсов.Записать("Тест", "КаталогКонструктора", КаталогКонструктора, Истина);
	ЗаписиВременныхРесурсов.Записать("Тест", "ПараметрНабора", Файл, Ложь);

КонецПроцедуры
