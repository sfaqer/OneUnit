// Ресурсы вложенных прогонов сохраняются до завершения всех проверок временных ресурсов.
// Состояние общее для экземпляров тестового набора.

#Использовать collectionos
#Использовать tempfiles
#Использовать fs

Перем Пути;
Перем Отчёты;

Процедура Учесть(Знач Путь) Экспорт

	Корень = ФС.НормализоватьПуть(ФС.ОбъединитьПути(КаталогВременныхФайлов(), "oneunit"));
	ПолныйПуть = ФС.НормализоватьПуть(Путь);

	Если Не СтрНачинаетсяС(СтрЗаменить(ПолныйПуть, "\", "/"), СтрЗаменить(Корень, "\", "/") + "/") Тогда
		ВызватьИсключение "Проверка ресурсов получила путь вне временного каталога OneUnit";
	КонецЕсли;

	Пути.Добавить(ПолныйПуть);

КонецПроцедуры

Функция ПутьОтчёта(Знач Расширение) Экспорт
	Возврат Отчёты.НовоеИмяФайла(Расширение);
КонецФункции

Процедура Удалить() Экспорт

	Для Каждого Путь Из Пути Цикл

		Если ФС.Существует(Путь) Тогда
			УдалитьФайлы(Путь);
		КонецЕсли;

	КонецЦикла;

	Пути.Очистить();
	Отчёты.Удалить();

КонецПроцедуры

Пути = Новый МножествоСоответствие;
Отчёты = Новый МенеджерВременныхФайлов;
