#Использовать asserts
#Использовать fs

Процедура Записать(Знач Этап, Знач Имя, Знач Путь, Знач ЭтоКаталог) Экспорт

	Ожидаем.Что(Путь).ИмеетТип("Строка");
	Ожидаем.Что(ФС.Существует(Путь)).ЭтоИстина();
	Ожидаем.Что(ФС.КаталогСуществует(Путь)).Равно(ЭтоКаталог);
	Данные = Новый Структура("phase, name, path, directory", Этап, Имя, Путь, ЭтоКаталог);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Данные);
	Сообщить("TEMP_RESOURCE:" + Запись.Закрыть());

КонецПроцедуры

Процедура СохранитьПутиПервогоТеста(Знач КаталогНабора, Пути) Экспорт

	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ОбъединитьПути(КаталогНабора, "пути-первого-теста.json"));
	ЗаписатьJSON(Запись, Пути.ВМассив());
	Запись.Закрыть();

КонецПроцедуры

Процедура ПроверитьУдалениеПервогоТеста(Знач КаталогНабора, Знач ОжидаемоеКоличество) Экспорт

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ОбъединитьПути(КаталогНабора, "пути-первого-теста.json"));
	Пути = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Ожидаем.Что(Пути.Количество()).Равно(ОжидаемоеКоличество);

	Для Каждого Путь Из Пути Цикл
		Ожидаем.Что(ФС.Существует(Путь), Путь).ЭтоЛожь();
	КонецЦикла;

	Сообщить("TEMP_TEST_SCOPE_CLEANED_BEFORE_SECOND");

КонецПроцедуры

Процедура Наполнить(Знач Путь, Знач ЭтоКаталог) Экспорт

	ИмяФайла = ?(ЭтоКаталог, ОбъединитьПути(Путь, "данные.txt"), Путь);
	Запись = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8NoBOM);
	Запись.Записать("Данные теста");
	Запись.Закрыть();

КонецПроцедуры
