#Использовать "Поддержка"

&ВременныйКаталог(Область = "Набор", Очистка = "ПриУспехе")
Перем Каталог;

&ТестовыйНабор
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&Тест
&Порядок(1)
Процедура Первый() Экспорт

	ЗаписиВременныхРесурсов.Наполнить(Каталог, Истина);
	ЗаписиВременныхРесурсов.Записать("Тест", "Каталог", Каталог, Истина);
	ВызватьИсключение "Падение первого теста";

КонецПроцедуры

&Тест
&Порядок(2)
Процедура Второй() Экспорт
	ЗаписиВременныхРесурсов.Записать("Тест", "Каталог", Каталог, Истина);
КонецПроцедуры
