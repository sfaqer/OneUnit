// Изолированные тесты с битой лямбдой совета. Условия изолированного теста сначала
// проверяются в родителе на экземпляре набора: выключенный тест пропускается,
// не поднимая изолированную среду, и совет не исполняется - будь условие константой,
// проверкой версии OneScript или методом набора. Тест, которого условия в родителе
// не выключили, и тест с условием, которое в родителе не решить, среду поднимают
// и ломаются на совете. Конструктор пишет в консоль: вывод экземпляра, созданного
// для проверки в родителе, не теряется

&Тест
&Изолированный(Совет = "() -> СоветаНет()")
&Выключен("Выключен безусловно")
Процедура ПоделочныйВыключен() Экспорт
КонецПроцедуры

&Тест
&Изолированный(Уровень = "Процесс", Совет = "() -> СоветаНет()")
&Выключен("Выключен безусловно")
Процедура ПроцессныйВыключен() Экспорт
КонецПроцедуры

&Тест
&Изолированный(Уровень = "Процесс", Совет = "() -> СоветаНет()")
&ВключенДляOneScript("<1", Причина = "Выключен для версии OneScript")
Процедура ПроцессныйВыключенПоВерсии() Экспорт
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(1)
&Изолированный(Уровень = "Процесс", Совет = "() -> СоветаНет()")
&Выключен("Шаблон выключен безусловно")
Процедура ПроцессныйШаблонВыключен(Значение) Экспорт
КонецПроцедуры

&Тест
&Изолированный(Уровень = "Процесс", Совет = "() -> СоветаНет()")
&ВключенЕсли("() -> ЗапускатьТест()", Причина = "Выключен методом набора")
Процедура ПроцессныйВыключенМетодомНабора() Экспорт
КонецПроцедуры

&Тест
&Изолированный(Уровень = "Процесс", Совет = "() -> СоветаНет()")
&ВыключенЕсли("() -> Ложь")
Процедура ПроцессныйВключенВРодителе() Экспорт
КонецПроцедуры

&Тест
&Изолированный(Совет = "() -> СоветаНет()")
&ВыключенЕсли("() -> Новый ТипКоторогоНетВРодителе()", Причина = "Выключен в среде")
Процедура ПоделочныйСУсловиемДляСреды() Экспорт
КонецПроцедуры

&Тест
&Изолированный(Совет = "() -> СоветаНет()")
&ВыключенЕсли("() -> Новый ТипКоторогоНетВРодителе()", Причина = "Выключен в среде")
&ВключенЕсли("() -> Ложь", Причина = "Выключен после условия для среды")
Процедура ПоделочныйВыключенПослеУсловияДляСреды() Экспорт
КонецПроцедуры

Функция ЗапускатьТест() Экспорт
	Возврат Ложь;
КонецФункции

&ТестовыйНабор
Процедура ПриСозданииОбъекта()
	Сообщить("ВыводЭкземпляраВРодителе");
КонецПроцедуры
