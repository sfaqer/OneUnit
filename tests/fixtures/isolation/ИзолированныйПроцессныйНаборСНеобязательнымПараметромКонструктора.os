// Процессный набор, у конструктора которого все параметры необязательные: точка
// входа создает такой набор напрямую через Новый, и лямбда совета строит совет
// методом набора

#Использовать asserts

&Деталька("Изоляция.Значение", ЗначениеПоУмолчанию = "не-задано")
Перем Значение;

&ТестовыйНабор
&Изолированный(Уровень = "Процесс", Совет = "() -> СоветИзМетода()")
Процедура ПриСозданииОбъекта(&Деталька("Изоляция.Префикс", ЗначениеПоУмолчанию = "") Префикс = "")
КонецПроцедуры

Функция СоветИзМетода() Экспорт

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("Изоляция.Значение", "из-метода-набора");

	Совет = Новый СоветДругогоМастера();
	Совет.ПолучитьСтроительМенеджераПараметров().ДобавитьПровайдерСоответствие(ЗначенияДеталек);

	Возврат Совет;

КонецФункции

&Тест
Процедура ЗначениеПриходитИзМетодаНабора() Экспорт
	Ожидаем.Что(Значение).Равно("из-метода-набора");
КонецПроцедуры
