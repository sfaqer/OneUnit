&Тест
&Тег("ФильтрыСовета")
&Изолированный(Совет = "() -> ГенераторИзоляции.СоветСФильтрами()")
Процедура НевидимыйТест() Экспорт
	Ожидаем.Что(Истина).ЭтоИстина();
КонецПроцедуры

&Тест
&Тег("ФильтрыСовета")
&Изолированный(Уровень = "Процесс", Совет = "() -> ГенераторИзоляции.СоветСФильтрами()")
Процедура ПроцессныйТест() Экспорт
	Ожидаем.Что(Истина).ЭтоИстина();
КонецПроцедуры

