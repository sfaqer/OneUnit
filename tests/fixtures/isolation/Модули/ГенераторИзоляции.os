#Использовать autumn
#Использовать collectionos

// Возвращает совет создания поделки с заданной деталькой - имитация фабрики
// конфигураций из тестов, которым нужна собственная поделка (как ГенераторДанных
// в autumn-data)
//
//  Возвращаемое значение:
//   СоветДругогоМастера - Совет со значением детальки "Изоляция.Значение"
//
Функция СоветСоЗначением() Экспорт

	Возврат СоветСДеталькой("Изоляция", Новый Соответствие(Соответствия.ИзЭлементов("Значение", "из-совета")));

КонецФункции

// Возвращает совет со значением детальки, заданным устаревшим API autumn
// СоветДругогоМастера.ЗначенияДеталек - советы, написанные до autumn 5,
// продолжают работать
//
//  Возвращаемое значение:
//   СоветДругогоМастера - Совет со значением детальки "Изоляция.Значение"
//
Функция СоветСУстаревшимиЗначениямиДеталек() Экспорт

	Возврат Новый СоветДругогоМастера().ЗначенияДеталек(
		Новый Соответствие(Соответствия.ИзЭлементов("Изоляция.Значение", "из-устаревшего-совета"))
	);

КонецФункции

// Возвращает совет, подменяющий детальку фильтра наборов, - с ним дочерний
// прогон не обнаруживает ни одного набора
//
//  Возвращаемое значение:
//   СоветДругогоМастера - Совет с фильтром, не пропускающим ни один набор
//
Функция СоветНеВидящийНаборы() Экспорт

	Возврат СоветСДеталькой("OneUnit.ТестовыеНаборыВключаемые", "НетТакогоНабора");

КонецФункции

// Возвращает совет, подменяющий детальки прогона в обеих формах настроек:
// секцией OneUnit, как в autumn-properties.json проекта, - файлы тестов,
// плоским ключом, как переменная среды OneUnit_Имя, - фильтр тестов. Секция
// добавляет и собственную детальку. Детальки изолированного прогона должны
// перекрыть подмену, не потеряв остального
//
//  Возвращаемое значение:
//   СоветДругогоМастера - Совет с настройками OneUnit с приоритетом файла настроек
//
Функция СоветСНастройкамиOneUnit() Экспорт

	СекцияOneUnit = Новый Соответствие();
	СекцияOneUnit.Вставить("ФайлыТестов", "./tests/НетТакогоНабора.os");
	СекцияOneUnit.Вставить("ЗначениеИзСекции", "из-секции");

	Настройки = Новый Соответствие();
	Настройки.Вставить("OneUnit", СекцияOneUnit);
	Настройки.Вставить("OneUnit.ТестовыеМетодыВключаемые", "НетТакогоТеста");

	Совет = Новый СоветДругогоМастера();
	Совет.ПолучитьСтроительМенеджераПараметров().ДобавитьПровайдерСоответствие(Настройки, 2, "проект");

	Возврат Совет;

КонецФункции

// Возвращает совет со значением детальки - объектом: лямбда совета исполняется
// в среде изолированного прогона, поэтому объекты в детальках допустимы
// на любом уровне изоляции
//
//  Возвращаемое значение:
//   СоветДругогоМастера - Совет со значением-объектом
//
Функция СоветСОбъектом() Экспорт

	Возврат СоветСДеталькой("Изоляция.Объект", Новый СписокМассив);

КонецФункции

Функция СоветСДеталькой(Знач Имя, Знач Значение)

	Совет = Новый СоветДругогоМастера();
	Совет.ПолучитьСтроительМенеджераПараметров().ДобавитьПровайдерСоответствие(
		Новый Соответствие(Соответствия.ИзЭлементов(Имя, Значение))
	);

	Возврат Совет;

КонецФункции
