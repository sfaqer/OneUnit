#Использовать asserts
#Использовать autumn
#Использовать "../resolvers/Поставщики"

&Деталька("OneUnit.ВыполняетсяВИзоляции", ЗначениеПоУмолчанию = Ложь)
Перем ВСреде;

&Деталька("СохранениеРезультатов.Режим", ЗначениеПоУмолчанию = "Успех")
Перем Режим;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
	Сообщить("Вывод конструктора окружения");
КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми(&ЗначениеПоставщика("Контекст") Контекст) Экспорт

	Сообщить("Вывод ПередВсеми окружения");

	Если ВСреде И Режим = "Закрытие" Тогда
		Контекст.ПриЗакрытии(Новый Действие(ЭтотОбъект, "ЗакрытьОкружение"));
	КонецЕсли;

КонецПроцедуры

&ПослеВсех
Процедура ПослеВсех() Экспорт

	Сообщить("Вывод ПослеВсех окружения");

	Если ВСреде И Режим = "ПослеВсех" Тогда

		Попытка
			ВызватьИсключение "Вложенная причина окружения";
		Исключение
			ВызватьИсключение Новый ИнформацияОбОшибке("Ошибка ПослеВсех окружения", Неопределено, ИнформацияОбОшибке());
		КонецПопытки;

	КонецЕсли;

КонецПроцедуры

Процедура ЗакрытьОкружение(Контекст) Экспорт // BSLLS:UnusedParameters-off

	Сообщить("Вывод закрытия окружения");

	Попытка
		ВызватьИсключение "Вложенная причина окружения";
	Исключение
		ВызватьИсключение Новый ИнформацияОбОшибке("Ошибка закрытия окружения", Неопределено, ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

&Тест
&Изолированный(Совет = "() -> СоветСРежимом(""ПослеВсех"")")
Процедура ПадающийПоделочный() Экспорт
	ПадающийВызов();
КонецПроцедуры

&Тест
&Изолированный(Уровень = "Процесс", Совет = "() -> СоветСРежимом(""ПослеВсех"")")
Процедура ПадающийПроцессный() Экспорт
	ПадающийВызов();
КонецПроцедуры

&Тест
&Изолированный(Совет = "() -> СоветСРежимом(""Закрытие"")")
Процедура ПадающийСЗакрытиемПоделочный() Экспорт
	ПадающийВызов();
КонецПроцедуры

&Тест
&Изолированный(Уровень = "Процесс", Совет = "() -> СоветСРежимом(""Закрытие"")")
Процедура ПадающийСЗакрытиемПроцессный() Экспорт
	ПадающийВызов();
КонецПроцедуры

&Тест
&Изолированный
Процедура УспешныйПоделочный() Экспорт
	Сообщить("Вывод успешного изолированного теста");
КонецПроцедуры

&Тест
&Изолированный(Уровень = "Процесс")
Процедура УспешныйПроцессный() Экспорт
	Сообщить("Вывод успешного изолированного теста");
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(1)
&ИсточникЗначение(2)
&ВключенЕсли("() -> УсловиеКонтейнера()")
&Изолированный(Совет = "() -> СоветСРежимом(""ПослеВсех"")")
Процедура ШаблонПоделочный(Номер) Экспорт
	Итерация(Номер);
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(1)
&ИсточникЗначение(2)
&ВключенЕсли("() -> УсловиеКонтейнера()")
&Изолированный(Уровень = "Процесс", Совет = "() -> СоветСРежимом(""ПослеВсех"")")
Процедура ШаблонПроцессный(Номер) Экспорт
	Итерация(Номер);
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(1)
&ИсточникЗначение(2)
&ВключенЕсли("() -> УсловиеКонтейнера()")
&Изолированный
Процедура УспешныйШаблонПоделочный(Номер) Экспорт
	Итерация(Номер);
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(1)
&ИсточникЗначение(2)
&ВключенЕсли("() -> УсловиеКонтейнера()")
&Изолированный(Уровень = "Процесс")
Процедура УспешныйШаблонПроцессный(Номер) Экспорт
	Итерация(Номер);
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(1)
&ИсточникЗначение(2)
&ВключенЕсли("() -> ТолькоВРодителе()")
&Изолированный
Процедура ПропущенныйШаблонПоделочный(Номер) Экспорт
	Итерация(Номер);
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(1)
&ИсточникЗначение(2)
&ВключенЕсли("() -> ТолькоВРодителе()")
&Изолированный(Уровень = "Процесс")
Процедура ПропущенныйШаблонПроцессный(Номер) Экспорт
	Итерация(Номер);
КонецПроцедуры

Функция ТолькоВРодителе() Экспорт
	Возврат Не ВСреде;
КонецФункции

Процедура ПадающийВызов() Экспорт

	Сообщить("Вывод падающего изолированного теста");
	Ожидаем.Что(Ложь, "Ошибка изолированного теста").ЭтоИстина();

КонецПроцедуры

Процедура Итерация(Номер) Экспорт

	Сообщить("Вывод изолированной итерации " + Номер);
	Ожидаем.Что(Номер, "Ошибка изолированной итерации").Равно(2);

КонецПроцедуры

Функция УсловиеКонтейнера() Экспорт

	Сообщить("Вывод условия контейнера " + ?(ВСреде, "в среде", "в родителе"));
	Возврат Истина;

КонецФункции

Функция СоветСРежимом(Знач РежимОшибки) Экспорт

	Совет = Новый СоветДругогоМастера;
	Детальки = Новый Соответствие;
	Детальки.Вставить("СохранениеРезультатов.Режим", РежимОшибки);
	Совет.ПолучитьСтроительМенеджераПараметров().ДобавитьПровайдерСоответствие(Детальки);
	Возврат Совет;

КонецФункции
