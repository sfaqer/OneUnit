#Использовать asserts
#Использовать autumn
#Использовать "../resolvers/Поставщики"

Перем Режим;

&ТестовыйНабор(Характер = "Одиночка")
&Изолированный(Уровень = "Поделка")
Процедура ПриСозданииОбъекта(&Деталька("JUnit.Сбой", ЗначениеПоУмолчанию = "Конструктор") ТочкаСбоя)

	Режим = ТочкаСбоя;
	Сообщить("Вывод конструктора <&>");

	Если Режим = "Конструктор" Тогда
		ВложеннаяОшибка("Ошибка конструктора <&>");
	КонецЕсли;

КонецПроцедуры

&ПередВсеми
Процедура Подготовить(&ЗначениеПоставщика("Контекст") Контекст) Экспорт

	Сообщить("Вывод ПередВсеми <&>");

	Если Режим = "ПередВсеми" Тогда
		ВложеннаяОшибка("Ошибка ПередВсеми <&>");
	КонецЕсли;

	Если Режим = "ПередВсемиУтверждение" Тогда
		Ожидаем.Что(Ложь, "Утверждение ПередВсеми <&>").ЭтоИстина();
	КонецЕсли;

	Если Режим = "Закрытие" Тогда
		Контекст.ПриЗакрытии(Новый Действие(ЭтотОбъект, "Закрыть"));
	КонецЕсли;

КонецПроцедуры

&Тест
&ВключенЕсли("() -> ДопуститьТест()")
Процедура Проверка() Экспорт

	Сообщить("Вывод теста <&>");

	Если Режим = "ОшибкаТеста" Тогда
		Ожидаем.Что(Ложь, "Ошибка только дочернего теста").ЭтоИстина();
	КонецЕсли;

	Если Режим = "ПрерываниеТеста" Тогда
		Предполагаем.ЧтоИстинно(Ложь, "Предположение дочернего теста");
	КонецЕсли;

КонецПроцедуры

Функция ДопуститьТест() Экспорт
	Возврат Режим <> "ПропускТеста";
КонецФункции

&ПослеВсех
Процедура Завершить() Экспорт

	Сообщить("Вывод ПослеВсех <&>");

	Если Режим = "ПослеВсех" Тогда
		ВложеннаяОшибка("Ошибка ПослеВсех <&>");
	КонецЕсли;

	Если Режим = "ПослеВсехУтверждение" Тогда
		Ожидаем.Что(Ложь, "Утверждение ПослеВсех <&>").ЭтоИстина();
	КонецЕсли;

КонецПроцедуры

Процедура Закрыть(Контекст) Экспорт // BSLLS:UnusedParameters-off

	Сообщить("Вывод закрытия <&>");
	ВложеннаяОшибка("Ошибка закрытия <&>");

КонецПроцедуры

Процедура ВложеннаяОшибка(Знач Сообщение)

	Попытка
		ВызватьИсключение "Вложенная причина <&>";
	Исключение
		ВызватьИсключение Новый ИнформацияОбОшибке(Сообщение, Неопределено, ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры
