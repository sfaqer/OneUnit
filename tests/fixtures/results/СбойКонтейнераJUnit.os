#Использовать autumn
#Использовать collectionos

Перем Режим;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта(&Деталька("JUnit.Сбой", ЗначениеПоУмолчанию = "Успех") ТочкаСбоя)
	Режим = ТочкаСбоя;
КонецПроцедуры

&ПараметризованныйТест
&ИсточникВыражение("() -> Данные()")
&ВключенЕсли("() -> Условие()")
Процедура Шаблон(Значение) Экспорт
	Сообщить("Вывод итерации " + Значение);
КонецПроцедуры

Функция Данные() Экспорт

	Если Режим = "Источник" Тогда
		ВызватьИсключение "Ошибка источника <&>";
	КонецЕсли;

	Возврат Списки.ИзЭлементов(Списки.ИзЭлементов(1), Списки.ИзЭлементов(2)).ПроцессорКоллекции();

КонецФункции

Функция Условие() Экспорт

	Если Режим = "Условие" Тогда
		ВызватьИсключение "Ошибка условия контейнера <&>";
	КонецЕсли;

	Возврат Режим <> "Пропуск";

КонецФункции
