#Использовать asserts
#Использовать "../resolvers/Поставщики"

&ТестовыйНабор(Характер = "Одиночка")
&Изолированный
Процедура ПриСозданииОбъекта()
	Сообщить("Вывод конструктора изолированного набора");
КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми(&ЗначениеПоставщика("Контекст") Контекст) Экспорт
	Контекст.ПриЗакрытии(Новый Действие(ЭтотОбъект, "ЗакрытьНабор"));
КонецПроцедуры

&Тест
Процедура Падающий() Экспорт

	Сообщить("Вывод падающего ребенка");
	Ожидаем.Что(Ложь, "Ошибка дочернего теста").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура Успешный() Экспорт
	Сообщить("Вывод успешного ребенка");
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(1)
&ИсточникЗначение(2)
Процедура Шаблон(Номер) Экспорт

	Сообщить("Вывод итерации " + Номер);
	Ожидаем.Что(Номер, "Ошибка итерации").Равно(2);

КонецПроцедуры

&ПослеВсех
Процедура ПослеВсех() Экспорт

	Сообщить("Вывод ПослеВсех изолированного набора");
	ВызватьИсключение "Ошибка ПослеВсех изолированного набора";

КонецПроцедуры

Процедура ЗакрытьНабор(Контекст) Экспорт // BSLLS:UnusedParameters-off

	Сообщить("Вывод закрытия изолированного набора");
	ВызватьИсключение "Ошибка закрытия изолированного набора";

КонецПроцедуры
