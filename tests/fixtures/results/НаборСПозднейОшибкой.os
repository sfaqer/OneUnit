#Использовать asserts
#Использовать autumn
#Использовать "../resolvers/Поставщики"

Перем Режим;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта(
	&Деталька("СохранениеРезультатов.Режим", ЗначениеПоУмолчанию = "ПослеВсех") РежимОшибки)

	Режим = РежимОшибки;
	Сообщить("Вывод конструктора набора");

КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми(&ЗначениеПоставщика("Контекст") Контекст) Экспорт

	Сообщить("Вывод ПередВсеми");

	Если Режим = "Закрытие" Тогда
		Контекст.ПриЗакрытии(Новый Действие(ЭтотОбъект, "ЗакрытьНабор"));
	КонецЕсли;

КонецПроцедуры

&Тест
Процедура Падающий() Экспорт

	Сообщить("Вывод падающего ребенка");
	Ожидаем.Что(Ложь, "Ошибка дочернего теста").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура Успешный() Экспорт
	Сообщить("Вывод успешного ребенка");
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(1)
&ИсточникЗначение(2)
&ВключенЕсли("() -> УсловиеКонтейнера()")
Процедура Шаблон(Номер) Экспорт

	Сообщить("Вывод итерации " + Номер);
	Ожидаем.Что(Номер, "Ошибка итерации").Равно(2);

КонецПроцедуры

Функция УсловиеКонтейнера() Экспорт

	Сообщить("Вывод условия контейнера");
	Возврат Истина;

КонецФункции

&ПослеВсех
Процедура ПослеВсех() Экспорт

	Сообщить("Вывод ПослеВсех");

	Если Режим = "ПослеВсех" Тогда

		Попытка
			ВызватьИсключение "Вложенная причина ПослеВсех";
		Исключение
			ВызватьИсключение Новый ИнформацияОбОшибке("Ошибка ПослеВсех", Неопределено, ИнформацияОбОшибке());
		КонецПопытки;

	КонецЕсли;

КонецПроцедуры

Процедура ЗакрытьНабор(Контекст) Экспорт // BSLLS:UnusedParameters-off

	Сообщить("Вывод закрытия набора");

	Попытка
		ВызватьИсключение "Вложенная причина закрытия";
	Исключение
		ВызватьИсключение Новый ИнформацияОбОшибке("Ошибка закрытия набора", Неопределено, ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры
