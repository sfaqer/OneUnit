#Использовать autumn
#Использовать fluent
#Использовать collectionos

&ТестовыйНабор(Характер = "Одиночка")
&Изолированный(Уровень = "Процесс", Совет = "() -> СоветСВыводом()")
Процедура ПриСозданииОбъекта()
	Сообщить("Вывод конструктора обнаружения");
КонецПроцедуры

&ПараметризованныйТест
&ИсточникВыражение("() -> ДанныеСВыводом()")
Процедура Шаблон(Значение) Экспорт // BSLLS:UnusedParameters-off
КонецПроцедуры

Функция ДанныеСВыводом() Экспорт

	Сообщить("Вывод источника обнаружения");
	Возврат ПроцессорыКоллекций.ИзНабора(Списки.ИзЭлементов(1), Списки.ИзЭлементов(2));

КонецФункции

Функция СоветСВыводом() Экспорт

	Сообщить("Вывод совета обнаружения");
	Возврат Новый СоветДругогоМастера;

КонецФункции
