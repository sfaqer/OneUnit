// Набор, поле которого получает значение поставщика: по журналу видно, для какого
// узла и когда заполнялось поле - после условий узла и перед его методами

#Использовать collectionos
#Использовать "Поставщики"
#Использовать "../../support"

&ЗначениеПоставщика("Счетчик")
Перем Номер;

&ТестовыйНабор
Процедура ПриСозданииОбъекта()
	ЖурналВыполнения.Записать("Конструктор " + ?(Номер = Неопределено, "без поля", Номер));
КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми() Экспорт
	ЖурналВыполнения.Записать("ПередВсеми " + Номер);
КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым(&ЗначениеПоставщика("Счетчик") НомерПараметра) Экспорт
	ЖурналВыполнения.Записать(СтрШаблон("ПередКаждым %1 %2", Номер, НомерПараметра));
КонецПроцедуры

&Тест
Процедура Тест() Экспорт
	ЖурналВыполнения.Записать("Тест " + Номер);
КонецПроцедуры

// Экземпляр для выражения источника создается при обнаружении, а контейнеру -
// только для его условия: им поле не заполняется
&ПараметризованныйТест
&ИсточникВыражение("() -> Значения()")
&ВключенЕсли("() -> Истина")
Процедура Шаблон(А) Экспорт // BSLLS:UnusedParameters-off
	ЖурналВыполнения.Записать("Шаблон " + Номер);
КонецПроцедуры

Функция Значения() Экспорт
	Возврат ПроцессорыКоллекций.ИзНабора(Списки.ИзЭлементов(1));
КонецФункции
