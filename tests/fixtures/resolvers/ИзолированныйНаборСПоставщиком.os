// Изолированный набор уровня "Поделка" с поставщиками параметров и поля: значения
// спрашиваются в его среде

#Использовать asserts
#Использовать "Поставщики"

Перем ЗначениеКонструктора;

&ЗначениеПоставщика("Поле")
Перем Поле;

&ТестовыйНабор
&Изолированный
Процедура ПриСозданииОбъекта(&ЗначениеПоставщика("Конструктор") Значение)
	ЗначениеКонструктора = Значение;
КонецПроцедуры

&Тест
Процедура Тест(&ЗначениеПоставщика("Тест") П) Экспорт
	Ожидаем.Что(ЗначениеКонструктора).Равно("Конструктор");
	Ожидаем.Что(П).Равно("Тест");
	Ожидаем.Что(Поле).Равно("Поле");
КонецПроцедуры
