// Тест с таймаутом и регистрацией действия после закрытия контекста.
// Контекст закрывается при завершении узла без ожидания фонового метода.
// Поздно зарегистрированное действие выполняется синхронно при регистрации.

#Использовать "Поставщики"
#Использовать "../../support"

&ТестовыйНабор
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&Тест
&Таймаут(50)
Процедура Тест(&ЗначениеПоставщика("Контекст") Контекст) Экспорт
	Приостановить(300);
	Контекст.ПриЗакрытии(Новый Действие(ЭтотОбъект, "ПозднееЗакрытие"));
	ЖурналВыполнения.Записать("Позднее действие добавлено");
КонецПроцедуры

Процедура ПозднееЗакрытие(Контекст) Экспорт
	ЖурналВыполнения.Записать("Позднее закрытие " + Контекст.Результат().Получить().Состояние());
КонецПроцедуры
