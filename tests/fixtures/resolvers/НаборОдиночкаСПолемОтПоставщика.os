// Набор-одиночка, поле которого получает значение поставщика: экземпляр один,
// а поле заполняется заново перед методами каждого теста, в его контексте

#Использовать "Поставщики"
#Использовать "../../support"

&ЗначениеПоставщика("Счетчик")
Перем Номер;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&Тест
Процедура Первый() Экспорт
	ЖурналВыполнения.Записать("Первый " + Номер);
КонецПроцедуры

&Тест
Процедура Второй() Экспорт
	ЖурналВыполнения.Записать("Второй " + Номер);
КонецПроцедуры
