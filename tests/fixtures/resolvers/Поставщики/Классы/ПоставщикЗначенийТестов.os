// Поставщик значений параметров и полей для тестов поставщиков: отдает значение аннотации
// &ЗначениеПоставщика и пишет в журнал, для какого узла его спросили и как узел
// закрылся. Особые значения:
//  "Счетчик"         - номер запроса в хранилище контекста узла;
//  "Упасть"          - исключение поставщика;
//  "ПадениеЗакрытия" - исключение действия закрытия;
//  "Контекст"        - сам контекст исполнения: код теста добавляет в него действия

#Использовать annotations
#Использовать "../../../../support"

Перем Метка; // Строка - Метод и параметр или поле, для которых спросили поставщика

Функция Значение(КонтекстЭлемента, КонтекстИсполнения) Экспорт

	ЗначениеАннотации = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
		КонтекстЭлемента.Аннотация("ЗначениеПоставщика").Получить(),
		"Значение",
		""
	);

	Если ТипЗнч(КонтекстЭлемента) = Тип("КонтекстПоля") Тогда
		Метка   = "Поле." + КонтекстЭлемента.Имя();
		Описание = Метка;
	Иначе
		Метка   = КонтекстЭлемента.Метод().Имя + "." + КонтекстЭлемента.Имя();
		Описание = СтрШаблон("%1[%2]", Метка, КонтекстЭлемента.Индекс());
	КонецЕсли;

	Сообщить("Вывод поставщика " + Метка);

	ЖурналВыполнения.Записать(СтрШаблон("Поставщик %1 для %2", Описание, ИмяУзла(КонтекстИсполнения)));

	Если ЗначениеАннотации = "Упасть" Тогда
		ВызватьИсключение "Поставщик не смог";
	КонецЕсли;

	КонтекстИсполнения.ПриЗакрытии(Новый Действие(
		ЭтотОбъект,
		?(ЗначениеАннотации = "ПадениеЗакрытия", "ЗакрытьСПадением", "Закрыть")
	));

	Если ЗначениеАннотации = "Контекст" Тогда
		Возврат КонтекстИсполнения;
	КонецЕсли;

	Если ЗначениеАннотации = "Счетчик" Тогда
		Номер = КонтекстИсполнения.Хранилище().ПолучитьИлиУмолчание("Счетчик", 0) + 1;
		КонтекстИсполнения.Хранилище().Вставить("Счетчик", Номер);
		Возврат Номер;
	КонецЕсли;

	Возврат ЗначениеАннотации;

КонецФункции

Процедура Закрыть(Контекст) Экспорт

	Сообщить("Вывод закрытия " + Метка);

	Состояние = "-";

	Если Контекст.Результат().СодержитЗначение() Тогда
		Состояние = Контекст.Результат().Получить().Состояние();
	КонецЕсли;

	ЖурналВыполнения.Записать(СтрШаблон(
		"Закрыт %1: %2 %3 падения=%4",
		ИмяУзла(Контекст),
		Метка,
		Состояние,
		Формат(Контекст.ЕстьПадения(), "БЛ=Нет; БИ=Да")
	));

КонецПроцедуры

Процедура ЗакрытьСПадением(Контекст) Экспорт // BSLLS:UnusedParameters-off
	ВызватьИсключение "Закрытие не смогло";
КонецПроцедуры

Функция ИмяУзла(Контекст)
	Возврат Контекст.Узел().Имя();
КонецФункции

&Желудь
&Характер("Компанейский")
Процедура ПриСозданииОбъекта()
КонецПроцедуры
