// Набор, параметры конструктора и методов которого получают значения поставщика:
// по журналу видно, в контексте какого узла спрашивали поставщика, что получили
// методы и когда узлы закрылись

#Использовать "Поставщики"
#Использовать "../../support"

Перем ЗначениеКонструктора;

&ТестовыйНабор
Процедура ПриСозданииОбъекта(&ЗначениеПоставщика("Конструктор") Значение)
	ЗначениеКонструктора = Значение;
КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми(&ЗначениеПоставщика("ПередВсеми") Значение) Экспорт
	ЖурналВыполнения.Записать("ПередВсеми " + Значение);
КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым(&ЗначениеПоставщика("Счетчик") Номер) Экспорт
	ЖурналВыполнения.Записать("ПередКаждым " + Номер);
КонецПроцедуры

&Тест
Процедура Тест(&ЗначениеПоставщика("Счетчик") Номер) Экспорт
	ЖурналВыполнения.Записать("Тест " + Номер + " " + ЗначениеКонструктора);
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(1, 2)
Процедура Параметризованный(А, &ЗначениеПоставщика("Середина") Б, В) Экспорт
	ЖурналВыполнения.Записать(СтрШаблон("Параметризованный %1 %2 %3", А, Б, В));
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(1)
Процедура СУмолчанием(А, Б = 5, &ЗначениеПоставщика("Последний") В) Экспорт
	ЖурналВыполнения.Записать(СтрШаблон("СУмолчанием %1 %2 %3", А, Б, В));
КонецПроцедуры

&ПараметризованныйТест
&ИсточникJSON("[ {""В"": 3, ""А"": 1} ]")
Процедура ПоИмени(А, &ЗначениеПоставщика("Середина") Б, В) Экспорт
	ЖурналВыполнения.Записать(СтрШаблон("ПоИмени %1 %2 %3", А, Б, В));
КонецПроцедуры

&ПараметризованныйТест
&ИсточникНеопределено
Процедура ВсеНеопределено(А, &ЗначениеПоставщика("Последний") Б) Экспорт
	ЖурналВыполнения.Записать(СтрШаблон("ВсеНеопределено %1 %2", ТипЗнч(А), Б));
КонецПроцедуры

&ПослеВсех
Процедура ПослеВсех(&ЗначениеПоставщика("ПослеВсех") Значение) Экспорт
	ЖурналВыполнения.Записать("ПослеВсех " + Значение);
КонецПроцедуры

// Сигнатура без поставщиков для проверок аргументов вызова
Процедура БезПоставщиков(А, Б = 5) Экспорт // BSLLS:UnusedParameters-off
КонецПроцедуры
