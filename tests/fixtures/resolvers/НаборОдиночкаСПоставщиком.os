// Набор-одиночка с поставщиком параметра конструктора: значение спрашивается
// один раз, в контексте ее набора

#Использовать "Поставщики"
#Использовать "../../support"

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта(&ЗначениеПоставщика("Одиночка") Значение)
	ЖурналВыполнения.Записать("Конструктор одиночки " + Значение);
КонецПроцедуры

&Тест
Процедура Первый() Экспорт
	ЖурналВыполнения.Записать("Первый");
КонецПроцедуры

&Тест
Процедура Второй() Экспорт
	ЖурналВыполнения.Записать("Второй");
КонецПроцедуры
