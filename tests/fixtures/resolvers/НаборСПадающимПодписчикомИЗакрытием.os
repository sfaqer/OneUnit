// Подписчик прерывает прогон, а действие закрытия набора падает с вложенной причиной.
// Оба исключения и вывод закрытия должны сохраниться в отказе прогона

#Использовать "Поставщики"
#Использовать "Подписчики"

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта(&ЗначениеПоставщика("Контекст") Контекст)

	Контекст.ПриЗакрытии(Новый Действие(ЭтотОбъект, "Закрыть"));

КонецПроцедуры

&Тест
Процедура Тест() Экспорт
КонецПроцедуры

Процедура Закрыть(Контекст) Экспорт // BSLLS:UnusedParameters-off

	Сообщить("Вывод перед ошибкой закрытия");

	Попытка
		ВызватьИсключение "Корневая причина закрытия";
	Исключение
		ВызватьИсключение Новый ИнформацияОбОшибке("Закрытие не смогло", , ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры
