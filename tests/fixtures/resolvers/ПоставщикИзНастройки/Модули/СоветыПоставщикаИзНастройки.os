#Использовать collectionos

// Возвращает совет изолированной поделки, в которой включен ПоставщикИзНастройки
//
//  Возвращаемое значение:
//   СоветДругогоМастера - Совет со значением детальки "ПоставщикИзНастройки.Включен"
//
Функция СоветСПоставщиком() Экспорт

	Совет = Новый СоветДругогоМастера();
	Совет.ПолучитьСтроительМенеджераПараметров().ДобавитьПровайдерСоответствие(
		Новый Соответствие(Соответствия.ИзЭлементов(
			"ПоставщикИзНастройки",
			Новый Соответствие(Соответствия.ИзЭлементов("Включен", Истина))
		))
	);

	Возврат Совет;

КонецФункции
