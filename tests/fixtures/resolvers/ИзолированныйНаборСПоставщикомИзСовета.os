// Изолированный набор уровня "Поделка", поставщика конструктора, метода жизненного
// цикла и поля которого включает совет изоляции: поставщик есть только в среде
// набора, и родитель его регистрацию не проверяет

#Использовать asserts
#Использовать "ПоставщикИзНастройки"

Перем ЗначениеКонструктора;

&ЗначениеИзНастройки
Перем Поле;

&ТестовыйНабор
&Изолированный(Совет = "() -> СоветыПоставщикаИзНастройки.СоветСПоставщиком()")
Процедура ПриСозданииОбъекта(&ЗначениеИзНастройки Значение)
	ЗначениеКонструктора = Значение;
КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми(&ЗначениеИзНастройки Значение) Экспорт
	// Набор компанейский: ПередВсеми исполняется на своем экземпляре, а не на экземпляре теста
	Ожидаем.Что(Значение).Равно("из настройки");
КонецПроцедуры

&Тест
Процедура Тест(&ЗначениеИзНастройки Значение) Экспорт
	Ожидаем.Что(ЗначениеКонструктора).Равно("из настройки");
	Ожидаем.Что(Поле).Равно("из настройки");
	Ожидаем.Что(Значение).Равно("из настройки");
КонецПроцедуры
