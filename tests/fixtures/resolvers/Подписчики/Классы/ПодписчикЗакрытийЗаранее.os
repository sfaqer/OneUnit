// Подписчик начала плана, который заранее добавляет действие закрытия в контекст
// каждого теста: так в контексте оказывается действие и у теста, до которого
// исполнение не дойдет. Подписку добавляет напильник при создании желудя, поэтому
// подписчик работает только в поделке, которая его создала

#Использовать "../../../../support"

&ПодпискаНаСобытие("ИсполнениеТестПланНачало")
Процедура ПриНачалеПлана(ТестПлан) Экспорт

	Для Каждого Набор Из ТестПлан.Дети() Цикл
		Для Каждого Тест Из Набор.Дети() Цикл
			Тест.Контекст().ПриЗакрытии(Новый Действие(ЭтотОбъект, "Закрыть"));
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура Закрыть(Контекст) Экспорт
	ЖурналВыполнения.Записать("Закрыт заранее " + Контекст.Узел().Имя());
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
