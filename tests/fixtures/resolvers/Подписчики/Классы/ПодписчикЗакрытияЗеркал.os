// Подписчик начала теста, который добавляет действие закрытия в контекст теста,
// в том числе зеркала изолированного теста в родителе. Подписку добавляет напильник
// при создании желудя, поэтому подписчик работает только в поделке, которая его создала

#Использовать "../../../../support"

&ПодпискаНаСобытие("ИсполнениеТестНачало")
Процедура ПриНачалеТеста(Тест) Экспорт

	// У контейнера действий закрытия нет
	Если Тест.ТипОпределения() = ТипыОпределенийТестов.Контейнер Тогда
		Возврат;
	КонецЕсли;

	Тест.Контекст().ПриЗакрытии(Новый Действие(ЭтотОбъект, "Закрыть"));

КонецПроцедуры

Процедура Закрыть(Контекст) Экспорт
	ЖурналВыполнения.Записать(СтрШаблон(
		"Подписчик закрыл %1 %2",
		Контекст.Узел().Имя(),
		Контекст.Результат().Получить().Состояние()
	));
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
