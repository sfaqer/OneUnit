// Набор с изолированными тестами, поставщика значений которых включает совет
// изоляции: поставщик есть только в среде теста, и родитель его регистрацию
// не проверяет - ни у параметров тестов, ни у ПередКаждым, ни у полей: их
// значения получает тест там, где исполняется

#Использовать asserts
#Использовать "ПоставщикИзНастройки"

&ЗначениеИзНастройки
Перем Поле;

Перем ЗначениеПередКаждым;

&ТестовыйНабор
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым(&ЗначениеИзНастройки Значение) Экспорт
	ЗначениеПередКаждым = Значение;
КонецПроцедуры

&Тест
&Изолированный(Совет = "() -> СоветыПоставщикаИзНастройки.СоветСПоставщиком()")
Процедура ПоделочныйТест(&ЗначениеИзНастройки Значение) Экспорт
	Ожидаем.Что(Значение).Равно("из настройки");
	Ожидаем.Что(ЗначениеПередКаждым).Равно("из настройки");
	Ожидаем.Что(Поле).Равно("из настройки");
КонецПроцедуры

&Тест
&Изолированный(Уровень = "Процесс", Совет = "() -> СоветыПоставщикаИзНастройки.СоветСПоставщиком()")
Процедура ПроцессныйТест(&ЗначениеИзНастройки Значение) Экспорт
	Ожидаем.Что(Значение).Равно("из настройки");
	Ожидаем.Что(ЗначениеПередКаждым).Равно("из настройки");
	Ожидаем.Что(Поле).Равно("из настройки");
КонецПроцедуры
