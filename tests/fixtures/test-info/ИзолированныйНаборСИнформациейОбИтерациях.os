#Использовать asserts
#Использовать "Поддержка"

&ИнформацияОТесте
Перем ИнформацияПоля;

&ТестовыйНабор
&Изолированный
&Тег("Набор")
&Тег("Изоляция")
Процедура ПриСозданииОбъекта(&ИнформацияОТесте Информация)
	ЗаписиИнформацииОТесте.Записать("Конструктор", Информация, ЭтотОбъект);
КонецПроцедуры

&ПовторяемыйТест(2, Имя = "{ОтображаемоеИмя} {ТекущееПовторение}/{ВсегоПовторений}")
&ОтображаемоеИмя("Повтор")
&Тег("Повторение")
Процедура Повтор(&ИнформацияОТесте Информация) Экспорт
	ЗаписатьИнформацию(Информация);
КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(11)
&ИсточникЗначение(22)
&ОтображаемоеИмя("Аргументы")
&Тег("Параметры")
Процедура Параметры(Значение, &ИнформацияОТесте Информация) Экспорт

	Ожидаем.Что(Значение = 11 Или Значение = 22).ЭтоИстина();
	ЗаписатьИнформацию(Информация);

КонецПроцедуры

Процедура ЗаписатьИнформацию(Информация)

	ЗаписиИнформацииОТесте.Записать("Тест", Информация, ЭтотОбъект);
	ЗаписиИнформацииОТесте.Записать("Поле", ИнформацияПоля, ЭтотОбъект);

КонецПроцедуры
