#Использовать asserts
#Использовать "Поддержка"

&ТестовыйНабор
&Изолированный(
	Уровень = "Процесс",
	Совет = "() -> ПроверкиСоветаИнформации.СоветБезЭкземпляра()"
)
&Тег("Изоляция")
Процедура ПриСозданииОбъекта(&ИнформацияОТесте Информация)

	ПроверкиСоветаИнформации.ОтметитьКонструктор();
	ЗаписиИнформацииОТесте.Записать("Конструктор", Информация, ЭтотОбъект);

КонецПроцедуры

&Тест
&Тег("Метод")
Процедура Тест(&ИнформацияОТесте Информация) Экспорт

	Ожидаем.Что(ПроверкиСоветаИнформации.КоличествоКонструкторов()).Равно(2);
	ЗаписиИнформацииОТесте.Записать("Тест", Информация, ЭтотОбъект);

КонецПроцедуры
