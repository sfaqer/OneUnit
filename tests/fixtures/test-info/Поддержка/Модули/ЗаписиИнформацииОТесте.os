#Использовать collectionos

Процедура Записать(Знач Этап, Информация, Экземпляр, Знач ЗначениеАргумента = Неопределено) Экспорт

	Данные = Новый Структура(
		"phase, name, method, tags, correct_class",
		Этап,
		Информация.ОтображаемоеИмя(),
		Информация.Метод().Обработать("Метод -> Метод.Имя()").Иначе_(""),
		Информация.Теги().ПроцессорКоллекции().ВМассив(),
		Информация.Набор() = ТипЗнч(Экземпляр)
	);

	Если ЗначениеАргумента <> Неопределено Тогда
		Данные.Вставить("value", ЗначениеАргумента);
	КонецЕсли;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Данные);
	Сообщить("TEST_INFO:" + Запись.Закрыть());

КонецПроцедуры
