&Тест
&ОтображаемоеИмя("Обычный тест")
&Тег("Метод")
&Тег("Общий")
Процедура Тест(&ИнформацияОТесте Информация) Экспорт

	ЗаписиИнформацииОТесте.Записать("Тест", Информация, ЭтотОбъект);
	ЗаписиИнформацииОТесте.Записать("Поле", ИнформацияПоля, ЭтотОбъект);
	Метод = Информация.Метод().Получить();
	Ожидаем.Что(Метод).ИмеетТип("ИнформацияОМетоде");
	Ожидаем.Что(Метод.Имя()).Равно("Тест");
	Ожидаем.Что(Метод.Набор()).Равно(Информация.Набор());
	ОшибкаИзменения = Неопределено;

	Попытка
		Метод.Имя = "Изменённое имя";
	Исключение
		ОшибкаИзменения = ИнформацияОбОшибке();
	КонецПопытки;

	Ожидаем.Что(ОшибкаИзменения).Не_().ЭтоНеопределено();
	Ожидаем.Что(Информация.Метод().Получить().Имя()).Равно("Тест");
	Ожидаем.Что(Информация.Теги()).ИмеетТип("ФиксированноеМножество");

КонецПроцедуры

