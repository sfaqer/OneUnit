#Использовать asserts
#Использовать fluent
#Использовать collectionos
#Использовать "Поддержка"

Перем ИнформацияКонструктора;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта(&ИнформацияОТесте Информация)

	ИнформацияКонструктора = Информация;

	Если Информация = Неопределено Тогда
		Сообщить("TEST_INFO_DISCOVERY");
	КонецЕсли;

КонецПроцедуры

&ПараметризованныйТест
&ИсточникВыражение("() -> Данные()")
Процедура Шаблон(Значение, &ИнформацияОТесте Информация) Экспорт

	Ожидаем.Что(Значение).Равно(1);
	Ожидаем.Что(ИнформацияКонструктора).Не_().ЭтоНеопределено();
	Ожидаем.Что(ИнформацияКонструктора.Метод().Пустой()).ЭтоИстина();
	ЗаписиИнформацииОТесте.Записать("Тест", Информация, ЭтотОбъект);

КонецПроцедуры

Функция Данные() Экспорт

	Ожидаем.Что(ИнформацияКонструктора).ЭтоНеопределено();
	Возврат ПроцессорыКоллекций.ИзНабора(Списки.ИзЭлементов(1));

КонецФункции
