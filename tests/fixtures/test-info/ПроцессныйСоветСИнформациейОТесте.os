#Использовать asserts
#Использовать autumn
#Использовать "Поддержка"

Перем ИнформацияКонструктора;

&ТестовыйНабор
&Изолированный(Уровень = "Процесс", Совет = "() -> СоздатьСовет()")
&Тег("Изоляция")
Процедура ПриСозданииОбъекта(&ИнформацияОТесте Информация = "Резерв")

	ИнформацияКонструктора = Информация;

	Если ТипЗнч(Информация) = Тип("ИнформацияОТесте") Тогда
		ЗаписиИнформацииОТесте.Записать("Конструктор", Информация, ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

Функция СоздатьСовет() Экспорт

	Ожидаем.Что(ИнформацияКонструктора).Равно("Резерв");
	Сообщить("TEST_INFO_ADVICE_DEFAULT");
	Возврат Новый СоветДругогоМастера();

КонецФункции

&Тест
&Тег("Метод")
Процедура Тест(&ИнформацияОТесте Информация) Экспорт

	Ожидаем.Что(ИнформацияКонструктора).ИмеетТип("ИнформацияОТесте");
	ЗаписиИнформацииОТесте.Записать("Тест", Информация, ЭтотОбъект);

КонецПроцедуры
