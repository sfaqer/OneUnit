#Использовать "Поддержка"

Перем ИнформацияКонструктора;
Перем ИнформацияПервогоТеста;

&ИнформацияОТесте
Перем ИнформацияПоля;

&ТестовыйНабор(Характер = "Одиночка")
&Тег("Набор")
Процедура ПриСозданииОбъекта(&ИнформацияОТесте Информация)

	ИнформацияКонструктора = Информация;
	ЗаписиИнформацииОТесте.Записать("Конструктор", Информация, ЭтотОбъект);

КонецПроцедуры

&Тест
&Порядок(1)
&Тег("Первый")
Процедура Первый(&ИнформацияОТесте Информация) Экспорт

	ИнформацияПервогоТеста = Информация;
	ЗаписатьИнформацию(Информация);

КонецПроцедуры

&Тест
&Порядок(2)
&Тег("Второй")
Процедура Второй(&ИнформацияОТесте Информация) Экспорт

	ЗаписатьИнформацию(Информация);
	ЗаписиИнформацииОТесте.Записать("СохранённыйПервыйТест", ИнформацияПервогоТеста, ЭтотОбъект);

КонецПроцедуры

Процедура ЗаписатьИнформацию(Информация)

	ЗаписиИнформацииОТесте.Записать("Тест", Информация, ЭтотОбъект);
	ЗаписиИнформацииОТесте.Записать("Поле", ИнформацияПоля, ЭтотОбъект);
	ЗаписиИнформацииОТесте.Записать("СохранённыйКонструктор", ИнформацияКонструктора, ЭтотОбъект);

КонецПроцедуры
