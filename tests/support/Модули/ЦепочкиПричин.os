// Проверки цепочек причин: вложенные ИнформацияОбОшибке разворачиваются
// в подробное описание звено за звеном, от следствия к корню. Звенья разделены
// заголовком «По причине:» - фрагмент ищется в своем звене, а не где-то в тексте.

#Использовать asserts
#Использовать "../../.."

// Проверяет, что звенья цепочки причины, начиная с первого, содержат фрагменты:
// каждое - свой, по порядку
//
// Параметры:
//  Причина   - ИнформацияОбОшибке - Причина с цепочкой
//  Фрагменты - Массив из Строка - Фрагменты звеньев от следствия к корню
//
Процедура ПроверитьЗвенья(Причина, Фрагменты) Экспорт

	Описание = ТестированиеСлужебный.ПодробноеОписаниеОшибки("Причина", Причина);

	ПроверитьЗвеньяСНачала(Описание, Звенья(Описание), 0, Фрагменты);

КонецПроцедуры

// Проверяет, что готовое подробное описание (вывод консоли, сообщение MCP)
// содержит цепочку, звенья которой содержат фрагменты - каждое свой, по порядку,
// начиная со звена первого фрагмента
//
// Параметры:
//  ПодробноеОписание - Строка - Описание с развернутой цепочкой причин
//  Фрагменты - Массив из Строка - Фрагменты звеньев от следствия к корню
//
Процедура ПроверитьЗвеньяОписания(Знач ПодробноеОписание, Фрагменты) Экспорт

	Звенья = Звенья(ПодробноеОписание);

	Для Начало = 0 По Звенья.ВГраница() Цикл
		Если СтрНайти(Звенья[Начало], Фрагменты[0]) > 0 Тогда
			ПроверитьЗвеньяСНачала(ПодробноеОписание, Звенья, Начало, Фрагменты);
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение СтрШаблон("Нет звена ""%1"" в:%2%3", Фрагменты[0], Символы.ПС, ПодробноеОписание);

КонецПроцедуры

// Проверяет, что подробное описание причины несет перехваченный вывод - секцию
// «Вывод:» с фрагментом
//
// Параметры:
//  Причина  - ИнформацияОбОшибке - Причина с выводом
//  Фрагмент - Строка - Фрагмент вывода
//
Процедура ПроверитьВывод(Причина, Знач Фрагмент) Экспорт

	Описание = ТестированиеСлужебный.ПодробноеОписаниеОшибки("Причина", Причина);

	Секция = СтрНайти(Описание, "Вывод:");

	Ожидаем.Что(Секция, "Секция вывода в:" + Символы.ПС + Описание).Больше(0);
	Ожидаем.Что(СтрНайти(Описание, Фрагмент, НаправлениеПоиска.СНачала, Секция), Описание).Больше(0);

КонецПроцедуры

Процедура ПроверитьЗвеньяСНачала(Знач Описание, Звенья, Знач Начало, Фрагменты)

	Ожидаем.Что(Звенья.Количество() - Начало, "Звеньев в:" + Символы.ПС + Описание)
		.БольшеИлиРавно(Фрагменты.Количество());

	Для Индекс = 0 По Фрагменты.ВГраница() Цикл
		Ожидаем.Что(
			СтрНайти(Звенья[Начало + Индекс], Фрагменты[Индекс]),
			СтрШаблон("Звено %1 ""%2"" в:%3%4", Индекс, Фрагменты[Индекс], Символы.ПС, Описание)
		).Больше(0);
	КонецЦикла;

КонецПроцедуры

Функция Звенья(Знач Описание)

	Разделитель = "По причине:";

	Звенья = Новый Массив;

	Позиция = СтрНайти(Описание, Разделитель);

	Пока Позиция > 0 Цикл
		Звенья.Добавить(Лев(Описание, Позиция - 1));
		Описание = Сред(Описание, Позиция + СтрДлина(Разделитель));
		Позиция  = СтрНайти(Описание, Разделитель);
	КонецЦикла;

	Звенья.Добавить(Описание);

	Возврат Звенья;

КонецФункции
