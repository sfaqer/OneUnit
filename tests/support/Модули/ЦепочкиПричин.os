// Проверки цепочек причин: вложенные ИнформацияОбОшибке разворачиваются
// в подробное описание звено за звеном, от следствия к корню.

#Использовать asserts
#Использовать "../../.."

// Проверяет, что подробное описание причины содержит фрагменты звеньев цепочки
// в указанном порядке
//
// Параметры:
//  Причина   - ИнформацияОбОшибке - Причина с цепочкой
//  Фрагменты - Массив из Строка - Фрагменты звеньев от следствия к корню
//
Процедура ПроверитьЗвенья(Причина, Фрагменты) Экспорт
	ПроверитьЗвеньяОписания(ТестированиеСлужебный.ПодробноеОписаниеОшибки("Причина", Причина), Фрагменты);
КонецПроцедуры

// Проверяет, что готовое подробное описание (вывод консоли, сообщение MCP)
// содержит фрагменты звеньев цепочки в указанном порядке
//
// Параметры:
//  ПодробноеОписание - Строка - Описание с развернутой цепочкой причин
//  Фрагменты - Массив из Строка - Фрагменты звеньев от следствия к корню
//
Процедура ПроверитьЗвеньяОписания(Знач ПодробноеОписание, Фрагменты) Экспорт

	Позиция = 0;

	Для Каждого Фрагмент Из Фрагменты Цикл

		Найден = СтрНайти(ПодробноеОписание, Фрагмент, НаправлениеПоиска.СНачала, Позиция + 1);

		Ожидаем.Что(Найден, СтрШаблон("Звено ""%1"" после позиции %2 в:%3%4", Фрагмент, Позиция, Символы.ПС, ПодробноеОписание))
			.Больше(0);

		Позиция = Найден;

	КонецЦикла;

КонецПроцедуры
