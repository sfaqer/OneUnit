// Тесты параллельного пула процессных наборов

#Использовать asserts
#Использовать "./support"
#Использовать "./fixtures/parallel/Модули"
#Использовать ".."

Функция ВыводДерева(Знач Параллельность, Знач Наборы)

	Доп = Новый Соответствие;
	Доп.Вставить("OneUnit.Параллельность", Параллельность);
	Доп.Вставить("OneUnit.РежимВыводаЛога", РежимыВыводаЛога.Дерево);

	Буфер = Новый ПотокВПамяти();
	ТестированиеСлужебный.НачатьПерехватВывода(Буфер);

	Попытка
		ПрогоныТестов.Прогнать(
			Наборы,
			"./tests/fixtures/parallel",
			"",
			Доп
		);
	Исключение
		ТестированиеСлужебный.ЗавершитьПерехватВывода();
		ВызватьИсключение;
	КонецПопытки;

	ТестированиеСлужебный.ЗавершитьПерехватВывода();

	Возврат ПрогоныТестов.ПрочитатьПоток(Буфер);

КонецФункции

Процедура ПроверитьПорядокМаркеров(Знач Вывод)

	ПозицияA = СтрНайти(Вывод, "ONEUNIT_PARALLEL_MARKER_A");
	ПозицияB = СтрНайти(Вывод, "ONEUNIT_PARALLEL_MARKER_B");

	Ожидаем.Что(ПозицияA, Вывод).Больше(0);
	Ожидаем.Что(ПозицияB, Вывод).Больше(0);
	Ожидаем.Что(ПозицияA, Вывод).Меньше(ПозицияB);
	Ожидаем.Что(СтрНайти(Вывод, "ПервыйМаркер"), Вывод).Больше(0);
	Ожидаем.Что(СтрНайти(Вывод, "ВторойМаркер"), Вывод).Больше(0);
	Ожидаем.Что(СтрНайти(Вывод, "завершился аварийно"), Вывод).Равно(0);
	Ожидаем.Что(СтрНайти(Вывод, "потеряла сообщения"), Вывод).Равно(0);

КонецПроцедуры

&Тест
Процедура Параллельность1СохраняетПорядокДерева() Экспорт

	ОтметкиПараллельности.ОчиститьОтметки();

	Вывод = ВыводДерева(1, "ПервыйПроцессныйНаборСВыводом,ВторойПроцессныйНаборСВыводом");

	ПроверитьПорядокМаркеров(Вывод);

КонецПроцедуры

&Тест
Процедура ДваПроцессныхНабораНеСмешиваютВыводВДереве() Экспорт

	ОтметкиПараллельности.ОчиститьОтметки();
	ОтметкиПараллельности.ОжидатьПерекрытие();

	Вывод = ВыводДерева(2, "ПервыйПроцессныйНаборСВыводом,ВторойПроцессныйНаборСВыводом");

	ПроверитьПорядокМаркеров(Вывод);

	СтартA = ОтметкиПараллельности.ПрочитатьОтметку("A-start");
	КонецA = ОтметкиПараллельности.ПрочитатьОтметку("A-end");
	СтартB = ОтметкиПараллельности.ПрочитатьОтметку("B-start");
	КонецB = ОтметкиПараллельности.ПрочитатьОтметку("B-end");

	Ожидаем.Что(СтартA).МеньшеИлиРавно(КонецB);
	Ожидаем.Что(СтартB).МеньшеИлиРавно(КонецA);

КонецПроцедуры

&Тест
Процедура ПоследовательныйБарьерНеПересекаетсяСПулом() Экспорт

	ОтметкиПараллельности.ОчиститьОтметки();
	ОтметкиПараллельности.ОжидатьПерекрытие();

	Наборы = "ПоследовательныйПроцессныйНабор,ПервыйПроцессныйНаборСВыводом,ВторойПроцессныйНаборСВыводом";
	Вывод = ВыводДерева(2, Наборы);

	ПроверитьПорядокМаркеров(Вывод);

	ПозицияSEQ = СтрНайти(Вывод, "ONEUNIT_PARALLEL_MARKER_SEQ");
	ПозицияA = СтрНайти(Вывод, "ONEUNIT_PARALLEL_MARKER_A");

	Ожидаем.Что(ПозицияSEQ, Вывод).Больше(0);
	Ожидаем.Что(ПозицияSEQ, Вывод).Меньше(ПозицияA);
	Ожидаем.Что(СтрНайти(Вывод, "ПоследовательныйМаркер"), Вывод).Больше(0);

	КонецSEQ = ОтметкиПараллельности.ПрочитатьОтметку("SEQ-end");
	СтартA = ОтметкиПараллельности.ПрочитатьОтметку("A-start");
	СтартB = ОтметкиПараллельности.ПрочитатьОтметку("B-start");

	Ожидаем.Что(КонецSEQ).МеньшеИлиРавно(СтартA);
	Ожидаем.Что(КонецSEQ).МеньшеИлиРавно(СтартB);

КонецПроцедуры
