// Тесты параллельного пула процессных наборов

#Использовать asserts
#Использовать "./support"
#Использовать ".."

Функция ВыводДерева(Знач Параллельность)

	Доп = Новый Соответствие;
	Доп.Вставить("OneUnit.Параллельность", Параллельность);
	Доп.Вставить("OneUnit.РежимВыводаЛога", РежимыВыводаЛога.Дерево);

	Буфер = Новый ПотокВПамяти();
	ТестированиеСлужебный.НачатьПерехватВывода(Буфер);

	Попытка
		ПрогоныТестов.Прогнать(
			"ПервыйПроцессныйНаборСВыводом,ВторойПроцессныйНаборСВыводом",
			"./tests/fixtures/parallel",
			"",
			Доп
		);
	Исключение
		ТестированиеСлужебный.ЗавершитьПерехватВывода();
		ВызватьИсключение;
	КонецПопытки;

	ТестированиеСлужебный.ЗавершитьПерехватВывода();

	Возврат ПрогоныТестов.ПрочитатьПоток(Буфер);

КонецФункции

&Тест
Процедура Параллельность1СохраняетПорядокДерева() Экспорт

	Вывод = ВыводДерева(1);

	ПозицияA = СтрНайти(Вывод, "ONEUNIT_PARALLEL_MARKER_A");
	ПозицияB = СтрНайти(Вывод, "ONEUNIT_PARALLEL_MARKER_B");

	Ожидаем.Что(ПозицияA).Больше(0);
	Ожидаем.Что(ПозицияB).Больше(0);
	Ожидаем.Что(ПозицияA).Меньше(ПозицияB);

КонецПроцедуры

&Тест
Процедура ДваПроцессныхНабораНеСмешиваютВыводВДереве() Экспорт

	Вывод = ВыводДерева(2);

	ПозицияA = СтрНайти(Вывод, "ONEUNIT_PARALLEL_MARKER_A");
	ПозицияB = СтрНайти(Вывод, "ONEUNIT_PARALLEL_MARKER_B");

	Ожидаем.Что(ПозицияA).Больше(0);
	Ожидаем.Что(ПозицияB).Больше(0);
	Ожидаем.Что(ПозицияA).Меньше(ПозицияB);

КонецПроцедуры
