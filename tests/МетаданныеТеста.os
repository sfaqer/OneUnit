#Использовать asserts
#Использовать collectionos
#Использовать fluent
#Использовать "./support"
#Использовать ".."

&Тест
Процедура ИнформацияДоступнаВКонструктореМетодахИПолях() Экспорт

	ИмяНабора = "НаборСИнформациейОТесте";
	Прогон = ПрогоныТестов.Прогнать(ИмяНабора, "", "./tests/fixtures/test-info/" + ИмяНабора + ".os");
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	Тест = Набор.Дети().Получить(0);
	РезультатНабора = Прогон.Статистика.Результат(Набор);
	РезультатТеста = Прогон.Статистика.Результат(Тест);

	Ожидаем.Что(РезультатНабора.Состояние(), РезультатНабора.ОписанияПричин()).Равно(СостоянияВыполненияТестов.Успех);
	Ожидаем.Что(РезультатТеста.Состояние(), РезультатТеста.ОписанияПричин()).Равно(СостоянияВыполненияТестов.Успех);
	ЗаписиНабора = ПрочитатьЗаписи(РезультатНабора.Вывод());
	ЗаписиТеста = ПрочитатьЗаписи(РезультатТеста.Вывод());
	Ожидаем.Что(ЗаписиНабора.Количество()).Равно(6);
	Ожидаем.Что(ЗаписиТеста.Количество()).Равно(5);

	Для Каждого Запись Из ЗаписиНабора Цикл

		Ожидаем.Что(Запись.name).Равно(ИмяНабора);
		Ожидаем.Что(Запись.method).Равно("");
		Ожидаем.Что(Запись.correct_class).ЭтоИстина();
		Ожидаем.Что(Запись.tags.Найти("Набор")).Не_().ЭтоНеопределено();
		Ожидаем.Что(Запись.tags.Найти("Общий")).Не_().ЭтоНеопределено();
		Ожидаем.Что(Запись.tags.Количество()).Равно(2);

	КонецЦикла;

	Для Каждого Запись Из ЗаписиТеста Цикл

		Ожидаем.Что(Запись.name).Равно("Обычный тест");
		Ожидаем.Что(Запись.method).Равно("Тест");
		Ожидаем.Что(Запись.correct_class).ЭтоИстина();
		Ожидаем.Что(Запись.tags.Найти("Набор")).Не_().ЭтоНеопределено();
		Ожидаем.Что(Запись.tags.Найти("Общий")).Не_().ЭтоНеопределено();
		Ожидаем.Что(Запись.tags.Найти("Метод")).Не_().ЭтоНеопределено();
		Ожидаем.Что(Запись.tags.Количество()).Равно(3);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ОдиночкаСохраняетИнформациюКонструктораИОбновляетПоле() Экспорт

	ИмяНабора = "НаборОдиночкаСИнформациейОТесте";
	Прогон = ПрогнатьНабор(ИмяНабора);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	ПроверитьУспех(Прогон, 2);
	Конструкторы = ПрочитатьЗаписи(Прогон.Статистика.Результат(Набор).Вывод());
	Ожидаем.Что(Конструкторы.Количество()).Равно(1);
	Ожидаем.Что(Конструкторы.Получить(0).method).Равно("");

	Для Каждого Тест Из Набор.Дети() Цикл

		Записи = ПрочитатьЗаписи(Прогон.Статистика.Результат(Тест).Вывод());
		Ожидаем.Что(Записи.Количество()).Равно(?(Тест.Имя() = "Второй", 4, 3));

		Для Каждого Запись Из Записи Цикл

			Ожидаем.Что(Запись.correct_class).ЭтоИстина();

			Если Запись.phase = "СохранённыйКонструктор" Тогда

				Ожидаем.Что(Запись.name).Равно(ИмяНабора);
				Ожидаем.Что(Запись.method).Равно("");
				Ожидаем.Что(Запись.tags.Количество()).Равно(1);

			ИначеЕсли Запись.phase = "СохранённыйПервыйТест" Тогда

				Ожидаем.Что(Запись.name).Равно("Первый");
				Ожидаем.Что(Запись.method).Равно("Первый");
				Ожидаем.Что(Запись.tags.Найти("Первый")).Не_().ЭтоНеопределено();
				Ожидаем.Что(Запись.tags.Найти("Второй")).ЭтоНеопределено();

			Иначе

				Ожидаем.Что(Запись.name).Равно(Тест.Имя());
				Ожидаем.Что(Запись.method).Равно(Тест.ИмяМетода());
				Ожидаем.Что(Запись.tags.Найти(Тест.ИмяМетода())).Не_().ЭтоНеопределено();

			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ИнформацияОТестеСодержитИмяВызоваИМетодШаблона() Экспорт

	ИмяНабора = "НаборСИнформациейОбИтерациях";
	Прогон = ПрогнатьНабор(ИмяНабора);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	ПроверитьУспех(Прогон, 4);

	Для Каждого Шаблон Из Набор.Дети() Цикл

		Ожидаем.Что(Шаблон.Дети().Количество()).Равно(2);

		Если Шаблон.ИмяМетода() = "Параметры" Тогда

			ЗначенияПлана = Шаблон.Дети().ПроцессорКоллекции()
				.Обработать("Вызов -> Вызов.Параметры().Получить(0)")
				.Получить("СписокМассив");
			Ожидаем.Что(ЗначенияПлана.Содержит(11)).ЭтоИстина();
			Ожидаем.Что(ЗначенияПлана.Содержит(22)).ЭтоИстина();

		КонецЕсли;

		Для Каждого Итерация Из Шаблон.Дети() Цикл

			Записи = ПрочитатьЗаписи(Прогон.Статистика.Результат(Итерация).Вывод());
			Ожидаем.Что(Записи.Количество()).Равно(3);

			Если Шаблон.ИмяМетода() = "Параметры" Тогда

				ЗаписьТеста = Записи.ПроцессорКоллекции()
					.Фильтровать("Запись -> Запись.phase = ""Тест""")
					.ПолучитьПервый();
				Ожидаем.Что(ЗаписьТеста.value).Равно(Итерация.Параметры().Получить(0));

			КонецЕсли;

			Для Каждого Запись Из Записи Цикл

				Ожидаем.Что(Запись.name).Равно(Итерация.Имя());
				Ожидаем.Что(Запись.method).Равно(Шаблон.ИмяМетода());
				Ожидаем.Что(Запись.correct_class).ЭтоИстина();
				Ожидаем.Что(Запись.tags.Количество()).Равно(2);

			КонецЦикла;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ИзолированныйНаборСИнформациейОТесте")
&ИсточникЗначение("ПроцессныйНаборСИнформациейОТесте")
Процедура ИзолированныйНаборПолучаетСобственнуюИнформацию(ИмяНабора) Экспорт

	Прогон = ПрогнатьНабор(ИмяНабора);
	ПроверитьУспех(Прогон, 1);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	Тест = Набор.Дети().Получить(0);
	Записи = ПрочитатьЗаписи(Прогон.Статистика.Результат(Тест).Вывод());
	ПроверитьКонструктор(
		ПрочитатьЗаписи(Прогон.Статистика.Результат(Набор).Вывод()),
		ИмяНабора,
		""
	);
	ПроверитьКонструктор(Записи, "Тест в среде", "Тест");
	ПроверитьЗаписиТеста(Записи, "Тест в среде", "Тест");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Поделочный")
&ИсточникЗначение("Процессный")
Процедура ИзолированныйТестПолучаетСобственнуюИнформацию(ИмяМетода) Экспорт

	ИмяНабора = "НаборСИзолированнымиВызовамиИнформации";
	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.ТестовыеМетодыВключаемые", ИмяМетода);
	Прогон = ПрогоныТестов.Прогнать(
		ИмяНабора,
		"",
		"./tests/fixtures/test-info/" + ИмяНабора + ".os",
		Детальки
	);
	ПроверитьУспех(Прогон, 1);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	Тест = Набор.Дети().Получить(0);
	Записи = ПрочитатьЗаписи(Прогон.Статистика.Результат(Тест).Вывод());
	ПроверитьКонструктор(Записи, ИмяНабора, "");
	ПроверитьКонструктор(Записи, ИмяМетода, ИмяМетода);
	ПроверитьЗаписиТеста(Записи, ИмяМетода, ИмяМетода);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ИзолированныйНаборСИнформациейОбИтерациях")
&ИсточникЗначение("ПроцессныйНаборСИнформациейОбИтерациях")
Процедура ИзолированныеИтерацииПередаютСведенияВКонструкторПараметрИПоле(ИмяНабора) Экспорт

	Прогон = ПрогнатьНабор(ИмяНабора);
	ПроверитьУспех(Прогон, 4);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	ПроверитьКонструктор(
		ПрочитатьЗаписи(Прогон.Статистика.Результат(Набор).Вывод()),
		ИмяНабора,
		""
	);

	Для Каждого Шаблон Из Набор.Дети() Цикл

		Ожидаем.Что(Шаблон.Дети().Количество()).Равно(2);

		Для Каждого Итерация Из Шаблон.Дети() Цикл

			Записи = ПрочитатьЗаписи(Прогон.Статистика.Результат(Итерация).Вывод());
			ПроверитьКонструктор(Записи, Итерация.Имя(), Шаблон.ИмяМетода());
			Ожидаем.Что(Записи.Количество()).Равно(3);

			Для Каждого Запись Из Записи Цикл

				Ожидаем.Что(Запись.name).Равно(Итерация.Имя());
				Ожидаем.Что(Запись.method).Равно(Шаблон.ИмяМетода());
				Ожидаем.Что(Запись.correct_class).ЭтоИстина();
				Ожидаем.Что(Запись.tags.Количество()).Равно(3);
				Ожидаем.Что(Запись.tags.Найти("Изоляция")).Не_().ЭтоНеопределено();

			КонецЦикла;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ПоделочныйСоветСИнформациейОТесте", "TEST_INFO_ADVICE_UNDEFINED")
&ИсточникЗначение("ПроцессныйСоветСИнформациейОТесте", "TEST_INFO_ADVICE_DEFAULT")
&ИсточникЗначение(
	"ПроцессныйСоветБезЭкземпляраСИнформациейОТесте",
	"TEST_INFO_ADVICE_WITHOUT_INSTANCE"
)
Процедура СоветПолучаетЭкземплярПоПравиламСвоегоУровня(ИмяНабора, МаркерСовета) Экспорт

	Прогон = ПрогнатьНабор(ИмяНабора);
	ПроверитьУспех(Прогон, 1);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	ВыводНабора = Прогон.Статистика.Результат(Набор).Вывод();
	Ожидаем.Что(ВыводНабора).Содержит(МаркерСовета);
	ПроверитьКонструктор(ПрочитатьЗаписи(ВыводНабора), ИмяНабора, "");
	Тест = Набор.Дети().Получить(0);
	Записи = ПрочитатьЗаписи(Прогон.Статистика.Результат(Тест).Вывод());
	ПроверитьКонструктор(Записи, Тест.Имя(), "Тест");
	ЗаписьТеста = Записи.ПроцессорКоллекции()
		.Фильтровать("Запись -> Запись.phase = ""Тест""")
		.ПолучитьПервый();
	Ожидаем.Что(ЗаписьТеста.correct_class).ЭтоИстина();
	Ожидаем.Что(ЗаписьТеста.method).Равно("Тест");

КонецПроцедуры

&Тест
Процедура ОбнаружениеНеРазрешаетИнформациюКонструктора() Экспорт

	ИмяНабора = "НаборСИнформациейВИсточнике";
	Прогон = ПрогнатьНабор(ИмяНабора);
	ПроверитьУспех(Прогон, 1);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	Шаблон = Набор.Дети().Получить(0);
	Ожидаем.Что(Прогон.Статистика.Результат(Шаблон).Вывод()).Содержит("TEST_INFO_DISCOVERY");
	Итерация = Шаблон.Дети().Получить(0);
	Записи = ПрочитатьЗаписи(Прогон.Статистика.Результат(Итерация).Вывод());
	Ожидаем.Что(Записи.Получить(0).name).Равно(Итерация.Имя());
	Ожидаем.Что(Записи.Получить(0).method).Равно("Шаблон");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("ЕслиСодержитЗначение", "Описание -> Описание = Неопределено")
&ИсточникЗначение("ЕслиСодержитЗначение", "Описание -> Описание = ""Подмена""")
&ИсточникЗначение("Обработать", "Описание -> { Описание = Неопределено; Возврат 0; }")
&ИсточникЗначение(
	"Развернуть",
	"Описание -> { Описание = Неопределено; Возврат Опциональные.Пустой(); }"
)
&ИсточникЗначение("Фильтровать", "Описание -> { Описание = Неопределено; Возврат Истина; }")
&ИсточникЗначение("ЕслиСодержитЗначениеИначе", "Описание -> Описание = Неопределено")
Процедура ОбработкаОпциональногоНеИзменяетСведенияОМетоде(ИмяОбработки, Обработчик) Экспорт

	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.ТестовыеНаборыВключаемые", "НетТакогоНабора");
	Поделка = ПрогоныТестов.СоздатьПоделку(Детальки);
	Информация = Поделка.НайтиЖелудь("ИнформацияОТесте", Массивы.ИзЭлементов(
		"Имя",
		Списки.ИзЭлементов(),
		Тип("Строка"),
		Новый Опциональный("Тест")
	));
	ИсходныйМетод = Информация.Метод().Получить();
	Аргументы = Новый Массив;
	Аргументы.Добавить(Обработчик);

	Если ИмяОбработки = "ЕслиСодержитЗначениеИначе" Тогда
		Аргументы.Добавить("() -> {}");
	КонецЕсли;

	Рефлектор = Новый Рефлектор;
	Рефлектор.ВызватьМетод(Информация.Метод(), ИмяОбработки, Аргументы);

	Ожидаем.Что(Информация.Метод().СодержитЗначение()).ЭтоИстина();
	Ожидаем.Что(Информация.Метод().Получить()).ИмеетТип("ИнформацияОМетоде");
	Ожидаем.Что(Информация.Метод().Получить()).Равно(ИсходныйМетод);
	Ожидаем.Что(Информация.Метод().Получить().Имя()).Равно("Тест");

КонецПроцедуры

&Тест
Процедура ТегиКопируютсяИНедоступныДляИзменения() Экспорт

	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.ТестовыеНаборыВключаемые", "НетТакогоНабора");
	Поделка = ПрогоныТестов.СоздатьПоделку(Детальки);
	Теги = Новый СписокМассив(Списки.ИзЭлементов("Первый", "Второй", "Первый"));
	Информация = Поделка.НайтиЖелудь("ИнформацияОТесте", Массивы.ИзЭлементов(
		"Имя",
		Теги,
		Тип("Строка"),
		Опциональные.Пустой()
	));
	Теги.Очистить();
	Теги.Добавить("Новый");

	Ожидаем.Что(Информация.Теги().Количество()).Равно(2);
	Ожидаем.Что(Информация.Теги().Содержит("Первый")).ЭтоИстина();
	Ожидаем.Что(Информация.Теги().Содержит("Новый")).ЭтоЛожь();
	Ожидаем.Что(Информация.Метод().Пустой()).ЭтоИстина();
	ОшибкаИзменения = Неопределено;

	Попытка
		Информация.Теги().Добавить("Новый");
	Исключение
		ОшибкаИзменения = ИнформацияОбОшибке();
	КонецПопытки;

	Ожидаем.Что(ОшибкаИзменения).Не_().ЭтоНеопределено();
	Ожидаем.Что(Информация.Теги().Количество()).Равно(2);

КонецПроцедуры

Функция ПрогнатьНабор(Знач ИмяНабора)
	Возврат ПрогоныТестов.Прогнать(ИмяНабора, "", "./tests/fixtures/test-info/" + ИмяНабора + ".os");
КонецФункции

Процедура ПроверитьУспех(Прогон, Знач КоличествоТестов)

	Статистика = Прогон.Статистика.СтатистикаТестПлана();
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0)).Равно(КоличествоТестов);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("НаборовСломано", 0)).Равно(0);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("НаборовОшибка", 0)).Равно(0);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовСломано", 0)).Равно(0);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовОшибка", 0)).Равно(0);

КонецПроцедуры

Процедура ПроверитьКонструктор(Записи, Знач ИмяУзла, Знач ИмяМетода)

	Конструкторы = Записи.ПроцессорКоллекции()
		.Фильтровать(
			"Запись -> Запись.phase = ""Конструктор"" И Запись.name = Имя И Запись.method = Метод",
			Новый Структура("Имя, Метод", ИмяУзла, ИмяМетода)
		)
		.Получить("СписокМассив");
	Ожидаем.Что(Конструкторы.Количество()).Равно(1);
	Ожидаем.Что(Конструкторы.Получить(0).correct_class).ЭтоИстина();

КонецПроцедуры

Процедура ПроверитьЗаписиТеста(Записи, Знач ИмяТеста, Знач ИмяМетода)

	ЗаписиТеста = Записи.ПроцессорКоллекции()
		.Фильтровать("Запись -> Запись.phase <> ""Конструктор""")
		.Получить("СписокМассив");
	Ожидаем.Что(ЗаписиТеста.Количество()).Равно(2);

	Для Каждого Запись Из ЗаписиТеста Цикл

		Ожидаем.Что(Запись.name).Равно(ИмяТеста);
		Ожидаем.Что(Запись.method).Равно(ИмяМетода);
		Ожидаем.Что(Запись.correct_class).ЭтоИстина();
		Ожидаем.Что(Запись.tags.Найти("Изоляция")).Не_().ЭтоНеопределено();
		Ожидаем.Что(Запись.tags.Найти("Метод")).Не_().ЭтоНеопределено();

	КонецЦикла;

КонецПроцедуры

Функция ПрочитатьЗаписи(Знач Вывод)

	Возврат ПроцессорыКоллекций.ИзКоллекции(СтрРазделить(Вывод, Символы.ПС))
		.Фильтровать("Строка -> СтрНачинаетсяС(Строка, ""TEST_INFO:"")")
		.Обработать(
			"Строка -> {
			|	Чтение = Новый ЧтениеJSON;
			|	Чтение.УстановитьСтроку(Сред(Строка, СтрДлина(""TEST_INFO:"") + 1));
			|	Запись = ПрочитатьJSON(Чтение);
			|	Чтение.Закрыть();
			|	Возврат Запись;
			|}"
		)
		.Получить("СписокМассив");

КонецФункции
