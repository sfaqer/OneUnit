#Использовать asserts
#Использовать collectionos
#Использовать fluent
#Использовать tempfiles
#Использовать "./support"
#Использовать ".."

&ПараметризованныйТест
&ИсточникЗначение("НаборСИнформациейОПовторении")
&ИсточникЗначение("ИзолированныйПоделкаПовтор")
&ИсточникЗначение("ИзолированныйПроцессПовтор")
&ИсточникЗначение("ИзолированныеМетодыПовторений")
Процедура НомерИКоличествоДоступныВМетодахИПолях(ИмяНабора) Экспорт

	Прогон = ПрогнатьНабор(ИмяНабора);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	ПроверитьУспех(Прогон, 4);

	Для Каждого Шаблон Из Набор.Дети() Цикл

		Ожидаем.Что(Шаблон.Повторение().Пустой()).ЭтоИстина();
		Номер = 0;
		Количество = Шаблон.Дети().Количество();

		Для Каждого Вызов Из Шаблон.Дети() Цикл

			Номер = Номер + 1;
			ПроверитьПовторение(Вызов.Повторение().Получить(), Номер, Количество);
			Записи = ПрочитатьЗаписи(Прогон.Статистика.Результат(Вызов).Вывод());
			Ожидаем.Что(Записи.Количество()).Равно(6);
			Этапы = Записи.ПроцессорКоллекции().Обработать("Запись -> Запись.phase").Получить("МножествоСоответствие");
			Ожидаем.Что(Этапы.Количество()).Равно(6);
			Ожидаем.Что(Этапы.Содержит("ПередКаждым")).ЭтоИстина();
			Ожидаем.Что(Этапы.Содержит("Тест")).ЭтоИстина();
			Ожидаем.Что(Этапы.Содержит("ПослеКаждого")).ЭтоИстина();

			Для Каждого Запись Из Записи Цикл

				Ожидаем.Что(Запись.current).Равно(Номер);
				Ожидаем.Что(Запись.total).Равно(Количество);

			КонецЦикла;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура НомерНеЗависитОтОтображаемогоИмени() Экспорт

	Прогон = ПрогнатьНабор("НаборСИнформациейОПовторении");
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, "НаборСИнформациейОПовторении");
	Шаблон = ПрогоныТестов.НайтиТест(Набор, "Повтор");
	Ожидаем.Что(Шаблон.Дети().Количество()).Равно(3);

	Для Индекс = 0 По Шаблон.Дети().ВГраница() Цикл

		Вызов = Шаблон.Дети().Получить(Индекс);
		Ожидаем.Что(Вызов.Имя()).Равно("Одинаковое имя");
		ПроверитьПовторение(Вызов.Повторение().Получить(), Индекс + 1, 3);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ПолеОдиночкиОбновляетсяИСохраняетПрежниеСнимки() Экспорт

	ИмяНабора = "ОдиночкаСИнформациейОПовторении";
	Прогон = ПрогнатьНабор(ИмяНабора);
	ПроверитьУспех(Прогон, 3);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	Шаблон = Набор.Дети().Получить(0);
	ЧислоКонструкторов = СтрЧислоВхождений(Прогон.Статистика.Результат(Набор).Вывод(), "SINGLE_CONSTRUCTOR");

	Для Индекс = 0 По Шаблон.Дети().ВГраница() Цикл

		Вывод = Прогон.Статистика.Результат(Шаблон.Дети().Получить(Индекс)).Вывод();
		ЧислоКонструкторов = ЧислоКонструкторов + СтрЧислоВхождений(Вывод, "SINGLE_CONSTRUCTOR");
		Записи = ПрочитатьЗаписи(Вывод);
		Ожидаем.Что(Записи.Количество()).Равно(2);
		Ожидаем.Что(Записи.Получить(0).current).Равно(Индекс + 1);
		Ожидаем.Что(Записи.Получить(1).current).Равно(Индекс + 1);

	КонецЦикла;

	Ожидаем.Что(ЧислоКонструкторов).Равно(1);

КонецПроцедуры

&Тест
Процедура СоставПланаСохраняетСведенияОПовторении() Экспорт

	Прогон = ПрогнатьНабор("НаборСИнформациейОПовторении");
	Репортер = Прогон.Поделка.НайтиЖелудь("РепортерПланJSON");
	Путь = ВременныеФайлы.НовоеИмяФайла("json");
	Репортер.ЗаписатьПлан(Прогон.План, Путь);
	Состав = Репортер.ПрочитатьСостав(Путь).Получить();
	Шаблоны = Состав.Получить(0).Тесты;
	Ожидаем.Что(Шаблоны.Количество()).Равно(2);

	Для Каждого Шаблон Из Шаблоны Цикл

		Ожидаем.Что(Шаблон.Повторение.Пустой()).ЭтоИстина();

		Для Индекс = 0 По Шаблон.Дети.ВГраница() Цикл
			ПроверитьПовторение(Шаблон.Дети.Получить(Индекс).Повторение.Получить(), Индекс + 1, Шаблон.Дети.Количество());
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Обычный", 1)
&ИсточникЗначение("Параметры", 2)
Процедура ВнеПовторяемогоТестаЗначениеНедоступноДажеПриНаличииУмолчания(ИмяМетода, Количество) Экспорт

	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.ТестовыеМетодыВключаемые", ИмяМетода);
	ИмяНабора = "НедоступнаяИнформацияОПовторении";
	Прогон = ПрогоныТестов.Прогнать(ИмяНабора, "", ПутьНабора(ИмяНабора), Детальки);
	Статистика = Прогон.Статистика.СтатистикаТестПлана();
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовСломано", 0)).Равно(Количество);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	Узел = Набор.Дети().Получить(0);
	Вызовы = ?(Узел.ТипОпределения() = ТипыОпределенийТестов.Контейнер, Узел.Дети(), Списки.ИзЭлементов(Узел));

	Для Каждого Вызов Из Вызовы Цикл

		Ожидаем.Что(Вызов.Повторение().Пустой()).ЭтоИстина();
		ПроверитьНедоступность(Прогон.Статистика.Результат(Вызов));

	КонецЦикла;

	Репортер = Прогон.Поделка.НайтиЖелудь("РепортерПланJSON");
	Состав = Репортер.СоставЗаписей(Репортер.ЗаписиСостава(Репортер.СоставПлана(Прогон.План)));
	Ожидаем.Что(Состав.Получить(0).Тесты.Получить(0).Повторение.Пустой()).ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("НедоступноеПовторениеПередВсеми")
&ИсточникЗначение("НедоступноеПовторениеПослеВсех")
Процедура МетодыНабораНеПолучаютИнформациюОПовторении(ИмяНабора) Экспорт

	Прогон = ПрогнатьНабор(ИмяНабора);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	ПроверитьНедоступность(Прогон.Статистика.Результат(Набор));

КонецПроцедуры

&Тест
Процедура КонструкторОдиночкиНеПолучаетИнформациюОПовторении() Экспорт

	ИмяНабора = "НедоступноеПовторениеКонструктораОдиночки";
	Прогон = ПрогнатьНабор(ИмяНабора);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);

	ПроверитьНедоступность(Прогон.Статистика.Результат(Набор));

КонецПроцедуры

&Тест
Процедура КонструкторКомпанейскогоНабораНеПолучаетИнформациюОПовторении() Экспорт

	ИмяНабора = "НедоступноеПовторениеКонструктора";
	Прогон = ПрогнатьНабор(ИмяНабора);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	ПроверитьНедоступность(Прогон.Статистика.Результат(Набор));

КонецПроцедуры

&Тест
Процедура ПолеОдиночкиНеПередаётСведенияОПовторенииОбычномуТесту() Экспорт

	ИмяНабора = "СмешанныйНаборСИнформациейОПовторении";
	Прогон = ПрогнатьНабор(ИмяНабора);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	Шаблон = ПрогоныТестов.НайтиТест(Набор, "Повтор");
	РезультатПовторения = Прогон.Статистика.Результат(Шаблон.Дети().Получить(0));
	Ожидаем.Что(РезультатПовторения.Состояние()).Равно(СостоянияВыполненияТестов.Успех);
	Обычный = ПрогоныТестов.НайтиТест(Набор, "Обычный");
	ПроверитьНедоступность(Прогон.Статистика.Результат(Обычный));

КонецПроцедуры

&Тест
Процедура ПадениеПовторенияНеОстанавливаетСледующие() Экспорт

	ИмяНабора = "НаборСПадениемПовторения";
	Прогон = ПрогнатьНабор(ИмяНабора);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	Вызовы = Набор.Дети().Получить(0).Дети();
	Ожидаем.Что(Вызовы.Количество()).Равно(3);

	Для Индекс = 0 По Вызовы.ВГраница() Цикл

		Результат = Прогон.Статистика.Результат(Вызовы.Получить(Индекс));
		Состояние = ?(Индекс = 0, СостоянияВыполненияТестов.Сломан, СостоянияВыполненияТестов.Успех);
		Ожидаем.Что(Результат.Состояние(), Результат.ОписанияПричин()).Равно(Состояние);
		Записи = ПрочитатьЗаписи(Результат.Вывод());
		Ожидаем.Что(Записи.Количество()).Равно(1);
		Ожидаем.Что(Записи.Получить(0).current).Равно(Индекс + 1);
		Ожидаем.Что(Записи.Получить(0).total).Равно(3);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ИзменениеОпциональногоНеМеняетСведенияВПланеИОписании() Экспорт

	Прогон = ПрогнатьНабор("НаборСИнформациейОПовторении");
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, "НаборСИнформациейОПовторении");
	Вызов = ПрогоныТестов.НайтиТест(Набор, "Повтор").Дети().Получить(0);
	Информация = Вызов.Повторение().Получить();
	Повторение = Новый Опциональный(Информация);
	Описание = Прогон.Поделка.НайтиЖелудь("ОписаниеТеста", Массивы.ИзЭлементов(
		"Имя",
		Списки.ИзЭлементов(),
		Повторение
	));
	КопияВызова = Прогон.Поделка.НайтиЖелудь("ОпределениеТеста", Массивы.ИзЭлементов(
		Вызов.ТипОпределения(),
		Вызов.Имя(),
		Новый СписокМассив,
		Вызов.Родитель(),
		Вызов.ИмяМетода(),
		Вызов.Параметры(),
		Вызов.Таймаут(),
		Вызов.Теги(),
		Вызов.Условия(),
		Вызов.Порядок(),
		Вызов.Изоляция(),
		Вызов.Исполнитель(),
		Повторение
	));
	Повторение.ЕслиСодержитЗначение("Информация -> Информация = Неопределено");
	ПроверитьПовторение(Описание.Повторение().Получить(), 1, 3);

	Для Каждого Объект Из Списки.ИзЭлементов(Вызов, Описание, КопияВызова) Цикл

		Объект.Повторение().ЕслиСодержитЗначение("Информация -> Информация = Неопределено");
		ПроверитьПовторение(Объект.Повторение().Получить(), 1, 3);

	КонецЦикла;

КонецПроцедуры

Функция ПрогнатьНабор(Знач ИмяНабора)
	Возврат ПрогоныТестов.ПрогнатьОднажды("repetition-info:" + ИмяНабора, ИмяНабора, "", ПутьНабора(ИмяНабора));
КонецФункции

Функция ПутьНабора(Знач ИмяНабора)
	Возврат "./tests/fixtures/repetition-info/" + ИмяНабора + ".os";
КонецФункции

Процедура ПроверитьПовторение(Информация, Знач Номер, Знач Количество)

	Ожидаем.Что(Информация).ИмеетТип("ИнформацияОПовторении");
	Ожидаем.Что(Информация.ТекущееПовторение()).Равно(Номер);
	Ожидаем.Что(Информация.ВсегоПовторений()).Равно(Количество);

КонецПроцедуры

Процедура ПроверитьУспех(Прогон, Знач Количество)

	Статистика = Прогон.Статистика.СтатистикаТестПлана();
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0)).Равно(Количество);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовСломано", 0)).Равно(0);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовОшибка", 0)).Равно(0);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("НаборовСломано", 0)).Равно(0);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("НаборовОшибка", 0)).Равно(0);

КонецПроцедуры

Процедура ПроверитьНедоступность(Результат)

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Описание = ТестированиеСлужебный.ПодробноеОписаниеОшибки("Причина", Результат.Причины().Получить(0));
	Ожидаем.Что(Описание).Содержит("Информация о повторении доступна только при выполнении повторяемого теста");
	Ожидаем.Что(Результат.Вывод()).Не_().Содержит("UNEXPECTED_BODY");

КонецПроцедуры

Функция ПрочитатьЗаписи(Знач Вывод)

	Возврат ПроцессорыКоллекций.ИзКоллекции(СтрРазделить(Вывод, Символы.ПС))
		.Фильтровать("Строка -> СтрНачинаетсяС(Строка, ""REPETITION_INFO:"")")
		.Обработать(
			"Строка -> {
			|	Чтение = Новый ЧтениеJSON;
			|	Чтение.УстановитьСтроку(Сред(Строка, СтрДлина(""REPETITION_INFO:"") + 1));
			|	Запись = ПрочитатьJSON(Чтение);
			|	Чтение.Закрыть();
			|	Возврат Запись;
			|}"
		)
		.Получить("СписокМассив");

КонецФункции
