#Использовать asserts
#Использовать collectionos
#Использовать fluent
#Использовать tempfiles
#Использовать "./support"
#Использовать ".."
#Использовать "../src/shared"

&ПараметризованныйТест
&ИсточникЗначение("НаборСИнформациейОВызове")
&ИсточникЗначение("ИзолированныйПоделкаВызов")
&ИсточникЗначение("ИзолированныйПроцессВызов")
&ИсточникЗначение("ИзолированныеМетодыВызовов")
Процедура ИнформацияДоступнаВМетодахИПолях(ИмяНабора) Экспорт

	Прогон = ПрогнатьНабор(ИмяНабора);
	ПроверитьУспех(Прогон, 7);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	Ожидаем.Что(Набор.Дети().Количество()).Равно(5);

	Для Каждого Шаблон Из Набор.Дети() Цикл

		Ожидаем.Что(Шаблон.НомерПараметризованногоВызова().Пустой()).ЭтоИстина();

		Если Шаблон.ИмяМетода() = "Значения" Тогда
			КоличествоАргументов = 2;
		ИначеЕсли Шаблон.ИмяМетода() = "Объекты" Тогда
			КоличествоАргументов = 3;
		ИначеЕсли Шаблон.ИмяМетода() = "БезАргументов" Тогда
			КоличествоАргументов = 0;
		Иначе
			КоличествоАргументов = 1;
		КонецЕсли;

		Для Индекс = 0 По Шаблон.Дети().ВГраница() Цикл

			Вызов = Шаблон.Дети().Получить(Индекс);
			Ожидаем.Что(Вызов.НомерПараметризованногоВызова().Получить()).Равно(Индекс + 1);
			Записи = ПрочитатьЗаписи(Прогон.Статистика.Результат(Вызов).Вывод());
			Ожидаем.Что(Записи.Количество()).Равно(6);
			Этапы = Записи.ПроцессорКоллекции().Обработать("Запись -> Запись.phase").Получить("МножествоСоответствие");
			Ожидаем.Что(Этапы.Количество()).Равно(6);

			Для Каждого Запись Из Записи Цикл

				Ожидаем.Что(Запись.number).Равно(Индекс + 1);
				Ожидаем.Что(Запись.count).Равно(КоличествоАргументов);
				Ожидаем.Что(Запись.types.Количество()).Равно(КоличествоАргументов);

			КонецЦикла;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура РазныеИсточникиИОдинаковыеЗначенияПолучаютПоследовательныеНомера() Экспорт

	ИмяНабора = "РазныеИсточникиВызовов";
	Прогон = ПрогнатьНабор(ИмяНабора);
	ПроверитьУспех(Прогон, 8);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	Вызовы = Набор.Дети().Получить(0).Дети();
	Значения = Списки.ИзЭлементов(
		"Значение",
		"Значение",
		Неопределено,
		"JSON1",
		"JSON2",
		НаправлениеПоиска.СНачала,
		НаправлениеПоиска.СКонца,
		"Выражение"
	);
	Ожидаем.Что(Вызовы.Количество()).Равно(Значения.Количество());

	Для Индекс = 0 По Вызовы.ВГраница() Цикл

		Вызов = Вызовы.Получить(Индекс);
		Ожидаем.Что(Вызов.Имя()).Равно("Одинаковое имя");
		Ожидаем.Что(Вызов.НомерПараметризованногоВызова().Получить()).Равно(Индекс + 1);
		Ожидаем.Что(Вызов.Параметры().Получить(0)).Равно(Значения.Получить(Индекс));
		Записи = ПрочитатьЗаписи(Прогон.Статистика.Результат(Вызов).Вывод());
		Ожидаем.Что(Записи.Количество()).Равно(1);
		Ожидаем.Что(Записи.Получить(0).number).Равно(Индекс + 1);
		Ожидаем.Что(Записи.Получить(0).count).Равно(1);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ПовторноеОбнаружениеНачинаетНумерациюЗаново() Экспорт

	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.КаталогиТестов", "");
	Детальки.Вставить("OneUnit.ФайлыТестов", ПутьНабора("РазныеИсточникиВызовов"));
	Детальки.Вставить("OneUnit.ТестовыеНаборыВключаемые", "РазныеИсточникиВызовов");
	Поделка = ПрогоныТестов.СоздатьПоделку(Детальки);
	Менеджер = Поделка.НайтиЖелудь("МенеджерТестирования");

	Для Повтор = 1 По 2 Цикл

		Набор = ПрогоныТестов.НайтиНабор(Менеджер.Обнаружить(), "РазныеИсточникиВызовов");
		Вызовы = Набор.Дети().Получить(0).Дети();
		Ожидаем.Что(Вызовы.Количество()).Равно(8);

		Для Индекс = 0 По Вызовы.ВГраница() Цикл
			Ожидаем.Что(Вызовы.Получить(Индекс).НомерПараметризованногоВызова().Получить()).Равно(Индекс + 1);
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ПолеОдиночкиОбновляетсяИСохраняетСнимкиВызовов() Экспорт

	ИмяНабора = "ОдиночкаСИнформациейОВызове";
	Прогон = ПрогнатьНабор(ИмяНабора);
	ПроверитьУспех(Прогон, 3);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	КоличествоКонструкторов = СтрЧислоВхождений(
		Прогон.Статистика.Результат(Набор).Вывод(),
		"INVOCATION_SINGLE_CONSTRUCTOR"
	);
	Вызовы = Набор.Дети().Получить(0).Дети();

	Для Индекс = 0 По Вызовы.ВГраница() Цикл

		Вывод = Прогон.Статистика.Результат(Вызовы.Получить(Индекс)).Вывод();
		КоличествоКонструкторов = КоличествоКонструкторов + СтрЧислоВхождений(Вывод, "INVOCATION_SINGLE_CONSTRUCTOR");
		Записи = ПрочитатьЗаписи(Вывод);
		Ожидаем.Что(Записи.Количество()).Равно(2);
		Ожидаем.Что(Записи.Получить(0).number).Равно(Индекс + 1);
		Ожидаем.Что(Записи.Получить(1).number).Равно(Индекс + 1);

	КонецЦикла;

	Ожидаем.Что(КоличествоКонструкторов).Равно(1);

КонецПроцедуры

&Тест
Процедура АргументыКопируютсяВСписокТолькоДляЧтения() Экспорт

	Поделка = ПоделкаБезТестов();
	Объект = Новый Структура("Значение", 33);
	Источник = Новый СписокМассив(Списки.ИзЭлементов(11, Неопределено, Объект));
	Информация = Поделка.НайтиЖелудь("ИнформацияОПараметризованномВызове", Массивы.ИзЭлементов(7, Источник));
	Источник.Очистить();
	Источник.Добавить(99);

	Ожидаем.Что(Информация.НомерВызова()).Равно(7);
	Ожидаем.Что(Информация.Аргументы().Количество()).Равно(3);
	Ожидаем.Что(Информация.Аргументы().Получить(0)).Равно(11);
	Ожидаем.Что(Информация.Аргументы().Получить(1)).ЭтоНеопределено();
	Ожидаем.Что(Информация.Аргументы().Получить(2)).Равно(Объект);
	Информация.Аргументы().ПроцессорКоллекции().ДляКаждого("Аргумент -> Аргумент = Неопределено");
	Ожидаем.Что(Информация.Аргументы().Получить(0)).Равно(11);
	Ожидаем.Что(Информация.Аргументы().Получить(2)).Равно(Объект);
	ОшибкаИзменения = Неопределено;

	Попытка
		Информация.Аргументы().Добавить(22);
	Исключение
		ОшибкаИзменения = ИнформацияОбОшибке();
	КонецПопытки;

	Ожидаем.Что(ОшибкаИзменения).Не_().ЭтоНеопределено();
	Ожидаем.Что(Информация.Аргументы().Количество()).Равно(3);

КонецПроцедуры

&Тест
Процедура ПланПередаётНомерБезСериализацииОбъектовАргументов() Экспорт

	Прогон = ПрогнатьНабор("НаборСИнформациейОВызове");
	Репортер = Прогон.Поделка.НайтиЖелудь("РепортерПланJSON");
	Путь = ВременныеФайлы.НовоеИмяФайла("json");
	Репортер.ЗаписатьПлан(Прогон.План, Путь);
	Состав = Репортер.ПрочитатьСостав(Путь).Получить();
	Ожидаем.Что(Состав.Получить(0).Тесты.Количество()).Равно(5);

	Для Каждого Шаблон Из Состав.Получить(0).Тесты Цикл

		Ожидаем.Что(Шаблон.НомерВызова.Пустой()).ЭтоИстина();

		Для Индекс = 0 По Шаблон.Дети.ВГраница() Цикл
			Ожидаем.Что(Шаблон.Дети.Получить(Индекс).НомерВызова.Получить()).Равно(Индекс + 1);
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Обычный", 1)
&ИсточникЗначение("Повтор", 2)
Процедура ВнеПараметризованногоТестаСведенияНедоступны(ИмяМетода, Количество) Экспорт

	ИмяНабора = "НедоступнаяИнформацияОВызове";
	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.ТестовыеМетодыВключаемые", ИмяМетода);
	Прогон = ПрогоныТестов.Прогнать(ИмяНабора, "", ПутьНабора(ИмяНабора), Детальки);
	Статистика = Прогон.Статистика.СтатистикаТестПлана();
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовСломано", 0)).Равно(Количество);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	Узел = Набор.Дети().Получить(0);
	Вызовы = ?(Узел.ТипОпределения() = ТипыОпределенийТестов.Контейнер, Узел.Дети(), Списки.ИзЭлементов(Узел));

	Для Каждого Вызов Из Вызовы Цикл

		Ожидаем.Что(Вызов.НомерПараметризованногоВызова().Пустой()).ЭтоИстина();
		ПроверитьНедоступность(Прогон.Статистика.Результат(Вызов));

	КонецЦикла;

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("НедоступныйВызовПередВсеми")
&ИсточникЗначение("НедоступныйВызовПослеВсех")
&ИсточникЗначение("НедоступныйВызовКонструктора")
&ИсточникЗначение("НедоступныйВызовКонструктораОдиночки")
Процедура УровеньНабораНеПолучаетИнформациюОВызове(ИмяНабора) Экспорт

	Прогон = ПрогнатьНабор(ИмяНабора);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	ПроверитьНедоступность(Прогон.Статистика.Результат(Набор));

КонецПроцедуры

&Тест
Процедура ПолеОдиночкиНеПередаётИнформациюВСледующийОбычныйТест() Экспорт

	ИмяНабора = "СмешанныйНаборВызовов";
	Прогон = ПрогнатьНабор(ИмяНабора);
	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);
	ПервыйВызов = ПрогоныТестов.НайтиТест(Набор, "Значения").Дети().Получить(0);
	Ожидаем.Что(Прогон.Статистика.Результат(ПервыйВызов).Состояние()).Равно(СостоянияВыполненияТестов.Успех);
	Обычный = ПрогоныТестов.НайтиТест(Набор, "Обычный");
	ПроверитьНедоступность(Прогон.Статистика.Результат(Обычный));

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("0")
&ИсточникЗначение("-1")
&ИсточникЗначение("1.5")
&ИсточникЗначение("null")
&ИсточникЗначение("{}")
&ИсточникЗначение("""1""")
Процедура НекорректныйНомерДаётНеразобранныйПлан(НомерJSON) Экспорт

	Репортер = ПоделкаБезТестов().НайтиЖелудь("РепортерПланJSON");
	Путь = ВременныеФайлы.НовоеИмяФайла("json");
	Текст = СтрШаблон(
		"{""suites"":[{""suite"":""Набор"",""output"":"""",""errors"":[],""tests"":[{
		|""test"":""Тест"",""method"":""Тест"",""output"":"""",""errors"":[],""parameterized_invocation"":%1}]}]}",
		НомерJSON
	);
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8NoBOM);
	Запись.Записать(Текст);
	Запись.Закрыть();

	Ожидаем.Что(Репортер.ПрочитатьСостав(Путь).Пустой()).ЭтоИстина();

КонецПроцедуры

Функция ПрогнатьНабор(Знач ИмяНабора)
	Возврат ПрогоныТестов.ПрогнатьОднажды("invocation-info:" + ИмяНабора, ИмяНабора, "", ПутьНабора(ИмяНабора));
КонецФункции

Функция ПутьНабора(Знач ИмяНабора)
	Возврат "./tests/fixtures/parameterized-info/" + ИмяНабора + ".os";
КонецФункции

Функция ПоделкаБезТестов()

	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.КаталогиТестов", "");
	Детальки.Вставить("OneUnit.ФайлыТестов", "");
	Возврат ПрогоныТестов.СоздатьПоделку(Детальки);

КонецФункции

Процедура ПроверитьУспех(Прогон, Знач Количество)

	Статистика = Прогон.Статистика.СтатистикаТестПлана();
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0)).Равно(Количество);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовСломано", 0)).Равно(0);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовОшибка", 0)).Равно(0);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("НаборовСломано", 0)).Равно(0);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("НаборовОшибка", 0)).Равно(0);

КонецПроцедуры

Процедура ПроверитьНедоступность(Результат)

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Описание = ТестированиеСлужебный.ПодробноеОписаниеОшибки("Причина", Результат.Причины().Получить(0));
	Ожидаем.Что(Описание).Содержит(
		"Информация о параметризованном вызове доступна только при выполнении параметризованного теста"
	);
	Ожидаем.Что(Результат.Вывод()).Не_().Содержит("UNEXPECTED_INVOCATION_BODY");

КонецПроцедуры

Функция ПрочитатьЗаписи(Знач Вывод)

	Возврат ПроцессорыКоллекций.ИзКоллекции(СтрРазделить(Вывод, Символы.ПС))
		.Фильтровать("Строка -> СтрНачинаетсяС(Строка, ""INVOCATION_INFO:"")")
		.Обработать(
			"Строка -> {
			|	Чтение = Новый ЧтениеJSON;
			|	Чтение.УстановитьСтроку(Сред(Строка, СтрДлина(""INVOCATION_INFO:"") + 1));
			|	Запись = ПрочитатьJSON(Чтение);
			|	Чтение.Закрыть();
			|	Возврат Запись;
			|}"
		)
		.Получить("СписокМассив");

КонецФункции
