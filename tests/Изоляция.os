КонецПроцедуры

&Тест
Процедура БитаяЛямбдаСоветаЛомаетТестНеРоняяПрогон() Экспорт

	// Поделочная лямбда падает в родителе, процессная - в точке входа ребенка:
	// оба теста ломаются с причинами, прогон продолжается
	Прогон     = ПрогоныТестов.Прогнать("НаборСБитойЛямбдойСовета", "./tests/fixtures/isolation");
	Статистика = Прогон.Статистика.СтатистикаТестПлана();

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовСломано", 0)).Равно(2);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("НаборовОбнаружено", 0)).Равно(1);

КонецПроцедуры

&Тест
Процедура СоветБезЭкземпляраЛомаетНаборПричинойСоздания() Экспорт

	// Лямбда совета обращается к методу набора, а набор не создался: причина -
	// конструктор, ошибка совета - ее следствие, корень - лог autumn с исключением
	// конструктора. Совет строится и при обнаружении состава, и при исполнении
	ИмяНабора = "ИзолированныйНаборСоСломаннымКонструкторомИСоветом";

	План  = ПланОбнаружения(ИмяНабора);
	Набор = ПрогоныТестов.НайтиНабор(План, ИмяНабора);

	Ошибка = Набор.ОшибкиОбнаружения().Получить(0);

	Ожидаем.Что(Ошибка.Описание).Равно("Не удаётся инстанцировать тестовый набор");

	ПроверитьЦепочкуПричинСовета(Ошибка);

	Прогон = ПрогоныТестов.Прогнать(ИмяНабора, "./tests/fixtures/isolation");
	Набор  = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);

	Результат = Прогон.Статистика.Результат(Набор);

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Ожидаем.Что(Результат.ОписанияПричин().Получить(0)).Равно("Не удаётся инстанцировать тестовый набор");

	ПроверитьЦепочкуПричинСовета(Результат.Причины().Получить(0));

КонецПроцедуры

&Тест
Процедура ВыводСоветаДостаетсяНабору() Экспорт

	// Лямбда совета пишет в консоль: вывод построения совета - в выводе набора.
	// На уровне процесса точка входа ребенка передает его родителю сообщением канала
	Прогон = ПрогоныТестов.Прогнать(
		"ИзолированныйНаборСВыводомСовета,ИзолированныйПроцессныйНаборСВыводомСовета",
		"./tests/fixtures/isolation"
	);

	ИменаНаборов = Массивы.ИзЭлементов("ИзолированныйНаборСВыводомСовета", "ИзолированныйПроцессныйНаборСВыводомСовета");

	Для Каждого ИмяНабора Из ИменаНаборов Цикл

		Результат = Прогон.Статистика.Результат(ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора));

		Ожидаем.Что(Результат.Состояние(), ИмяНабора).Равно(СостоянияВыполненияТестов.Успех);
		Ожидаем.Что(СтрНайти(Результат.Вывод(), "ВыводСовета"), ИмяНабора + ": " + Результат.Вывод()).Больше(0);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ВыводУпавшегоСоветаИдетСОтказом() Экспорт

	// Лямбда совета пишет в консоль и падает: при обнаружении вывод - в подробной
	// причине отказа, при исполнении - в выводе сломанного набора
	ИмяНабора = "ИзолированныйНаборСВыводомПередОтказомСовета";

	План  = ПланОбнаружения(ИмяНабора);
	Набор = ПрогоныТестов.НайтиНабор(План, ИмяНабора);

	ЦепочкиПричин.ПроверитьЗвенья(Набор.ОшибкиОбнаружения().Получить(0), Массивы.ИзЭлементов("Совет сломан намеренно"));
	ЦепочкиПричин.ПроверитьВывод(Набор.ОшибкиОбнаружения().Получить(0), "ВыводПередОтказомСовета");

	Прогон = ПрогоныТестов.Прогнать(ИмяНабора, "./tests/fixtures/isolation");
	Набор  = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);

	Результат = Прогон.Статистика.Результат(Набор);

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Ожидаем.Что(СтрНайти(Результат.ОписанияПричин().Получить(0), "Совет сломан намеренно")).Больше(0);
	Ожидаем.Что(СтрНайти(Результат.Вывод(), "ВыводПередОтказомСовета"), Результат.Вывод()).Больше(0);

КонецПроцедуры

&Тест
Процедура ВыводУпавшегоСоветаПроцессаИдетСОтказом() Экспорт

	// Точка входа ребенка печатает отказ лямбды совета вместе с ее выводом,
	// и он доходит до подробной причины сломанного набора
	ИмяНабора = "ИзолированныйПроцессныйНаборСВыводомПередОтказомСовета";

	Прогон = ПрогоныТестов.Прогнать(ИмяНабора, "./tests/fixtures/isolation");

	Результат = Прогон.Статистика.Результат(ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора));

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);

	ЦепочкиПричин.ПроверитьВывод(Результат.Причины().Получить(0), "ВыводПередОтказомСовета");

КонецПроцедуры

&Тест
Процедура ОтказСобранногоПоСоветуНесетВыводСовета() Экспорт

	// Лямбда совета пишет в консоль и возвращает не совет: поделка по нему
	// не собирается, а вывод совета идет с отказом среды - у поделки в выводе
	// набора, у процесса - в подробной причине
	Прогон = ПрогоныТестов.Прогнать(
		"ИзолированныйНаборСВыводомИНеСоветом,ИзолированныйПроцессныйНаборСВыводомИНеСоветом",
		"./tests/fixtures/isolation"
	);

	Результат = Прогон.Статистика.Результат(ПрогоныТестов.НайтиНабор(Прогон.План, "ИзолированныйНаборСВыводомИНеСоветом"));

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Ожидаем.Что(СтрНайти(Результат.Вывод(), "ВыводНеСовета"), Результат.Вывод()).Больше(0);

	Результат = Прогон.Статистика.Результат(
		ПрогоныТестов.НайтиНабор(Прогон.План, "ИзолированныйПроцессныйНаборСВыводомИНеСоветом")
	);

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);

	ЦепочкиПричин.ПроверитьВывод(Результат.Причины().Получить(0), "ВыводНеСовета");

КонецПроцедуры

&Тест
Процедура ОтказСоветаБезЗахватаНеПриписываетсяСозданиюНабора() Экспорт

	// Конструктору набора нужны параметры: точка входа ребенка не создает набор
	// напрямую, и лямбда совета исполняется без захвата. Ее отказ - собственный,
	// а не следствие создания набора
	ИмяНабора = "ИзолированныйПроцессныйНаборСПараметрамиКонструктораИБитымСоветом";

	Прогон = ПрогоныТестов.Прогнать(ИмяНабора, "./tests/fixtures/isolation");

	Результат = Прогон.Статистика.Результат(ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора));

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);

	Описание = ТестированиеСлужебный.ПодробноеОписаниеОшибки("Причина", Результат.Причины().Получить(0));

	Ожидаем.Что(СтрНайти(Описание, "СоветаНет"), Описание).Больше(0);
	Ожидаем.Что(СтрНайти(Описание, "Не удаётся инстанцировать"), Описание).Равно(0);

КонецПроцедуры

&Тест
Процедура СоветЗахватываетНаборСНеобязательнымиПараметрамиКонструктора() Экспорт

	// Конструктор, все параметры которого необязательные, создается и без аргументов:
	// точка входа ребенка поднимает набор напрямую, и лямбда совета строит совет
	// методом набора
	Статистика = СтатистикаПрогона("ИзолированныйПроцессныйНаборСНеобязательнымПараметромКонструктора");

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0)).Равно(1);

КонецПроцедуры

&Тест
Процедура СоветБезЭкземпляраЗавершаетДочернийПроцессЦепочкойПричин() Экспорт

	// На уровне процесса лямбда совета исполняется в точке входа дочернего
	// процесса: он завершается аварийно, а в его выводе - цепочка причин от отказа
	// создания набора через ошибку лямбды до исключения конструктора
	ИмяНабора = "ИзолированныйПроцессныйНаборСоСломаннымКонструкторомИСоветом";

	План  = ПланОбнаружения(ИмяНабора);
	Набор = ПрогоныТестов.НайтиНабор(План, ИмяНабора);

	ПроверитьЦепочкуПричинСовета(Набор.ОшибкиОбнаружения().Получить(0));

	Прогон = ПрогоныТестов.Прогнать(ИмяНабора, "./tests/fixtures/isolation");
	Набор  = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);

	Результат = Прогон.Статистика.Результат(Набор);

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);

	ПроверитьЦепочкуПричинСовета(Результат.Причины().Получить(0));

КонецПроцедуры

&Тест
Процедура ПроцессныйНаборВклеиваетИтерацииКонтейнера() Экспорт

	// Итерации повторяемого теста изолированного процессного набора
	// вклеиваются в план родителя из отчета дочернего прогона
	Статистика = СтатистикаПрогона("ИзолированныйПроцессныйПовторяемыйНабор");

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("НаборовУспешно", 0)).Равно(1);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0)).Равно(2);

КонецПроцедуры

&Тест
Процедура ОбнаружениеПоказываетКонтейнерПроцессногоНабора() Экспорт

	// Состав контейнера приезжает из плана дочернего обнаружения с итерациями
	План  = ПланОбнаружения("ИзолированныйПроцессныйПовторяемыйНабор");
	Набор = ПрогоныТестов.НайтиНабор(План, "ИзолированныйПроцессныйПовторяемыйНабор");

	Ожидаем.Что(Набор.Дети().Количество()).Равно(1);
	Ожидаем.Что(Набор.Дети().Получить(0).Дети().Количество()).Равно(2);

КонецПроцедуры

&Тест
Процедура ПропускНабораПереноситсяИзДочернегоПрогона() Экспорт

	// Условие выключает набор только в изолированной среде: пропуск уровня
	// набора переносится из отчета дочернего прогона
	Прогон     = ПрогоныТестов.Прогнать("НаборПропускаемыйВИзоляции", "./tests/fixtures/isolation");
	Статистика = Прогон.Статистика.СтатистикаТестПлана();

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("НаборовПропущено", 0)).Равно(1);

	Набор     = ПрогоныТестов.НайтиНабор(Прогон.План, "НаборПропускаемыйВИзоляции");
	Результат = Прогон.Статистика.Результат(Набор);

	Ожидаем.Что(СтрНайти(Результат.ОписанияПричин().Получить(0), "Набор пропускается в изолированной среде")).Больше(0);

КонецПроцедуры

&Тест
Процедура ИзолированныеТестыНаследуютПадениеНабораВИзоляции() Экспорт

	// ПередВсеми фикстуры падает только в изолированной среде: обычный тест
	// зеленый, а изолированные наследуют состояние и причины сломанного набора
	Прогон     = ПрогоныТестов.Прогнать("НаборПадающийВИзоляции", "./tests/fixtures/isolation");
	Статистика = Прогон.Статистика.СтатистикаТестПлана();

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0)).Равно(1);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовСломано", 0)).Равно(2);

	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, "НаборПадающийВИзоляции");

	// Вывод набора, не дошедшего до тестов, тест наследует на обоих уровнях:
	// процессный получает его из отчета дочернего прогона
	Для Каждого ИмяТеста Из Массивы.ИзЭлементов("ПоделочныйНаследуетПадениеНабора", "ПроцессныйНаследуетПадениеНабора") Цикл

		Результат = Прогон.Статистика.Результат(ПрогоныТестов.НайтиТест(Набор, ИмяТеста));

		Ожидаем.Что(СтрНайти(Результат.ОписанияПричин().Получить(0), "ПередВсеми падает в изолированной среде"), ИмяТеста)
			.Больше(0);
		Ожидаем.Что(СтрНайти(Результат.Вывод(), "ВыводПередВсемиВИзоляции"), ИмяТеста).Больше(0);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ИзолированныеТестыНаследуютПропускНабораВИзоляции() Экспорт

	// Условие фикстуры выключает набор только в изолированной среде: обычный тест
	// зеленый, а изолированные наследуют пропуск набора дочернего прогона
	Прогон     = ПрогоныТестов.Прогнать("НаборСИзолированнымиТестамиВыключаемыйВИзоляции", "./tests/fixtures/isolation");
	Статистика = Прогон.Статистика.СтатистикаТестПлана();

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0)).Равно(1);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовПропущено", 0)).Равно(2);

	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, "НаборСИзолированнымиТестамиВыключаемыйВИзоляции");
	Тест  = ПрогоныТестов.НайтиТест(Набор, "ПроцессныйНаследуетПропускНабора");

	Результат = Прогон.Статистика.Результат(Тест);

	Ожидаем.Что(СтрНайти(Результат.ОписанияПричин().Получить(0), "Набор выключен в изолированной среде")).Больше(0);

КонецПроцедуры

&Тест
Процедура УсловияИзолированногоТестаПроверяютсяВЕгоСреде() Экспорт

	// Условие фикстуры истинно только в изолированной среде: обычный тест
	// выполняется, изолированные тесты и шаблоны обоих уровней пропускаются,
	// а итерации пропущенного шаблона не исполняются
	Прогон = ПрогоныТестов.Прогнать("НаборСУсловиямиИзолированныхТестов", "./tests/fixtures/isolation");
	Набор  = ПрогоныТестов.НайтиНабор(Прогон.План, "НаборСУсловиямиИзолированныхТестов");

	Ожидаем.Что(Прогон.Статистика.Результат(ПрогоныТестов.НайтиТест(Набор, "ОбычныйВыполняется")).Состояние())
		.Равно(СостоянияВыполненияТестов.Успех);

	Для Каждого ИмяТеста Из Массивы.ИзЭлементов("ПоделочныйВыключенВИзоляции", "ПроцессныйВыключенВИзоляции") Цикл

		Результат = Прогон.Статистика.Результат(ПрогоныТестов.НайтиТест(Набор, ИмяТеста));

		Ожидаем.Что(Результат.Состояние(), ИмяТеста).Равно(СостоянияВыполненияТестов.Пропущен);
		Ожидаем.Что(Результат.ОписанияПричин().Получить(0), ИмяТеста).Равно("Тест выключен в изолированной среде");

	КонецЦикла;

	Для Каждого ИмяТеста Из Массивы.ИзЭлементов("ПоделочныйШаблонВыключенВИзоляции", "ПроцессныйШаблонВыключенВИзоляции") Цикл

		Результат = Прогон.Статистика.Результат(ПрогоныТестов.НайтиТест(Набор, ИмяТеста));

		Ожидаем.Что(Результат.Состояние(), ИмяТеста).Равно(СостоянияВыполненияТестов.Пропущен);
		Ожидаем.Что(Результат.ОписанияПричин().Получить(0), ИмяТеста).Равно("Шаблон выключен в изолированной среде");

	КонецЦикла;

	Статистика = Прогон.Статистика.СтатистикаТестПлана();

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0), "Успешных").Равно(1);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовПропущено", 0), "Пропущенных").Равно(2);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовСломано", 0), "Сломанных").Равно(0);

КонецПроцедуры

&Тест
Процедура ВыключенныйИзолированныйТестНеПоднимаетСреду() Экспорт

	// Лямбда совета у всех тестов фикстуры битая: тест, выключенный условием
	// в родителе, пропускается, не поднимая среду. Тест, которого условия в родителе
	// не выключили, и тест с условием, которое там не решить, среду поднимают
	// и ломаются на совете
	Прогон = ПрогоныТестов.Прогнать("НаборСВыключеннымиИзолированнымиТестами", "./tests/fixtures/isolation");
	Набор  = ПрогоныТестов.НайтиНабор(Прогон.План, "НаборСВыключеннымиИзолированнымиТестами");

	Пропуски = Новый Соответствие;
	Пропуски.Вставить("ПоделочныйВыключен", "Выключен безусловно");
	Пропуски.Вставить("ПроцессныйВыключен", "Выключен безусловно");
	Пропуски.Вставить("ПроцессныйВыключенПоВерсии", "Выключен для версии OneScript");
	Пропуски.Вставить("ПроцессныйШаблонВыключен", "Шаблон выключен безусловно");
	Пропуски.Вставить("ПроцессныйВыключенМетодомНабора", "Выключен методом набора");
	Пропуски.Вставить("ПоделочныйВыключенПослеУсловияДляСреды", "Выключен после условия для среды");

	Для Каждого Пропуск Из Пропуски Цикл

		Результат = Прогон.Статистика.Результат(ПрогоныТестов.НайтиТест(Набор, Пропуск.Ключ));

		Ожидаем.Что(Результат.Состояние(), Пропуск.Ключ).Равно(СостоянияВыполненияТестов.Пропущен);
		Ожидаем.Что(Результат.ОписанияПричин().Получить(0), Пропуск.Ключ).Равно(Пропуск.Значение);

	КонецЦикла;

	// Условие на методе набора проверено на экземпляре, созданном в родителе, -
	// вывод его конструктора остается у пропущенного теста
	Результат = Прогон.Статистика.Результат(ПрогоныТестов.НайтиТест(Набор, "ПроцессныйВыключенМетодомНабора"));

	Ожидаем.Что(СтрНайти(Результат.Вывод(), "ВыводЭкземпляраВРодителе"), Результат.Вывод()).Больше(0);

	Для Каждого ИмяТеста Из Массивы.ИзЭлементов("ПроцессныйВключенВРодителе", "ПоделочныйСУсловиемДляСреды") Цикл

		Результат = Прогон.Статистика.Результат(ПрогоныТестов.НайтиТест(Набор, ИмяТеста));
		Описание  = ТестированиеСлужебный.ПодробноеОписаниеОшибки("Причина", Результат.Причины().Получить(0));

		Ожидаем.Что(Результат.Состояние(), ИмяТеста).Равно(СостоянияВыполненияТестов.Сломан);
		Ожидаем.Что(СтрНайти(Описание, "СоветаНет"), ИмяТеста + ": " + Описание).Больше(0);

	КонецЦикла;

	// И у теста, которого условия в родителе не выключили, вывод проверки в родителе не теряется
	Результат = Прогон.Статистика.Результат(ПрогоныТестов.НайтиТест(Набор, "ПроцессныйВключенВРодителе"));

	Ожидаем.Что(СтрНайти(Результат.Вывод(), "ВыводЭкземпляраВРодителе"), Результат.Вывод()).Больше(0);

КонецПроцедуры

&Тест
Процедура УсловияИзолированногоНабораПроверяютсяБезЭкземпляра() Экспорт

	// Ради условий конструктор изолированного набора вне его среды не выполняется: условие
	// на переменной окружения решается в родителе без экземпляра - набор пропущен,
	// не запуская процесс; условие на методе набора в родителе не решить - его
	// проверяет среда, и набор ломается на битом совете
	ЖурналВыполнения.Очистить();

	Прогон = ПрогоныТестов.Прогнать(
		"ИзолированныйПроцессныйНаборВыключенныйОкружением,ИзолированныйПроцессныйНаборСУсловиемНаМетоде",
		"./tests/fixtures/isolation"
	);

	Результат = Прогон.Статистика.Результат(
		ПрогоныТестов.НайтиНабор(Прогон.План, "ИзолированныйПроцессныйНаборВыключенныйОкружением")
	);

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Пропущен);
	Ожидаем.Что(Результат.ОписанияПричин().Получить(0)).Равно("Не задана переменная окружения");

	Результат = Прогон.Статистика.Результат(
		ПрогоныТестов.НайтиНабор(Прогон.План, "ИзолированныйПроцессныйНаборСУсловиемНаМетоде")
	);

	Описание = ТестированиеСлужебный.ПодробноеОписаниеОшибки("Причина", Результат.Причины().Получить(0));

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Ожидаем.Что(СтрНайти(Описание, "СоветаНет"), Описание).Больше(0);

	Ожидаем.Что(ЖурналВыполнения.Записи.Найти("КонструкторИзолированногоНабора")).ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура УсловияНабораСИмпортамиПроверяетТолькоЕгоПроцесс() Экспорт

	// В родителе класса из импорта набора нет, и условие на нем выключило бы набор.
	// Узел с импортами в родителе не проверяется: его условия решает его процесс,
	// где импорт подключен, и набор выполняется
	Статистика = СтатистикаПрогона("ИзолированныйПроцессныйНаборСУсловиемНаИмпорте");

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("НаборовУспешно", 0)).Равно(1);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0)).Равно(1);

КонецПроцедуры

&Тест
Процедура ВыводСоветаДостаетсяИзолированномуТесту() Экспорт

	// Лямбда совета изолированного теста пишет в консоль: на уровне процесса точка
	// входа ребенка передает этот вывод родителю, и он - в выводе теста, как у поделки
	Прогон = ПрогоныТестов.Прогнать("НаборСИзолированнымиТестамиСВыводомСовета", "./tests/fixtures/isolation");
	Набор  = ПрогоныТестов.НайтиНабор(Прогон.План, "НаборСИзолированнымиТестамиСВыводомСовета");

	Для Каждого ИмяТеста Из Массивы.ИзЭлементов("ПоделочныйТестСВыводомСовета", "ПроцессныйТестСВыводомСовета") Цикл

		Результат = Прогон.Статистика.Результат(ПрогоныТестов.НайтиТест(Набор, ИмяТеста));

		Ожидаем.Что(Результат.Состояние(), ИмяТеста).Равно(СостоянияВыполненияТестов.Успех);
		Ожидаем.Что(СтрНайти(Результат.Вывод(), "ВыводСовета"), ИмяТеста + ": " + Результат.Вывод()).Больше(0);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура НевернаяИзоляцияТестаВИзолированномНабореЛомаетТест() Экспорт

	// В среде изолированного набора изоляция теста не применяется, но неверное
	// объявление ломает тест, как и вне изолированной среды
	ИмяНабора = "ИзолированныйНаборСНевернойИзоляциейТеста";

	План  = ПланОбнаружения(ИмяНабора);
	Набор = ПрогоныТестов.НайтиНабор(План, ИмяНабора);

	Ошибки = ПрогоныТестов.НайтиТест(Набор, "ТестСНевернойИзоляцией").ОшибкиОбнаружения();

	Ожидаем.Что(Ошибки).ИмеетДлину(1);
	Ожидаем.Что(СтрНайти(Ошибки.Получить(0).Описание, "неизвестный уровень изоляции: Луна")).Больше(0);

	Прогон = ПрогоныТестов.Прогнать(ИмяНабора, "./tests/fixtures/isolation");
	Набор  = ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора);

	Результат = Прогон.Статистика.Результат(ПрогоныТестов.НайтиТест(Набор, "ТестСНевернойИзоляцией"));

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Сломан);
	Ожидаем.Что(СтрНайти(Результат.ОписанияПричин().Получить(0), "неизвестный уровень изоляции: Луна")).Больше(0);

	Результат = Прогон.Статистика.Результат(ПрогоныТестов.НайтиТест(Набор, "ВерныйТест"));

	Ожидаем.Что(Результат.Состояние()).Равно(СостоянияВыполненияТестов.Успех);

КонецПроцедуры

&Тест
Процедура ПустойСоветНеЛомаетИзолированныйНабор() Экспорт

	Статистика = СтатистикаПрогона("ИзолированныйНаборСПустымСоветом");

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0)).Равно(1);

КонецПроцедуры

&Тест
Процедура ПропускПереноситсяИзДочернегоПрогона() Экспорт

	Прогон     = ПрогоныТестов.Прогнать("ИзолированныйПроцессныйНаборСПропуском", "./tests/fixtures/isolation");
	Статистика = Прогон.Статистика.СтатистикаТестПлана();

	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовУспешно", 0)).Равно(1);
	Ожидаем.Что(Статистика.ПолучитьИлиУмолчание("ТестовПропущено", 0)).Равно(1);

	Набор = ПрогоныТестов.НайтиНабор(Прогон.План, "ИзолированныйПроцессныйНаборСПропуском");
	Тест  = ПрогоныТестов.НайтиТест(Набор, "ВыключенныйВПроцессе");

	Результат = Прогон.Статистика.Результат(Тест);

	Ожидаем.Что(СтрНайти(Результат.ОписанияПричин().Получить(0), "Пропуск переносится из дочернего прогона")).Больше(0);

КонецПроцедуры

&Тест
Процедура ОбнаружениеНевидимогоНабораОставляетЕгоПустым() Экспорт

	// Дочернее обнаружение не нашло набор (совет подменил фильтр) -
	// обнаружение не падает, набор остается пустым плейсхолдером
	План  = ПланОбнаружения("ИзолированныйНевидимыйНабор");
	Набор = ПрогоныТестов.НайтиНабор(План, "ИзолированныйНевидимыйНабор");

	Ожидаем.Что(Набор.Дети().Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ИзолированныйПроцессПишетСтатистикуПокрытия() Экспорт

	// При прогоне с покрытием изолированный дочерний процесс получает -codestat
	// и складывает статистику в каталог родительского прогона, который мержит
	// ее в общие отчеты покрытия.
	// Каталог - через собственный менеджер: глобальный модуль ВременныеФайлы
	// зачищается построителем декоратора при каждом создании поделки
	МенеджерВременныхФайлов = Новый МенеджерВременныхФайлов();
	КаталогСтатистики = МенеджерВременныхФайлов.СоздатьКаталог();

	ДопДетальки = Новый Соответствие;
	ДопДетальки.Вставить("OneUnit.КаталогСтатистикиПокрытия", КаталогСтатистики);

	ПрогоныТестов.Прогнать("ИзолированныйПроцессныйКрасныйНабор", "./tests/fixtures/isolation", "", ДопДетальки);

	КоличествоСтатистик = НайтиФайлы(КаталогСтатистики, "stat_*.json").Количество();
	МенеджерВременныхФайлов.Удалить();

	Ожидаем.Что(КоличествоСтатистик).Больше(0);

КонецПроцедуры

&Тест
Процедура ИзолированныйПроцессПишетСтатистикуВПутьСПробелом() Экспорт

	// Путь к статистике уезжает в дочерний процесс параметром -codestat, а параметры
	// команды склеиваются через пробел: без кавычек путь расщепился бы на два аргумента,
	// дочерний процесс не стартовал бы и ни одного stat_*.json не появилось.
	// Так ломался прогон с покрытием, когда TEMP содержал пробел
	МенеджерВременныхФайлов = Новый МенеджерВременныхФайлов();
	КаталогСтатистики = ОбъединитьПути(МенеджерВременныхФайлов.СоздатьКаталог(), "каталог с пробелом");
	СоздатьКаталог(КаталогСтатистики);

	ДопДетальки = Новый Соответствие;
	ДопДетальки.Вставить("OneUnit.КаталогСтатистикиПокрытия", КаталогСтатистики);

	ПрогоныТестов.Прогнать("ИзолированныйПроцессныйКрасныйНабор", "./tests/fixtures/isolation", "", ДопДетальки);

	КоличествоСтатистик = НайтиФайлы(КаталогСтатистики, "stat_*.json").Количество();
	МенеджерВременныхФайлов.Удалить();

	Ожидаем.Что(КоличествоСтатистик).Больше(0);

КонецПроцедуры

&Тест
Процедура ОбнаружениеПоказываетСоставИзолированногоНабора() Экспорт

	// Чистое обнаружение (без исполнения) разворачивает изолированный набор
	// в его среде - внешний тулинг видит фактический состав тестов
	План  = ПланОбнаружения("ИзолированныйЗеленыйНабор");
	Набор = ПрогоныТестов.НайтиНабор(План, "ИзолированныйЗеленыйНабор");

	Ожидаем.Что(Набор.Дети().Количество()).Равно(2);
	Ожидаем.Что(ПрогоныТестов.НайтиТест(Набор, "ПервыйЗеленый")).Не_().ЭтоНеопределено();
	Ожидаем.Что(ПрогоныТестов.НайтиТест(Набор, "ВторойЗеленый")).Не_().ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура ОбнаружениеПоказываетСоставПроцессногоНабора() Экспорт

	// Состав приезжает из дочернего процесса обнаружения, тесты не исполняются -
	// красный тест набора виден в плане, но прогон обнаружения зеленый
	План  = ПланОбнаружения("ИзолированныйПроцессныйКрасныйНабор");
	Набор = ПрогоныТестов.НайтиНабор(План, "ИзолированныйПроцессныйКрасныйНабор");

	Ожидаем.Что(Набор.Дети().Количество()).Равно(2);
	Ожидаем.Что(ПрогоныТестов.НайтиТест(Набор, "КрасныйТест")).Не_().ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура ОшибкаОбнаруженияШаблонаДоходитИзПоделки() Экспорт

	План  = ПланОбнаружения("ИзолированныйБитыйНабор");
	Набор = ПрогоныТестов.НайтиНабор(План, "ИзолированныйБитыйНабор");

	Ожидаем.Что(Набор.Дети().Количество()).Равно(1);

	Шаблон = ПрогоныТестов.НайтиТест(Набор, "ТестСНевернымКлючом");

	Ожидаем.Что(Шаблон.ОшибкиОбнаружения()).ИмеетДлину(1);
	Ожидаем.Что(СтрНайти(Шаблон.ОшибкиОбнаружения().Получить(0).Описание, "НеТотПараметр")).Больше(0);

КонецПроцедуры

Функция ПланОбнаружения(Знач ВключаемыеНаборы)

	Детальки = Новый Соответствие;
	Детальки.Вставить("OneUnit.КаталогиТестов", "./tests/fixtures/isolation");
	Детальки.Вставить("OneUnit.ФайлыТестов", "");
	Детальки.Вставить("OneUnit.ТестовыеНаборыВключаемые", ВключаемыеНаборы);

	Поделка = ПрогоныТестов.СоздатьПоделку(Детальки);

	Возврат Поделка.НайтиЖелудь("МенеджерТестирования").Обнаружить();

КонецФункции

// Цепочка одинакова на обоих уровнях изоляции: отказ создания набора,
// ошибка лямбды совета, исключение конструктора
Процедура ПроверитьЦепочкуПричинСовета(Причина)

	ЦепочкиПричин.ПроверитьЗвенья(Причина, Массивы.ИзЭлементов(
		"Не удаётся инстанцировать тестовый набор",
		"Неизвестный символ: СоветНабора",
		"Конструктор набора сломан намеренно"
	));

КонецПроцедуры

Функция СтатистикаПрогона(Знач ВключаемыеНаборы)

	Возврат ПрогоныТестов.Прогнать(
		ВключаемыеНаборы,
		"./tests/fixtures/isolation"
	).Статистика.СтатистикаТестПлана();

КонецФункции

Функция ПрогонПроцессногоКрасногоНабора()

	Возврат ПрогоныТестов.ПрогнатьОднажды(
		"ПроцессныйКрасныйНабор",
		"ИзолированныйПроцессныйКрасныйНабор",
		"./tests/fixtures/isolation"
	);

КонецФункции

Функция ЧислоВхожденийСтатистикиВВыводеПрогона(Знач ВключаемыеНаборы)

	ПотокВывода = Новый ПотокВПамяти();
	ТестированиеСлужебный.НачатьПерехватВывода(ПотокВывода);

	Попытка
		ПрогоныТестов.Прогнать(ВключаемыеНаборы, "./tests/fixtures/isolation");
	Исключение
		ТестированиеСлужебный.ЗавершитьПерехватВывода();
		ВызватьИсключение;
	КонецПопытки;

	ТестированиеСлужебный.ЗавершитьПерехватВывода();

	Вывод = ПрогоныТестов.ПрочитатьПоток(ПотокВывода);

	Возврат ЧислоВхождений(Вывод, "Запуск тестов завершился");

КонецФункции

Процедура ПроверитьПеренесенноеВремя(Знач ИмяНабора, Знач ИмяТеста)

	Прогон = ПрогоныТестов.Прогнать(ИмяНабора, "./tests/fixtures/isolation");
	Тест   = ПрогоныТестов.НайтиТест(ПрогоныТестов.НайтиНабор(Прогон.План, ИмяНабора), ИмяТеста);

	Перенесенное = Прогон.Статистика.Результат(Тест).ПеренесенноеВремяВыполнения();

	Ожидаем.Что(Перенесенное.СодержитЗначение(), "время перенесено из изолированной среды").ЭтоИстина();

	Перенесенное = Перенесенное.Получить();

	Ожидаем.Что(Перенесенное).БольшеИлиРавно(250);
	Ожидаем.Что(Прогон.Статистика.СтатистикаТеста(Тест).ПолучитьИлиУмолчание("ВремяВыполнения", 0))
		.Равно(Перенесенное);

КонецПроцедуры

Функция ВыводПрогонаДеревом(Знач ВключаемыеНаборы)

	ДопДетальки = Новый Соответствие;
	ДопДетальки.Вставить("OneUnit.РежимВыводаЛога", РежимыВыводаЛога.Дерево);

	ПотокВывода = Новый ПотокВПамяти();
	ТестированиеСлужебный.НачатьПерехватВывода(ПотокВывода);

	Попытка
		ПрогоныТестов.Прогнать(ВключаемыеНаборы, "./tests/fixtures/isolation", "", ДопДетальки);
	Исключение
		ТестированиеСлужебный.ЗавершитьПерехватВывода();
		ВызватьИсключение;
	КонецПопытки;

	ТестированиеСлужебный.ЗавершитьПерехватВывода();

	Возврат ПрогоныТестов.ПрочитатьПоток(ПотокВывода);

КонецФункции

Функция СтрокаТестаВДереве(Знач Вывод, Знач ИмяТеста)

	Для каждого СтрокаВывода Из СтрРазделить(Вывод, Символы.ПС) Цикл
		Если СтрНайти(СтрокаВывода, "─") > 0 И СтрНайти(СтрокаВывода, ИмяТеста) > 0 Тогда
			Возврат СтрокаВывода;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение СтрШаблон("В дереве прогона нет строки теста %1:%2%3", ИмяТеста, Символы.ПС, Вывод);

КонецФункции

Функция ЧислоВхождений(Знач Текст, Знач Подстрока)

	Вхождения = 0;
	Позиция   = СтрНайти(Текст, Подстрока);

	Пока Позиция > 0 Цикл
		Вхождения = Вхождения + 1;
		Позиция   = СтрНайти(Текст, Подстрока, НаправлениеПоиска.СНачала, Позиция + СтрДлина(Подстрока));
	КонецЦикла;

	Возврат Вхождения;

КонецФункции
